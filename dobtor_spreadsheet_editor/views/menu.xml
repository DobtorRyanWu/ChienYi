<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Phase 4.5 — Xlsx 高保真匯入預覽 client action -->
    <record id="action_xlsx_import" model="ir.actions.client">
        <field name="name">Xlsx 高保真匯入</field>
        <field name="tag">dobtor_spreadsheet_editor.import</field>
    </record>

    <!-- 不自建獨立 App；掛在 OCA spreadsheet_oca 既有的「Spreadsheets」選單底下，
         本模組為「繼承 OCA + 加 xlsx 高保真匯入」，不另立 top-level application。 -->
    <menuitem id="menu_xlsx_import"
              name="Xlsx 高保真匯入"
              parent="spreadsheet_oca.spreadsheet_spreadsheet_menu"
              action="action_xlsx_import"
              sequence="20"/>
</odoo>
