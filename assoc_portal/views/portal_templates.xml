<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 開通／重設密碼：token 放在網址的 # 之後（不進 access log、不進 Referer），
         由 JS 搬進表單送出 -->
    <template id="activate_page" name="設定密碼">
        <t t-call="web.frontend_layout">
            <div class="container my-5" style="max-width: 32rem;">
                <h2 class="mb-4">設定密碼</h2>
                <div t-if="error" class="alert alert-danger" role="alert"><t t-esc="error"/></div>
                <form method="post" action="/assoc/activate" class="ax-activate-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="token" id="ax_token" t-att-value="token or ''"/>
                    <div class="mb-3">
                        <label class="form-label" for="ax_password">新密碼（至少 8 個字元）</label>
                        <input type="password" name="password" id="ax_password" class="form-control"
                               autocomplete="new-password" required="required" minlength="8"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="ax_confirm">再輸入一次</label>
                        <input type="password" name="confirm" id="ax_confirm" class="form-control"
                               autocomplete="new-password" required="required" minlength="8"/>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">設定密碼</button>
                    <p class="text-muted mt-3 mb-0 small">
                        這張通知單只能用一次。設定完成後請用 Email 或身分證字號登入。
                    </p>
                </form>
            </div>
            <script type="text/javascript">
                // token 只在 fragment，搬進表單後立刻從網址移除
                (function () {
                    var params = new URLSearchParams(window.location.hash.slice(1));
                    var token = params.get('t');
                    if (token) {
                        document.getElementById('ax_token').value = token;
                        history.replaceState(null, '', window.location.pathname);
                    }
                })();
            </script>
        </t>
    </template>


    <!-- 會員專區與 My account 同一層：會員入口以原生入口卡（portal.portal_docs_entry，與
         Connection &amp; Security 同樣式）直接排在 /my，自成一個分類放在核心那一列前面。
         密碼不另做卡片——核心的 Connection &amp; Security 就是 /my/security。
         守衛不變：只有 `_member_for_user()` 認得的帳號看得到；各頁仍各自用 `_me()` 擋。 -->
    <template id="portal_my_home_assoc" inherit_id="portal.portal_my_home" name="會員入口">
        <xpath expr="//div[@id='portal_common_category']" position="before">
            <t t-set="assoc_member" t-value="request.env['assoc.member']._member_for_user()"/>
            <div t-if="assoc_member" class="o_portal_category row g-2 mt-3" id="assoc_member_category">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/assoc_portal/static/src/img/member-meeting.svg'"/>
                        <t t-set="title">我的大會</t>
                        <t t-set="text">一場大會的報到、委託、禮品、選舉收在同一頁。</t>
                        <t t-set="url" t-value="'/my/assoc/meetings'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/assoc_portal/static/src/img/member-profile.svg'"/>
                        <t t-set="title">我的資料</t>
                        <t t-set="text"><t t-esc="assoc_member.member_no"/>　<t t-esc="assoc_member.name"/>．證明文件上傳</t>
                        <t t-set="url" t-value="'/my/assoc/profile'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/assoc_portal/static/src/img/member-pass.svg'"/>
                        <t t-set="title">電子會員證</t>
                        <t t-set="text">報到時出示，QR 每 30 秒更新。</t>
                        <t t-set="url" t-value="'/my/assoc/pass'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/assoc_portal/static/src/img/member-dues.svg'"/>
                        <t t-set="title">會費與收據</t>
                        <t t-set="text">繳費紀錄與收據下載。</t>
                        <t t-set="url" t-value="'/my/assoc/dues'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/assoc_portal/static/src/img/member-gifts.svg'"/>
                        <t t-set="title">我的禮品</t>
                        <t t-set="text">大會紀念品與領取狀態。</t>
                        <t t-set="url" t-value="'/my/assoc/gifts'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/assoc_portal/static/src/img/member-proxy.svg'"/>
                        <t t-set="title">委託出席</t>
                        <t t-set="text">不能到場時，可委託其他會員代為出席。</t>
                        <t t-set="url" t-value="'/my/assoc/proxies'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/assoc_portal/static/src/img/member-credits.svg'"/>
                        <t t-set="title">繼續教育積分</t>
                        <t t-set="text">研討會出席紀錄與積分證明。</t>
                        <t t-set="url" t-value="'/my/assoc/credits'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
            </div>
        </xpath>
    </template>

    <template id="member_pass" name="電子會員證">
        <t t-call="portal.portal_layout">
            <h3 class="mb-3">電子會員證</h3>
            <div id="ax_pass" class="card mx-auto" style="max-width: 24rem;"
                 t-att-data-codes="codes_json" t-att-data-window="window_seconds">
                <div class="card-body text-center">
                    <img t-if="member.image_128" t-attf-src="data:image/png;base64,#{member.image_128.decode()}"
                         class="rounded mb-2" style="width: 84px; height: 84px; object-fit: cover;"
                         alt="會員照片"/>
                    <h5 class="card-title mb-0"><t t-esc="member.name"/></h5>
                    <p class="text-muted"><t t-esc="member.member_no"/>　<t t-esc="member.company_id.name"/></p>
                    <span t-if="fee_valid" class="badge text-bg-success mb-3">會籍有效</span>
                    <span t-else="" class="badge text-bg-secondary mb-3">會費待繳</span>
                    <div>
                        <img id="ax_pass_qr" t-att-src="first_code" alt="報到 QR"
                             style="width: 260px; height: 260px;"/>
                    </div>
                    <div class="progress mt-2" style="height: 4px;">
                        <div id="ax_pass_bar" class="progress-bar" style="width: 100%;"/>
                    </div>
                    <p class="text-muted small mt-2 mb-0">
                        報到請出示此畫面（<span id="ax_pass_left"/> 秒後更新）。截圖無效。
                    </p>
                </div>
            </div>
            <div class="text-center mt-3">
                <a class="btn btn-outline-secondary btn-sm" href="/my">回會員專區</a>
            </div>
            <script type="text/javascript">
                (function () {
                    var box = document.getElementById('ax_pass');
                    var codes = JSON.parse(box.dataset.codes);
                    var windowSeconds = parseInt(box.dataset.window, 10);
                    var img = document.getElementById('ax_pass_qr');
                    var bar = document.getElementById('ax_pass_bar');
                    var left = document.getElementById('ax_pass_left');
                    // 依牆鐘時間算時窗：用 setInterval 的次數的話，手機鎖屏／切背景時
                    // timer 被節流，解鎖後畫面上的碼會落後伺服器，到櫃台掃出來是過期
                    var startWindow = Math.floor(Date.now() / 1000 / windowSeconds);
                    function refill() {
                        fetch('/my/assoc/pass/tokens', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({jsonrpc: '2.0', method: 'call', params: {}})
                        }).then(function (response) {
                            return response.json();
                        }).then(function (data) {
                            codes = data.result.codes;
                            img.src = codes[0];
                        });
                    }
                    var shown = -1;
                    setInterval(function () {
                        var now = Date.now() / 1000;
                        var remain = Math.ceil(windowSeconds - (now % windowSeconds));
                        left.textContent = remain;
                        bar.style.width = (remain / windowSeconds * 100) + '%';
                        var index = Math.floor(now / windowSeconds) - startWindow;
                        if (index === shown) {
                            return;
                        }
                        if (index >= codes.length || index &lt; 0) {
                            refill();
                            startWindow = Math.floor(now / windowSeconds);
                            shown = 0;
                        } else {
                            img.src = codes[index];
                            shown = index;
                        }
                    }, 1000);
                })();
            </script>
        </t>
    </template>

    <template id="member_profile" name="我的資料">
        <t t-call="portal.portal_layout">
            <h3 class="mb-4">我的資料</h3>
            <table class="table">
                <tr><th style="width: 12rem;">會員編號</th><td><t t-esc="member.member_no"/></td></tr>
                <tr><th>姓名</th><td><t t-esc="member.name"/></td></tr>
                <tr><th>所屬公會</th><td><t t-esc="member.company_id.name"/></td></tr>
                <tr><th>身分證字號</th><td><t t-esc="member.national_id_masked or '—'"/></td></tr>
                <tr><th>Email</th><td><t t-esc="member.email or '—'"/></td></tr>
                <tr><th>手機</th><td><t t-esc="member.mobile or '—'"/></td></tr>
                <tr><th>技師科別</th><td><t t-esc="member.engineer_field or '—'"/></td></tr>
                <tr><th>技師證書字號</th><td><t t-esc="member.engineer_cert_no or '—'"/></td></tr>
                <tr><th>入會日期</th><td><t t-esc="member.join_date or '—'"/></td></tr>
                <tr><th>會費繳至</th><td><t t-esc="member.fee_paid_until or '—'"/></td></tr>
            </table>
            <p class="text-muted">
                資料有誤請洽公會辦公室更正（姓名、照片、聯絡方式由公會維護）。
            </p>

            <div t-if="upload_result == 'ok'" class="alert alert-success">
                已上傳，等候公會審核。
            </div>
            <div t-if="upload_result == 'too_big'" class="alert alert-danger">
                檔案太大（上限 10 MB）。
            </div>
            <div t-if="upload_result == 'bad_type'" class="alert alert-danger">
                只接受 PDF、JPG、PNG 檔。
            </div>
            <div t-if="upload_result == 'bad_image'" class="alert alert-danger">
                這個圖檔解不開，請重新輸出後再上傳。
            </div>
            <div t-if="upload_result == 'too_many'" class="alert alert-danger">
                待審文件太多，請等公會審核後再上傳。
            </div>

            <h5 class="mt-4">證明文件</h5>
            <table class="table table-sm align-middle">
                <thead><tr><th>類型</th><th>證號</th><th>狀態</th><th>檔案</th></tr></thead>
                <tbody>
                    <tr t-foreach="documents" t-as="doc">
                        <td><t t-esc="doc_type_labels.get(doc.doc_type)"/></td>
                        <td><t t-esc="doc.cert_no or '—'"/></td>
                        <td>
                            <span t-attf-class="badge #{'text-bg-success' if doc.state == 'approved' else ('text-bg-danger' if doc.state == 'rejected' else 'text-bg-secondary')}">
                                <t t-esc="state_labels.get(doc.state)"/>
                            </span>
                            <small t-if="doc.reject_reason" class="text-muted d-block">
                                <t t-esc="doc.reject_reason"/>
                            </small>
                        </td>
                        <td>
                            <a t-attf-href="/my/assoc/documents/#{doc.id}/file">下載</a>
                        </td>
                    </tr>
                    <tr t-if="not documents"><td colspan="4" class="text-muted">尚未上傳文件。</td></tr>
                </tbody>
            </table>

            <form method="post" action="/my/assoc/documents/upload" enctype="multipart/form-data"
                  class="row g-2 align-items-end">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="col-sm-4">
                    <label class="form-label" for="ax_doc_type">文件類型</label>
                    <select class="form-select" name="doc_type" id="ax_doc_type">
                        <option value="engineer_cert">技師證書</option>
                        <option value="practice_license">執業執照</option>
                        <option value="education">學經歷證明</option>
                        <option value="photo">會員照片</option>
                        <option value="other">其他</option>
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="form-label" for="ax_cert_no">證號（選填）</label>
                    <input type="text" class="form-control" name="cert_no" id="ax_cert_no"/>
                </div>
                <div class="col-sm-3">
                    <label class="form-label" for="ax_file">檔案（PDF／JPG／PNG）</label>
                    <input type="file" class="form-control" name="file" id="ax_file"
                           accept=".pdf,.jpg,.jpeg,.png" required="required"/>
                </div>
                <div class="col-sm-2">
                    <button type="submit" class="btn btn-primary w-100">上傳</button>
                </div>
            </form>

            <a class="btn btn-outline-secondary mt-4" href="/my">回會員專區</a>
        </t>
    </template>

    <template id="member_proxies" name="委託出席">
        <t t-call="portal.portal_layout">
            <h3 class="mb-3">委託出席</h3>
            <div t-if="proxy_result == 'ok'" class="alert alert-success">
                已送出。<strong>請把書面委託書交給公會辦公室或會場報到台</strong>，收到後才會生效。
            </div>
            <div t-if="proxy_result == 'cancelled'" class="alert alert-success">已取消。</div>
            <div t-if="proxy_result == 'no_holder'" class="alert alert-danger">
                找不到這位受託人：會員編號與姓名必須都吻合。
            </div>
            <div t-if="proxy_result == 'duplicate'" class="alert alert-danger">
                同一場會議、同一個事項只能委託一次，請先取消原本那筆。
            </div>
            <div t-if="proxy_result == 'closed'" class="alert alert-danger">這場已過委託截止時間。</div>
            <div t-if="proxy_result == 'refused'" class="alert alert-danger">
                無法建立委託，請洽公會辦公室。
            </div>
            <div t-if="proxy_result == 'invalid'" class="alert alert-danger">查無這場會議。</div>
            <div t-if="proxy_result == 'too_late'" class="alert alert-danger">
                大會已經開議或結束，生效的委託不能再撤回，請洽公會辦公室。
            </div>

            <p class="text-muted small">
                依人民團體法第 38 條：委託出席不得超過親自出席人數的三分之一，且每人只能接受
                <strong>1 人</strong>的委託。名額額滿時會先列為候補。
            </p>
            <p class="text-muted small">
                送出之後請按「列印委託書」印出、<strong>親自簽名或蓋章</strong>，交給受託人帶到會場報到台。
                報到台掃上面的條碼就找得到這一筆。<strong>重印會讓先前印出的那張失效。</strong>
            </p>

            <h5 class="mt-4">我委託別人</h5>
            <table class="table table-sm align-middle">
                <thead><tr><th>會議</th><th>受託人</th><th>事項</th><th>狀態</th><th/></tr></thead>
                <tbody>
                    <tr t-foreach="proxies" t-as="proxy">
                        <td><t t-esc="proxy.meeting_id.name"/></td>
                        <td><t t-esc="proxy.holder_member_id.name"/></td>
                        <td><t t-esc="purpose_labels.get(proxy.purpose)"/></td>
                        <td>
                            <span t-attf-class="badge #{'text-bg-success' if proxy.state == 'active' else ('text-bg-secondary' if proxy.state in ('cancelled', 'superseded') else 'text-bg-warning')}">
                                <t t-esc="state_labels.get(proxy.state)"/>
                            </span>
                        </td>
                        <td class="text-nowrap">
                            <!-- 列印一定要 POST：它會鑄新單號並讓外面那張舊的失效，
                                 用 GET 的話瀏覽器預抓或按上一頁就把紙作廢了。 -->
                            <form t-if="proxy.state in ('requested', 'waiting')" method="post"
                                  class="d-inline"
                                  t-attf-action="/my/assoc/proxies/#{proxy.id}/form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-primary">列印委託書</button>
                            </form>
                            <form t-if="proxy.state in ('requested', 'waiting') or (proxy.state == 'active' and proxy.meeting_id.state in ('draft', 'checkin_open'))" method="post"
                                  class="d-inline"
                                  t-attf-action="/my/assoc/proxies/#{proxy.id}/cancel">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-danger">取消</button>
                            </form>
                        </td>
                    </tr>
                    <tr t-if="not proxies"><td colspan="5" class="text-muted">尚未委託。</td></tr>
                </tbody>
            </table>

            <h5 class="mt-4">別人委託我</h5>
            <ul class="list-group mb-4">
                <li t-foreach="held" t-as="proxy" class="list-group-item">
                    <t t-esc="proxy.principal_member_id.name"/>　
                    <t t-esc="purpose_labels.get(proxy.purpose)"/>　
                    <span class="text-muted"><t t-esc="state_labels.get(proxy.state)"/></span>
                </li>
                <li t-if="not held" class="list-group-item text-muted">目前沒有人委託你。</li>
            </ul>

            <h5>新增委託</h5>
            <form t-if="open_meetings" method="post" action="/my/assoc/proxies/new" class="row g-2 align-items-end">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="col-sm-4">
                    <label class="form-label" for="ax_proxy_meeting">會議</label>
                    <select class="form-select" name="meeting_id" id="ax_proxy_meeting">
                        <option t-foreach="open_meetings" t-as="m" t-att-value="m.id">
                            <t t-esc="m.name"/>
                        </option>
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="form-label" for="ax_holder_no">受託人會員編號</label>
                    <input type="text" class="form-control" name="holder_no" id="ax_holder_no"
                           required="required"/>
                </div>
                <div class="col-sm-2">
                    <label class="form-label" for="ax_holder_name">受託人姓名</label>
                    <input type="text" class="form-control" name="holder_name" id="ax_holder_name"
                           required="required"/>
                </div>
                <div class="col-sm-2">
                    <label class="form-label" for="ax_purpose">事項</label>
                    <select class="form-select" name="purpose" id="ax_purpose">
                        <option value="attend">大會出席</option>
                        <option value="gift">禮品代領</option>
                    </select>
                </div>
                <div class="col-sm-1">
                    <button type="submit" class="btn btn-primary w-100">送出</button>
                </div>
            </form>
            <p t-else="" class="text-muted">目前沒有開放委託的會議。</p>
            <a class="btn btn-outline-secondary mt-3" href="/my">回會員專區</a>
        </t>
    </template>

    <template id="member_credits" name="我的積分">
        <t t-call="portal.portal_layout">
            <h3 class="mb-3">繼續教育積分</h3>
            <p>累計積分：<strong t-esc="total_points"/></p>
            <table class="table table-sm align-middle">
                <thead><tr><th>課程</th><th>日期</th><th>時數</th><th>積分</th><th>判定</th><th/></tr></thead>
                <tbody>
                    <tr t-foreach="attendances" t-as="att">
                        <td><t t-esc="att.meeting_id.name"/></td>
                        <!-- 同上：裸 t-esc 一個 Datetime 會印 naive UTC（台北早 8 小時） -->
                        <td>
                            <t t-out="att.meeting_id.date_begin"
                               t-options="{'widget': 'datetime', 'format': 'yyyy-MM-dd HH:mm',
                                           'tz_name': assoc_tz}"/>
                        </td>
                        <td><t t-esc="att.meeting_id.credit_hours"/></td>
                        <td><t t-esc="att.credit_points"/></td>
                        <td>
                            <span t-attf-class="badge #{'text-bg-success' if att.credit_status == 'eligible' else 'text-bg-secondary'}">
                                <t t-esc="status_labels.get(att.credit_status)"/>
                            </span>
                        </td>
                        <td>
                            <a t-if="att.credit_status == 'eligible'"
                               t-attf-href="/my/assoc/credits/#{att.id}/certificate">下載證明</a>
                        </td>
                    </tr>
                    <tr t-if="not attendances"><td colspan="6" class="text-muted">尚無研討會紀錄。</td></tr>
                </tbody>
            </table>
            <a class="btn btn-outline-secondary" href="/my">回會員專區</a>
        </t>
    </template>

    <template id="member_dues" name="會費與收據">
        <t t-call="portal.portal_layout">
            <h3 class="mb-3">會費與收據</h3>
            <p>
                會費繳至：<strong t-esc="member.fee_paid_until or '—'"/>
                <span t-if="fee_valid" class="badge text-bg-success ms-2">會籍有效</span>
                <span t-else="" class="badge text-bg-secondary ms-2">會費待繳</span>
            </p>

            <h5 class="mt-4">應繳紀錄</h5>
            <table class="table table-sm align-middle">
                <!-- text-nowrap：390px 的手機上「收據」會被拆成兩行 -->
                <thead><tr><th>期別</th><th class="text-nowrap">期間</th><th>金額</th>
                    <th>狀態</th><th class="text-nowrap">收據</th></tr></thead>
                <tbody>
                    <tr t-foreach="dues" t-as="one">
                        <td><t t-esc="one.period_id.name"/></td>
                        <td><t t-esc="one.date_from"/> ~ <t t-esc="one.date_to"/></td>
                        <td><t t-esc="one.amount_due"/></td>
                        <td>
                            <span t-attf-class="badge #{'text-bg-success' if one.state in ('paid', 'waived') else 'text-bg-danger'}">
                                <t t-esc="state_labels.get(one.state)"/>
                            </span>
                        </td>
                        <td>
                            <a t-if="one.payment_id and one.payment_id.state == 'posted'"
                               t-attf-href="/my/assoc/receipts/#{one.payment_id.id}">下載</a>
                        </td>
                    </tr>
                    <tr t-if="not dues"><td colspan="5" class="text-muted">尚無應繳紀錄。</td></tr>
                </tbody>
            </table>

            <h5 class="mt-4">收據</h5>
            <ul class="list-group mb-3">
                <li t-foreach="payments" t-as="payment" class="list-group-item d-flex justify-content-between">
                    <span>
                        <t t-esc="payment.date"/>　<t t-esc="payment.receipt_no"/>　
                        新臺幣 <t t-esc="payment.amount_total"/> 元
                    </span>
                    <a t-attf-href="/my/assoc/receipts/#{payment.id}">下載</a>
                </li>
                <li t-if="not payments" class="list-group-item text-muted">尚無收據。</li>
            </ul>
            <p class="text-muted small">繳費方式與金額請洽公會辦公室；系統只提供紀錄查詢。</p>
            <a class="btn btn-outline-secondary" href="/my">回會員專區</a>
        </t>
    </template>

    <template id="member_gifts" name="我的禮品">
        <t t-call="portal.portal_layout">
            <h3 class="mb-3">我的禮品</h3>
            <p class="text-muted">
                領取一律在大會現場的報到台辦理（要核對本人），這裡只看得到狀態。
            </p>

            <table class="table table-sm align-middle">
                <thead><tr><th>活動</th><th>品項</th><th class="text-nowrap">發放方式</th>
                    <th>狀態</th><th class="text-nowrap">領取</th></tr></thead>
                <tbody>
                    <tr t-foreach="gifts" t-as="one">
                        <td><t t-esc="one.campaign_id.name"/></td>
                        <td><t t-esc="one.item_id.name"/></td>
                        <!-- t-field 不能放在 <t> 上（QWeb 要求真正的 HTML 節點） -->
                        <td class="text-nowrap"><span t-field="one.delivery"/></td>
                        <td>
                            <span t-attf-class="badge #{'text-bg-success' if one.state in ('claimed', 'exported') else 'text-bg-secondary'}">
                                <t t-esc="state_labels.get(one.state)"/>
                            </span>
                        </td>
                        <td class="text-nowrap">
                            <t t-if="one.holder_member_id and one.holder_member_id != member">
                                由 <t t-esc="one.holder_member_id.name"/> 代領
                            </t>
                            <!-- **不要直接 t-esc 一個 Datetime**：它是 naive UTC，
                                 印出來會變成「2026-09-20 03:43:16.595695」——微秒外露，
                                 而且會員看到的是 UTC。
                                 **而只加 widget 也不夠**：widget 預設依**觀看者**的時區換算，
                                 而前台帳號的 tz 是從 portal 範本 partner 繼承來的
                                 （示範庫裡是 Europe/Brussels），於是會印出形狀合理但
                                 錯 6 小時的值——比外露微秒更難發現（第十輪 skeptic 實查）。
                                 領取時間是**公會當地發生的事實**，不該隨觀看者變，
                                 所以用 `tz_name` 釘死公會時區。 -->
                            <t t-elif="one.claimed_at">
                                <t t-out="one.claimed_at"
                                   t-options="{'widget': 'datetime', 'format': 'yyyy-MM-dd HH:mm',
                                               'tz_name': assoc_tz}"/>
                            </t>
                            <t t-else="">—</t>
                        </td>
                    </tr>
                    <tr t-if="not gifts"><td colspan="5" class="text-muted">目前沒有禮品紀錄。</td></tr>
                </tbody>
            </table>

            <div t-if="gift_proxies" class="mt-4">
                <h5>禮品代領委託</h5>
                <ul class="list-group">
                    <li t-foreach="gift_proxies" t-as="proxy" class="list-group-item">
                        <t t-if="proxy.principal_member_id == member">
                            我委託 <strong t-esc="proxy.holder_member_id.name"/> 代領
                        </t>
                        <t t-else="">
                            我代 <strong t-esc="proxy.principal_member_id.name"/> 領取
                        </t>
                        <span class="text-muted">（<t t-esc="proxy.meeting_id.name"/>）</span>
                    </li>
                </ul>
            </div>

            <a class="btn btn-secondary mt-4" href="/my">回會員專區</a>
        </t>
    </template>
</odoo>
