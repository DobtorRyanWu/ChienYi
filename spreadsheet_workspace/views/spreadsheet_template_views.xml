<odoo>

    <record id="spreadsheet_template_list_view" model="ir.ui.view">
        <field name="name">spreadsheet.workspace.template.list</field>
        <field name="model">spreadsheet.workspace.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_create_spreadsheet" type="object" string="建立" icon="fa-plus"/>
                <button name="action_preview" type="object" title="預覽" icon="fa-eye"/>
            </list>
        </field>
    </record>

    <record id="spreadsheet_template_kanban_view" model="ir.ui.view">
        <field name="name">spreadsheet.workspace.template.kanban</field>
        <field name="model">spreadsheet.workspace.template</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category">
                <templates>
                    <t t-name="card">
                        <!-- 寫法比照 OCA 試算表看板的 badge_image -->
                        <t t-if="record.preview_image.raw_value">
                            <field name="preview_image" widget="image" class="mb-2"
                                   options="{'img_class': 'object-fit-contain w-100', 'size': [0, 140]}"/>
                        </t>
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="description" class="text-muted"/>
                        <footer class="mt-2 pt-0">
                            <div class="d-flex gap-1">
                                <button name="action_create_spreadsheet" type="object" class="btn btn-primary btn-sm">
                                    <i class="fa fa-plus"/> 建立
                                </button>
                                <button name="action_preview" type="object" class="btn btn-secondary btn-sm">
                                    <i class="fa fa-eye"/> 預覽
                                </button>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="spreadsheet_template_form_view" model="ir.ui.view">
        <field name="name">spreadsheet.workspace.template.form</field>
        <field name="model">spreadsheet.workspace.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_spreadsheet" type="object" string="建立試算表"
                            class="btn-primary" icon="fa-plus"/>
                    <button name="action_preview" type="object" string="預覽" icon="fa-eye"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="已封存" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="模板名稱"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="preview_image" widget="image" options="{'size': [0, 140]}"/>
                        </group>
                    </group>
                    <group string="描述">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spreadsheet_template_search_view" model="ir.ui.view">
        <field name="name">spreadsheet.workspace.template.search</field>
        <field name="model">spreadsheet.workspace.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category"/>
                <separator/>
                <filter name="archived" string="已封存" domain="[('active', '=', False)]"/>
                <group expand="0" string="分組">
                    <filter name="group_by_category" string="分類" context="{'group_by': 'category'}"/>
                </group>
                <searchpanel>
                    <field name="category" string="分類" icon="fa-folder" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_spreadsheet_template" model="ir.actions.act_window">
        <field name="name">試算表模板庫</field>
        <field name="res_model">spreadsheet.workspace.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">還沒有模板</p>
            <p>在試算表的資訊視窗勾選「可作為模板」，表單上就會出現「另存為模板」。</p>
        </field>
    </record>

</odoo>
