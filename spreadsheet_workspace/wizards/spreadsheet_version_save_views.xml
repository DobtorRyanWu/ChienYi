<odoo>

    <record id="spreadsheet_version_save_form_view" model="ir.ui.view">
        <field name="name">spreadsheet.workspace.version.save.form</field>
        <field name="model">spreadsheet.workspace.version.save</field>
        <field name="arch" type="xml">
            <form string="存成版本">
                <sheet>
                    <group>
                        <field name="spreadsheet_id" readonly="1" options="{'no_open': True}"/>
                        <field name="commit_message" placeholder="這一版改了什麼，例如：第13期估驗數量核定"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="存成版本" class="btn-primary"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 編輯器上方列的「存成版本」用這個動作開小視窗（default_spreadsheet_id 由前端帶入） -->
    <record id="action_spreadsheet_version_save" model="ir.actions.act_window">
        <field name="name">存成版本</field>
        <field name="res_model">spreadsheet.workspace.version.save</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
