<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="spreadsheet_workspace.VersionCompareSide">
        <div class="card h-100">
            <div class="card-header fw-bold" t-esc="title"/>
            <div class="card-body py-2">
                <div><b>時間：</b><t t-esc="side.date"/></div>
                <div><b>提交者：</b><t t-esc="side.user"/></div>
                <div><b>說明：</b><t t-esc="side.message"/></div>
            </div>
        </div>
    </t>

    <t t-name="spreadsheet_workspace.VersionCompare">
        <div class="o_action o_spreadsheet_workspace_compare h-100 overflow-auto bg-view">
            <div class="d-flex align-items-center justify-content-between px-3 pt-3">
                <h4 class="mb-0">
                    <i class="fa fa-history me-2"/>版本對比
                    <small t-if="payload" class="text-muted ms-2" t-esc="payload.spreadsheet_name"/>
                </h4>
                <button type="button" class="btn btn-secondary" t-on-click="onClose">
                    <i class="fa fa-times me-1"/>關閉
                </button>
            </div>

            <div t-if="state.error" class="alert alert-warning m-3" t-esc="state.error"/>

            <t t-elif="payload">
                <div class="row g-3 mx-0 px-2 pt-3">
                    <div class="col-md-6">
                        <t t-call="spreadsheet_workspace.VersionCompareSide">
                            <t t-set="title" t-value="'原版本'"/>
                            <t t-set="side" t-value="payload.from"/>
                        </t>
                    </div>
                    <div class="col-md-6">
                        <t t-call="spreadsheet_workspace.VersionCompareSide">
                            <t t-set="title" t-value="'目前內容'"/>
                            <t t-set="side" t-value="payload.to"/>
                        </t>
                    </div>
                </div>

                <div t-if="!diff.sheets.length" class="alert alert-info m-3 o_spreadsheet_workspace_no_diff">
                    <i class="fa fa-info-circle me-1"/>兩個版本之間無差異
                </div>

                <div t-else="" class="px-3 pb-3">
                    <p class="mt-3 mb-2 o_spreadsheet_workspace_diff_summary">
                        共 <b t-esc="diff.total"/> 格不同，分布在 <b t-esc="diff.sheets.length"/> 張工作表。
                        比的是儲存格的輸入內容（文字、數字、公式），格式變動不列入。
                    </p>
                    <div t-foreach="diff.sheets" t-as="sheet" t-key="sheet.id" class="card mb-3">
                        <div class="card-header d-flex align-items-center gap-2">
                            <i class="fa fa-table"/>
                            <b t-esc="sheet.name"/>
                            <span t-if="sheet.change === 'added'" class="badge text-bg-success">新增的工作表</span>
                            <span t-if="sheet.change === 'removed'" class="badge text-bg-danger">已刪除的工作表</span>
                            <span t-if="sheet.previousName" class="text-muted small">
                                原名：<t t-esc="sheet.previousName"/>
                            </span>
                            <span class="ms-auto text-muted small"><t t-esc="sheet.rows.length"/> 格</span>
                        </div>
                        <table t-if="sheet.rows.length" class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 90px;">儲存格</th>
                                    <th style="width: 80px;">變動</th>
                                    <th>原版本</th>
                                    <th>目前內容</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="sheet.rows.slice(0, maxRows)" t-as="row" t-key="row.cell"
                                    class="o_spreadsheet_workspace_diff_row">
                                    <td class="fw-bold" t-esc="row.cell"/>
                                    <td>
                                        <span class="badge" t-att-class="changeBadgeClass(row.change)"
                                              t-esc="changeLabel(row.change)"/>
                                    </td>
                                    <td class="text-break" t-esc="row.before"/>
                                    <td class="text-break" t-esc="row.after"/>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="sheet.rows.length > maxRows" class="card-footer text-muted small">
                            這張工作表共 <t t-esc="sheet.rows.length"/> 格不同，只顯示前 <t t-esc="maxRows"/> 格。
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
