<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Preliminary Acceptance Views                -->
    <!-- ============================================ -->

    <!-- Tree View -->
    <record id="view_acceptance_preliminary_tree" model="ir.ui.view">
        <field name="name">acceptance.preliminary.tree</field>
        <field name="model">acceptance.preliminary</field>
        <field name="arch" type="xml">
            <list string="初驗紀錄" decoration-danger="has_unresolved_defect" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="acceptance_date"/>
                <field name="result" optional="show"/>
                <field name="defect_count" optional="show"/>
                <field name="unresolved_defect_count" optional="show"/>
                <field name="improvement_deadline" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'scheduled'"
                       decoration-warning="state in ('in_progress', 'pending_improvement')"
                       decoration-success="state in ('reviewed', 'improvement_done', 'closed')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="has_unresolved_defect" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_acceptance_preliminary_form" model="ir.ui.view">
        <field name="name">acceptance.preliminary.form</field>
        <field name="model">acceptance.preliminary</field>
        <field name="arch" type="xml">
            <form string="初驗紀錄">
                <header>
                    <button name="action_schedule" string="排定驗收" type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="開始驗收" type="object"
                            class="oe_highlight"
                            invisible="state not in ('draft', 'scheduled')"/>
                    <button name="action_complete_pass" string="驗收合格" type="object"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_complete_with_defects" string="完成驗收(有缺失)" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_confirm_improvement" string="確認改善完成" type="object"
                            class="oe_highlight"
                            invisible="state != 'pending_improvement'"/>
                    <button name="action_review" string="審核通過" type="object"
                            class="oe_highlight"
                            invisible="state not in ('in_progress', 'improvement_done')"/>
                    <button name="action_close" string="結案" type="object"
                            class="oe_highlight"
                            invisible="state != 'reviewed'"/>
                    <button name="action_create_final_acceptance" string="建立正驗" type="object"
                            invisible="not can_create_final"/>
                    <button name="action_cancel" string="取消" type="object"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_reset_draft" string="重設為草稿" type="object"
                            invisible="state not in ('scheduled', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,in_progress,reviewed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_defects" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="defect_count" widget="statinfo" string="缺失"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="基本資訊">
                            <field name="project_id"/>
                            <field name="authority_id"/>
                            <field name="contractor_company_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="驗收日期">
                            <field name="scheduled_date"/>
                            <field name="acceptance_date"/>
                            <field name="completion_date"/>
                            <field name="days_from_completion"/>
                        </group>
                    </group>
                    <group>
                        <group string="驗收人員">
                            <field name="chairman_id"/>
                            <field name="committee_ids" widget="many2many_tags"/>
                            <field name="supervision_representative_id"/>
                            <field name="contractor_representative_id"/>
                        </group>
                        <group string="驗收結果">
                            <field name="result"/>
                            <field name="improvement_deadline"
                                   invisible="result == 'pass'"/>
                            <field name="extension_deadline"
                                   invisible="not extension_deadline"/>
                            <field name="effective_deadline"
                                   invisible="not effective_deadline"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="驗收項目" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="category"/>
                                    <field name="name"/>
                                    <field name="task_id" optional="hide"/>
                                    <field name="result"/>
                                    <field name="defect_description"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="驗收缺失" name="defects">
                            <field name="defect_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="severity"/>
                                    <field name="description"/>
                                    <field name="deadline"/>
                                    <field name="state"/>
                                </list>
                            </field>
                            <button name="action_create_defect" string="新增缺失" type="object"
                                    class="oe_highlight"
                                    invisible="state not in ('in_progress', 'pending_improvement')"/>
                        </page>
                        <page string="會議紀錄" name="minutes">
                            <field name="minutes"/>
                        </page>
                        <page string="附件" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="審核資訊" name="review"
                              invisible="state == 'draft'">
                            <group>
                                <group>
                                    <field name="reviewer_id"/>
                                    <field name="review_date"/>
                                </group>
                                <group>
                                    <field name="review_comment"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <group string="備註">
                        <field name="note" nolabel="1"/>
                    </group>
                    <field name="can_create_final" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_acceptance_preliminary_search" model="ir.ui.view">
        <field name="name">acceptance.preliminary.search</field>
        <field name="model">acceptance.preliminary</field>
        <field name="arch" type="xml">
            <search string="搜尋初驗紀錄">
                <field name="name"/>
                <field name="project_id"/>
                <field name="contractor_company_id"/>
                <separator/>
                <filter string="草稿" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="已排定" name="scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="驗收中" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="待改善" name="pending_improvement" domain="[('state', '=', 'pending_improvement')]"/>
                <filter string="已審核" name="reviewed" domain="[('state', '=', 'reviewed')]"/>
                <filter string="已結案" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="有未解決缺失" name="has_defect" domain="[('has_unresolved_defect', '=', True)]"/>
                <filter string="合格" name="pass" domain="[('result', '=', 'pass')]"/>
                <filter string="不合格" name="fail" domain="[('result', '=', 'fail')]"/>
                <separator/>
                <filter string="本月" name="this_month" domain="[
                    ('acceptance_date', '>=', (context_today() - datetime.timedelta(days=context_today().day - 1)).strftime('%Y-%m-%d')),
                    ('acceptance_date', '&lt;', (context_today() + datetime.timedelta(days=32 - context_today().day)).replace(day=1).strftime('%Y-%m-%d'))
                ]"/>
                <group expand="0" string="群組">
                    <filter string="工程" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="狀態" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="結果" name="group_by_result" context="{'group_by': 'result'}"/>
                    <filter string="驗收月份" name="group_by_month" context="{'group_by': 'acceptance_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_acceptance_preliminary" model="ir.actions.act_window">
        <field name="name">初驗紀錄</field>
        <field name="res_model">acceptance.preliminary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acceptance_preliminary_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一筆初驗紀錄
            </p>
            <p>
                初驗是工程竣工後的初次驗收，用於檢驗工程是否符合契約要求。
            </p>
        </field>
    </record>

    <!-- Action: Pending Improvement -->
    <record id="action_acceptance_preliminary_pending" model="ir.actions.act_window">
        <field name="name">待改善初驗</field>
        <field name="res_model">acceptance.preliminary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_acceptance_preliminary_search"/>
        <field name="domain">[('state', '=', 'pending_improvement')]</field>
        <field name="context">{'search_default_has_defect': 1}</field>
    </record>

</odoo>
