<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================================
         驗收結案選單 (歸屬於 驗收結案)
         =================================================================== -->

    <!-- 初驗管理 -->
    <menuitem id="menu_acceptance_preliminary_list"
              name="初驗紀錄"
              parent="construction_supervision_base.menu_preliminary_acceptance"
              action="action_acceptance_preliminary"
              sequence="10"/>

    <menuitem id="menu_acceptance_preliminary_pending"
              name="待改善初驗"
              parent="construction_supervision_base.menu_preliminary_acceptance"
              action="action_acceptance_preliminary_pending"
              sequence="20"
              groups="base.group_user"/>

    <!-- 正驗管理 -->
    <menuitem id="menu_acceptance_final_list"
              name="正驗紀錄"
              parent="construction_supervision_base.menu_final_acceptance"
              action="action_acceptance_final"
              sequence="10"/>

    <menuitem id="menu_acceptance_final_pending"
              name="待審核正驗"
              parent="construction_supervision_base.menu_final_acceptance"
              action="action_acceptance_final_pending"
              sequence="20"
              groups="base.group_user"/>

    <!-- 驗收缺失 -->
    <menuitem id="menu_acceptance_defect_list"
              name="驗收缺失清單"
              parent="construction_supervision_base.menu_acceptance_defect"
              action="action_acceptance_defect"
              sequence="10"/>

    <menuitem id="menu_acceptance_defect_overdue"
              name="逾期缺失"
              parent="construction_supervision_base.menu_acceptance_defect"
              action="action_acceptance_defect_overdue"
              sequence="20"
              groups="base.group_user"/>

    <menuitem id="menu_acceptance_defect_pending_recheck"
              name="待覆驗缺失"
              parent="construction_supervision_base.menu_acceptance_defect"
              action="action_acceptance_defect_pending_recheck"
              sequence="30"
              groups="base.group_user"/>

    <!-- 結案管理 -->
    <menuitem id="menu_project_closure_list"
              name="結案處理"
              parent="construction_supervision_base.menu_closure"
              action="action_project_closure"
              sequence="10"/>

    <menuitem id="menu_project_closure_warranty"
              name="保固中工程"
              parent="construction_supervision_base.menu_closure"
              action="action_project_closure_warranty"
              sequence="20"/>

    <menuitem id="menu_project_closure_retention"
              name="待退保留款"
              parent="construction_supervision_base.menu_closure"
              action="action_project_closure_retention"
              sequence="30"
              groups="base.group_user"/>

</odoo>
