<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================ -->
        <!-- Record Rules for Acceptance Module          -->
        <!-- ============================================ -->

        <!-- Preliminary Acceptance: Company Rule -->
        <record id="rule_acceptance_preliminary_company" model="ir.rule">
            <field name="name">Preliminary Acceptance: Multi-Company</field>
            <field name="model_id" ref="model_acceptance_preliminary"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Final Acceptance: Company Rule -->
        <record id="rule_acceptance_final_company" model="ir.rule">
            <field name="name">Final Acceptance: Multi-Company</field>
            <field name="model_id" ref="model_acceptance_final"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Acceptance Defect: Company Rule -->
        <record id="rule_acceptance_defect_company" model="ir.rule">
            <field name="name">Acceptance Defect: Multi-Company</field>
            <field name="model_id" ref="model_acceptance_defect"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Project Closure: Company Rule -->
        <record id="rule_project_closure_company" model="ir.rule">
            <field name="name">Project Closure: Multi-Company</field>
            <field name="model_id" ref="model_project_closure"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
