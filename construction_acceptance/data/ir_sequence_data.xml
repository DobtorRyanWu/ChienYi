<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================= -->
        <!-- Preliminary Acceptance Sequence -->
        <!-- ============================= -->
        <record id="seq_acceptance_preliminary" model="ir.sequence">
            <field name="name">初驗單序號</field>
            <field name="code">acceptance.preliminary</field>
            <field name="prefix">PA%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ============================= -->
        <!-- Final Acceptance Sequence     -->
        <!-- ============================= -->
        <record id="seq_acceptance_final" model="ir.sequence">
            <field name="name">正驗單序號</field>
            <field name="code">acceptance.final</field>
            <field name="prefix">FA%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ============================= -->
        <!-- Acceptance Defect Sequence    -->
        <!-- ============================= -->
        <record id="seq_acceptance_defect" model="ir.sequence">
            <field name="name">驗收缺失序號</field>
            <field name="code">acceptance.defect</field>
            <field name="prefix">AD%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ============================= -->
        <!-- Project Closure Sequence      -->
        <!-- ============================= -->
        <record id="seq_project_closure" model="ir.sequence">
            <field name="name">結案單序號</field>
            <field name="code">project.closure</field>
            <field name="prefix">CL%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
