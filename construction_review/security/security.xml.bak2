<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 資料隔離規則 (Record Rules)                      -->
        <!-- ============================================== -->

        <!-- 送審管制 - 監造單位完整存取 -->
        <record id="rule_review_application_supervision" model="ir.rule">
            <field name="name">送審管制: 監造單位完整存取</field>
            <field name="model_id" ref="model_supervision_review_application"/>
            <field name="domain_force">[('project_id.company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervision_manager')), (4, ref('construction_supervision_base.group_supervision_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 送審管制 - 施工廠商可提送送審 -->
        <record id="rule_review_application_contractor" model="ir.rule">
            <field name="name">送審管制: 施工廠商提送送審</field>
            <field name="model_id" ref="model_supervision_review_application"/>
            <field name="domain_force">[('project_id.contractor_company_ids', 'in', [user.company_id.id])]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_contractor_manager')), (4, ref('construction_supervision_base.group_contractor_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 送審管制 - 系統管理者完整存取 -->
        <record id="rule_review_application_admin" model="ir.rule">
            <field name="name">送審管制: 管理者完整存取</field>
            <field name="model_id" ref="model_supervision_review_application"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
