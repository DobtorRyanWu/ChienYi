<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 資料隔離規則 (Record Rules)                      -->
        <!-- ============================================== -->

        <!-- 送審管制 - 監造單位完整存取 -->

        <!-- 送審管制 - 施工廠商可提送送審 -->

        <!-- 送審管制 - 系統管理者完整存取 -->
        <record id="rule_review_application_admin" model="ir.rule">
            <field name="name">送審管制: 管理者完整存取</field>
            <field name="model_id" ref="model_supervision_review_application"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
    <data>
        <!-- 掛在工程底下的業務資料：前台成員制可見性（2026-11-04 補）。原本前台讀得到、卻沒有任何前台規則，非成員經 RPC 讀得到別案（第四輪審查實測估驗單、契約變更、工程資料夾）。寫法同照片、缺失、日誌：所有前台帳號只看參與的工程，老闆另加公司範圍。回歸：construction_portal/tests/test_portal_orm_readonly.py 的 D 段 -->
        <record id="plan_control_portal_member_rule" model="ir.rule">
            <field name="name">Portal: 計畫管制 - 成員專案讀取（預設）</field>
            <field name="model_id" ref="model_supervision_plan_control"/>
            <field name="domain_force">[('project_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="plan_control_portal_boss_rule" model="ir.rule">
            <field name="name">Portal老闆: 計畫管制 - 公司範圍</field>
            <field name="model_id" ref="model_supervision_plan_control"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="review_application_portal_member_rule" model="ir.rule">
            <field name="name">Portal: 送審 - 成員專案讀取（預設）</field>
            <field name="model_id" ref="model_supervision_review_application"/>
            <field name="domain_force">[('project_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="review_application_portal_boss_rule" model="ir.rule">
            <field name="name">Portal老闆: 送審 - 公司範圍</field>
            <field name="model_id" ref="model_supervision_review_application"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
