    <!-- ====================== 登入 Modal（頁面層級，homepage 引入）======================
         自包含 .qy-modal：不依賴 Bootstrap JS，由 qytech.js 以 .qy-open 控制開關。
         所有登入動作導向 Odoo 真實 /web/login（email 會帶入 ?login= 預填）。 -->
    <template id="s_qytech_login_modal" name="千溢科技 - 登入視窗">
        <div class="qy-modal" id="qyLoginModal" role="dialog" aria-modal="true" aria-hidden="true">
            <div class="qy-modal-backdrop" data-qy-close="1"></div>
            <div class="qy-modal-panel">
                <div class="qy-modal-top-bar"></div>
                <button type="button" class="qy-modal-close" data-qy-close="1" aria-label="關閉"><i class="fa-solid fa-xmark"></i></button>
                <div class="text-center mb-4">
                    <div class="qy-modal-icon"><i class="fa-solid fa-cloud"></i></div>
                    <h3 class="qy-font-bold qy-text-slate-900 mb-1" style="font-size:1.5rem;">工程管理雲端</h3>
                    <p class="qy-text-slate-500 mb-0">請登入以存取專案資料</p>
                </div>
                <div class="d-flex flex-column gap-3">
                    <a href="/web/login" class="qy-oauth-btn">
                        <img src="https://www.svgrepo.com/show/475656/google-color.svg" style="width:1.25rem;height:1.25rem;" alt="Google"/>
                        使用 Google 帳號登入
                    </a>
                    <div class="qy-divider"><hr/><span>或使用一般帳號</span></div>
                    <!-- data-qy-login-form：qytech.js 攔截後導向 /web/login?login=<email> -->
                    <form action="/web/login" method="get" class="d-flex flex-column gap-3" data-qy-login-form="1">
                        <input type="email" name="login" placeholder="電子郵件" class="qy-input"/>
                        <input type="password" placeholder="密碼" class="qy-input"/>
                        <button type="submit" class="qy-btn qy-btn-blue-lg">登入系統</button>
                    </form>
                </div>
                <div class="mt-4 text-center qy-sm qy-text-slate-500">
                    <a href="/web/reset_password" class="qy-footer-link qy-text-slate-500">忘記密碼？</a>
                </div>
            </div>
        </div>
    </template>

