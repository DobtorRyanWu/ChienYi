    <!-- ====================== 聯絡 / 報修（Odoo 網站表單 → crm.lead）====================== -->
    <template id="s_qytech_contact" name="千溢科技 - 聯絡報修">
        <section id="contact" class="s_qytech_contact qytech-page qy-section qy-bg-white" data-name="千溢聯絡報修" data-snippet="s_qytech_contact" style="border-top:1px solid var(--qy-slate-200);">
            <div class="qy-container-4xl">
                <div class="text-center mb-5">
                    <h2 class="qy-h3 qy-font-bold qy-text-slate-900">聯絡我們 / 客服報修</h2>
                    <p class="qy-text-slate-600 mt-2 mb-0">我們提供全方位的技術支援。無論是業務諮詢或產品維修，請詳細填寫以下表單。</p>
                </div>

                <form action="/website/form/" method="post" enctype="multipart/form-data"
                      class="s_website_form qy-form-card p-4 p-md-5 o_mark_required"
                      data-mark="*" data-pre-fill="true" data-model_name="crm.lead"
                      data-success-mode="message">
                    <!-- 隱藏：lead 標題（crm.lead.name 必填） -->
                    <input type="hidden" name="name" value="官網聯絡/報修表單"/>

                    <!-- 區段一：基本資料 -->
                    <div class="mb-4">
                        <h3 class="qy-form-section-title qy-bl-blue">基本資料</h3>
                        <div class="row g-4">
                            <div class="col-md-6 s_website_form_field s_website_form_required" data-type="char">
                                <label class="qy-label">公司/機關名稱 <span class="qy-req">*</span></label>
                                <input type="text" name="partner_name" required="1" class="qy-glass-input form-control" placeholder="例如：千溢營造"/>
                            </div>
                            <div class="col-md-6 s_website_form_field s_website_form_required" data-type="char">
                                <label class="qy-label">聯絡人姓名 <span class="qy-req">*</span></label>
                                <input type="text" name="contact_name" required="1" class="qy-glass-input form-control" placeholder="王小明"/>
                            </div>
                            <div class="col-md-6 s_website_form_field s_website_form_model_required" data-type="email">
                                <label class="qy-label">電子郵件 <span class="qy-req">*</span></label>
                                <input type="email" name="email_from" required="1" class="qy-glass-input form-control" placeholder="name@company.com"/>
                            </div>
                            <div class="col-md-6 s_website_form_field s_website_form_required" data-type="tel">
                                <label class="qy-label">聯絡電話 <span class="qy-req">*</span></label>
                                <input type="tel" name="phone" required="1" class="qy-glass-input form-control" placeholder="0912-345-678"/>
                            </div>
                        </div>
                    </div>

                    <div style="border-top:1px solid var(--qy-slate-200);" class="my-2"></div>

                    <!-- 區段二：需求詳情 -->
                    <div>
                        <h3 class="qy-form-section-title qy-bl-cyan">需求詳情</h3>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6 s_website_form_field s_website_form_custom s_website_form_required" data-type="selection">
                                <label class="qy-label">服務類別 <span class="qy-req">*</span></label>
                                <select name="服務類別" required="1" class="qy-glass-input form-select">
                                    <option value="" disabled="disabled" selected="selected">請選擇服務項目...</option>
                                    <option value="業務諮詢">業務諮詢</option>
                                    <option value="系統操作問題">系統操作問題</option>
                                    <option value="硬體操作問題">硬體操作問題</option>
                                    <option value="帳號/權限管理">帳號/權限管理</option>
                                    <option value="其他/產學合作">其他/產學合作</option>
                                </select>
                            </div>
                            <div class="col-md-6 s_website_form_field s_website_form_custom" data-type="selection">
                                <label class="qy-label">相關產品</label>
                                <select name="相關產品" class="qy-glass-input form-select">
                                    <option value="" disabled="disabled" selected="selected">請選擇相關產品...</option>
                                    <option value="工程管理平台">工程管理平台</option>
                                    <option value="AI 門衛管理系統">AI 門衛管理系統</option>
                                    <option value="水下測量器具">水下測量器具</option>
                                    <option value="尚未購買/一般諮詢">尚未購買/一般諮詢</option>
                                </select>
                            </div>
                        </div>
                        <div class="s_website_form_field s_website_form_required" data-type="text">
                            <label class="qy-label">問題描述 / 需求說明 <span class="qy-req">*</span></label>
                            <textarea name="description" required="1" class="qy-glass-input form-control" rows="4" placeholder="請詳細描述您遇到的狀況，若為維修申請，請提供設備序號..."></textarea>
                        </div>
                    </div>

                    <div class="s_website_form_submit mt-4" data-mark="*">
                        <div class="s_website_form_label"></div>
                        <button type="submit" class="qy-btn qy-btn-blue-lg"><i class="fa-solid fa-paper-plane"></i> 送出表單</button>
                    </div>
                </form>
            </div>
        </section>
    </template>

