<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate=1：建立後允許使用者在後台自由調整，升級不覆蓋 -->
    <data noupdate="1">

        <!-- 將首頁註冊為網站頁面，網址 /qytech（可在後台改設為網站首頁 /）
             隱藏 Odoo 原生頁首/頁尾，改用本模組自帶導覽列與頁尾，達成 1:1 視覺 -->
        <record id="qytech_homepage_page" model="website.page">
            <field name="name">千溢科技首頁</field>
            <field name="url">/qytech</field>
            <field name="view_id" ref="website_qytech.qytech_homepage"/>
            <field name="website_indexed" eval="True"/>
            <field name="is_published" eval="True"/>
            <field name="header_visible" eval="False"/>
            <field name="footer_visible" eval="False"/>
        </record>

    </data>
</odoo>
