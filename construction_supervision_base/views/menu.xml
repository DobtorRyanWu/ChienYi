<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 主選單                                          -->
    <!-- ============================================== -->
    <menuitem id="menu_construction_supervision_root"
              name="工程監造"
              sequence="50"
              web_icon="construction_supervision_base,static/description/icon.png"/>

    <!-- ============================================== -->
