    <!-- ============================================== -->
    <menuitem id="menu_project_management"
              name="工程管理"
              parent="menu_construction_supervision_root"
              sequence="10"/>

    <menuitem id="menu_supervision_project"
              name="工程案件"
              parent="menu_project_management"
