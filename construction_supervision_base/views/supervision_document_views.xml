<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 工程文件 - 表單視圖（輕量版）                     -->
    <!-- ============================================== -->
    <record id="view_supervision_document_form" model="ir.ui.view">
        <field name="name">supervision.document.form</field>
        <field name="model">supervision.document</field>
        <field name="arch" type="xml">
            <form string="工程文件">
                <header>
                    <!-- 狀態按鈕 -->
                    <button name="action_upload" string="標記為已上傳"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_archive" string="封存"
                            type="object"
                            invisible="state != 'uploaded'"/>
                    <button name="action_unarchive" string="取消封存"
                            type="object"
                            invisible="state != 'archived'"/>
                    <button name="action_reset_draft" string="重設草稿"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,uploaded,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_history_attachments" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="history_count == 0">
                            <field name="history_count" string="歷史版本" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="已封存" bg_color="text-bg-secondary"
                            invisible="state != 'archived'"/>
                    <widget name="web_ribbon" title="逾期" bg_color="text-bg-warning"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <label for="document_no"/>
                        <h1>
                            <field name="document_no" readonly="1"/>
                        </h1>
                        <label for="name"/>
                        <h2>
                            <field name="name" placeholder="輸入文件名稱"/>
                        </h2>
                    </div>
                    <group>
                        <group string="文件資訊">
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="document_category_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="due_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="上傳資訊">
                            <field name="uploader_id" readonly="1"/>
                            <field name="upload_date" readonly="1"/>
                            <field name="last_update_date" readonly="1"/>
                            <field name="last_update_user_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="附件管理" name="attachments">
                            <!-- 附件檔案區域 -->
                            <group string="附件檔案">
                                <field name="upload_attachment_ids" widget="many2many_binary"
                                       nolabel="1"
                                       options="{'accepted_file_extensions': '*'}"
                                       help="點擊「附件」按鈕上傳檔案，或直接拖曳檔案至此處"/>
                            </group>
                        </page>
                        
                        <page string="歷史版本" name="history_attachments" invisible="history_count == 0">
                            <group>
                                <div class="alert alert-info" role="status">
                                    <i class="fa fa-history"/> 共有 <strong><field name="history_count" class="oe_inline"/></strong> 個歷史版本附件
                                </div>
                                <button name="action_view_history_attachments" string="查看歷史附件"
                                        type="object" class="btn-primary" 
                                        icon="fa-history"/>
                            </group>
                        </page>
                        <page string="備註" name="notes">
                            <field name="notes" nolabel="1" placeholder="備註說明..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 工程文件 - 列表視圖                              -->
    <!-- ============================================== -->
    <record id="view_supervision_document_tree" model="ir.ui.view">
        <field name="name">supervision.document.tree</field>
        <field name="model">supervision.document</field>
        <field name="arch" type="xml">
            <list string="工程文件" default_order="create_date desc"
                  decoration-muted="state == 'archived'"
                  decoration-success="state == 'uploaded'"
                  decoration-danger="is_overdue">
                <field name="document_no"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="document_category_id"/>
                <field name="attachment_count"/>
                <field name="uploader_id" optional="show"/>
                <field name="upload_date" optional="show"/>
                <field name="last_update_date" optional="show"/>
                <field name="due_date" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 工程文件 - 看板視圖                              -->
    <!-- ============================================== -->
    <record id="view_supervision_document_kanban" model="ir.ui.view">
        <field name="name">supervision.document.kanban</field>
        <field name="model">supervision.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="document_no"/>
                <field name="name"/>
                <field name="document_category_id"/>
                <field name="state"/>
                <field name="is_overdue"/>
                <field name="attachment_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click"
                             t-attf-class="#{record.is_overdue.raw_value ? 'border-danger' : ''}">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="document_no"/>
                                    </strong>
                                </div>
                                <span class="float-end">
                                    <t t-if="record.is_overdue.raw_value">
                                        <span class="badge text-bg-danger">逾期</span>
                                    </t>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="name"/>
                                <div class="mt-2">
                                    <field name="document_category_id" widget="badge"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <t t-if="record.attachment_count.raw_value > 0">
                                        <span class="badge text-bg-secondary">
                                            <i class="fa fa-paperclip" title="附件"/> <field name="attachment_count"/>
                                        </span>
                                    </t>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {
                                               'draft': 'secondary',
                                               'uploaded': 'success',
                                               'archived': 'default'
                                           }}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 工程文件 - 搜尋視圖                              -->
    <!-- ============================================== -->
    <record id="view_supervision_document_search" model="ir.ui.view">
        <field name="name">supervision.document.search</field>
        <field name="model">supervision.document</field>
        <field name="arch" type="xml">
            <search string="搜尋工程文件">
                <field name="document_no"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="document_category_id"/>
                <field name="uploader_id"/>
                <separator/>
                <filter string="草稿" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="已上傳" name="uploaded" domain="[('state', '=', 'uploaded')]"/>
                <filter string="已封存" name="archived" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter string="已逾期" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="有附件" name="has_attachment" domain="[('attachment_count', '>', 0)]"/>
                <separator/>
                <filter string="我上傳的" name="my_uploaded"
                        domain="[('uploader_id', '=', uid)]"/>
                <group expand="0" string="群組">
                    <filter string="狀態" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="文件分類" name="group_category" context="{'group_by': 'document_category_id'}"/>
                    <filter string="工程案件" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="上傳者" name="group_uploader" context="{'group_by': 'uploader_id'}"/>
                    <filter string="上傳月份" name="group_upload_month" context="{'group_by': 'upload_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 工程文件 - 動作                                  -->
    <!-- ============================================== -->
    <record id="action_supervision_document" model="ir.actions.act_window">
        <field name="name">工程文件</field>
        <field name="res_model">supervision.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_supervision_document_search"/>
        <field name="context">{'group_by': 'document_category_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                上傳第一份工程文件
            </p>
            <p>
                工程文件用於管理專案相關的各類文件。<br/>
                系統會自動保留每個文件的所有歷史版本。
            </p>
        </field>
    </record>


</odoo>
