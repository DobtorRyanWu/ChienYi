<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 工程案件 - 表單視圖                              -->
    <!-- ============================================== -->
    <record id="view_supervision_project_form" model="ir.ui.view">
        <field name="name">supervision.project.form</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="工程案件">
                <header>
                    <!-- 狀態按鈕 -->
                    <button name="action_approve" string="開始施工"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft' or not all_init_done"/>
                    <button name="action_complete" string="竣工"
                            type="object" class="oe_highlight"
                            invisible="state != 'construction'"/>
                    <button name="action_accept" string="進入驗收"
                            type="object" class="oe_highlight"
                            invisible="state != 'completion'"/>
                    <button name="action_close" string="結案"
                            type="object" class="oe_highlight"
                            invisible="state != 'acceptance'"/>
                    <button name="action_suspend" string="停工"
                            type="object"
                            invisible="state not in ('construction', 'completion')"/>
                    <button name="action_resume" string="復工"
                            type="object" class="oe_highlight"
                            invisible="state != 'suspended'"/>
                    <button name="action_terminate" string="終止"
                            type="object"
                            invisible="state in ('closed', 'terminated', 'correction')"
                            confirm="確定要終止此專案嗎？此操作無法復原。"/>
                    <!-- 更正機制按鈕 -->
                    <button name="action_submit_correction" string="提出更正"
                            type="object"
                            invisible="state not in ('construction', 'completion', 'acceptance')"
                            confirm="提出更正後，表單將開放編輯。完成後請手動點擊「完成更正」，或1天後系統將自動回復原狀態。確定要繼續嗎？"/>
                    <button name="action_complete_correction" string="完成更正"
                            type="object" class="oe_highlight"
                            invisible="state != 'correction'"/>
                    <!-- 匯入標單按鈕 -->
                    <button name="action_import_tender"
                            string="匯入契約標單"
                            type="object"
                            class="btn-secondary"
                            icon="fa-upload"
                            invisible="state != 'draft'"
                            groups="construction_supervision_base.group_supervisor_admin"
                            help="匯入政府採購標單 XML 檔案"/>
                    <!-- 重新整理工項排序（修復契約變更造成的跨彙總項排序錯亂）-->
                    <button name="action_resequence_tasks"
                            string="重新整理工項排序"
                            type="object"
                            class="btn-secondary"
                            icon="fa-sort-amount-asc"
                            groups="construction_supervision_base.group_supervisor_admin"
                            help="以階層重新整理工項顯示順序，修復契約變更後的排序錯亂"/>
                    <!-- 初始化循序確認按鈕（僅 draft 狀態，依序顯示）-->
                    <!-- 步驟 1: 人機管理 -->
                    <button name="action_init_done_equipment" type="object"
                            string="✓ 確認人機項目設定完成"
                            class="btn-secondary"
                            invisible="state != 'draft' or init_current_step != 'equipment'"/>
                    <button name="action_init_skip_equipment" type="object"
                            string="此項不適用"
                            invisible="state != 'draft' or init_current_step != 'equipment'"/>
                    <!-- 步驟 2: 自主檢查 -->
                    <button name="action_init_done_inspection" type="object"
                            string="✓ 確認自主檢查設定完成"
                            class="btn-secondary"
                            invisible="state != 'draft' or init_current_step != 'inspection'"/>
                    <button name="action_init_skip_inspection" type="object"
                            string="此項不適用"
                            invisible="state != 'draft' or init_current_step != 'inspection'"/>
                    <!-- 步驟 2-B: 編號前綴設定 -->
                    <button name="action_init_done_prefix" type="object"
                            string="✓ 確認編號前綴設定完成"
                            class="btn-secondary"
                            invisible="state != 'draft' or init_current_step != 'prefix'"/>
                    <button name="action_init_skip_prefix" type="object"
                            string="此項不適用"
                            invisible="state != 'draft' or init_current_step != 'prefix'"/>
                    <!-- 步驟 3: 檢試驗 -->
                    <button name="action_init_done_test" type="object"
                            string="✓ 確認檢試驗設定完成"
                            class="btn-secondary"
                            invisible="state != 'draft' or init_current_step != 'test'"/>
                    <button name="action_init_skip_test" type="object"
                            string="此項不適用"
                            invisible="state != 'draft' or init_current_step != 'test'"/>
                    <!-- 步驟 4: 樣板 -->
                    <button name="action_init_done_template" type="object"
                            string="✓ 確認樣板上傳完成"
                            class="btn-secondary"
                            invisible="state != 'draft' or init_current_step != 'template'"/>
                    <button name="action_init_skip_template" type="object"
                            string="此項不適用"
                            invisible="state != 'draft' or init_current_step != 'template'"/>
                    <!-- 步驟 5: 進度表 -->
                    <button name="action_init_done_schedule" type="object"
                            string="✓ 確認進度表設定完成"
                            class="btn-secondary"
                            invisible="state != 'draft' or init_current_step != 'schedule'"/>
                    <button name="action_init_skip_schedule" type="object"
                            string="此項不適用"
                            invisible="state != 'draft' or init_current_step != 'schedule'"/>
                    <!-- 回上一步（第一步時隱藏）-->
                    <button name="action_init_go_back" type="object"
                            string="↩ 回上一步"
                            invisible="state != 'draft' or init_current_step in ('equipment', 'done', False)"
                            confirm="確定要回到上一步？該步驟將需要重新確認。"/>
                    <!-- 依文件分類樹產生標準資料夾。可重複按，已存在的略過只補缺的，
                         所以不限制狀態——舊案補建、分類樹新增節點後回頭補都用同一顆。 -->
                    <button name="action_create_standard_folders" type="object"
                            string="建立標準資料夾"
                            class="btn-secondary" icon="fa-folder-open-o"
                            invisible="not id"
                            confirm="將依文件分類樹為本工程建立標準資料夾（已存在的會略過）。要繼續嗎？"/>
                </header>
                <sheet>
                    <!-- 狀態標籤（右上角） -->
                    <div class="float-end">
                        <field name="state" widget="badge"
                               decoration-info="state == 'draft'"
                               decoration-primary="state == 'construction'"
                               decoration-warning="state in ('completion', 'suspended')"
                               decoration-danger="state in ('acceptance', 'terminated')"
                               decoration-success="state == 'closed'"
                               decoration-muted="state == 'correction'"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <!-- 初始化 Smart Buttons（僅 draft 狀態顯示，點擊前往設定頁面）-->
                        <button name="action_init_goto_equipment" type="object"
                                class="oe_stat_button" icon="fa-wrench"
                                invisible="state != 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-circle-o text-muted" title="待設定"
                                       invisible="init_equipment_status != 'pending'"/>
                                    <i class="fa fa-check-circle text-success" title="已完成"
                                       invisible="init_equipment_status != 'done'"/>
                                    <i class="fa fa-minus-circle text-muted" title="不適用"
                                       invisible="init_equipment_status != 'not_required'"/>
                                    <field name="init_equipment_count"/>
                                </span>
                                <span class="o_stat_text">人機管理</span>
                            </div>
                        </button>
                        <button name="action_init_goto_inspection" type="object"
                                class="oe_stat_button" icon="fa-check-square-o"
                                invisible="state != 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-circle-o text-muted" title="待設定"
                                       invisible="init_inspection_status != 'pending'"/>
                                    <i class="fa fa-check-circle text-success" title="已完成"
                                       invisible="init_inspection_status != 'done'"/>
                                    <i class="fa fa-minus-circle text-muted" title="不適用"
                                       invisible="init_inspection_status != 'not_required'"/>
                                    <field name="init_inspection_count"/>
                                </span>
                                <span class="o_stat_text">自主檢查</span>
                            </div>
                        </button>
                        <button name="action_init_goto_prefix" type="object"
                                class="oe_stat_button" icon="fa-tag"
                                invisible="state != 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-circle-o text-muted" title="待設定"
                                       invisible="init_prefix_status != 'pending'"/>
                                    <i class="fa fa-check-circle text-success" title="已完成"
                                       invisible="init_prefix_status != 'done'"/>
                                    <i class="fa fa-minus-circle text-muted" title="不適用"
                                       invisible="init_prefix_status != 'not_required'"/>
                                    <field name="init_prefix_count"/>
                                </span>
                                <span class="o_stat_text">編號前綴</span>
                            </div>
                        </button>
                        <button name="action_init_goto_test" type="object"
                                class="oe_stat_button" icon="fa-flask"
                                invisible="state != 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-circle-o text-muted" title="待設定"
                                       invisible="init_test_status != 'pending'"/>
                                    <i class="fa fa-check-circle text-success" title="已完成"
                                       invisible="init_test_status != 'done'"/>
                                    <i class="fa fa-minus-circle text-muted" title="不適用"
                                       invisible="init_test_status != 'not_required'"/>
                                    <field name="init_test_count"/>
                                </span>
                                <span class="o_stat_text">檢試驗</span>
                            </div>
                        </button>
                        <button name="action_init_goto_template" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="state != 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-circle-o text-muted" title="待設定"
                                       invisible="init_template_status != 'pending'"/>
                                    <i class="fa fa-check-circle text-success" title="已完成"
                                       invisible="init_template_status != 'done'"/>
                                    <i class="fa fa-minus-circle text-muted" title="不適用"
                                       invisible="init_template_status != 'not_required'"/>
                                    <field name="init_template_count"/>
                                </span>
                                <span class="o_stat_text">樣板</span>
                            </div>
                        </button>
                        <!-- 應交文件管制表（移到進度表之後、照片之前；由 progress/photo 以 anchor 插入）
                             2026-08-20 起隨主選單一起隱藏（groups="base.group_no_one"）。
                             ⚠️ **不可以刪掉這顆按鈕**：construction_photo 用
                             //button[@name='action_view_documents'] 當 xpath 錨點把
                             照片按鈕插在它後面，刪了照片模組會載入失敗。
                             用 groups 隱藏則安全——view 繼承是在 arch 合併階段做的，
                             groups 過濾發生在之後的 postprocess，錨點仍然找得到。 -->
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                groups="base.group_no_one">
                            <field name="document_count" string="應交文件" widget="statinfo"/>
                        </button>
                        <!-- 工程資料夾（檔案實際存放位置；分類是「是什麼」、資料夾是「放在哪」）-->
                        <button name="action_view_folders" type="object"
                                class="oe_stat_button" icon="fa-folder-open-o">
                            <field name="folder_count" string="資料夾" widget="statinfo"/>
                        </button>
                        <!-- 契約工項（最末顆；邏輯 task_count / action_view_tasks 同在 base）
                             照片由 construction_photo 以 anchor 插在「文件」之後 -->
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="task_count" string="契約工項" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="已結案" bg_color="text-bg-success"
                            invisible="state != 'closed'"/>
                    <widget name="web_ribbon" title="已終止" bg_color="text-bg-danger"
                            invisible="state != 'terminated'"/>
                    <widget name="web_ribbon" title="停工" bg_color="text-bg-warning"
                            invisible="state != 'suspended'"/>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code" readonly="state != 'draft'"/>
                        </h1>
                        <label for="name"/>
                        <h2>
                            <field name="name" placeholder="輸入工程名稱"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                        </h2>
                    </div>
                    <group>
                        <group string="基本資訊" name="basic_info">
                            <field name="project_type" widget="radio"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <field name="year"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <field name="authority_name"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <field name="authority_contact_name"/>
                            <field name="location"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <field name="management_company_name"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <!-- 與管理公司成對，所以放在基本資訊而不是契約資訊。
                                 不加 readonly：是管制表表頭要印的資料，常在施工中才補登 -->
                            <field name="contractor_company_name"
                                   placeholder="例：○○營造股份有限公司"/>
                            <field name="company_id" invisible="1"/>
                            <field name="supervision_engineer_id"
                                   domain="[('active', '=', True)]"/>
                            <field name="project_leader_id"
                                   domain="[('active', '=', True)]"/>
                        </group>
                        <group string="契約資訊" name="contract_info">
                            <field name="contract_no"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <!-- 得標／訂約日期刻意不加 readonly：是管制表表頭要印的資料，
                                 多半在施工中才回頭補登，鎖住等於填不了 -->
                            <field name="award_date"/>
                            <field name="contract_sign_date"/>
                            <field name="contract_amount"
                                   readonly="state not in ('draft', 'correction')"
                                   placeholder="未匯入工項前可手動輸入"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="contract_start_date"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <field name="contract_end_date"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <field name="contract_duration"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <field name="extension_duration" readonly="1"/>
                            <field name="total_approved_duration" readonly="1"/>
                            <field name="tender_xml_data" widget="binary"
                                   filename="tender_xml_filename"
                                   string="原始標單 XML"
                                   readonly="1"/>
                            <field name="tender_xml_filename" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="實際日期" name="actual_dates">
                            <field name="actual_start_date"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <field name="actual_end_date"
                                   readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                            <field name="actual_duration"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- 頁籤 1: 工程位置 -->
                        <page string="工程位置" name="location">
                            <group>
                                <group>
                                    <field name="location_detail"
                                           readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                                </group>
                                <group>
                                    <field name="latitude"
                                           readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                                    <field name="longitude"
                                           readonly="state in ('construction', 'completion', 'acceptance', 'closed', 'suspended', 'terminated')"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- 頁籤 3: 活動指派設定 -->
                        <page string="活動指派設定" name="activity_assignment">
                            <group>
                                <group string="負責人設定">
                                    <field name="activity_default_user_id"/>
                                    <field name="activity_test_user_id"/>
                                    <field name="activity_inspection_user_id"/>
                                </group>
                                <group string="說明">
                                    <div class="text-muted">
                                        <p>指派優先順序：專屬負責人 → 預設負責人 → 監造工程師 → 專案負責人</p>
                                        <p>檢試驗預警、完工提醒等自動活動將依此設定指派。</p>
                                    </div>
                                </group>
                            </group>
                        </page>

                        <!-- 頁籤: 參與成員 (逐帳號可見性) -->
                        <page string="參與成員" name="members">
                            <div class="text-muted mb-2">
                                <p>指派可在前台存取本專案的帳號。主管/現場人員/定期閱覽者只看得到自己被加入的專案；老闆角色不受此限（可見公司承包的所有專案）。</p>
                            </div>
                            <field name="member_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>

                        <!-- 頁籤 4: 備註 (例外可編輯) -->
                        <page string="備註" name="notes">
                            <group>
                                <field name="notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 工程案件 - 列表視圖                              -->
    <!-- ============================================== -->
    <record id="view_supervision_project_tree" model="ir.ui.view">
        <field name="name">supervision.project.tree</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="工程案件" default_order="code desc"
                  decoration-muted="state in ('closed', 'terminated')"
                  decoration-warning="state == 'suspended'"
                  decoration-info="state == 'acceptance'">
                <field name="code"/>
                <field name="name"/>
                <field name="year"/>
                <field name="project_type" widget="badge"/>
                <field name="authority_name"/>
                <field name="contract_amount" sum="契約金額合計"/>
                <field name="contract_start_date"/>
                <field name="contract_end_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"
                       decoration-warning="state in ('suspended', 'acceptance')"
                       decoration-info="state == 'construction'"
                       decoration-muted="state == 'terminated'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 工程案件 - 看板視圖                              -->
    <!-- ============================================== -->
    <record id="view_supervision_project_kanban" model="ir.ui.view">
        <field name="name">supervision.project.kanban</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="code"/>
                <field name="name"/>
                <field name="state"/>
                <field name="project_type"/>
                <field name="authority_name"/>
                <field name="contract_amount"/>
                <progressbar field="state"
                             colors='{"construction": "info", "acceptance": "warning", "closed": "success"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="code"/>
                                    </strong>
                                </div>
                                <span class="float-end">
                                    <field name="project_type" widget="badge"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="name"/>
                                <div class="mt-2">
                                    <field name="authority_name"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <field name="contract_amount" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 工程案件 - 搜尋視圖                              -->
    <!-- ============================================== -->
    <record id="view_supervision_project_search" model="ir.ui.view">
        <field name="name">supervision.project.search</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <search string="搜尋工程案件">
                <field name="code"/>
                <field name="name"/>
                <field name="year"/>
                <field name="contract_no"/>
                <field name="authority_name"/>
                <field name="supervision_engineer_id"/>
                <separator/>
                <filter string="未開始" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="施工中" name="construction" domain="[('state', '=', 'construction')]"/>
                <filter string="驗收中" name="acceptance" domain="[('state', '=', 'acceptance')]"/>
                <filter string="已結案" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="一般式" name="general" domain="[('project_type', '=', 'general')]"/>
                <filter string="預約式" name="reservation" domain="[('project_type', '=', 'reservation')]"/>
                <separator/>
                <filter string="我的專案" name="my_projects"
                        domain="[('supervision_engineer_id', '=', uid)]"/>
                <group expand="0" string="群組" name="groupby">
                    <filter string="年份" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="狀態" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="工程類型" name="group_type" context="{'group_by': 'project_type'}"/>
                    <filter string="業主" name="group_authority" context="{'group_by': 'authority_name'}"/>
                    <filter string="開工月份" name="group_start_month" context="{'group_by': 'contract_start_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

