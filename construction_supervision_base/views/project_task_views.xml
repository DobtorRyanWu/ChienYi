<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 契約工項 - 表單視圖擴展                          -->
    <!-- ============================================== -->
    <record id="view_task_form_supervision" model="ir.ui.view">
        <field name="name">project.task.form.supervision</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- 添加隱藏欄位供狀態判斷 -->
            <xpath expr="//form" position="inside">
                <field name="is_project_approved" invisible="1"/>
                <field name="project_state" invisible="1"/>
                <field name="is_summary_item" invisible="1"/>
            </xpath>

            <!-- 移除原生智慧按鈕（子任務、工時等），契約工項不需要 -->
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 移除原生欄位：客戶、截止日期、受指派人、獲分配時間 -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='date_assign']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <!-- 隱藏 label 和外層 div（hr_timesheet 將 allocated_hours 替換成含 progress% 和子任務資訊的 div） -->
            <xpath expr="//label[@for='allocated_hours']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='allocated_hours']/.." position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            
            <!-- 修改必填欄位 -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="placeholder">輸入工項名稱...</attribute>
                <attribute name="readonly">is_project_approved</attribute>
            </xpath>
            
            <!-- 新增工程相關欄位到主要區塊 -->
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="parent_id"
                       placeholder="選擇父工項（根節點請留空）"
                       domain="[('project_id', '=', project_id), ('id', '!=', id), ('is_summary_item', '=', True)]"
                       options="{'no_create': True}"
                       readonly="is_project_approved"
                       help="有子項次的彙總項目才可作為父工項"/>
                <field name="item_no" required="1" placeholder="自動產生" readonly="is_project_approved"/>
                <field name="display_item_no" readonly="1" string="顯示項次"/>
                <field name="item_level" readonly="1"/>
            </xpath>

            <!-- 移除原有的分頁，重新設計 -->
            <xpath expr="//notebook" position="replace">
                <notebook>
                    <!-- 第1頁：契約價量 -->
                    <page string="契約價量" name="contract_price_qty">
                        <group>
                            <group string="價量資訊">
                                <field name="unit" required="1" placeholder="M, M2, M3, 式..." readonly="is_project_approved"/>
                                <field name="planned_qty" required="1" readonly="is_project_approved"/>
                                <field name="unit_price" required="1" readonly="is_project_approved"/>
                                <field name="planned_amount" class="oe_inline" readonly="1"/>
                                <!-- 預備單價項目：不計入契約金額（預約式議價新增項目用） -->
                                <field name="exclude_from_contract_amount"
                                       readonly="is_project_approved"/>
                                <field name="product_id" string="標準工項"
                                       domain="[('is_standard_work_item', '=', True)]"
                                       context="{'tree_view_ref': 'construction_supervision_base.view_product_standard_work_item_list', 'search_view_ref': 'construction_supervision_base.view_product_standard_work_item_search'}"
                                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                                       readonly="is_project_approved"/>
                            </group>
                            <group string="實際執行">
                                <field name="actual_qty" readonly="1"/>
                                <field name="actual_amount" readonly="1"/>
                                <field name="qty_remaining"/>
                                <field name="completion_rate" widget="progressbar"/>
                            </group>
                        </group>
                        <group>
                            <group string="預算狀態">
                                <field name="budget_status" widget="badge"
                                       decoration-success="budget_status == 'under'"
                                       decoration-warning="budget_status == 'on_budget'"
                                       decoration-danger="budget_status == 'over'"/>
                            </group>
                        </group>
                    </page>

                    <!-- 第2頁：子工項（僅彙總項顯示，列出下一層級工項） -->
                    <page string="子工項" name="child_items" invisible="not is_summary_item">
                        <field name="child_ids" nolabel="1" readonly="1">
                            <list string="子工項" default_order="item_no_sort">
                                <field name="display_item_no" string="項次" width="80"/>
                                <field name="name" string="項目及說明"/>
                                <field name="unit" string="單位" width="70"/>
                                <field name="planned_qty" string="契約數量" width="100"/>
                                <field name="unit_price" string="契約單價" width="110"/>
                                <field name="planned_amount" string="契約複價" sum="合計" width="120"/>
                                <field name="is_summary_item" column_invisible="1"/>
                            </list>
                        </field>
                    </page>

                    <!-- 第3頁：歷史紀錄 -->
                    <page string="歷史紀錄" name="change_history">
                        <field name="version_ids" nolabel="1" readonly="1">
                            <list string="歷史紀錄" default_order="version">
                                <field name="version" string="版本" width="60"/>
                                <field name="planned_qty" string="契約數量" width="120"/>
                                <field name="unit_price" string="契約單價" width="120"/>
                                <field name="planned_amount" string="契約金額" width="130"/>
                                <field name="change_order_id" string="變更單編號"/>
                            </list>
                        </field>
                    </page>

                    <!-- 第3頁：詳細描述（原生） -->
                    <page string="詳細描述" name="description">
                        <field name="description" placeholder="工項詳細說明..." readonly="is_project_approved"/>
                    </page>

                    <!-- 第3頁：備註 -->
                    <page string="備註" name="notes">
                        <group>
                            <field name="construction_notes"
                                   placeholder="輸入施工注意事項、備註說明..."
                                   readonly="is_project_approved"/>
                        </group>
                        <group>
                            <field name="specification"
                                   placeholder="輸入規格說明..."
                                   readonly="is_project_approved"/>
                        </group>
                    </page>

                    <!-- 其他原生頁籤（附加檔案、檢核清單等）會自動繼承-->
                </notebook>
            </xpath>

            <!-- 隱藏欄位 -->
            <xpath expr="//form" position="inside">
                <field name="supervision_project_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 契約工項 - 列表視圖擴展                          -->
    <!-- ============================================== -->
    <record id="view_task_tree_supervision" model="ir.ui.view">
        <field name="name">project.task.tree.supervision</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="item_no" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="assigned_company_id" optional="show"/>
                <field name="assignment_state" widget="badge" optional="show"
                       decoration-muted="assignment_state == 'unassigned'"
                       decoration-info="assignment_state == 'assigned'"
                       decoration-warning="assignment_state == 'in_progress'"
                       decoration-success="assignment_state in ('completed', 'accepted')"/>
                <field name="planned_qty" optional="hide" sum="數量合計"/>
                <field name="unit" optional="hide"/>
                <field name="unit_price" optional="hide"/>
                <field name="product_id" string="標準工項" optional="hide" readonly="1"/>
                <field name="planned_amount" optional="show" sum="金額合計"/>
                <field name="construction_notes" string="備註" optional="hide"/>
                <field name="completion_rate" widget="progressbar" optional="show"/>
                <field name="schedule_status" widget="badge" optional="hide"
                       decoration-success="schedule_status == 'ahead'"
                       decoration-warning="schedule_status == 'on_schedule'"
                       decoration-danger="schedule_status == 'delayed'"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 契約工項 - 搜尋視圖擴展                          -->
    <!-- ============================================== -->
    <record id="view_task_search_supervision" model="ir.ui.view">
        <field name="name">project.task.search.supervision</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <!-- 搜尋框預設欄位(name)改標「項目及說明」，並做 CJK 逐字比對 +
                 同時搜尋工項編號/項次路徑（讓「預力基樁」能命中「預力混凝土基樁…」）。
                 影響所有指向 project.task 的 m2o「選擇」對話框（皆吃預設搜尋視圖）。 -->
            <!-- 搜 display_name → 伺服器端觸發 project.task._search_display_name（CJK 逐字
                 比對 name + 同搜 item_no/item_no_path）。filter_domain 由瀏覽器 py.js 評估，
                 故只能用簡單運算式，複雜比對交給伺服器端的 _search_display_name。 -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">項目及說明</attribute>
                <attribute name="filter_domain">[('display_name', 'ilike', self)]</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="item_no" string="工項編號"/>
                <field name="item_no_path" string="項次路徑"/>
                <field name="parent_id" string="父工項"/>
                <field name="assigned_company_id"/>
            </xpath>
            <xpath expr="//filter[@name='my_tasks']" position="after">
                <separator/>
                <filter string="未分配" name="unassigned"
                        domain="[('assigned_company_id', '=', False)]"/>
                <filter string="已分配" name="assigned"
                        domain="[('assigned_company_id', '!=', False)]"/>
                <filter string="執行中" name="in_progress"
                        domain="[('assignment_state', '=', 'in_progress')]"/>
                <filter string="已完成" name="completed"
                        domain="[('assignment_state', 'in', ('completed', 'accepted'))]"/>
                <separator/>
                <filter string="進度落後" name="schedule_delayed"
                        domain="[('schedule_status', '=', 'delayed')]"/>
                <filter string="超出預算" name="over_budget"
                        domain="[('budget_status', '=', 'over')]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="工程案件" name="group_by_project"
                        context="{'group_by': 'project_id'}"/>
                <filter string="承包廠商" name="group_by_assigned_company"
                        context="{'group_by': 'assigned_company_id'}"/>
                <filter string="分配狀態" name="group_by_assignment_state"
                        context="{'group_by': 'assignment_state'}"/>
                <filter string="預算狀態" name="group_by_budget_status"
                        context="{'group_by': 'budget_status'}"/>
                <filter string="時程狀態" name="group_by_schedule_status"
                        context="{'group_by': 'schedule_status'}"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 契約工項 - 專案專屬列表視圖                      -->
    <!-- ============================================== -->
    <record id="view_task_tree_project_specific" model="ir.ui.view">
        <field name="name">project.task.tree.project.specific</field>
        <field name="model">project.task</field>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <list string="契約工項"
                  default_order="item_no_sort"
                  decoration-warning="schedule_status == 'delayed'"
                  decoration-success="assignment_state == 'accepted'"
                  decoration-info="item_level == 1"
                  decoration-muted="item_level >= 2"
                  editable="bottom">
                <!-- 排序控制 -->
                <field name="sequence" widget="handle"/>
                
                <!-- 父工項 (編輯用，隱藏) -->
                <field name="parent_id"
                       column_invisible="1"
                       readonly="is_project_approved"
                       domain="[('project_id', '=', project_id), ('id', '!=', id), ('is_summary_item', '=', True)]"
                       options="{'no_create': True}"/>

                <!-- 工項編號（顯示：葉節點只顯示末段，非葉節點顯示完整）-->
                <field name="display_item_no" string="項次" readonly="1"/>
                <!-- 完整項次：從階層計算（一致格式），取代直接顯示 item_no -->
                <field name="full_item_no" string="完整項次" optional="hide" readonly="1"/>
                <!-- 原始項次編號（item_no）：各專案存法不一，保留供匯入比對／進階編輯 -->
                <field name="item_no" string="原始項次編號" optional="hide" readonly="is_project_approved"/>
                
                <!-- 項目及說明 -->
                <field name="name" string="項目及說明" readonly="is_project_approved"/>
                
                <!-- 單位 -->
                <field name="unit" string="單位" readonly="is_project_approved"/>
                
                <!-- 契約數量 -->
                <field name="planned_qty" string="契約數量" readonly="is_project_approved"/>
                
                <!-- 契約單價 -->
                <field name="unit_price" string="契約單價" readonly="is_project_approved"/>
                
                <!-- 契約複價 -->
                <field name="planned_amount" string="契約複價" sum="契約複價合計" readonly="1"/>

                <!-- 預備單價項目（不計入契約金額）：預設隱藏，勾選時整列以 muted 標示 -->
                <field name="exclude_from_contract_amount" string="不計入契約金額"
                       optional="hide" readonly="is_project_approved"/>
                
                <!-- 備註 -->
                <field name="construction_notes" string="備註" optional="show" readonly="is_project_approved"/>
                
                <!-- 廠商分配 (例外可編輯) -->
                <field name="assigned_company_id" 
                       string="承包廠商" 
                       optional="hide"
                       options="{'no_create': True}"/>
                
                <!-- 隱藏欄位 -->
                <field name="item_level" column_invisible="1"/>
                <field name="is_summary_item" column_invisible="1"/>
                <field name="ref_item_code" column_invisible="1"/>
                <field name="project_id" column_invisible="1"/>
                <field name="assignment_state" column_invisible="1"/>
                <field name="schedule_status" column_invisible="1"/>
                <field name="is_project_approved" column_invisible="1"/>
                <field name="project_state" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 契約工項 - 專用列表視圖（取消editable）              -->
    <!-- ============================================== -->
    <record id="view_task_tree_supervision_full" model="ir.ui.view">
        <field name="name">project.task.tree.supervision.full</field>
        <field name="model">project.task</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="契約工項" 
                  default_order="item_no_sort"
                  decoration-muted="assignment_state == 'accepted'"
                  decoration-info="assignment_state == 'assigned'"
                  decoration-warning="assignment_state == 'in_progress'"
                  decoration-danger="schedule_status == 'delayed'">
                <!-- 顯示欄位依代操回報「各大項未區隔，項目會混淆」調整
                     （2026-08-10）：項次／父工項／項目及說明／單位／契約數量／
                     契約單價／備註。本 view 由契約工項主畫面、時程分析，以及
                     施工日誌、週報、通報單、契約變更等 6 個「選擇施工項目」
                     對話框共用，一起改才會一致。 -->

                <!-- 工程案件（已由 domain 過濾，預設隱藏） -->
                <field name="project_id" string="工程案件" optional="hide"/>

                <!-- 工項編號（顯示：葉節點末段，非葉節點完整）-->
                <field name="display_item_no" string="項次"/>
                <!-- 完整項次：從階層計算（一致格式） -->
                <field name="full_item_no" string="完整項次" optional="hide" readonly="1"/>
                <field name="item_no" string="原始項次編號" optional="hide"/>

                <!-- 父工項：選取對話框只列葉節點（domain 排除 is_summary_item），
                     沒有這欄就分不出屬於哪個大項——這正是代操回報的問題 -->
                <field name="parent_id" string="父工項"/>

                <!-- 項目及說明 -->
                <field name="name" string="項目及說明"/>

                <!-- 單位 -->
                <field name="unit" string="單位"/>

                <!-- 契約數量 -->
                <field name="planned_qty" string="契約數量"/>

                <!-- 契約單價 -->
                <field name="unit_price" string="契約單價"/>

                <!-- 契約複價：不在指定的顯示欄位內，改為預設隱藏。
                     仍可從欄位選單開啟，開啟時合計照算。 -->
                <field name="planned_amount" string="契約複價" sum="契約複價合計"
                       optional="hide"/>

                <!-- 備註 -->
                <field name="construction_notes" string="備註" optional="show"/>

                <!-- 預備單價項目（不計入契約金額） -->
                <field name="exclude_from_contract_amount" string="不計入契約金額"
                       optional="hide"/>

                <!-- 隱藏欄位 -->
                <field name="item_level" column_invisible="1"/>
                <field name="is_summary_item" column_invisible="1"/>
                <field name="assignment_state" column_invisible="1"/>
                <field name="schedule_status" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 契約工項 - 專用動作                              -->
    <!-- ============================================== -->
    <record id="action_supervision_task" model="ir.actions.act_window">
        <field name="name">契約工項</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_task_tree_supervision_full"/>
        <field name="search_view_id" ref="project.view_task_search_form"/>
        <field name="context">{
            'search_default_group_by_project': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一個契約工項
            </p>
            <p>
                契約工項用於管理工程專案中的各項施工項目，
                可分配給不同廠商執行並追蹤預算與進度。
            </p>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 專案階段類型擴展                                  -->
    <!-- ============================================== -->
    <record id="view_task_type_form_supervision" model="ir.ui.view">
        <field name="name">project.task.type.form.supervision</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <field name="is_construction_stage"/>
                <field name="is_acceptance_stage"/>
            </xpath>
        </field>
    </record>

</odoo>
