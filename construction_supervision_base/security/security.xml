<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 舊群組清理已完成，delete 操作已移除（避免在未曾安裝舊群組的 DB 升級時出錯） -->

        <!-- ============================================== -->
        <!-- 模組分類                                        -->
        <!-- ============================================== -->
        <!-- 舊的 Category 已刪除，避免在用戶表單中顯示「已廢棄」區塊 -->

        <!-- 新架構：特殊權限 category -->
        <record id="module_category_supervision_special" model="ir.module.category">
            <field name="name">工程監造 - 特殊權限</field>
            <field name="description">系統管理者與代操作員專用</field>
            <field name="sequence">101</field>
        </record>

        <!-- 新架構：權限等級 category -->
        <record id="module_category_supervision_level" model="ir.module.category">
            <field name="name">工程監造 - 權限等級</field>
            <field name="description">Portal 用戶的權限等級（訂閱者/專案負責人/一般使用者/觀看者）</field>
            <field name="sequence">102</field>
        </record>

        <!-- ============================================== -->
        <!-- 使用者群組                                      -->
        <!-- ============================================== -->

        <!-- 系統管理者 -->
        <record id="group_supervisor_admin" model="res.groups">
            <field name="name">系統管理者</field>
            <field name="category_id" ref="module_category_supervision_special"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">工程監造系統管理者，擁有所有權限</field>
        </record>

    </data>

    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 資料隔離規則 (Record Rules)                      -->
        <!-- ============================================== -->

        <!-- 系統管理者 - 完整存取 -->
        <record id="rule_admin_full_access_project" model="ir.rule">
            <field name="name">管理者: 工程案件完整存取</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_document" model="ir.rule">
            <field name="name">管理者: 文件完整存取</field>
            <field name="model_id" ref="model_supervision_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
