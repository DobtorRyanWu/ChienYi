<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 舊群組清理已完成，delete 操作已移除（避免在未曾安裝舊群組的 DB 升級時出錯） -->

        <!-- ============================================== -->
        <!-- 模組分類                                        -->
        <!-- ============================================== -->
        <!-- 舊的 Category 已刪除，避免在用戶表單中顯示「已廢棄」區塊 -->

        <!-- 新架構：特殊權限 category -->
        <record id="module_category_supervision_special" model="ir.module.category">
            <field name="name">工程監造 - 特殊權限</field>
            <field name="description">代操作員（業務全權，不能碰系統設定）／工程管理者（代操作員＋系統設定）</field>
            <field name="sequence">101</field>
        </record>

        <!-- 新架構：權限等級 category -->
        <record id="module_category_supervision_level" model="ir.module.category">
            <field name="name">工程監造 - 權限等級</field>
            <field name="description">前台角色（老闆/主管/現場人員/定期閱覽者），每個帳號單選一個</field>
            <field name="sequence">102</field>
        </record>

        <!-- ============================================== -->
        <!-- 使用者群組                                      -->
        <!-- ============================================== -->

        <!-- 工程後台使用者（xmlid 沿用 group_supervisor_admin，22 個模組 190 處引用它） -->
        <!-- 18.0.6.2.0 起移出「特殊權限」分類，不再出現在使用者表單的下拉選單，    -->
        <!-- 只作為代操作員／工程管理者背後的基礎權限（開 debug 才看得到勾選框）。  -->
        <!-- category_id 必須寫 eval="False"：只刪掉這一行，-u 不會清掉 DB 裡的舊值。 -->
        <record id="group_supervisor_admin" model="res.groups">
            <field name="name">工程後台使用者</field>
            <field name="category_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">能使用工程系統後台的業務資料；本身不含系統設定、帳號管理等管理權。由代操作員／工程管理者自動帶入，不需單獨指派。</field>
        </record>

    </data>

    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 資料隔離規則 (Record Rules)                      -->
        <!-- ============================================== -->

        <!-- 系統管理者 - 完整存取 -->
        <record id="rule_admin_full_access_project" model="ir.rule">
            <field name="name">管理者: 工程案件完整存取</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_document" model="ir.rule">
            <field name="name">管理者: 文件完整存取</field>
            <field name="model_id" ref="model_supervision_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
