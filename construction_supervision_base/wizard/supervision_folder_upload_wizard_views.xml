<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_supervision_folder_upload_wizard_form" model="ir.ui.view">
        <field name="name">supervision.folder.upload.wizard.form</field>
        <field name="model">supervision.folder.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="上傳檔案">
                <group>
                    <field name="project_id" options="{'no_create': True}"/>
                    <!-- 必須先選工程才能選資料夾：不然不同工程的同名資料夾
                         會全部列出來，使用者分不出哪個是哪個 -->
                    <field name="folder_id" options="{'no_create_edit': True}"
                           readonly="not project_id"
                           placeholder="請先選擇工程案件"/>
                    <field name="folder_path" readonly="1"
                           invisible="not folder_id"/>
                    <field name="document_category_id" options="{'no_create': True}"/>
                </group>
                <separator string="檔案"/>
                <!-- many2many_binary 原生支援一次選取多檔與拖曳，
                     「一次選 50 個檔丟進一個資料夾」直接可用 -->
                <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                <footer>
                    <button name="action_upload" string="上傳" type="object"
                            class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_supervision_folder_upload" model="ir.actions.act_window">
        <field name="name">上傳檔案</field>
        <field name="res_model">supervision.folder.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_supervision_folder_upload_wizard_form"/>
    </record>

</odoo>
