<odoo>
    <!-- ===================================================================
         施工日誌選單 (歸屬於 施工執行 > 施工日誌)
         =================================================================== -->

    <!-- 我的日誌 - for contractors -->
    <menuitem
        id="menu_daily_log_my"
        name="我的日誌"
        parent="construction_supervision_base.menu_daily_log"
        action="action_daily_log_sheet_my"
        sequence="10"
        groups="base.group_user,construction_supervision_base.group_supervisor_admin,base.group_portal"
    />

    <!-- 施工排程 -->
    <menuitem
        id="menu_weekly_schedule"
        name="施工排程"
        parent="construction_supervision_base.menu_daily_log"
        action="action_weekly_schedule"
        sequence="15"
        groups="base.group_user,construction_supervision_base.group_supervisor_admin,base.group_portal"
    />

    <!-- 所有日誌 (for supervision) -->
    <menuitem
        id="menu_daily_log_all"
        name="所有日誌"
        parent="construction_supervision_base.menu_daily_log"
        action="action_daily_log_sheet_all"
        sequence="20"
        groups="base.group_user,construction_supervision_base.group_supervisor_admin,base.group_portal"
    />

    <!-- 設定選單 -->
    <menuitem
        id="menu_daily_log_config"
        name="設定"
        parent="construction_supervision_base.menu_daily_log"
        sequence="100"
        groups="construction_supervision_base.group_supervisor_admin"
    />

    <!-- 日誌明細 (under 設定) -->
    <menuitem
        id="menu_daily_log_lines"
        name="日誌明細"
        parent="menu_daily_log_config"
        action="action_daily_log_line"
        sequence="10"
        active="0"
    />

    <!-- 天氣記錄 (under 設定) -->
    <menuitem
        id="menu_daily_log_weather"
        name="天氣記錄"
        parent="menu_daily_log_config"
        action="action_daily_log_weather"
        sequence="20"
        active="0"
    />

</odoo>
