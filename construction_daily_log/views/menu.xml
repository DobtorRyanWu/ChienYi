<odoo>
    <!-- ===================================================================
         Menu Structure for Construction Daily Log
         =================================================================== -->

    <!-- Daily Log Main Menu (under Project menu) -->
    <menuitem
        id="menu_daily_log_root"
        name="施工日誌"
        parent="project.menu_main_pm"
        sequence="20"
    />

    <!-- My Daily Logs - for contractors -->
    <menuitem
        id="menu_daily_log_my"
        name="我的日誌"
        parent="menu_daily_log_root"
        action="action_daily_log_sheet_my"
        sequence="10"
        groups="construction_supervision_base.group_contractor_manager,construction_supervision_base.group_contractor_engineer"
    />

    <!-- All Daily Logs (for supervision) -->
    <menuitem
        id="menu_daily_log_all"
        name="所有日誌"
        parent="menu_daily_log_root"
        action="action_daily_log_sheet_all"
        sequence="20"
        groups="construction_supervision_base.group_supervision_manager,construction_supervision_base.group_supervision_engineer,construction_supervision_base.group_supervisor_admin"
    />

    <!-- To Review (for supervisors) -->
    <menuitem
        id="menu_daily_log_to_review"
        name="待審核"
        parent="menu_daily_log_root"
        action="action_daily_log_sheet_to_review"
        sequence="30"
        groups="construction_supervision_base.group_supervision_manager,construction_supervision_base.group_supervision_engineer"
    />

    <!-- Configuration Menu -->
    <menuitem
        id="menu_daily_log_config"
        name="設定"
        parent="menu_daily_log_root"
        sequence="100"
        groups="construction_supervision_base.group_supervisor_admin"
    />

    <!-- Daily Log Lines (under Configuration) -->
    <menuitem
        id="menu_daily_log_lines"
        name="日誌明細"
        parent="menu_daily_log_config"
        action="action_daily_log_line"
        sequence="10"
    />

    <!-- Weather Records (under Configuration) -->
    <menuitem
        id="menu_daily_log_weather"
        name="天氣記錄"
        parent="menu_daily_log_config"
        action="action_daily_log_weather"
        sequence="20"
    />

</odoo>
