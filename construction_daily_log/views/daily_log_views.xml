<odoo>
    <!-- ===================================================================
         Daily Log Sheet Views
         =================================================================== -->

    <!-- List View -->
    <record id="daily_log_sheet_view_list" model="ir.ui.view">
        <field name="name">daily.log.sheet.list</field>
        <field name="model">daily.log.sheet</field>
        <field name="arch" type="xml">
            <list
                decoration-info="state in ('new', 'draft')"
                decoration-warning="state == 'confirm'"
                decoration-success="state == 'done'"
                multi_edit="1"
            >
                <field name="name" string="Period"/>
                <field name="project_id"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_worker_count" sum="Total Workers"/>
                <field name="total_equipment_count" sum="Total Equipment"/>
                <field name="total_work_hours" widget="float_time" sum="Total Hours"/>
                <field name="reviewer_id" optional="show"/>
                <field name="state" widget="badge"
                    decoration-info="state in ('new', 'draft')"
                    decoration-warning="state == 'confirm'"
                    decoration-success="state == 'done'"
                />
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="daily_log_sheet_view_form" model="ir.ui.view">
        <field name="name">daily.log.sheet.form</field>
        <field name="model">daily.log.sheet</field>
        <field name="arch" type="xml">
            <form string="Daily Log Sheet">
                <field name="can_review" invisible="1"/>
                <field name="user_id" invisible="1"/>
                <header>
                    <button name="action_confirm"
                        string="Submit for Review"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />
                    <button name="action_done"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'confirm' or can_review != True"
                    />
                    <button name="action_draft"
                        string="Set to Draft"
                        type="object"
                        invisible="state != 'done' or can_review != True"
                    />
                    <button name="action_refuse"
                        string="Refuse"
                        type="object"
                        invisible="state != 'confirm' or can_review != True"
                    />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirm,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                        >
                            <field name="total_work_hours" widget="statinfo" string="Work Hours"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="project_id"/>
                        <h1>
                            <field name="project_id"
                                placeholder="Select Project"
                                readonly="state not in ('new', 'draft')"
                            />
                        </h1>
                    </div>
                    <group>
                        <group name="basic_info">
                            <field name="employee_id"
                                widget="many2one_avatar_employee"
                                readonly="state not in ('new', 'draft')"
                            />
                            <field name="sheet_range"
                                readonly="state not in ('new', 'draft')"
                            />
                            <label for="date_start" string="Period"/>
                            <div class="o_row">
                                <field name="date_start"
                                    readonly="state not in ('new', 'draft')"
                                />
                                <span class="mx-2">to</span>
                                <field name="date_end"
                                    readonly="state not in ('new', 'draft')"
                                />
                            </div>
                        </group>
                        <group name="statistics">
                            <field name="total_worker_count"/>
                            <field name="total_equipment_count"/>
                            <field name="company_id"
                                groups="base.group_multi_company"
                                readonly="state not in ('new', 'draft')"
                            />
                            <field name="notification_slip_id"
                                invisible="project_type != 'reservation'"
                                readonly="state not in ('new', 'draft')"
                            />
                        </group>
                    </group>

                    <notebook>
                        <page string="Daily Log Lines" name="lines">
                            <field name="line_ids"
                                readonly="state not in ('new', 'draft')"
                                context="{
                                    'default_sheet_id': id,
                                    'default_project_id': project_id,
                                    'default_employee_id': employee_id,
                                }"
                            >
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="day_week" readonly="1"/>
                                    <field name="work_item_id"
                                        domain="[('project_id', '=', parent.project_id)]"
                                    />
                                    <field name="work_description"/>
                                    <field name="location"/>
                                    <field name="worker_count"/>
                                    <field name="equipment_count"/>
                                    <field name="completion_qty"/>
                                    <field name="completion_unit"/>
                                    <field name="unit_amount" widget="float_time" string="Hours"/>
                                    <field name="has_issue"/>
                                </list>
                            </field>
                        </page>

                        <page string="Weather Records" name="weather">
                            <button name="action_add_weather"
                                string="Add Weather Records"
                                type="object"
                                class="btn-secondary mb-3"
                                invisible="state not in ('new', 'draft')"
                            />
                            <field name="weather_ids"
                                readonly="state not in ('new', 'draft')"
                            >
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="day_week" readonly="1"/>
                                    <field name="weather_am"/>
                                    <field name="weather_pm"/>
                                    <field name="temperature_high"/>
                                    <field name="temperature_low"/>
                                    <field name="is_workday"/>
                                    <field name="work_stopped_reason"
                                        invisible="is_workday"
                                    />
                                    <field name="actual_progress"/>
                                    <field name="has_progress_change"/>
                                </list>
                            </field>
                        </page>

                        <page string="Progress &amp; Notes" name="progress">
                            <group>
                                <group name="progress_info">
                                    <field name="has_progress_change"/>
                                    <field name="actual_progress"
                                        widget="progressbar"
                                    />
                                </group>
                                <group name="review_info">
                                    <field name="reviewer_id" readonly="1"/>
                                    <field name="review_date" readonly="1"/>
                                    <field name="review_policy"/>
                                </group>
                            </group>
                            <separator string="Work Summary"/>
                            <field name="work_summary"
                                placeholder="Enter summary of work done..."
                                readonly="state not in ('new', 'draft')"
                            />
                            <separator string="Notes"/>
                            <field name="notes"
                                placeholder="Enter additional notes..."
                                readonly="state not in ('new', 'draft')"
                            />
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="daily_log_sheet_view_search" model="ir.ui.view">
        <field name="name">daily.log.sheet.search</field>
        <field name="model">daily.log.sheet</field>
        <field name="arch" type="xml">
            <search string="Search Daily Log">
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <separator/>
                <filter name="filter_my_sheets" string="My Sheets"
                    domain="[('employee_id.user_id', '=', uid)]"
                />
                <separator/>
                <filter name="filter_new" string="New"
                    domain="[('state', '=', 'new')]"
                />
                <filter name="filter_draft" string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter name="filter_confirm" string="Pending Review"
                    domain="[('state', '=', 'confirm')]"
                />
                <filter name="filter_done" string="Approved"
                    domain="[('state', '=', 'done')]"
                />
                <separator/>
                <filter name="filter_this_week" string="This Week"
                    domain="[
                        ('date_start', '>=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                        ('date_start', '&lt;', (context_today() + relativedelta(days=7-context_today().weekday())).strftime('%Y-%m-%d'))
                    ]"
                />
                <filter name="filter_this_month" string="This Month"
                    domain="[
                        ('date_start', '>=', context_today().strftime('%Y-%m-01')),
                        ('date_start', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))
                    ]"
                />
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="groupby_project" string="Project"
                        context="{'group_by': 'project_id'}"
                    />
                    <filter name="groupby_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"
                    />
                    <filter name="groupby_state" string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter name="groupby_month" string="Month"
                        context="{'group_by': 'date_start:month'}"
                    />
                    <filter name="groupby_company" string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="daily_log_sheet_view_kanban" model="ir.ui.view">
        <field name="name">daily.log.sheet.kanban</field>
        <field name="model">daily.log.sheet</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="total_work_hours"/>
                <field name="can_review"/>
                <templates>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        <a t-if="record.state.raw_value == 'draft'" role="menuitem"
                            name="action_confirm" type="object" class="dropdown-item">
                            Submit for Review
                        </a>
                        <a t-if="record.state.raw_value == 'confirm' and record.can_review.value"
                            role="menuitem" name="action_done" type="object" class="dropdown-item">
                            Approve
                        </a>
                        <a t-if="record.state.raw_value == 'confirm' and record.can_review.value"
                            role="menuitem" name="action_refuse" type="object" class="dropdown-item">
                            Refuse
                        </a>
                    </t>
                    <t t-name="card">
                        <div class="ribbon ribbon-top-right" t-if="record.state.raw_value == 'confirm'">
                            <span class="text-bg-warning">Pending</span>
                        </div>
                        <div class="ribbon ribbon-top-right" t-if="record.state.raw_value == 'done'">
                            <span class="text-bg-success">Approved</span>
                        </div>
                        <div class="o_kanban_record_top mb-2">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="project_id"/>
                            <div class="d-flex align-items-center mt-2">
                                <field name="employee_id" widget="many2one_avatar_employee"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="total_work_hours" widget="float_time"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="date_start"/> - <field name="date_end"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="daily_log_sheet_view_calendar" model="ir.ui.view">
        <field name="name">daily.log.sheet.calendar</field>
        <field name="model">daily.log.sheet</field>
        <field name="arch" type="xml">
            <calendar string="Daily Log Sheets"
                date_start="date_start"
                date_stop="date_end"
                color="state"
                mode="month"
            >
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ===================================================================
         Daily Log Line Views
         =================================================================== -->

    <record id="daily_log_line_view_list" model="ir.ui.view">
        <field name="name">daily.log.line.list</field>
        <field name="model">daily.log.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/>
                <field name="day_week" readonly="1"/>
                <field name="project_id"/>
                <field name="work_item_id"/>
                <field name="work_description"/>
                <field name="location"/>
                <field name="worker_count" sum="Workers"/>
                <field name="equipment_count" sum="Equipment"/>
                <field name="completion_qty"/>
                <field name="completion_unit"/>
                <field name="unit_amount" widget="float_time" sum="Hours"/>
                <field name="sheet_state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="daily_log_line_view_form" model="ir.ui.view">
        <field name="name">daily.log.line.form</field>
        <field name="model">daily.log.line</field>
        <field name="arch" type="xml">
            <form string="Daily Log Line">
                <sheet>
                    <group>
                        <group name="basic">
                            <field name="sheet_id"/>
                            <field name="date"/>
                            <field name="day_week" readonly="1"/>
                            <field name="project_id"/>
                            <field name="work_item_id"/>
                        </group>
                        <group name="work">
                            <field name="location"/>
                            <field name="worker_count"/>
                            <field name="equipment_count"/>
                            <field name="unit_amount" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <group name="completion">
                            <field name="completion_qty"/>
                            <field name="completion_unit"/>
                            <field name="completion_percentage" widget="progressbar"/>
                        </group>
                        <group name="issues">
                            <field name="has_issue"/>
                            <field name="issue_description"
                                invisible="not has_issue"
                            />
                        </group>
                    </group>
                    <separator string="Work Description"/>
                    <field name="work_description"/>
                    <separator string="Material Notes"/>
                    <field name="material_note"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================================
         Daily Log Weather Views
         =================================================================== -->

    <record id="daily_log_weather_view_list" model="ir.ui.view">
        <field name="name">daily.log.weather.list</field>
        <field name="model">daily.log.weather</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/>
                <field name="day_week" readonly="1"/>
                <field name="weather_am"/>
                <field name="weather_pm"/>
                <field name="temperature_high"/>
                <field name="temperature_low"/>
                <field name="is_workday"/>
                <field name="work_stopped_reason" invisible="is_workday"/>
                <field name="cumulative_duration"/>
                <field name="remaining_duration"/>
                <field name="planned_progress"/>
                <field name="actual_progress"/>
                <field name="progress_variance"/>
            </list>
        </field>
    </record>

    <record id="daily_log_weather_view_form" model="ir.ui.view">
        <field name="name">daily.log.weather.form</field>
        <field name="model">daily.log.weather</field>
        <field name="arch" type="xml">
            <form string="Weather Record">
                <sheet>
                    <group>
                        <group name="date_info">
                            <field name="sheet_id"/>
                            <field name="date"/>
                            <field name="day_week" readonly="1"/>
                        </group>
                        <group name="weather">
                            <field name="weather_am"/>
                            <field name="weather_pm"/>
                            <field name="temperature_high"/>
                            <field name="temperature_low"/>
                        </group>
                    </group>
                    <group>
                        <group name="work_status">
                            <field name="is_workday"/>
                            <field name="work_stopped_reason"
                                invisible="is_workday"
                            />
                            <field name="work_stop_note"
                                invisible="is_workday or not work_stopped_reason"
                            />
                        </group>
                        <group name="duration">
                            <field name="approved_duration"/>
                            <field name="cumulative_duration"/>
                            <field name="remaining_duration"/>
                        </group>
                    </group>
                    <group>
                        <group name="progress">
                            <field name="planned_progress"/>
                            <field name="actual_progress"/>
                            <field name="has_progress_change"/>
                            <field name="progress_variance"/>
                        </group>
                    </group>
                    <separator string="Notes"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================================
         Actions
         =================================================================== -->

    <!-- My Daily Logs Action -->
    <record id="action_daily_log_sheet_my" model="ir.actions.act_window">
        <field name="name">My Daily Logs</field>
        <field name="res_model">daily.log.sheet</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{
            'search_default_filter_my_sheets': 1,
            'default_employee_id': False,
        }</field>
        <field name="search_view_id" ref="daily_log_sheet_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first daily log sheet
            </p>
            <p>
                Record your daily construction activities, worker counts,
                equipment usage, and work progress here.
            </p>
        </field>
    </record>

    <!-- All Daily Logs Action -->
    <record id="action_daily_log_sheet_all" model="ir.actions.act_window">
        <field name="name">All Daily Logs</field>
        <field name="res_model">daily.log.sheet</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="search_view_id" ref="daily_log_sheet_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No daily log sheets found
            </p>
            <p>
                View all daily log sheets from all employees.
            </p>
        </field>
    </record>

    <!-- To Review Action -->
    <record id="action_daily_log_sheet_to_review" model="ir.actions.act_window">
        <field name="name">Daily Logs to Review</field>
        <field name="res_model">daily.log.sheet</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'confirm'), ('can_review', '=', True)]</field>
        <field name="context">{'search_default_filter_confirm': 1}</field>
        <field name="search_view_id" ref="daily_log_sheet_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No daily logs pending review
            </p>
            <p>
                Daily log sheets submitted for your review will appear here.
            </p>
        </field>
    </record>

    <!-- Daily Log Lines Action -->
    <record id="action_daily_log_line" model="ir.actions.act_window">
        <field name="name">Daily Log Lines</field>
        <field name="res_model">daily.log.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Weather Records Action -->
    <record id="action_daily_log_weather" model="ir.actions.act_window">
        <field name="name">Weather Records</field>
        <field name="res_model">daily.log.weather</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
