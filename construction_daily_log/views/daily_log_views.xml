<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================================
         施工日誌表單 - 表單視圖（修改後）
         ======================================================================== -->
    
    <record id="daily_log_sheet_view_form" model="ir.ui.view">
        <field name="name">daily.log.sheet.form</field>
        <field name="model">daily.log.sheet</field>
        <field name="arch" type="xml">
            <form string="施工日誌">
                <header>
                    <!-- 解鎖按鈕（只有高權限且日誌已鎖定時顯示）-->
                    <!-- 狀態切換按鈕 -->
                    <button name="action_mark_filled" string="標記已填寫"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft' or is_locked"/>
                    <button name="action_revert_to_draft" string="退回編輯"
                            type="object"
                            invisible="state != 'filled' or is_locked"/>

                    <!-- 解鎖按鈕：有權限者直接解鎖，無權限者提出申請 -->
                    <button name="action_unlock" string="申請解鎖"
                            type="object" class="oe_highlight"
                            invisible="not is_locked or is_unlocked"/>

                    <!-- 待審核時：有權限者可批准/駁回 -->
                    <button name="action_approve_unlock_request"
                            string="批准解鎖申請" type="object" class="btn-success"
                            invisible="unlock_request_state != 'pending' or not can_unlock"/>
                    <button name="action_reject_unlock_request"
                            string="駁回解鎖申請" type="object" class="btn-danger"
                            invisible="unlock_request_state != 'pending' or not can_unlock"/>

                    <button name="action_relock" string="重新鎖定"
                            type="object"
                            invisible="not is_unlocked or not can_unlock"/>

                    <!-- 狀態列 -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,filled,locked"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object"
                                class="oe_stat_button" icon="fa-list-alt">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">日誌明細</span>
                            </div>
                        </button>
                    </div>
                    
                    <!-- 鎖定狀態警告 -->
                    <div class="alert alert-warning" role="alert" 
                         invisible="not is_locked or is_unlocked">
                        <strong>此日誌已鎖定</strong>
                        <p>日誌日期已超過 <field name="days_since_log" readonly="1"/> 天（超過14天自動鎖定）</p>
                        <p>您可以點擊「申請解鎖」以提出解鎖申請</p>
                    </div>

                    <!-- 解鎖申請待審核提示 -->
                    <div class="alert alert-info" role="alert"
                         invisible="unlock_request_state != 'pending'">
                        <strong>解鎖申請待審核</strong>
                        <p>申請人：<field name="unlock_requested_by_id" readonly="1"/>，請監造工程師於上方按鈕批准或駁回</p>
                    </div>

                    <!-- 解鎖中提示 -->
                    <div class="alert alert-info" role="alert" 
                         invisible="not is_unlocked">
                        <strong>已授權解鎖</strong>
                        <p>解鎖人：<field name="unlocked_by_id" readonly="1"/></p>
                        <p>失效時間：<field name="unlock_expires_at" readonly="1"/></p>
                        <p>原因：<field name="unlock_reason" readonly="1"/></p>
                    </div>
                    
                    <widget name="web_ribbon" title="已鎖定" bg_color="text-bg-danger"
                            invisible="not is_locked or is_unlocked"/>
                    <widget name="web_ribbon" title="已解鎖" bg_color="text-bg-info"
                            invisible="not is_unlocked"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="complete_name" readonly="1" invisible="1"/>
                        </h2>
                    </div>
                    
                    <!-- 基本日誌資料 -->
                    <group string="基本日誌資料">
                        <group name="log_basic">
                            <field name="supervision_project_id" 
                                   placeholder="選擇工程案件"
                                   options="{'no_create': True}"
                                   readonly="is_locked and not is_unlocked"/>
                            <field name="project_id" invisible="1"/>
                            <field name="project_type" invisible="1"/>
                            <field name="employee_id" 
                                   widget="many2one_avatar_employee" 
                                   readonly="1"/>
                            <field name="log_date"
                                   readonly="is_locked and not is_unlocked"/>
                            <field name="company_id" 
                                   groups="base.group_multi_company" 
                                   readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- 工期資訊 -->
                    <group string="工期資訊">
                        <group name="duration_contract">
                            <field name="contract_duration" readonly="1"/>
                            <field name="extension_duration" readonly="1"/>
                            <field name="total_approved_duration" readonly="1"/>
                        </group>
                        <group name="duration_status">
                            <field name="cumulative_duration" readonly="1"/>
                            <field name="remaining_duration" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- 天氣記錄 -->
                    <group string="天氣記錄">
                        <group>
                            <field name="weather_am" 
                                   widget="radio"
                                   readonly="is_locked and not is_unlocked"/>
                        </group>
                        <group>
                            <field name="weather_pm" 
                                   widget="radio"
                                   readonly="is_locked and not is_unlocked"/>
                        </group>
                    </group>
                    
                    <!-- 頁籤 -->
                    <notebook>
                        <!-- 進度狀況頁籤會由 construction_progress 模組新增 (sequence=10) -->
                        
                        <!-- 施工日誌明細 -->
                        <page string="施工日誌明細" name="daily_log_lines" sequence="20">
                            <!-- 批次新增按鈕 -->
                            <div class="oe_button_box" name="line_buttons">
                                <button name="action_add_items_wizard" 
                                        type="object"
                                        string="新增工項"
                                        class="oe_highlight"
                                        icon="fa-plus-square"
                                        invisible="is_locked and not is_unlocked"/>
                            </div>
                            
                            <field name="line_ids" 
                                   context="{'default_sheet_id': id, 'default_project_id': project_id}"
                                   readonly="is_locked and not is_unlocked">
                                <list editable="bottom" create="false"
                                      default_order="type_order, work_item_sequence, sequence"
                                      decoration-danger="is_over_contract"
                                      decoration-muted="entry_type == 'extra'"
                                      decoration-warning="completion_rate >= 90 and completion_rate &lt; 100 and not is_over_contract">
                                    <field name="type_order" column_invisible="1"/>
                                    <field name="entry_type" string="類型" readonly="1" width="90px"/>
                                    <field name="work_item_id"
                                           domain="[('project_id', '=', parent.project_id), ('is_summary_item', '=', False), ('active', '=', True)]"
                                           options="{'no_create': True, 'no_open': True}"
                                           placeholder="選擇施工項目..."
                                           readonly="entry_type == 'extra'"/>
                                    <field name="custom_name" string="自填說明" optional="show"
                                           readonly="entry_type == 'contract'"/>
                                    <field name="parent_item_name" string="父工項" readonly="1"/>
                                    <field name="item_no" optional="show"/>
                                    <field name="unit" readonly="1"/>
                                    <field name="contract_qty" readonly="1"/>
                                    <field name="daily_qty" sum="本日完成總計"/>
                                    <field name="cumulative_qty" readonly="1"/>
                                    <field name="completion_rate" widget="progressbar" optional="hide"/>
                                    <field name="work_description" optional="show"/>
                                    <!-- 隱藏欄位 -->
                                    <field name="date" column_invisible="1"/>
                                    <field name="project_id" column_invisible="1"/>
                                    <field name="is_over_contract" column_invisible="1"/>
                                    <field name="task_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- 工地材料管理 -->
                        <page string="工地材料管理" name="material_management" sequence="25">
                            <div class="text-muted mb-2">
                                含約定之重要材料使用狀況及數量等
                            </div>
                            <field name="material_ids" readonly="is_locked and not is_unlocked">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="施工項目名稱"/>
                                    <field name="unit"/>
                                    <field name="contract_qty"/>
                                    <field name="daily_qty"/>
                                    <field name="cumulative_qty"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>

                        <!-- 人機使用頁籤會由 construction_equipment 模組新增 (sequence=30) -->

                        <!-- 其餘日誌事項 -->
                        <page string="其餘日誌事項" name="other_matters" sequence="40">
                            <group>
                                <!-- (1) 技術士設置要求 -->
                                <group string="一、設置要求">
                                    <field name="has_technician_requirement" 
                                           widget="radio"
                                           readonly="is_locked and not is_unlocked"/>
                                </group>
                            </group>
                            
                            <group string="二、工地職業安全衛生事項">
                                <!-- (1) 施工前檢查事項 -->
                                <group string="(1) 施工前檢查事項" colspan="2">
                                    <field name="safety_pre_work_education" 
                                           widget="radio"
                                           readonly="is_locked and not is_unlocked"/>
                                    <field name="safety_labor_insurance_check" 
                                           widget="radio"
                                           readonly="is_locked and not is_unlocked"/>
                                    <field name="safety_ppe_check" 
                                           widget="radio"
                                           readonly="is_locked and not is_unlocked"/>
                                </group>
                                
                                <!-- (2) 其他事項 -->
                                <group string="(2) 其他事項" colspan="2">
                                    <field name="safety_other_matters" 
                                           nolabel="1"
                                           placeholder="請輸入工地職業安全衛生其他事項..."
                                           readonly="is_locked and not is_unlocked"/>
                                </group>
                            </group>
                            
                            <!-- (3) 施工取樣試驗紀錄 -->
                            <group string="三、施工取樣試驗紀錄">
                                <field name="sampling_test_record" 
                                       nolabel="1"
                                       placeholder="請輸入施工取樣試驗紀錄..."
                                       readonly="is_locked and not is_unlocked"/>
                            </group>
                            
                            <!-- (4) 通知協力廠商辦理事項 -->
                            <group string="四、通知協力廠商辦理事項">
                                <field name="subcontractor_notification" 
                                       nolabel="1"
                                       placeholder="請輸入需通知協力廠商辦理的事項..."
                                       readonly="is_locked and not is_unlocked"/>
                            </group>
                            
                            <!-- (5) 重要事項紀錄 -->
                            <group string="五、重要事項紀錄">
                                <field name="important_matters" 
                                       nolabel="1"
                                       placeholder="請輸入重要事項或特殊狀況..."
                                       readonly="is_locked and not is_unlocked"/>
                            </group>
                        </page>
                        
                        <!-- 備註 -->
                        <page string="備註" name="notes" sequence="50">
                            <group>
                                <field name="work_summary"
                                       placeholder="本日工作摘要..."
                                       readonly="is_locked and not is_unlocked"/>
                                <field name="notes"
                                       placeholder="其他附註說明..."
                                       readonly="is_locked and not is_unlocked"/>
                            </group>
                        </page>

                        <!-- 施工照片 -->
                        <page string="照片" name="photos" sequence="60">
                            <field name="photo_ids"
                                   widget="many2many_binary"
                                   string="施工照片"
                                   readonly="is_locked and not is_unlocked"/>
                        </page>
                    </notebook>
                    
                    <!-- 隱藏欄位 -->
                    <field name="is_locked" invisible="1"/>
                    <field name="can_unlock" invisible="1"/>
                    <field name="lock_date" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                    <field name="department_id" invisible="1"/>
                    <field name="task_ids" invisible="1"/>
                    <field name="notification_slip_id" invisible="1"/>
                    <field name="has_progress_change" invisible="1"/>
                    <field name="actual_progress" invisible="1"/>
                    <field name="weather_ids" invisible="1"/>
                </sheet>
                
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================================================================
         施工日誌表單 - 列表視圖
         ======================================================================== -->
    
    <record id="daily_log_sheet_view_tree" model="ir.ui.view">
        <field name="name">daily.log.sheet.tree</field>
        <field name="model">daily.log.sheet</field>
        <field name="arch" type="xml">
            <list string="施工日誌" 
                  default_order="supervision_project_id, log_date desc"
                  decoration-info="state in ('draft', 'filled') and not is_locked"
                  decoration-danger="is_locked and not is_unlocked"
                  decoration-success="is_unlocked">
                <field name="log_date"/>
                <field name="supervision_project_id"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="is_locked" optional="show" widget="boolean_toggle"/>
                <field name="days_since_log" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'filled'"
                       decoration-muted="state == 'auto_locked'"
                       decoration-danger="state == 'locked'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ========================================================================
         施工日誌表單 - 看板視圖
         ======================================================================== -->
    
    <record id="daily_log_sheet_view_kanban" model="ir.ui.view">
        <field name="name">daily.log.sheet.kanban</field>
        <field name="model">daily.log.sheet</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="log_date"/>
                <field name="supervision_project_id"/>
                <field name="employee_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="log_date"/>
                                    </strong>
                                </div>
                                <span class="float-end">
                                    <field name="state" widget="badge"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="supervision_project_id"/>
                                <div class="mt-2">
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================================================
         施工日誌表單 - 搜尋視圖
         ======================================================================== -->
    
    <record id="daily_log_sheet_view_search" model="ir.ui.view">
        <field name="name">daily.log.sheet.search</field>
        <field name="model">daily.log.sheet</field>
        <field name="arch" type="xml">
            <search string="搜尋施工日誌">
                <field name="supervision_project_id"/>
                <field name="employee_id"/>
                <field name="log_date"/>
                <field name="name"/>
                
                <separator/>
                <filter string="編輯中" name="draft" 
                        domain="[('state', '=', 'draft'), ('is_locked', '=', False)]"/>
                <filter string="已鎖定" name="locked" 
                        domain="[('is_locked', '=', True), ('is_unlocked', '=', False)]"/>
                <filter string="已解鎖" name="unlocked" 
                        domain="[('is_unlocked', '=', True)]"/>
                
                <separator/>
                <filter string="本週" name="this_week"
                        domain="[('log_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                ('log_date', '&lt;=', (context_today() + relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="本月" name="this_month"
                        domain="[('log_date', '&gt;=', context_today().strftime('%Y-%m-01')),
                                ('log_date', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter string="我的日誌" name="my_logs"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                
                <group expand="0" string="群組" name="groupby">
                    <filter string="專案" name="group_project" 
                            context="{'group_by': 'supervision_project_id'}"/>
                    <filter string="員工" name="group_employee" 
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="狀態" name="group_state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="日期" name="group_date" 
                            context="{'group_by': 'log_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================================================
         施工日誌表單 - 動作
         ======================================================================== -->
    
    <record id="action_daily_log_sheet" model="ir.actions.act_window">
        <field name="name">施工日誌</field>
        <field name="res_model">daily.log.sheet</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="daily_log_sheet_view_search"/>
        <field name="context">{
            'search_default_my_logs': 1,
            'search_default_group_project': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一份施工日誌
            </p>
            <p>
                施工日誌用於記錄每日的施工情況、工作內容、人力配置等資訊。
            </p>
        </field>
    </record>

    <!-- ========================================================================
         我的日誌 - 動作（承包商專用）
         ======================================================================== -->
    
    <record id="action_daily_log_sheet_my" model="ir.actions.act_window">
        <field name="name">我的日誌</field>
        <field name="res_model">daily.log.sheet</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="daily_log_sheet_view_search"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{
            'search_default_group_project': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立您的第一份施工日誌
            </p>
            <p>
                在此記錄您負責的施工日誌。
            </p>
        </field>
    </record>

    <!-- ========================================================================
         所有日誌 - 動作（監造專用）
         ======================================================================== -->
    
    <record id="action_daily_log_sheet_all" model="ir.actions.act_window">
        <field name="name">所有日誌</field>
        <field name="res_model">daily.log.sheet</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="daily_log_sheet_view_search"/>
        <field name="context">{
            'search_default_group_project': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                尚無施工日誌
            </p>
            <p>
                系統中所有的施工日誌都會顯示在這裡。
            </p>
        </field>
    </record>

    <!-- ========================================================================
         日誌明細 - 列表視圖
         ======================================================================== -->
    
    <record id="daily_log_line_view_list" model="ir.ui.view">
        <field name="name">daily.log.line.list</field>
        <field name="model">daily.log.line</field>
        <field name="arch" type="xml">
            <list string="施工日誌明細" create="false"
                  default_order="type_order, work_item_sequence, sequence"
                  decoration-danger="is_over_contract"
                  decoration-muted="entry_type == 'extra'"
                  decoration-warning="completion_rate >= 90 and completion_rate &lt; 100 and not is_over_contract">
                <field name="sequence" widget="handle"/>
                <field name="type_order" column_invisible="1"/>
                <field name="date"/>
                <field name="entry_type" string="類型" readonly="1"/>
                <field name="work_item_id"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="entry_type == 'extra'"/>
                <field name="custom_name" string="自填說明" optional="show"
                       readonly="entry_type == 'contract'"/>
                <field name="item_no" optional="show"/>
                <field name="unit" readonly="1"/>
                <field name="contract_qty" readonly="1"/>
                <field name="daily_qty" sum="本日完成總計"/>
                <field name="cumulative_qty" readonly="1"/>
                <field name="completion_rate" widget="progressbar" optional="hide"/>
                <field name="work_description" optional="show"/>
                <!-- 隱藏欄位 -->
                <field name="sheet_id" column_invisible="1"/>
                <field name="project_id" column_invisible="1"/>
                <field name="is_over_contract" column_invisible="1"/>
                <field name="task_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ========================================================================
         日誌明細 - 動作
         ======================================================================== -->
    
    <record id="action_daily_log_line" model="ir.actions.act_window">
        <field name="name">日誌明細</field>
        <field name="res_model">daily.log.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                尚無日誌明細
            </p>
            <p>
                所有施工日誌的明細記錄都會顯示在這裡。
            </p>
        </field>
    </record>

    <!-- ========================================================================
         天氣記錄 - 動作
         ======================================================================== -->
    
    <record id="action_daily_log_weather" model="ir.actions.act_window">
        <field name="name">天氣記錄</field>
        <field name="res_model">daily.log.weather</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                尚無天氣記錄
            </p>
            <p>
                歷史天氣記錄都會顯示在這裡。
            </p>
        </field>
    </record>

</odoo>
