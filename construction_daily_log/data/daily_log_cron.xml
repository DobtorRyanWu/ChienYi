<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate：排程開關由各站決定。沒有 noupdate 時，每次 -u 都把這裡寫死的 active 蓋回去。 -->
    <data noupdate="1">

    <!-- 2026-11-20 起不再鎖定：這支排程改成把滿 14 天還在編輯中的日誌標成已填寫（xml id 沿用舊名）。
         既有資料庫的排程名稱由 migrations/18.0.2.15.0 更新（這裡是 noupdate）。 -->
    <record id="ir_cron_auto_lock_daily_logs" model="ir.cron">
        <field name="name">施工日誌 - 滿 14 天的編輯中日誌自動標成已填寫</field>
        <field name="model_id" search="[('model', '=', 'daily.log.sheet')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_lock()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    </data>
</odoo>
