<odoo>

    <record id="weekly_schedule_add_items_wizard_form" model="ir.ui.view">
        <field name="name">weekly.schedule.add.items.wizard.form</field>
        <field name="model">weekly.schedule.add.items.wizard</field>
        <field name="arch" type="xml">
            <form string="新增施工項目">
                <group>
                    <group>
                        <field name="schedule_id" invisible="1"/>
                        <field name="project_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="available_item_count" readonly="1"/>
                    </group>
                </group>

                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="selected" nolabel="1" width="40px"/>
                        <field name="name" string="施工項目" readonly="1"/>
                        <field name="parent_id" string="父工項" readonly="1" optional="show"/>
                        <field name="item_no" string="工項編號" readonly="1"/>
                        <field name="unit" string="單位" readonly="1"/>
                        <field name="planned_qty" string="契約數量" readonly="1"
                               digits="[16, 4]"/>
                        <field name="task_id" column_invisible="1" force_save="1"/>
                    </list>
                </field>

                <footer>
                    <button string="新增選取工項" type="object"
                            name="action_add_selected"
                            class="btn-primary"
                            invisible="available_item_count == 0"/>
                    <button string="全部新增" type="object"
                            name="action_add_all"
                            class="btn-secondary"
                            invisible="available_item_count == 0"/>
                    <button string="關閉" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
