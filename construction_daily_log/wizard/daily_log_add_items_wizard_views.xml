<odoo>

    <!-- ===================================================================
         新增施工項目 Wizard（雙分頁：契約工項 + 自填項目，確認後關閉）
         切換分頁不會清空另一頁已填內容（兩者皆為 wizard 欄位）。
         =================================================================== -->

    <record id="daily_log_add_items_wizard_form" model="ir.ui.view">
        <field name="name">daily.log.add.items.wizard.form</field>
        <field name="model">daily.log.add.items.wizard</field>
        <field name="arch" type="xml">
            <form string="新增施工項目">
                <group>
                    <group>
                        <field name="sheet_id" invisible="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="log_date" readonly="1"/>
                    </group>
                </group>

                <notebook>
                    <!-- 分頁一：契約工項 -->
                    <page string="契約工項" name="contract_items">
                        <field name="selected_task_ids" nolabel="1"
                               domain="[('project_id', '=', project_id), ('is_summary_item', '=', False), ('active', '=', True)]"
                               options="{'no_create': True, 'no_open': True}"
                               context="{'list_view_ref': 'construction_supervision_base.view_task_tree_supervision_full', 'search_view_ref': 'construction_supervision_base.view_task_search_supervision'}">
                            <list>
                                <field name="display_item_no" string="項次" readonly="1" width="60px"/>
                                <!-- 父工項：與選取對話框一致。已選清單同樣只有葉節點，
                                     沒有這欄一樣分不出屬於哪個大項（代操回報的問題） -->
                                <field name="parent_id" string="父工項" readonly="1"/>
                                <field name="name" string="施工項目" readonly="1"/>
                                <field name="unit" string="單位" readonly="1"/>
                                <field name="planned_qty" string="契約數量" readonly="1" digits="[16, 4]"/>
                                <field name="item_no" string="完整項次" readonly="1" optional="hide"/>
                            </list>
                        </field>
                    </page>

                    <!-- 分頁二：自填項目（純文字，不登記為契約工項） -->
                    <page string="自填項目（非契約工項）" name="extra_items">
                        <div class="text-muted mb-2">
                            無法量化的施工動作（如「工區復舊」）可在此自填；僅為文字，不會登記為契約工項。
                        </div>
                        <field name="extra_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name" string="項目說明" placeholder="如：工區復舊"/>
                                <field name="location" string="位置" optional="show"/>
                                <field name="work_description" string="備註" optional="show"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <footer>
                    <button string="新增選取工項" type="object"
                            name="action_add_selected"
                            class="btn-primary"
                            invisible="not selected_task_ids and not extra_line_ids"/>
                    <button string="關閉" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 保留 form_existing 記錄以避免升級錯誤（內容與主 form 相同） -->
    <record id="daily_log_add_items_wizard_form_existing" model="ir.ui.view">
        <field name="name">daily.log.add.items.wizard.form.existing</field>
        <field name="model">daily.log.add.items.wizard</field>
        <field name="arch" type="xml">
            <form string="新增施工項目">
                <group>
                    <group>
                        <field name="sheet_id" invisible="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="log_date" readonly="1"/>
                    </group>
                </group>

                <notebook>
                    <page string="契約工項" name="contract_items">
                        <field name="selected_task_ids" nolabel="1"
                               domain="[('project_id', '=', project_id), ('is_summary_item', '=', False), ('active', '=', True)]"
                               options="{'no_create': True, 'no_open': True}"
                               context="{'list_view_ref': 'construction_supervision_base.view_task_tree_supervision_full', 'search_view_ref': 'construction_supervision_base.view_task_search_supervision'}">
                            <list>
                                <field name="display_item_no" string="項次" readonly="1" width="60px"/>
                                <!-- 父工項：與選取對話框一致。已選清單同樣只有葉節點，
                                     沒有這欄一樣分不出屬於哪個大項（代操回報的問題） -->
                                <field name="parent_id" string="父工項" readonly="1"/>
                                <field name="name" string="施工項目" readonly="1"/>
                                <field name="unit" string="單位" readonly="1"/>
                                <field name="planned_qty" string="契約數量" readonly="1" digits="[16, 4]"/>
                                <field name="item_no" string="完整項次" readonly="1" optional="hide"/>
                            </list>
                        </field>
                    </page>

                    <page string="自填項目（非契約工項）" name="extra_items">
                        <div class="text-muted mb-2">
                            無法量化的施工動作（如「工區復舊」）可在此自填；僅為文字，不會登記為契約工項。
                        </div>
                        <field name="extra_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name" string="項目說明" placeholder="如：工區復舊"/>
                                <field name="location" string="位置" optional="show"/>
                                <field name="work_description" string="備註" optional="show"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <footer>
                    <button string="新增選取工項" type="object"
                            name="action_add_selected"
                            class="btn-primary"
                            invisible="not selected_task_ids and not extra_line_ids"/>
                    <button string="關閉" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
