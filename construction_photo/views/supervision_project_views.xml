<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 工程案件 - 表單視圖擴展（工程告示牌）          -->
    <!-- ============================================== -->
    <record id="view_supervision_project_form_signboard" model="ir.ui.view">
        <field name="name">supervision.project.form.signboard</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="construction_supervision_base.view_supervision_project_form"/>
        <field name="arch" type="xml">
            <!-- 在 notebook 最後插入「工程告示牌」頁籤 -->
            <xpath expr="//notebook" position="inside">
                <page string="工程告示牌" name="signboard">
                    <button name="%(construction_photo.action_photo_upload_wizard)d"
                            type="action" string="批次上傳照片"
                            class="btn-primary" icon="fa-camera"/>
                    <field name="signboard_photo_ids" nolabel="1" mode="kanban" create="false"
                           context="{'kanban_view_ref': 'construction_photo.supervision_photo_view_kanban_embedded',
                                     'form_view_ref': 'construction_photo.supervision_photo_view_form_embedded'}"/>
                    <div class="alert alert-info mt-3" role="alert">
                        <i class="fa fa-info-circle"/>
                        工程告示牌照片就是「照片管理」裡的同一筆記錄（照片資料表已收斂成一張），
                        點卡片可以逐張修改說明／分類／拍攝地點說明，照片管理那邊立刻同步。
                        照片本身若沒有 GPS 資訊，會自動沿用本工程的座標。
                    </div>
                </page>
                <page string="工程照片" name="project_photos">
                    <field name="photo_ids" nolabel="1" mode="kanban" create="false"
                           context="{'kanban_view_ref': 'construction_photo.supervision_photo_view_kanban_embedded',
                                     'form_view_ref': 'construction_photo.supervision_photo_view_form_embedded'}"/>
                    <div class="alert alert-info mt-3" role="alert">
                        <i class="fa fa-info-circle"/>
                        此頁顯示所有關聯到本工程案件的照片（透過 supervision.photo.project_id）。
                    </div>
                </page>
            </xpath>
            <!-- 「照片數量」smart button；排在「文件」之後 -->
            <xpath expr="//button[@name='action_view_documents']" position="after">
                <button name="action_view_photos" type="object"
                        class="oe_stat_button" icon="fa-camera">
                    <field name="photo_count" widget="statinfo" string="照片"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
