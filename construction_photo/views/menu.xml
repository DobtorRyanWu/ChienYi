<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         照片管理選單 (歸屬於 施工執行 > 照片管理)
         =================================================================== -->

    <!-- 工程照片 -->
    <menuitem id="menu_supervision_photo"
              name="工程照片"
              action="supervision_photo_action"
              parent="construction_supervision_base.menu_photo_management"
              sequence="10"/>

    <!-- 批次上傳照片：與「批次下載照片」對稱。清單/看板的 <header> 已有常駐
         按鈕，這裡再放一個選單入口當雙保險——代操人員原本在 ⚙️ 找不到上傳
         入口，才會去按 Odoo 標準的「匯入記錄」（那支只吃 CSV/XLSX）。 -->
    <menuitem id="menu_photo_batch_upload"
              name="批次上傳照片"
              action="action_photo_upload_wizard"
              parent="construction_supervision_base.menu_photo_management"
              sequence="12"/>

    <!-- 批次下載照片 -->
    <menuitem id="menu_photo_batch_download"
              name="批次下載照片"
              action="action_photo_download_wizard"
              parent="construction_supervision_base.menu_photo_management"
              sequence="15"/>

    <!-- 照片標籤 -->
    <menuitem id="menu_photo_tag"
              name="照片標籤"
              action="supervision_photo_tag_action"
              parent="construction_supervision_base.menu_photo_management"
              sequence="20"
              groups="base.group_user,construction_supervision_base.group_supervisor_admin,base.group_portal"/>

    <!-- 照片分類（master data） -->
    <menuitem id="menu_photo_category"
              name="照片分類"
              action="action_supervision_photo_category"
              parent="construction_supervision_base.menu_photo_management"
              sequence="30"
              groups="construction_supervision_base.group_supervisor_admin"/>

</odoo>
