<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List 視圖 -->
    <record id="view_supervision_photo_category_list" model="ir.ui.view">
        <field name="name">supervision.photo.category.list</field>
        <field name="model">supervision.photo.category</field>
        <field name="arch" type="xml">
            <list string="照片分類" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="photo_count" string="照片數"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form 視圖 -->
    <record id="view_supervision_photo_category_form" model="ir.ui.view">
        <field name="name">supervision.photo.category.form</field>
        <field name="model">supervision.photo.category</field>
        <field name="arch" type="xml">
            <form string="照片分類">
                <sheet>
                    <widget name="web_ribbon" title="已停用" bg_color="bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                            <field name="photo_count"/>
                        </group>
                    </group>
                    <group string="說明">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_supervision_photo_category" model="ir.actions.act_window">
        <field name="name">照片分類</field>
        <field name="res_model">supervision.photo.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">建立第一個照片分類</p>
            <p>定義照片的工項/材料分類，匯入腳本與後台都會用到。</p>
        </field>
    </record>
</odoo>
