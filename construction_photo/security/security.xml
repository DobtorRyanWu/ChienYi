<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 工程照片 資料隔離規則 (Record Rules)             -->
        <!-- ============================================== -->

        <!-- 工程照片 - 監造單位可看所屬工程的所有照片 -->
        <record id="rule_supervision_photo_supervision" model="ir.rule">
            <field name="name">工程照片: 監造單位完整存取</field>
            <field name="model_id" ref="model_supervision_photo"/>
            <field name="domain_force">[('project_id.company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervision_manager')), (4, ref('construction_supervision_base.group_supervision_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 工程照片 - 施工廠商可看參與工程的照片 -->
        <record id="rule_supervision_photo_contractor" model="ir.rule">
            <field name="name">工程照片: 施工廠商存取</field>
            <field name="model_id" ref="model_supervision_photo"/>
            <field name="domain_force">[('project_id.contractor_company_ids', 'in', [user.company_id.id])]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_contractor_manager')), (4, ref('construction_supervision_base.group_contractor_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 工程照片 - 系統管理者完整存取 -->
        <record id="rule_supervision_photo_admin" model="ir.rule">
            <field name="name">工程照片: 系統管理者完整存取</field>
            <field name="model_id" ref="model_supervision_photo"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <!-- ============================================== -->
        <!-- 照片標籤 資料隔離規則 (Record Rules)             -->
        <!-- ============================================== -->

        <!-- 照片標籤 - 所有人可讀取 -->
        <record id="rule_photo_tag_read_all" model="ir.rule">
            <field name="name">照片標籤: 所有人可讀取</field>
            <field name="model_id" ref="model_supervision_photo_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervision_manager')), (4, ref('construction_supervision_base.group_supervision_engineer')), (4, ref('construction_supervision_base.group_contractor_manager')), (4, ref('construction_supervision_base.group_contractor_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 照片標籤 - 系統管理者完整存取 -->
        <record id="rule_photo_tag_admin" model="ir.rule">
            <field name="name">照片標籤: 系統管理者完整存取</field>
            <field name="model_id" ref="model_supervision_photo_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
