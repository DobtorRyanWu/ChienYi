<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 估驗計價表單：「匯入估驗試算表」按鈕（帶 context 讓匯入的試算表回掛本估驗）+ 關聯試算表 smart button -->
    <record id="view_payment_estimate_form_sse" model="ir.ui.view">
        <field name="name">payment.estimate.form.sse</field>
        <field name="model">payment.estimate</field>
        <field name="inherit_id" ref="construction_payment.view_payment_estimate_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(dobtor_spreadsheet_editor.action_xlsx_import)d"
                        type="action"
                        string="匯入估驗試算表"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'sse_create_vals': {'payment_estimate_id': id}}"/>
                <button name="action_generate_spreadsheet"
                        type="object"
                        string="從工項產生試算表"
                        class="btn-secondary"
                        icon="fa-magic"
                        invisible="not line_ids"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="sse_button_box">
                    <button name="action_open_spreadsheets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-table"
                            invisible="spreadsheet_count == 0">
                        <field name="spreadsheet_count" widget="statinfo" string="關聯試算表"/>
                    </button>
                </div>
                <field name="spreadsheet_count" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
