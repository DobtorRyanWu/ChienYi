<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 公文的讀取範圍（淞源 C10，2026-11-12）。前台帳號沒有寫入 ACL（新增走 controller 守衛）。

         1. 全域（不掛群組，讀寫建刪都套）：只碰得到「所屬公司在自己允許公司內」的公文。
            同一個工程上的監造與營造廠各有各的公文，彼此看不到。
         2. 前台成員：只看自己參與工程的公文；沒掛工程的（公司共通）成員看不到。
         3. 前台老闆：所屬公司範圍內全部（含沒掛工程的）。
         受限帳號（營造方、後台角色帳號）另由 construction_company_dashboard 的 rule_scope 收窄成
         「所屬公司＝自己的公司」（NARROW_BY_COMPANY）；沒列進去的話，那邊預設是拒絕。 -->
    <data>
        <record id="official_doc_company_rule" model="ir.rule">
            <field name="name">公文：所屬公司在允許公司內（全域）</field>
            <field name="model_id" ref="model_construction_official_doc"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="official_doc_portal_member_rule" model="ir.rule">
            <field name="name">Portal: 公文 - 成員專案讀取</field>
            <field name="model_id" ref="model_construction_official_doc"/>
            <field name="domain_force">[('project_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="official_doc_portal_boss_rule" model="ir.rule">
            <field name="name">Portal老闆: 公文 - 所屬公司範圍內全部</field>
            <field name="model_id" ref="model_construction_official_doc"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
