<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 參觀帳號的頁面（淞源 C11）：只有照片與指定的公文，全部唯讀。
         沿用前台外殼的樣式（cy- 類別、wb- 開頭的色彩變數），但不放前台的抽屜選單與底部導航——
         那些連到的頁面參觀帳號一個都進不去。觸控目標至少 44px。 -->

    <template id="portal_visit_layout" name="參觀：外框">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="cy-v10-app">
                <div style="display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--wb-bg2); border-bottom: 1px solid var(--wb-bdr);">
                    <div style="flex: 1; min-width: 0;">
                        <div style="font-weight: 700; color: var(--wb-t1);">參觀：<t t-esc="visit_user.name"/></div>
                        <div style="font-size: 0.8rem; color: var(--wb-t3);">
                            可看到 <t t-esc="valid_until"/> 為止；只能瀏覽，不能修改任何資料
                        </div>
                    </div>
                    <a href="/web/session/logout?redirect=/web/login" class="cy-btn"
                       style="min-height: 44px; display: inline-flex; align-items: center; white-space: nowrap;">登出</a>
                </div>
                <!-- 不用前台的等寬分段麵包屑：工程名稱很長，分段會被切掉（2026-11-13 手機寬度實看）。
                     有連結的是「回上一層」，最後一段當標題、可以換行 -->
                <div t-if="crumbs" style="padding: 10px 16px 0;">
                    <div style="display: flex; flex-wrap: wrap; gap: 4px 12px;">
                        <t t-foreach="crumbs" t-as="crumb">
                            <a t-if="crumb[1]" t-att-href="crumb[1]"
                               style="min-height: 44px; display: inline-flex; align-items: center; color: var(--wb-brand-darker); font-weight: 600; text-decoration: none;">
                                <i class="fa fa-chevron-left" style="margin-right: 6px;" aria-hidden="true"/><t t-esc="crumb[0]"/>
                            </a>
                        </t>
                    </div>
                    <t t-foreach="crumbs" t-as="crumb">
                        <h2 t-if="not crumb[1]" style="font-size: 1.1rem; font-weight: 700; color: var(--wb-t1); margin: 4px 0 0; overflow-wrap: anywhere;" t-esc="crumb[0]"/>
                    </t>
                </div>
                <div class="cy-content" style="padding: 16px;">
                    <t t-out="0"/>
                </div>
            </div>
        </t>
    </template>

    <!-- 找不到／沒有開放：不分是哪一種（不洩漏存在性） -->
    <template id="portal_visit_not_found" name="參觀：找不到">
        <t t-call="construction_office.portal_visit_layout">
            <t t-set="crumbs" t-value="[('參觀首頁', '/construction/visit'), ('找不到', False)]"/>
            <div class="cy-empty">
                <i class="fa fa-eye-slash"/>
                <div class="cy-empty-text">找不到這個頁面，或這項內容沒有開放給這個帳號</div>
            </div>
            <a href="/construction/visit" class="cy-btn cy-btn-primary"
               style="min-height: 44px; display: inline-flex; align-items: center; margin-top: 12px;">回參觀首頁</a>
        </t>
    </template>

    <!-- 首頁：可以看的工程 -->
    <template id="portal_visit_home" name="參觀：首頁">
        <t t-call="construction_office.portal_visit_layout">
            <div class="cy-sec-divider"><span>可以看的工程</span></div>
            <t t-if="not rows">
                <div class="cy-empty"><i class="fa fa-eye-slash"/><div class="cy-empty-text">目前沒有開放給這個帳號的內容</div></div>
            </t>
            <t t-foreach="rows" t-as="row">
                <div style="background: var(--wb-bg2); border: 1px solid var(--wb-bdr); border-radius: var(--wb-radius); padding: 14px 16px; margin-bottom: 12px;">
                    <div style="font-weight: 700; font-size: 1.05rem; color: var(--wb-t1); margin-bottom: 10px;" t-esc="row['project'].name"/>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <a t-if="row['grant'].allow_photos" t-attf-href="/construction/visit/#{row['project'].id}/photos"
                           class="cy-btn cy-btn-primary" style="min-height: 44px; display: inline-flex; align-items: center;">
                            <i class="fa fa-camera" style="margin-right: 6px;"/>照片（<t t-esc="row['photo_count']"/>）
                        </a>
                        <a t-if="row['doc_count']" t-attf-href="/construction/visit/#{row['project'].id}/docs"
                           class="cy-btn" style="min-height: 44px; display: inline-flex; align-items: center;">
                            <i class="fa fa-envelope-o" style="margin-right: 6px;"/>公文（<t t-esc="row['doc_count']"/>）
                        </a>
                        <span t-if="not row['grant'].allow_photos and not row['doc_count']" style="color: var(--wb-t3);">沒有開放的內容</span>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- 照片牆 -->
    <template id="portal_visit_photos" name="參觀：照片">
        <t t-call="construction_office.portal_visit_layout">
            <t t-set="crumbs" t-value="[('參觀首頁', '/construction/visit'), (project.name + '：照片', False)]"/>
            <div class="cy-total-count">共 <t t-esc="photo_count"/> 張</div>
            <t t-if="not photos">
                <div class="cy-empty"><i class="fa fa-camera"/><div class="cy-empty-text">這個工程還沒有照片</div></div>
            </t>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px;">
                <t t-foreach="photos" t-as="photo">
                    <a t-attf-href="/construction/visit/photo/#{photo.id}" target="_blank" rel="noopener"
                       style="display: block; background: var(--wb-bg2); border: 1px solid var(--wb-bdr); border-radius: var(--wb-radius-sm); overflow: hidden; text-decoration: none; color: inherit;">
                        <img t-attf-src="/construction/visit/photo/#{photo.id}/#{thumb_size}x#{thumb_size}" loading="lazy"
                             t-att-alt="photo.name or '工程照片'"
                             style="width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; background: var(--wb-bg3);"/>
                        <div style="padding: 6px 8px; font-size: 0.8rem; color: var(--wb-t2); line-height: 1.3;">
                            <div t-if="photo.shot_date" t-esc="photo.shot_date"/>
                            <div t-if="photo.location_description" style="color: var(--wb-t3); overflow-wrap: anywhere;" t-esc="photo.location_description"/>
                        </div>
                    </a>
                </t>
            </div>
            <div class="d-flex justify-content-center mt-3"><t t-call="portal.pager"/></div>
        </t>
    </template>

    <!-- 指定的公文：列表 -->
    <template id="portal_visit_docs" name="參觀：公文列表">
        <t t-call="construction_office.portal_visit_layout">
            <t t-set="crumbs" t-value="[('參觀首頁', '/construction/visit'), (project.name + '：公文', False)]"/>
            <div class="cy-total-count">共 <t t-esc="len(docs)"/> 份</div>
            <t t-if="not docs">
                <div class="cy-empty"><i class="fa fa-envelope-o"/><div class="cy-empty-text">沒有開放的公文</div></div>
            </t>
            <t t-foreach="docs" t-as="doc">
                <a t-attf-href="/construction/visit/doc/#{doc.id}" class="cy-task-row">
                    <div class="cy-task-info">
                        <div class="cy-task-name" style="overflow-wrap: anywhere;" t-esc="doc.subject"/>
                        <div class="cy-task-sub">
                            <t t-esc="direction_labels.get(doc.direction, '')"/>
                            <t t-if="doc.doc_date">・<t t-esc="doc.doc_date"/></t>
                            <t t-if="doc.organization">・<t t-esc="doc.organization"/></t>
                            <t t-if="doc.doc_number">・<t t-esc="doc.doc_number"/></t>
                        </div>
                    </div>
                    <i class="fa fa-chevron-right" style="color: var(--wb-t3);" aria-hidden="true"/>
                </a>
            </t>
        </t>
    </template>

    <!-- 指定的公文：內容與附件 -->
    <template id="portal_visit_doc" name="參觀：公文內容">
        <t t-call="construction_office.portal_visit_layout">
            <t t-set="crumbs" t-value="[('參觀首頁', '/construction/visit'), (project.name + '：公文', '/construction/visit/%s/docs' % project.id), ('內容', False)]"/>
            <div style="background: var(--wb-bg2); border: 1px solid var(--wb-bdr); border-radius: var(--wb-radius); padding: 14px 16px;">
                <div style="font-weight: 700; font-size: 1.05rem; color: var(--wb-t1); overflow-wrap: anywhere; margin-bottom: 8px;" t-esc="doc.subject"/>
                <div style="font-size: 0.9rem; color: var(--wb-t2); line-height: 1.7;">
                    <div><t t-esc="direction_labels.get(doc.direction, '')"/><t t-if="doc.doc_date">・公文日期 <t t-esc="doc.doc_date"/></t></div>
                    <div t-if="doc.organization">機關：<t t-esc="doc.organization"/></div>
                    <div t-if="doc.doc_number">文號：<t t-esc="doc.doc_number"/></div>
                </div>
                <div t-if="doc.summary" style="margin-top: 10px; white-space: pre-wrap; overflow-wrap: anywhere;" t-esc="doc.summary"/>
            </div>
            <div class="cy-sec-divider"><span>附件</span></div>
            <t t-if="not attachments">
                <div style="color: var(--wb-t3);">這份公文沒有附件</div>
            </t>
            <t t-foreach="attachments" t-as="att">
                <a t-attf-href="/construction/visit/doc/#{doc.id}/file/#{att.id}" class="cy-task-row">
                    <span class="cy-task-icon blue"><i class="fa fa-download"/></span>
                    <div class="cy-task-info"><div class="cy-task-name" style="overflow-wrap: anywhere;" t-esc="att.name"/></div>
                </a>
            </t>
        </t>
    </template>
</odoo>
