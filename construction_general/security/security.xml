<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- 一般式工程模組安全群組 -->

        <!-- 一般式工程 - 使用者 -->
        <record id="group_general_user" model="res.groups">
            <field name="name">一般式工程 - 使用者</field>
            <field name="category_id" ref="construction_supervision_base.module_category_construction_supervision"/>
            <field name="implied_ids" eval="[(4, ref('construction_quality.group_quality_user'))]"/>
            <field name="comment">可建立與填寫一般式工程相關記錄</field>
        </record>

        <!-- 一般式工程 - 主管 -->
        <record id="group_general_manager" model="res.groups">
            <field name="name">一般式工程 - 主管</field>
            <field name="category_id" ref="construction_supervision_base.module_category_construction_supervision"/>
            <field name="implied_ids" eval="[(4, ref('group_general_user')), (4, ref('construction_quality.group_quality_manager'))]"/>
            <field name="comment">可審核進度報告、損益報告，管理缺失改善</field>
        </record>

    </data>

    <data noupdate="1">

        <!-- Record Rules -->

        <!-- 一般式缺失改善 - 公司隔離 -->
        <record id="rule_general_defect_improvement_company" model="ir.rule">
            <field name="name">一般式缺失改善: 公司隔離</field>
            <field name="model_id" ref="model_general_defect_improvement"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 一般式進度報告 - 公司隔離 -->
        <record id="rule_general_progress_report_company" model="ir.rule">
            <field name="name">一般式進度報告: 公司隔離</field>
            <field name="model_id" ref="model_general_progress_report"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 一般式即時損益 - 公司隔離 -->
        <record id="rule_general_realtime_profit_company" model="ir.rule">
            <field name="name">一般式即時損益: 公司隔離</field>
            <field name="model_id" ref="model_general_realtime_profit"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 系統管理者 - 完整存取 -->
        <record id="rule_admin_full_access_general_defect" model="ir.rule">
            <field name="name">管理者: 一般式缺失改善完整存取</field>
            <field name="model_id" ref="model_general_defect_improvement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_general_progress" model="ir.rule">
            <field name="name">管理者: 一般式進度報告完整存取</field>
            <field name="model_id" ref="model_general_progress_report"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_general_profit" model="ir.rule">
            <field name="name">管理者: 一般式即時損益完整存取</field>
            <field name="model_id" ref="model_general_realtime_profit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
