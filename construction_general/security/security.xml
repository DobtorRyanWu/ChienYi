<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Record Rules -->

        <!-- 一般式缺失改善 - 公司隔離 -->
        <record id="rule_general_defect_improvement_company" model="ir.rule">
            <field name="name">一般式缺失改善: 公司隔離</field>
            <field name="model_id" ref="model_general_defect_improvement"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 一般式進度報告 - 公司隔離 -->
