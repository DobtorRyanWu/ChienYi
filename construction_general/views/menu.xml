<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         一般式工程選單 (整合至品質安全及計價請款)
         =================================================================== -->

    <!-- 一般式監造缺失改善 (歸屬於 品質安全 > 缺失管理) -->
    <menuitem id="menu_general_defect_improvement_supervision"
              name="一般式監造缺失改善"
              parent="construction_supervision_base.menu_defect_management"
              action="action_general_defect_improvement_supervision"
              sequence="10"/>

    <!-- 一般式營造缺失改善 (歸屬於 品質安全 > 缺失管理) -->
    <menuitem id="menu_general_defect_improvement_contractor"
              name="一般式營造缺失改善"
              parent="construction_supervision_base.menu_defect_management"
              action="action_general_defect_improvement_contractor"
              sequence="11"/>

    <!-- 一般式逾期缺失 (不分監造/營造，歸屬於 品質安全 > 缺失管理) -->
    <menuitem id="menu_general_defect_improvement_overdue"
              name="一般式逾期缺失"
              parent="construction_supervision_base.menu_defect_management"
              action="action_general_defect_improvement_overdue"
              sequence="35"/>

    <!-- 一般式進度報告 (歸屬於 工程管理 > 進度管理) -->
    <menuitem id="menu_general_progress_report"
              name="進度報告"
              parent="construction_supervision_base.menu_schedule_management"
              action="action_general_progress_report"
              sequence="40"/>

    <!-- 即時損益 Dashboard (歸屬於 計價請款) -->
    <menuitem id="menu_general_realtime_profit"
              name="即時損益"
              parent="construction_supervision_base.menu_payment_root"
              action="action_profit_loss_dashboard"
              sequence="35"/>

    <!-- M4-b：一般式缺失已收斂到 supervision.defect（見 construction_quality「缺失管理」下的
         監造缺失改善選單）。以下 3 個一般式缺失選單現為冗餘（general.defect.improvement 已空），
         停用之。可逆：把 eval 改回 True 或移除本段即恢復。 -->
    <record id="menu_general_defect_improvement_supervision" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_general_defect_improvement_contractor" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_general_defect_improvement_overdue" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
