<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 一般式進度報告 List View -->
    <record id="view_general_progress_report_tree" model="ir.ui.view">
        <field name="name">general.progress.report.tree</field>
        <field name="model">general.progress.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="report_type"/>
                <field name="report_date"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="planned_progress"/>
                <field name="actual_progress"/>
                <field name="progress_variance"
                       decoration-success="progress_variance > 0"
                       decoration-danger="progress_variance &lt; -5"/>
                <field name="progress_status"
                       decoration-success="progress_status == 'ahead'"
                       decoration-info="progress_status == 'on_track'"
                       decoration-warning="progress_status == 'delayed'"
                       decoration-danger="progress_status == 'critical'"
                       widget="badge"/>
                <field name="reporter_id"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <!-- 一般式進度報告 Form View -->
    <record id="view_general_progress_report_form" model="ir.ui.view">
        <field name="name">general.progress.report.form</field>
        <field name="model">general.progress.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="落後" bg_color="text-bg-warning"
                            invisible="progress_status != 'delayed'"/>
                    <widget name="web_ribbon" title="嚴重落後" bg_color="text-bg-danger"
                            invisible="progress_status != 'critical'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <!-- 操作列：同步按鈕 + 上次同步時間 -->
                    <div class="d-flex align-items-center gap-3 mb-3"
                         invisible="not period_start or not period_end">
                        <button name="action_sync_all"
                                string="同步數據"
                                type="object"
                                class="btn btn-secondary btn-sm"/>
                        <button name="action_load_task_progress"
                                string="載入工項進度"
                                type="object"
                                class="btn btn-secondary btn-sm"
                                invisible="progress_line_ids"/>
                        <span class="text-muted small" invisible="not last_sync_date">
                            最後同步：<field name="last_sync_date" readonly="1" nolabel="1"/>
                        </span>
                    </div>
                    <group>
                        <group string="工程資訊">
                            <field name="project_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="report_type"/>
                        </group>
                        <group string="報告期間">
                            <field name="report_date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                    </group>
                    <group>
                        <group string="累計進度">
                            <field name="planned_progress"/>
                            <field name="actual_progress"/>
                            <field name="progress_variance"
                                   decoration-success="progress_variance > 0"
                                   decoration-danger="progress_variance &lt; -5"/>
                            <field name="progress_status"
                                   decoration-success="progress_status == 'ahead'"
                                   decoration-info="progress_status == 'on_track'"
                                   decoration-warning="progress_status == 'delayed'"
                                   decoration-danger="progress_status == 'critical'"
                                   widget="badge"/>
                        </group>
                    </group>
                    <group>
                        <group string="工期資訊">
                            <field name="contract_duration"/>
                            <field name="elapsed_days"/>
                            <field name="remaining_days"/>
                        </group>
                        <group string="施工日數">
                            <field name="work_days"/>
                            <field name="rain_days"/>
                            <field name="holiday_days"/>
                        </group>
                    </group>
                    <group>
                        <group string="報告人">
                            <field name="reporter_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="工項進度明細" name="progress_lines">
                            <field name="progress_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="task_id"/>
                                    <field name="item_no"/>
                                    <field name="item_name"/>
                                    <field name="unit"/>
                                    <field name="planned_qty"/>
                                    <field name="period_qty"/>
                                    <field name="actual_qty"/>
                                    <field name="remaining_qty"/>
                                    <field name="completion_rate"
                                           decoration-success="completion_rate >= 100"
                                           decoration-warning="completion_rate >= 50 and completion_rate &lt; 100"
                                           decoration-info="completion_rate &lt; 50"
                                           widget="progressbar"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="施工概況" name="summary">
                            <group string="本期施工概況">
                                <field name="work_summary" nolabel="1"/>
                            </group>
                            <group string="本期施工項目">
                                <field name="work_items" nolabel="1"/>
                            </group>
                        </page>
                        <page string="品質安全" name="quality_safety">
                            <group>
                                <group string="品質管理摘要">
                                    <field name="quality_summary" nolabel="1"/>
                                </group>
                                <group string="安全衛生摘要">
                                    <field name="safety_summary" nolabel="1"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="defect_count"/>
                                    <field name="defect_improved_count"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 一般式進度報告 Search View -->
    <record id="view_general_progress_report_search" model="ir.ui.view">
        <field name="name">general.progress.report.search</field>
        <field name="model">general.progress.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="reporter_id"/>
                <separator/>
                <filter string="週報" name="weekly"
                        domain="[('report_type', '=', 'weekly')]"/>
                <filter string="月報" name="monthly"
                        domain="[('report_type', '=', 'monthly')]"/>
                <separator/>
                <filter string="進度落後" name="delayed"
                        domain="[('progress_status', 'in', ('delayed', 'critical'))]"/>
                <separator/>
                <filter string="本月" name="this_month"
                        domain="[('report_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="工程" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="報告類型" name="group_type"
                            context="{'group_by': 'report_type'}"/>
                    <filter string="進度狀態" name="group_progress"
                            context="{'group_by': 'progress_status'}"/>
                    <filter string="報告日期" name="group_date"
                            context="{'group_by': 'report_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 一般式進度報告 Kanban View -->
    <record id="view_general_progress_report_kanban" model="ir.ui.view">
        <field name="name">general.progress.report.kanban</field>
        <field name="model">general.progress.report</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="project_id"/>
                <field name="report_type"/>
                <field name="report_date"/>
                <field name="actual_progress"/>
                <field name="progress_status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="project_id"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <field name="report_type"/> - <field name="report_date"/>
                                </div>
                                <div>
                                    實際進度: <field name="actual_progress"/>%
                                </div>
                                <div>
                                    <span t-if="record.progress_status.raw_value == 'critical'" class="badge text-bg-danger">嚴重落後</span>
                                    <span t-if="record.progress_status.raw_value == 'delayed'" class="badge text-bg-warning">落後</span>
                                    <span t-if="record.progress_status.raw_value == 'on_track'" class="badge text-bg-info">正常</span>
                                    <span t-if="record.progress_status.raw_value == 'ahead'" class="badge text-bg-success">超前</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 一般式進度報告 Action -->
    <record id="action_general_progress_report" model="ir.actions.act_window">
        <field name="name">進度報告</field>
        <field name="res_model">general.progress.report</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_general_progress_report_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一份進度報告
            </p>
            <p>
                定期記錄工程施工進度與狀況。
            </p>
        </field>
    </record>

</odoo>
