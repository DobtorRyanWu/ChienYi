<?xml version="1.0" encoding="utf-8"?>
<!--
    一般式：缺失改善單、進度報告 的「列印」按鈕（佔位）
    ⚠️ 本檔僅提供列印入口（會出現在表單/清單的「列印」下拉）。
       實際 PDF 版面/欄位由報表負責人於 <template> 內設計，現為佔位內容。
-->
<odoo>

    <!-- ============ 一般式缺失改善單 ============ -->
    <record id="action_report_general_defect" model="ir.actions.report">
        <field name="name">缺失改善單</field>
        <field name="model">general.defect.improvement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construction_general.report_general_defect</field>
        <field name="report_file">construction_general.report_general_defect</field>
        <field name="binding_model_id" ref="model_general_defect_improvement"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_general_defect">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="text-align:center;">缺失改善單</h2>
                        <p>編號／名稱：<span t-field="doc.display_name"/></p>
                        <p class="text-muted" style="margin-top:40px;">
                            （此列印格式尚待設計，將由報表負責人完成；本頁為佔位內容。）
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============ 進度報告 ============ -->
    <record id="action_report_general_progress" model="ir.actions.report">
        <field name="name">進度報告</field>
        <field name="model">general.progress.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construction_general.report_general_progress</field>
        <field name="report_file">construction_general.report_general_progress</field>
        <field name="binding_model_id" ref="model_general_progress_report"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_general_progress">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="text-align:center;">進度報告</h2>
                        <p>編號／名稱：<span t-field="doc.display_name"/></p>
                        <p class="text-muted" style="margin-top:40px;">
                            （此列印格式尚待設計，將由報表負責人完成；本頁為佔位內容。）
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
