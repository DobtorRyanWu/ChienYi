<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================== -->
        <!-- 多公司隔離規則 (Multi-Company Isolation)         -->
        <!-- ============================================== -->
        <!-- 用戶只能查看自己公司的成本分析 -->

        <!-- 成本分析：多公司隔離 -->
        <record id="rule_cost_analysis_multi_company" model="ir.rule">
            <field name="name">成本分析 - 多公司隔離</field>
            <field name="model_id" ref="model_cost_analysis"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 成本分析明細：多公司隔離 -->
        <record id="rule_cost_analysis_line_multi_company" model="ir.rule">
            <field name="name">成本分析明細 - 多公司隔離</field>
            <field name="model_id" ref="model_cost_analysis_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 系統管理員：查看所有公司 -->
        <record id="rule_cost_analysis_admin_all" model="ir.rule">
            <field name="name">成本分析 - 系統管理員全部權限</field>
            <field name="model_id" ref="model_cost_analysis"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_cost_analysis_line_admin_all" model="ir.rule">
            <field name="name">成本分析明細 - 系統管理員全部權限</field>
            <field name="model_id" ref="model_cost_analysis_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
