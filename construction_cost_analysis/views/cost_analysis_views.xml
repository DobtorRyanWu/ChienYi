<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================== -->
    <!-- 成本分析報表 (cost.analysis.report)   -->
    <!-- ====================================== -->

    <!-- Tree View -->
    <record id="view_cost_analysis_report_tree" model="ir.ui.view">
        <field name="name">cost.analysis.report.tree</field>
        <field name="model">cost.analysis.report</field>
        <field name="arch" type="xml">
            <list string="成本分析報表" create="false" edit="false" delete="false">
                <field name="project_id"/>
                <field name="item_no"/>
                <field name="item_name"/>
                <field name="unit"/>
                <field name="company_id" optional="show"/>
                <field name="contract_qty" sum="契約數量合計"/>
                <field name="contract_price"/>
                <field name="contract_amount" sum="契約金額合計"/>
                <field name="actual_qty" sum="實際數量合計"/>
                <field name="actual_amount" sum="實際金額合計"/>
                <field name="qty_variance" sum="數量差異合計" optional="show"/>
                <field name="amount_variance" sum="金額差異合計"/>
                <field name="variance_rate" optional="show"
                       decoration-danger="variance_rate > 0"
                       decoration-success="variance_rate &lt; 0"/>
                <field name="profit_loss" sum="損益合計"
                       decoration-danger="profit_loss &lt; 0"
                       decoration-success="profit_loss > 0"/>
                <field name="profit_loss_rate"
                       decoration-danger="profit_loss_rate &lt; 0"
                       decoration-success="profit_loss_rate > 0"/>
            </list>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_cost_analysis_report_pivot" model="ir.ui.view">
        <field name="name">cost.analysis.report.pivot</field>
        <field name="model">cost.analysis.report</field>
        <field name="arch" type="xml">
            <pivot string="成本分析" display_quantity="true">
                <field name="project_id" type="row"/>
                <field name="company_id" type="row"/>
                <field name="contract_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
                <field name="amount_variance" type="measure"/>
                <field name="profit_loss" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_cost_analysis_report_graph" model="ir.ui.view">
        <field name="name">cost.analysis.report.graph</field>
        <field name="model">cost.analysis.report</field>
        <field name="arch" type="xml">
            <graph string="成本分析圖表" type="bar" stacked="True">
                <field name="project_id"/>
                <field name="contract_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_cost_analysis_report_search" model="ir.ui.view">
        <field name="name">cost.analysis.report.search</field>
        <field name="model">cost.analysis.report</field>
        <field name="arch" type="xml">
            <search string="成本分析搜尋">
                <field name="project_id"/>
                <field name="item_no"/>
                <field name="item_name"/>
                <field name="company_id"/>
                <separator/>
                <filter name="has_variance" string="有差異"
                        domain="[('amount_variance', '!=', 0)]"/>
                <filter name="over_budget" string="超出預算"
                        domain="[('profit_loss', '&lt;', 0)]"/>
                <filter name="under_budget" string="低於預算"
                        domain="[('profit_loss', '>', 0)]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter name="group_by_project" string="工程案件"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_company" string="承包廠商"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cost_analysis_report" model="ir.actions.act_window">
        <field name="name">成本分析報表</field>
        <field name="res_model">cost.analysis.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_cost_analysis_report_search"/>
        <field name="context">{'search_default_group_by_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                成本分析報表
            </p>
            <p>
                此報表顯示各工項的契約金額與實際執行金額對比分析。
            </p>
        </field>
    </record>


    <!-- ====================================== -->
    <!-- 成本分析摘要 (cost.analysis.summary)  -->
    <!-- ====================================== -->

    <!-- Tree View -->
    <record id="view_cost_analysis_summary_tree" model="ir.ui.view">
        <field name="name">cost.analysis.summary.tree</field>
        <field name="model">cost.analysis.summary</field>
        <field name="arch" type="xml">
            <list string="成本分析摘要" create="false" edit="false" delete="false">
                <field name="project_code"/>
                <field name="project_name"/>
                <field name="project_state" optional="show"/>
                <field name="total_contract_amount" sum="契約總額合計"/>
                <field name="total_change_amount" sum="變更總額合計" optional="show"/>
                <field name="current_contract_amount" sum="現行契約合計"/>
                <field name="total_actual_amount" sum="實際執行合計"/>
                <field name="execution_rate"
                       decoration-danger="execution_rate > 100"
                       decoration-warning="execution_rate > 90 and execution_rate &lt;= 100"/>
                <field name="total_estimate_amount" sum="估驗總額合計" optional="show"/>
                <field name="estimate_rate" optional="show"/>
                <field name="profit_loss" sum="損益合計"
                       decoration-danger="profit_loss &lt; 0"
                       decoration-success="profit_loss > 0"/>
                <field name="profit_loss_rate"
                       decoration-danger="profit_loss_rate &lt; 0"
                       decoration-success="profit_loss_rate > 0"/>
                <field name="task_count" optional="show"/>
                <field name="completed_task_count" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View (readonly) -->
    <record id="view_cost_analysis_summary_form" model="ir.ui.view">
        <field name="name">cost.analysis.summary.form</field>
        <field name="model">cost.analysis.summary</field>
        <field name="arch" type="xml">
            <form string="成本分析摘要" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="project_name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="project_code" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="契約金額">
                            <field name="total_contract_amount"/>
                            <field name="total_change_amount"/>
                            <field name="current_contract_amount"/>
                        </group>
                        <group string="執行狀況">
                            <field name="total_actual_amount"/>
                            <field name="execution_rate" widget="progressbar"/>
                            <field name="total_estimate_amount"/>
                            <field name="estimate_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <group string="損益分析">
                            <field name="profit_loss"
                                   decoration-danger="profit_loss &lt; 0"
                                   decoration-success="profit_loss > 0"/>
                            <field name="profit_loss_rate"/>
                        </group>
                        <group string="工項統計">
                            <field name="task_count"/>
                            <field name="completed_task_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_cost_analysis_summary_pivot" model="ir.ui.view">
        <field name="name">cost.analysis.summary.pivot</field>
        <field name="model">cost.analysis.summary</field>
        <field name="arch" type="xml">
            <pivot string="專案成本摘要">
                <field name="project_name" type="row"/>
                <field name="current_contract_amount" type="measure"/>
                <field name="total_actual_amount" type="measure"/>
                <field name="total_estimate_amount" type="measure"/>
                <field name="profit_loss" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_cost_analysis_summary_graph" model="ir.ui.view">
        <field name="name">cost.analysis.summary.graph</field>
        <field name="model">cost.analysis.summary</field>
        <field name="arch" type="xml">
            <graph string="專案成本對比" type="bar">
                <field name="project_name"/>
                <field name="current_contract_amount" type="measure"/>
                <field name="total_actual_amount" type="measure"/>
                <field name="profit_loss" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_cost_analysis_summary_search" model="ir.ui.view">
        <field name="name">cost.analysis.summary.search</field>
        <field name="model">cost.analysis.summary</field>
        <field name="arch" type="xml">
            <search string="成本摘要搜尋">
                <field name="project_name"/>
                <field name="project_code"/>
                <separator/>
                <filter name="has_loss" string="有虧損"
                        domain="[('profit_loss', '&lt;', 0)]"/>
                <filter name="has_profit" string="有盈餘"
                        domain="[('profit_loss', '>', 0)]"/>
                <filter name="over_execution" string="超出執行"
                        domain="[('execution_rate', '>', 100)]"/>
                <separator/>
                <filter name="state_construction" string="施工中"
                        domain="[('project_state', '=', 'construction')]"/>
                <filter name="state_completion" string="已竣工"
                        domain="[('project_state', '=', 'completion')]"/>
                <filter name="state_closed" string="已結案"
                        domain="[('project_state', '=', 'closed')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cost_analysis_summary" model="ir.actions.act_window">
        <field name="name">成本分析摘要</field>
        <field name="res_model">cost.analysis.summary</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_cost_analysis_summary_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                成本分析摘要
            </p>
            <p>
                此報表顯示各工程專案的成本摘要，包含契約金額、執行金額及損益分析。
            </p>
        </field>
    </record>

</odoo>
