<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================== -->
    <!-- Cost Analysis Line Tree View               -->
    <!-- ========================================== -->
    <record id="view_cost_analysis_line_tree" model="ir.ui.view">
        <field name="name">cost.analysis.line.tree</field>
        <field name="model">cost.analysis.line</field>
        <field name="arch" type="xml">
            <list string="成本分析明細"
                  decoration-success="price_variance_level == 'excellent'"
                  decoration-info="price_variance_level == 'good'"
                  decoration-warning="price_variance_level == 'warning'"
                  decoration-bf="price_variance_level == 'alert'"
                  decoration-danger="price_variance_level == 'critical'">
                <field name="sequence" widget="handle"/>
                <field name="item_no"/>
                <field name="name"/>
                <field name="unit"/>
                <field name="quantity" sum="總數量"/>
                <field name="contract_unit_price"/>
                <field name="contract_amount" sum="契約總金額"/>
                <field name="suggested_unit_price"/>
                <field name="suggested_amount" sum="建議總金額"/>
                <field name="price_variance_amount" sum="差異總額"/>
                <field name="price_variance_pct"/>
                <field name="price_variance_level" invisible="1"/>
                <field name="has_suggestion"/>
                <field name="is_summary_item"/>
            </list>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- Cost Analysis List View                    -->
    <!-- ========================================== -->
    <record id="view_cost_analysis_tree" model="ir.ui.view">
        <field name="name">cost.analysis.tree</field>
        <field name="model">cost.analysis</field>
        <field name="arch" type="xml">
            <list string="成本分析"
                  decoration-muted="state == 'done'"
                  decoration-success="state == 'confirmed'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="import_mode"/>
                <field name="total_budget" sum="招標總計"/>
                <field name="suggested_total" sum="建議總計"/>
                <field name="variance_amount" sum="差異總計"/>
                <field name="variance_percent"/>
                <field name="line_count"/>
                <field name="matched_line_count"/>
                <field name="match_rate"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- Cost Analysis Form View                    -->
    <!-- ========================================== -->
    <record id="view_cost_analysis_form" model="ir.ui.view">
        <field name="name">cost.analysis.form</field>
        <field name="model">cost.analysis</field>
        <field name="arch" type="xml">
            <form string="成本分析">
                <header>
                    <button name="action_load_from_project"
                            string="載入工項"
                            type="object"
                            invisible="import_mode != 'project' or not source_project_id or state != 'draft'"/>
                    <button name="action_parse_xml"
                            string="解析 XML"
                            type="object"
                            invisible="import_mode != 'xml' or not xml_file or state != 'draft'"/>
                    <button name="action_import_suggested_prices"
                            string="導入價格庫"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm"
                            string="確認"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_done"
                            string="完成"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <button name="action_reset_to_draft"
                            string="重設為草稿"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="成本分析名稱..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="import_mode"/>
                            <field name="source_project_id"
                                   invisible="import_mode != 'project'"/>
                            <field name="xml_file"
                                   widget="binary"
                                   filename="xml_filename"
                                   string="匯入 XML 檔案"
                                   invisible="import_mode != 'xml'"/>
                            <field name="xml_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_budget" widget="monetary"/>
                            <field name="suggested_total" widget="monetary"/>
                            <field name="variance_amount" widget="monetary"/>
                            <field name="variance_percent"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="line_count"/>
                            <field name="matched_line_count"/>
                        </group>
                        <group>
                            <field name="match_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="預算明細" name="lines">
                            <field name="line_ids" context="{'tree_view_ref': 'construction_cost_analysis.view_cost_analysis_line_tree'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_no"/>
                                    <field name="name"/>
                                    <field name="unit"/>
                                    <field name="quantity"/>
                                    <field name="contract_unit_price"/>
                                    <field name="contract_amount"/>
                                    <field name="library_item_id"
                                           domain="[('company_id', '=', parent.company_id)]"/>
                                    <field name="suggested_unit_price"/>
                                    <field name="suggested_amount"/>
                                    <field name="price_variance_pct"/>
                                    <field name="has_suggestion"/>
                                    <field name="is_summary_item"/>
                                </list>
                            </field>
                        </page>
                        <!-- 統計分析頁籤已移除 -->
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- Cost Analysis Search View                  -->
    <!-- ========================================== -->
    <record id="view_cost_analysis_search" model="ir.ui.view">
        <field name="name">cost.analysis.search</field>
        <field name="model">cost.analysis</field>
        <field name="arch" type="xml">
            <search string="搜尋成本分析">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="草稿" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="已確認" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="已完成" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="從專案匯入" name="filter_from_project" domain="[('import_mode', '=', 'project')]"/>
                <filter string="從 XML 匯入" name="filter_from_xml" domain="[('import_mode', '=', 'xml')]"/>
                <group expand="0" string="分組">
                    <filter string="工程案件" name="group_project" context="{'group_by': 'source_project_id'}"/>
                    <filter string="狀態" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="匯入模式" name="group_by_import_mode" context="{'group_by': 'import_mode'}"/>
                    <filter string="公司" name="group_by_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- Cost Analysis Action                       -->
    <!-- ========================================== -->
    <record id="action_cost_analysis" model="ir.actions.act_window">
        <field name="name">成本分析</field>
        <field name="res_model">cost.analysis</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cost_analysis_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立新的成本分析
            </p>
            <p>
                成本分析可幫助您：<br/>
                • 從既有專案或 XML 標單匯入工項<br/>
                • 自動比對價格庫，計算差異百分比<br/>
                • 5 級差異警示<br/>
                • 計算總預算估價
            </p>
        </field>
    </record>

</odoo>
