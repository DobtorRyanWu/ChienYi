    Security configuration for Construction Progress module.
    Uses groups defined in construction_supervision_base module.
-->
<odoo>
    <data noupdate="1">

        <!-- ===================================================================
             Record Rules - Multi-Company Isolation for Progress Schedule
             =================================================================== -->

        <!-- Progress Schedule: Supervision can manage all schedules -->

        <!-- Progress Schedule: Contractor can only view -->

        <!-- Progress Schedule: Admin full access -->
        <record id="rule_progress_schedule_admin" model="ir.rule">
            <field name="name">進度表: 管理者完整存取</field>
            <field name="model_id" ref="model_progress_schedule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <!-- Progress Schedule Line: Supervision full access -->

        <!-- Progress Schedule Line: Contractor can only view -->

        <!-- Progress Schedule Line: Admin full access -->
        <record id="rule_progress_schedule_line_admin" model="ir.rule">
            <field name="name">進度表明細: 管理者完整存取</field>
            <field name="model_id" ref="model_progress_schedule_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
    <data>
        <!-- 掛在工程底下的業務資料：前台成員制可見性（2026-11-04 補）。原本前台讀得到、卻沒有任何前台規則，非成員經 RPC 讀得到別案（第四輪審查實測估驗單、契約變更、工程資料夾）。寫法同照片、缺失、日誌：所有前台帳號只看參與的工程，老闆另加公司範圍。回歸：construction_portal/tests/test_portal_orm_readonly.py 的 D 段 -->
        <record id="progress_schedule_portal_member_rule" model="ir.rule">
            <field name="name">Portal: 進度表 - 成員專案讀取（預設）</field>
            <field name="model_id" ref="model_progress_schedule"/>
            <field name="domain_force">[('project_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="progress_schedule_portal_boss_rule" model="ir.rule">
            <field name="name">Portal老闆: 進度表 - 公司範圍</field>
            <field name="model_id" ref="model_progress_schedule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="progress_schedule_line_portal_member_rule" model="ir.rule">
            <field name="name">Portal: 進度表區間 - 成員專案讀取（預設）</field>
            <field name="model_id" ref="model_progress_schedule_line"/>
            <field name="domain_force">[('project_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="progress_schedule_line_portal_boss_rule" model="ir.rule">
            <field name="name">Portal老闆: 進度表區間 - 公司範圍</field>
            <field name="model_id" ref="model_progress_schedule_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
