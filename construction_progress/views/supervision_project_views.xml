<odoo>

    <!-- ===================================================================
         Extend Supervision Project Form View
         =================================================================== -->

    <record id="view_supervision_project_form_progress" model="ir.ui.view">
        <field name="name">supervision.project.form.progress</field>
        <field name="model">supervision.project</field>
        <field name="inherit_id" ref="construction_supervision_base.view_supervision_project_form"/>
        <field name="arch" type="xml">
            <!-- 進度表 smart button（含初始化狀態圖示 + 數量）-->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_schedules" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <i class="fa fa-circle-o text-muted" title="待設定"
                               invisible="init_schedule_status != 'pending' or state != 'draft'"/>
                            <i class="fa fa-check-circle text-success" title="已完成"
                               invisible="init_schedule_status != 'done' or state != 'draft'"/>
                            <i class="fa fa-minus-circle text-muted" title="不適用"
                               invisible="init_schedule_status != 'not_required' or state != 'draft'"/>
                            <field name="schedule_count"/>
                        </span>
                        <span class="o_stat_text">進度表</span>
                    </div>
                </button>
            </xpath>

            <!-- Add schedule progress info before notebook -->
            <xpath expr="//notebook" position="before">
                <group invisible="not active_schedule_id">
                    <group string="進度表進度">
                        <!-- 1. 本日預定進度 -->
                        <field name="daily_planned_progress" string="本日預定進度(%)"/>
                        
                        <!-- 2. 本日實際進度 -->
                        <field name="daily_actual_progress" string="本日實際進度(%)"/>
                        
                        <!-- 3. 累計預定進度 -->
                        <field name="schedule_cumulative_planned" string="累計預定進度(%)"/>
                        
                        <!-- 4. 累計實際進度 -->
                        <field name="schedule_cumulative_actual" string="累計實際進度(%)"/>
                        
                        <!-- 5. 進度差異 -->
                        <field name="schedule_variance" string="進度差異(%)"/>
                        
                        <field name="active_schedule_id" readonly="1"
                               options="{'no_open': False}"/>
                    </group>
                </group>
            </xpath>

            <!-- 進度表頁籤已移除（頁籤用不到，Smart Button 保留）-->
        </field>
    </record>

    <!-- ===================================================================
         Extend Supervision Project Tree View
         =================================================================== -->

    <record id="view_supervision_project_tree_progress" model="ir.ui.view">
        <field name="name">supervision.project.tree.progress</field>
        <field name="model">supervision.project</field>
        <field name="inherit_id" ref="construction_supervision_base.view_supervision_project_tree"/>
        <field name="arch" type="xml">
            <!-- Add schedule progress columns (optional) -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="schedule_variance" string="進度表差異" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================================
         Extend Supervision Project Search View
         =================================================================== -->

    <record id="view_supervision_project_search_progress" model="ir.ui.view">
        <field name="name">supervision.project.search.progress</field>
        <field name="model">supervision.project</field>
        <field name="inherit_id" ref="construction_supervision_base.view_supervision_project_search"/>
        <field name="arch" type="xml">
            <!-- Add schedule filters -->
            <xpath expr="//filter[@name='my_projects']" position="before">
                <filter string="有使用中進度表" name="has_schedule"
                        domain="[('active_schedule_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
