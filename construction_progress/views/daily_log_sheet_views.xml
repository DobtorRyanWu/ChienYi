<odoo>

    <!-- ===================================================================
         Extend Daily Log Sheet Form View - Add Progress Status Tab
         =================================================================== -->

    <record id="view_daily_log_sheet_form_inherit_progress" model="ir.ui.view">
        <field name="name">daily.log.sheet.form.inherit.progress</field>
        <field name="model">daily.log.sheet</field>
        <field name="inherit_id" ref="construction_daily_log.daily_log_sheet_view_form"/>
        <field name="arch" type="xml">
            <!-- 在 notebook 中加入進度狀況頁籤 -->
            <xpath expr="//page[@name='daily_log_lines']" position="before">
                <page string="進度狀況" name="progress_status">
                    <group>
                        <group name="progress_info">
                            <!-- 隱藏的輔助欄位 -->
                            <field name="active_progress_schedule_id" invisible="1"/>
                            <field name="progress_line_id" invisible="1"/>
                            
                            <!-- 進度資訊 -->
                            <!-- 2026-11-27：變更那天（某一版進度表的變更日期）預定那一格改叫「原定本日預定進度」
                                 （換版前那一版原本預定這一天的量），下面多兩格變更後的累計；一般日子照舊 -->
                            <field name="daily_planned_progress"
                                string="本日預定進度(%)"
                                readonly="1"
                                invisible="has_progress_change"/>
                            <field name="daily_planned_progress"
                                string="原定本日預定進度(%)"
                                readonly="1"
                                invisible="not has_progress_change"
                                help="換版前的進度表，原本預定這一天要做多少（只算這一天）。"/>
                            <field name="daily_actual_progress"
                                string="本日實際進度(%)"
                                readonly="state != 'draft'"/>
                            <field name="daily_progress_reference"
                                string="參考值 (%)"
                                readonly="1"
                                digits="[10, 4]"/>

                            <!-- 有無進度變更：照進度表的變更日期自動勾，不能手動改 -->
                            <field name="has_progress_change"
                                string="有無進度變更"
                                readonly="1"/>

                            <!-- 變更那天：變更後的累計預定／實際（跟進度圖同一套算法） -->
                            <field name="change_cumulative_planned"
                                string="變更後累計預定進度(%)"
                                invisible="not has_progress_change"/>
                            <field name="change_cumulative_actual"
                                string="變更後累計實際進度(%)"
                                invisible="not has_progress_change"/>
                        </group>
                    </group>
                    
                    <!-- 操作按鈕 -->
                    <group>
                        <group>
                            <button name="action_view_progress_schedule"
                                string="查看進度表"
                                type="object"
                                class="btn-secondary"
                                icon="fa-line-chart"
                                invisible="not active_progress_schedule_id and not has_progress_change"/>
                        </group>
                    </group>
                    
                    <!-- 提示訊息 -->
                    <div class="alert alert-info" role="alert" 
                        invisible="active_progress_schedule_id">
                        <strong>提示：</strong> 該工程沒有使用中的進度表，本日預定進度以 0 計；
                        需要預定進度時，再到「進度管理 > 進度表」建立並啟用。
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
