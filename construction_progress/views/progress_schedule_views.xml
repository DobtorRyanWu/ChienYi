<odoo>

    <!-- ===================================================================
         Progress Schedule Views
         =================================================================== -->

    <!-- Form View -->
    <record id="view_progress_schedule_form" model="ir.ui.view">
        <field name="name">progress.schedule.form</field>
        <field name="model">progress.schedule</field>
        <field name="arch" type="xml">
            <form string="進度表">
                <header>
                    <!-- 狀態動作按鈕 -->
                    <button name="action_generate_lines" type="object"
                            string="產生進度區間" class="btn-primary"
                            invisible="state != 'draft' or calculation_mode == 'custom'"
                            confirm="確定要重新產生進度區間嗎？現有所有明細將被清除。"/>
                    <button name="action_extend_lines" type="object"
                            string="補充進度區間" class="btn-primary"
                            invisible="state != 'draft' or not line_ids or calculation_mode == 'custom' or lines_cover_adjusted_end"
                            confirm="確定要補充進度區間嗎？系統將保留現有資料，只補上缺少的部分。"
                            help="保留現有進度資料，依新的調整後完工日期補充缺少的區間"/>
                    <button name="action_add_line" type="object"
                            string="新增區間" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_copy_from_previous_version" type="object"
                            string="從前一版本複製" class="btn-secondary"
                            icon="fa-clone"
                            invisible="state != 'draft' or line_ids"
                            help="複製前一個版本的進度明細"/>
                    <button name="action_sync_all_lines_from_daily_log" type="object"
                            string="從日誌同步進度" class="btn-secondary"
                            invisible="state == 'archived'"
                            icon="fa-refresh"/>
                    <button name="action_activate" type="object"
                            string="啟用" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_archive" type="object"
                            string="歸檔" class="btn-secondary"
                            invisible="state != 'active'"/>
                    <button name="action_reset_draft" type="object"
                            string="重設草稿"
                            invisible="state not in ('active', 'archived')"/>
                    <button name="action_create_new_version" type="object"
                            string="建立新版本" class="btn-secondary"
                            invisible="state != 'active'"
                            icon="fa-copy"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <!-- 進度狀態標籤 -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="進度區間"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="使用中"
                            invisible="state != 'active'"
                            bg_color="bg-success"/>
                    <widget name="web_ribbon" title="已歸檔"
                            invisible="state != 'archived'"
                            bg_color="bg-secondary"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="基本資訊">
                            <field name="project_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="version" readonly="1"/>
                            <field name="change_date"
                                   readonly="state != 'draft'"/>
                            <field name="calculation_mode"
                                   readonly="state != 'draft'"/>
                            <!-- 周期對齊方式（自訂模式不顯示） -->
                            <field name="week_alignment_mode"
                                   widget="radio"
                                   readonly="state != 'draft'"
                                   invisible="calculation_mode == 'custom'"/>
                            <!-- 說明文字（自訂模式不顯示） -->
                            <div class="text-muted" style="font-size:0.85em; grid-column: 1 / -1; padding: 0 8px 4px 8px;"
                                 invisible="calculation_mode == 'custom'">
                                ● 工期起算制：以開工日為準，每 7/14 天固定循環。<br/>
                                ● 日曆周制：首個區間自動截斷至當週週日，後續區間對齊週一至週日。
                            </div>
                            <field name="company_id" invisible="1"/>
                            <!-- 隱藏欄位：供按鈕 invisible 條件使用 -->
                            <field name="lines_cover_adjusted_end" invisible="1"/>
                        </group>
                        <group string="工期資訊">
                            <field name="start_date"/>
                            <field name="original_end_date"/>
                            <!-- 本次核准展延工期（使用者輸入，草稿可編輯） -->
                            <field name="current_extension"
                                   readonly="state != 'draft'"/>
                            <!-- 累計工期展延（自動計算，唯讀） -->
                            <field name="duration_extension"/>
                            <field name="adjusted_end_date"/>
                            <field name="approved_duration"/>
                            <field name="total_duration"/>
                        </group>
                    </group>
                    
                    <group string="契約變更資訊（可選）" invisible="not related_change_order_ids and state == 'draft'">
                        <field name="related_change_order_ids" widget="many2many_tags"
                               domain="[('project_id', '=', project_id)]"
                               readonly="state != 'draft'"
                               help="【可選功能】選擇此版本進度表對應處理的契約變更單。進度表變更原因不限於契約變更，也可能是設計變更、施工方法調整等。"/>
                    </group>

                    <!-- 目前進度摘要 -->
                    <group string="目前進度摘要" invisible="not line_ids">
                        <group>
                            <field name="current_cumulative_planned"/>
                            <field name="current_cumulative_actual"/>
                        </group>
                        <group>
                            <field name="current_variance"/>
                            <field name="current_variance_status" widget="badge"
                                   decoration-success="current_variance_status == 'ahead'"
                                   decoration-warning="current_variance_status == 'on_track'"
                                   decoration-danger="current_variance_status == 'delayed'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="進度明細" name="lines">
                            <field name="line_ids" nolabel="1"
                                   context="{'default_schedule_id': id}">
                                <list string="進度明細" editable="bottom"
                                      decoration-success="variance_status == 'ahead'"
                                      decoration-warning="variance_status == 'on_track'"
                                      decoration-danger="variance_status == 'delayed'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="period_display" string="期間" readonly="1"
                                           column_invisible="parent.calculation_mode == 'custom'"/>
                                    <field name="date_start" string="開始日期"
                                           readonly="parent.state != 'draft'"
                                           column_invisible="parent.calculation_mode != 'custom'"/>
                                    <field name="date_end" string="結束日期"
                                           readonly="parent.state != 'draft'"
                                           column_invisible="parent.calculation_mode != 'custom'"/>
                                    <field name="period_days" string="天數" readonly="1"/>
                                    <field name="planned_progress"
                                           readonly="parent.state != 'draft'"
                                           sum="預定進度合計"/>
                                    <field name="cumulative_planned" readonly="1"/>
                                    <field name="actual_progress"
                                           readonly="1"
                                           sum="實際進度合計"/>
                                    <field name="cumulative_actual" readonly="1"/>
                                    <field name="variance" string="超前(+)/落後(-)" readonly="1"/>
                                    <field name="variance_status" string="進度狀態" widget="badge"
                                           decoration-success="variance_status == 'ahead'"
                                           decoration-warning="variance_status == 'on_track'"
                                           decoration-danger="variance_status == 'delayed'"/>
                                    <field name="synced_from_log" readonly="1" widget="boolean"/>
                                    <field name="notes"/>
                                    <field name="schedule_state" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="變更說明" name="change_info"
                              invisible="version == 1">
                            <group>
                                <field name="change_reason"
                                       readonly="state != 'draft'"
                                       placeholder="請說明本版本進度表的變更原因..."/>
                            </group>
                        </page>
                        <page string="計畫基準校正" name="plan_correction"
                              invisible="version == 1">
                            <div class="alert alert-warning" role="alert"
                                 invisible="not needs_plan_correction">
                                <strong>⚠️ 計畫倒退校正模式</strong>：此版本進度表包含負值過渡區間，用於修正因契約展延後新版計畫基準低於舊版的情況。
                                啟用後，過渡區間的「預定進度」可為負數，累計曲線將從校正後目標重新計算。
                            </div>
                            <group string="校正設定">
                                <group>
                                    <field name="needs_plan_correction"
                                           readonly="state != 'draft'"/>
                                    <field name="correction_date"
                                           readonly="state != 'draft'"
                                           invisible="not needs_plan_correction"
                                           required="needs_plan_correction"/>
                                    <field name="correction_target_cumulative"
                                           readonly="state != 'draft'"
                                           invisible="not needs_plan_correction"
                                           required="needs_plan_correction"/>
                                </group>
                                <group invisible="not needs_plan_correction">
                                    <field name="correction_period_start"/>
                                    <field name="correction_period_end"/>
                                    <field name="correction_pre_cumulative"/>
                                    <field name="plan_correction_offset"
                                           widget="float"
                                           decoration-danger="plan_correction_offset &lt; 0"/>
                                </group>
                            </group>
                            <div invisible="not needs_plan_correction or not correction_period_start">
                                <button name="action_apply_correction" type="object"
                                        string="套用校正至過渡區間" class="btn-warning"
                                        invisible="state != 'draft'"
                                        confirm="確定要套用校正？系統將把過渡區間切割為子區間（基準日前 / 基準日當天 / 基準日後），並將基準日之後的所有區間預定進度歸零。此操作不可還原。"/>
                            </div>
                        </page>
                        <page string="備註" name="notes">
                            <field name="notes"
                                   readonly="state == 'archived'"
                                   placeholder="其他備註說明..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_progress_schedule_tree" model="ir.ui.view">
        <field name="name">progress.schedule.tree</field>
        <field name="model">progress.schedule</field>
        <field name="arch" type="xml">
            <list string="進度表"
                  decoration-success="current_variance_status == 'ahead'"
                  decoration-warning="current_variance_status == 'on_track'"
                  decoration-danger="current_variance_status == 'delayed'"
                  decoration-muted="state == 'archived'">
                
                <!-- 1. 所屬工程 -->
                <field name="project_id"/>
                
                <!-- 2. 進度表版本 -->
                <field name="version"/>
                
                <!-- 3. 計算模式 -->
                <field name="calculation_mode"/>
                
                <!-- 4. 本周日期 -->
                <field name="current_week_period" string="本周日期"/>
                
                <!-- 5. 本周預定進度 -->
                <field name="current_week_planned" string="本周預定進度(%)"/>
                
                <!-- 6. 累計預定進度 -->
                <field name="current_cumulative_planned" string="累計預定進度(%)"/>
                
                <!-- 7. 本周實際進度 -->
                <field name="current_week_actual" string="本周實際進度(%)"/>
                
                <!-- 8. 累計實際進度 -->
                <field name="current_cumulative_actual" string="累計實際進度(%)"/>
                
                <!-- 9. 進度差(+/-) -->
                <field name="current_variance" string="進度差(+/-)(%)"/>
                
                <!-- 10. 進度表狀態（使用中/已歸檔） -->
                <field name="state" string="進度表狀態" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'archived'"/>
                
                <!-- 11. 變更日期 -->
                <field name="change_date"/>
                
                <!-- 隱藏欄位：用於裝飾判斷 -->
                <field name="current_variance_status" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_progress_schedule_search" model="ir.ui.view">
        <field name="name">progress.schedule.search</field>
        <field name="model">progress.schedule</field>
        <field name="arch" type="xml">
            <search string="搜尋進度表">
                <field name="name"/>
                <field name="project_id"/>
                <field name="version"/>
                <separator/>
                <filter string="使用中" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="草稿" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="已歸檔" name="filter_archived"
                        domain="[('state', '=', 'archived')]"/>
                <separator/>
                <filter string="超前" name="filter_ahead"
                        domain="[('current_variance_status', '=', 'ahead')]"/>
                <filter string="正常" name="filter_on_track"
                        domain="[('current_variance_status', '=', 'on_track')]"/>
                <filter string="落後" name="filter_delayed"
                        domain="[('current_variance_status', '=', 'delayed')]"/>
                <separator/>
                <filter string="每周" name="filter_weekly"
                        domain="[('calculation_mode', '=', 'weekly')]"/>
                <filter string="每兩周" name="filter_biweekly"
                        domain="[('calculation_mode', '=', 'biweekly')]"/>
                <filter string="自訂" name="filter_custom"
                        domain="[('calculation_mode', '=', 'custom')]"/>
                <separator/>
                <group expand="0" string="分組">
                    <filter string="工程" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="狀態" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="進度狀態" name="group_variance_status"
                            context="{'group_by': 'current_variance_status'}"/>
                    <filter string="計算模式" name="group_mode"
                            context="{'group_by': 'calculation_mode'}"/>
                    <filter string="變更月份" name="group_change_month"
                            context="{'group_by': 'change_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================
         Progress Schedule Line Views
         =================================================================== -->

    <!-- Line Form View -->
    <record id="view_progress_schedule_line_form" model="ir.ui.view">
        <field name="name">progress.schedule.line.form</field>
        <field name="model">progress.schedule.line</field>
        <field name="arch" type="xml">
            <form string="進度表明細">
                <sheet>
                    <group>
                        <group string="時間區間">
                            <field name="schedule_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="project_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="period_display" readonly="1"/>
                            <field name="period_days" readonly="1"/>
                        </group>
                        <group string="進度資料">
                            <field name="planned_progress"/>
                            <field name="cumulative_planned" readonly="1"/>
                            <field name="actual_progress"/>
                            <field name="cumulative_actual" readonly="1"/>
                            <field name="variance" readonly="1"/>
                            <field name="variance_status" readonly="1" widget="badge"
                                   decoration-success="variance_status == 'ahead'"
                                   decoration-warning="variance_status == 'on_track'"
                                   decoration-danger="variance_status == 'delayed'"/>
                        </group>
                    </group>
                    <group string="同步資訊">
                        <group>
                            <field name="synced_from_log" readonly="1"/>
                            <field name="last_sync_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="備註">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <field name="schedule_state" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Line Tree View -->
    <record id="view_progress_schedule_line_tree" model="ir.ui.view">
        <field name="name">progress.schedule.line.tree</field>
        <field name="model">progress.schedule.line</field>
        <field name="arch" type="xml">
            <list string="進度表明細"
                  decoration-success="variance_status == 'ahead'"
                  decoration-warning="variance_status == 'on_track'"
                  decoration-danger="variance_status == 'delayed'">
                <field name="schedule_id"/>
                <field name="sequence"/>
                <field name="period_display" string="期間"/>
                <field name="period_days" string="天數"/>
                <field name="planned_progress" sum="預定進度合計"/>
                <field name="cumulative_planned"/>
                <field name="actual_progress" sum="實際進度合計"/>
                <field name="cumulative_actual"/>
                <field name="variance"/>
                <field name="variance_status" widget="badge"
                       decoration-success="variance_status == 'ahead'"
                       decoration-warning="variance_status == 'on_track'"
                       decoration-danger="variance_status == 'delayed'"/>
                <field name="synced_from_log" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Line Search View -->
    <record id="view_progress_schedule_line_search" model="ir.ui.view">
        <field name="name">progress.schedule.line.search</field>
        <field name="model">progress.schedule.line</field>
        <field name="arch" type="xml">
            <search string="搜尋進度明細">
                <field name="schedule_id" string="進度表"/>
                <field name="project_id" string="所屬工程"/>
                <field name="date_start"/>
                <field name="date_end"/>
                
                <separator/>
                
                <!-- 預設篩選：啟用中的進度表 -->
                <filter string="啟用中的進度表" name="filter_active_schedule"
                        domain="[('schedule_state', '=', 'active')]"
                        help="只顯示使用中進度表的明細"/>
                
                <!-- 新增篩選：最新版本 -->
                <filter string="最新版本" name="filter_latest_version"
                        domain="[('schedule_is_latest', '=', True)]"
                        help="只顯示各工程最新版本進度表的明細（不論狀態）"/>
                
                <separator/>
                
                <filter string="草稿狀態" name="filter_draft"
                        domain="[('schedule_state', '=', 'draft')]"/>
                <filter string="已歸檔" name="filter_archived"
                        domain="[('schedule_state', '=', 'archived')]"/>
                
                <separator/>
                
                <filter string="超前" name="filter_ahead"
                        domain="[('variance_status', '=', 'ahead')]"/>
                <filter string="正常" name="filter_on_track"
                        domain="[('variance_status', '=', 'on_track')]"/>
                <filter string="落後" name="filter_delayed"
                        domain="[('variance_status', '=', 'delayed')]"/>
                
                <separator/>
                
                <filter string="已同步" name="filter_synced"
                        domain="[('synced_from_log', '=', True)]"/>
                <filter string="未同步" name="filter_not_synced"
                        domain="[('synced_from_log', '=', False)]"/>
                
                <separator/>
                
                <!-- 分組 -->
                <group expand="1" string="分組">
                    <filter string="所屬工程" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="進度表版本" name="group_schedule"
                            context="{'group_by': 'schedule_id'}"/>
                    <filter string="進度狀態" name="group_variance_status"
                            context="{'group_by': 'variance_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================
         Actions
         =================================================================== -->

    <record id="action_progress_schedule" model="ir.actions.act_window">
        <field name="name">進度表</field>
        <field name="res_model">progress.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_progress_schedule_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立您的第一個進度表
            </p>
            <p>
                進度表用於追蹤工程的預定進度與實際進度。
                您可以選擇每周、每兩周或自訂的計算模式。
            </p>
        </field>
    </record>

    <record id="action_progress_schedule_line" model="ir.actions.act_window">
        <field name="name">進度明細</field>
        <field name="res_model">progress.schedule.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_progress_schedule_line_search"/>
        <field name="context">{
            'search_default_group_project': 1,
            'search_default_filter_active_schedule': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                尚無進度明細
            </p>
            <p>
                進度明細會在進度表中自動產生或手動新增。
            </p>
        </field>
    </record>

    <!-- ===================================================================
         Client Action: 進度表圖表儀表板
         =================================================================== -->

    <record id="action_progress_chart_dashboard" model="ir.actions.client">
        <field name="name">進度表圖表</field>
        <field name="tag">progress_chart_dashboard</field>
    </record>

</odoo>
