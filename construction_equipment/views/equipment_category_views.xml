<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== -->
    <!-- 機具設備分類視圖      -->
    <!-- ==================== -->

    <!-- Form View -->
    <record id="view_supervision_equipment_category_form" model="ir.ui.view">
        <field name="name">supervision.equipment.category.form</field>
        <field name="model">supervision.equipment.category</field>
        <field name="arch" type="xml">
            <form string="機具設備分類">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_equipment"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cogs">
                            <field name="equipment_count" widget="statinfo" string="設備"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="已封存" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="分類名稱..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="default_technician_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="設備屬性定義" name="properties">
                            <field name="equipment_properties_definition"/>
                        </page>
                        <page string="說明" name="note">
                            <field name="note" placeholder="分類說明..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_supervision_equipment_category_list" model="ir.ui.view">
        <field name="name">supervision.equipment.category.list</field>
        <field name="model">supervision.equipment.category</field>
        <field name="arch" type="xml">
            <list string="機具設備分類">
                <field name="sequence" widget="handle"/>
                <field name="complete_name"/>
                <field name="parent_id" optional="hide"/>
                <field name="equipment_count"/>
                <field name="default_technician_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_supervision_equipment_category_kanban" model="ir.ui.view">
        <field name="name">supervision.equipment.category.kanban</field>
        <field name="model">supervision.equipment.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="equipment_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <span class="oe_kanban_bottom_left">
                                        <field name="equipment_count"/> 設備
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_supervision_equipment_category_search" model="ir.ui.view">
        <field name="name">supervision.equipment.category.search</field>
        <field name="model">supervision.equipment.category</field>
        <field name="arch" type="xml">
            <search string="搜尋設備分類">
                <field name="name"/>
                <field name="complete_name"/>
                <field name="default_technician_id"/>
                <filter string="已封存" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="上層分類" name="group_parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_supervision_equipment_category" model="ir.actions.act_window">
        <field name="name">機具設備分類</field>
        <field name="res_model">supervision.equipment.category</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_supervision_equipment_category_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一個機具設備分類
            </p>
            <p>
                機具設備分類用於組織和管理施工設備，支援階層式分類結構。
                您可以為每個分類定義預設屬性和負責技師。
            </p>
        </field>
    </record>

</odoo>
