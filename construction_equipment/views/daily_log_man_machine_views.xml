<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== -->
    <!-- 人機項目主檔視圖      -->
    <!-- ==================== -->

    <!-- Form View -->
    <record id="view_daily_log_man_machine_form" model="ir.ui.view">
        <field name="name">daily.log.man.machine.form</field>
        <field name="model">daily.log.man.machine</field>
        <field name="arch" type="xml">
            <form string="人機項目">
                <sheet>
                    <group>
                        <group string="基本資訊">
                            <field name="project_id" required="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="record_type" widget="radio" required="1"/>
                        </group>
                    </group>
                    <group string="人員/機具設定">
                        <field name="personnel_type_id"
                               options="{'no_create': True, 'no_create_edit': True}"
                               placeholder="從下拉選單選擇..."/>
                    </group>
                    <group string="使用統計">
                        <group>
                            <field name="total_quantity" readonly="1"/>
                            <field name="total_hours" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="備註..."/>
                    </group>
                    <notebook>
                        <page string="使用明細" name="usage_details">
                            <field name="usage_detail_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="daily_log_id"/>
                                    <field name="quantity"/>
                                    <field name="hours"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_daily_log_man_machine_list" model="ir.ui.view">
        <field name="name">daily.log.man.machine.list</field>
        <field name="model">daily.log.man.machine</field>
        <field name="arch" type="xml">
            <list string="人機項目主檔" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="project_id"/>
                <field name="record_type" column_invisible="context.get('hide_record_type')"/>
                <field name="personnel_type_id"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="unit"/>
                <field name="total_hours" readonly="1"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_daily_log_man_machine_search" model="ir.ui.view">
        <field name="name">daily.log.man.machine.search</field>
        <field name="model">daily.log.man.machine</field>
        <field name="arch" type="xml">
            <search string="搜尋人機項目">
                <field name="project_id"/>
                <field name="personnel_type_id"/>
                <separator/>
                <filter string="人員" name="personnel" domain="[('record_type', '=', 'personnel')]"/>
                <filter string="機具" name="equipment" domain="[('record_type', '=', 'equipment')]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="工程" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="記錄類型" name="group_type" context="{'group_by': 'record_type'}"/>
                    <filter string="人員機具設定" name="group_personnel_type" context="{'group_by': 'personnel_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: 所有人機記錄 -->
    <record id="action_daily_log_man_machine" model="ir.actions.act_window">
        <field name="name">人機項目</field>
        <field name="res_model">daily.log.man.machine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_daily_log_man_machine_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一個人機項目
            </p>
            <p>
                在此建立工程的人員與機具項目。<br/>
                之後在施工日誌中可以選擇這些項目來登記每日使用量。
            </p>
        </field>
    </record>

    <!-- Action: 人員出工統計 -->
    <record id="action_daily_log_man_machine_personnel" model="ir.actions.act_window">
        <field name="name">人員出工統計</field>
        <field name="res_model">daily.log.man.machine</field>
        <field name="view_mode">list</field>
        <field name="domain">[('record_type', '=', 'personnel')]</field>
        <field name="context">{
            'search_default_group_project': 1,
            'search_default_personnel': 1,
            'hide_record_type': True
        }</field>
        <field name="search_view_id" ref="view_daily_log_man_machine_search"/>
    </record>

    <!-- Action: 機具使用統計 -->
    <record id="action_daily_log_man_machine_equipment" model="ir.actions.act_window">
        <field name="name">機具使用統計</field>
        <field name="res_model">daily.log.man.machine</field>
        <field name="view_mode">list</field>
        <field name="domain">[('record_type', '=', 'equipment')]</field>
        <field name="context">{
            'search_default_group_project': 1,
            'search_default_equipment': 1,
            'hide_record_type': True
        }</field>
        <field name="search_view_id" ref="view_daily_log_man_machine_search"/>
    </record>

</odoo>
