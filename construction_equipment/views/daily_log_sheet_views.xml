<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== -->
    <!-- 施工日誌表單擴展      -->
    <!-- ==================== -->

    <!-- 擴展施工日誌表單，加入人機使用頁籤 -->
    <record id="view_daily_log_sheet_form_inherit_man_machine" model="ir.ui.view">
        <field name="name">daily.log.sheet.form.inherit.man.machine</field>
        <field name="model">daily.log.sheet</field>
        <field name="inherit_id" ref="construction_daily_log.daily_log_sheet_view_form"/>
        <field name="arch" type="xml">
            <!-- 在 notebook 中加入人機使用頁籤 -->
            <xpath expr="//page[@name='material_management']" position="after">
                <page string="人機使用" name="man_machine_usage">
                    <!-- 批次新增按鈕 -->
                    <div class="mb-2"
                         invisible="is_locked and not is_unlocked">
                        <button name="action_add_man_machine_wizard"
                                type="object"
                                string="批次新增"
                                class="btn-primary"
                                icon="fa-plus"/>
                    </div>
                    <!-- 直接內嵌 List View -->
                    <field name="man_machine_detail_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="personnel_type_id" required="1"/>
                            <field name="record_type" column_invisible="1"/>
                            <field name="quantity"/>
                            <field name="hours" required="1"/>
                            <field name="employee_name" optional="show"/>
                            <!-- 機具設備填自由文字，不用關聯欄位。
                                 2026-08-10 決議關閉「工程管理 > 人機管理 > 機具設備」選單
                                 （見 construction_menu_profile），設備主檔沒有維護入口，
                                 關聯的 equipment_id 會挑不到任何資料。
                                 模型欄位 equipment_id 保留不刪，只是不顯示。 -->
                            <field name="specific_equipment_name" optional="show"
                                   invisible="record_type != 'equipment'"/>
                            <field name="note" optional="hide"/>
                        </list>
                    </field>
                    <!-- 統計資訊 -->
                    <group>
                        <group>
                            <label for="total_man_machine_hours"/>
                            <div class="o_row">
                                <field name="total_man_machine_hours" readonly="1"/>
                                <span>小時</span>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
