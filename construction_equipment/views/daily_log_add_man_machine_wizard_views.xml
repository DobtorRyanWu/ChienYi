<odoo>

    <!-- ===================================================================
         批次新增人機使用 Wizard
         =================================================================== -->

    <record id="daily_log_add_man_machine_wizard_form" model="ir.ui.view">
        <field name="name">daily.log.add.man.machine.wizard.form</field>
        <field name="model">daily.log.add.man.machine.wizard</field>
        <field name="arch" type="xml">
            <form string="批次新增人機使用">
                <!-- 基本資訊 -->
                <group>
                    <group>
                        <field name="sheet_id" invisible="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="log_date" readonly="1"/>
                    </group>
                </group>

                <notebook>
                    <!-- Tab 1：選擇人員/機具（Many2many，支援原生搜尋更多） -->
                    <page string="選擇人員/機具" name="select_types">
                        <field name="selected_type_ids" nolabel="1"
                               domain="[('active', '=', True)]"
                               options="{'no_create': True, 'no_open': True}">
                            <list>
                                <field name="record_type" string="類型"
                                       decoration-info="record_type == 'personnel'"
                                       decoration-warning="record_type == 'equipment'"/>
                                <field name="name" string="名稱"/>
                                <field name="sequence" column_invisible="1"/>
                            </list>
                        </field>
                    </page>

                    <!-- Tab 2：設定數量與時數 -->
                    <page string="數量與時數" name="qty_hours">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom" create="false" delete="false">
                                <field name="personnel_type_id" string="名稱"
                                       decoration-info="record_type == 'personnel'"
                                       decoration-warning="record_type == 'equipment'"/>
                                <field name="record_type" string="類型" readonly="1" width="60px"/>
                                <field name="quantity" string="數量"/>
                                <field name="hours" string="時數（小時）"/>
                                <field name="sequence" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <!-- 底部按鈕 -->
                <footer>
                    <button string="新增" type="object"
                            name="action_add_selected"
                            class="btn-primary"
                            invisible="not selected_type_ids"/>
                    <button string="關閉" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
