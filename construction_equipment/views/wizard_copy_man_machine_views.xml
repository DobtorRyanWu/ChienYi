<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== -->
    <!-- 人機項目複製精靈視圖  -->
    <!-- ==================== -->

    <!-- Wizard Form View -->
    <record id="view_man_machine_copy_wizard_form" model="ir.ui.view">
        <field name="name">daily.log.man.machine.copy.wizard.form</field>
        <field name="model">daily.log.man.machine.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="複製人機項目到其他工程">
                <group>
                    <group>
                        <field name="target_project_id" 
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <label for="source_count" string="選中記錄"/>
                        <div>
                            <field name="source_count" class="oe_inline"/> 筆
                        </div>
                    </group>
                </group>
                
                <separator string="調整各項目單價"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="source_name" readonly="1"/>
                        <field name="original_price" readonly="1"/>
                        <field name="adjust_mode" widget="radio"/>
                        <field name="adjust_value" 
                               invisible="adjust_mode == 'keep'"
                               required="adjust_mode != 'keep'"
                               placeholder="+100/-50 或 +10/-15"/>
                        <field name="new_price"/>
                        <field name="source_id" column_invisible="1"/>
                    </list>
                </field>

                <footer>
                    <button string="確認複製" 
                            type="object" 
                            name="action_copy" 
                            class="btn-primary"/>
                    <button string="取消" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_man_machine_copy_wizard" model="ir.actions.act_window">
        <field name="name">複製到其他工程</field>
        <field name="res_model">daily.log.man.machine.copy.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_daily_log_man_machine"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
