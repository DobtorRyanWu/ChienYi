<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== -->
    <!-- 維護請求階段視圖      -->
    <!-- ==================== -->

    <!-- Stage Form View -->
    <record id="view_supervision_equipment_request_stage_form" model="ir.ui.view">
        <field name="name">supervision.equipment.request.stage.form</field>
        <field name="model">supervision.equipment.request.stage</field>
        <field name="arch" type="xml">
            <form string="維護請求階段">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="fold"/>
                            <field name="done"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stage List View -->
    <record id="view_supervision_equipment_request_stage_list" model="ir.ui.view">
        <field name="name">supervision.equipment.request.stage.list</field>
        <field name="model">supervision.equipment.request.stage</field>
        <field name="arch" type="xml">
            <list string="維護請求階段" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="done"/>
                <field name="request_count"/>
            </list>
        </field>
    </record>

    <!-- Stage Action -->
    <record id="action_supervision_equipment_request_stage" model="ir.actions.act_window">
        <field name="name">維護請求階段</field>
        <field name="res_model">supervision.equipment.request.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== -->
    <!-- 維護請求視圖          -->
    <!-- ==================== -->

    <!-- Form View -->
    <record id="view_supervision_equipment_request_form" model="ir.ui.view">
        <field name="name">supervision.equipment.request.form</field>
        <field name="model">supervision.equipment.request</field>
        <field name="arch" type="xml">
            <form string="設備維護請求">
                <header>
                    <button name="action_mark_done"
                            string="標記完成"
                            type="object"
                            class="btn-primary"
                            invisible="stage_id.done"/>
                    <button name="action_assign_to_me"
                            string="指派給我"
                            type="object"
                            invisible="user_id"/>
                    <button name="action_send_notification"
                            string="發送通知"
                            type="object"
                            invisible="not user_id"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="維護主題..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="設備資訊">
                            <field name="equipment_id"/>
                            <field name="category_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                        </group>
                        <group string="維護類型">
                            <field name="maintenance_type" widget="radio"/>
                            <field name="priority" widget="priority"/>
                            <field name="kanban_state" widget="label_selection"
                                   options="{'classes': {'normal': 'secondary', 'blocked': 'danger', 'done': 'success'}}"/>
                        </group>
                    </group>
                    <group>
                        <group string="排程">
                            <field name="request_date"/>
                            <field name="schedule_date"/>
                            <field name="close_date" readonly="1"/>
                            <field name="duration"/>
                            <field name="actual_duration"/>
                        </group>
                        <group string="指派">
                            <field name="user_id"/>
                            <field name="owner_user_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="問題描述" name="description">
                            <field name="description" placeholder="詳細描述問題或維護需求..."/>
                        </page>
                        <page string="診斷與維修" name="repair">
                            <group>
                                <group>
                                    <label for="diagnosis"/>
                                </group>
                            </group>
                            <field name="diagnosis" placeholder="診斷結果..."/>
                            <separator string="維修記錄"/>
                            <field name="repair_notes" placeholder="維修過程與結果..."/>
                        </page>
                        <page string="循環維護" name="recurring"
                              invisible="maintenance_type != 'preventive'">
                            <group>
                                <group>
                                    <field name="recurring_maintenance"/>
                                    <label for="repeat_interval" invisible="not recurring_maintenance"/>
                                    <div class="o_row" invisible="not recurring_maintenance">
                                        每 <field name="repeat_interval" nolabel="1" class="oe_inline"/>
                                        <field name="repeat_unit" nolabel="1" class="oe_inline"/>
                                    </div>
                                    <field name="repeat_until" invisible="not recurring_maintenance"/>
                                </group>
                            </group>
                        </page>
                        <page string="費用" name="cost">
                            <group>
                                <group>
                                    <field name="parts_cost" widget="monetary"/>
                                    <field name="labor_cost" widget="monetary"/>
                                    <field name="total_cost" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="附件" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_supervision_equipment_request_list" model="ir.ui.view">
        <field name="name">supervision.equipment.request.list</field>
        <field name="model">supervision.equipment.request</field>
        <field name="arch" type="xml">
            <list string="設備維護請求" multi_edit="1"
                  decoration-danger="is_overdue"
                  decoration-warning="priority == '3'"
                  decoration-muted="stage_id.done">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="category_id" optional="hide"/>
                <field name="maintenance_type" widget="badge"
                       decoration-info="maintenance_type == 'corrective'"
                       decoration-success="maintenance_type == 'preventive'"/>
                <field name="priority" widget="priority"/>
                <field name="request_date"/>
                <field name="schedule_date" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="stage_id" widget="badge"/>
                <field name="kanban_state" widget="label_selection"
                       options="{'classes': {'normal': 'secondary', 'blocked': 'danger', 'done': 'success'}}"
                       optional="show"/>
                <field name="close_date" optional="hide"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="project_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_supervision_equipment_request_kanban" model="ir.ui.view">
        <field name="name">supervision.equipment.request.kanban</field>
        <field name="model">supervision.equipment.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column"
                    quick_create="false" on_create="quick_create">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="maintenance_type"/>
                <field name="priority"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <field name="kanban_state"/>
                <field name="color"/>
                <field name="is_overdue"/>
                <progressbar field="kanban_state"
                             colors='{"normal": "200", "blocked": "danger", "done": "success"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card #{record.is_overdue.raw_value ? 'border-danger' : ''}"
                             t-att-style="'border-left: 4px solid ' + kanban_getcolor(record.color.raw_value) + ';'">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <field name="priority" widget="priority"/>
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="equipment_id"/>
                                </div>
                                <div class="o_kanban_record_subtitle text-muted">
                                    <field name="maintenance_type" widget="badge"
                                           decoration-info="maintenance_type == 'corrective'"
                                           decoration-success="maintenance_type == 'preventive'"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <span class="oe_kanban_bottom_left">
                                        <field name="schedule_date" widget="date"/>
                                    </span>
                                    <span class="oe_kanban_bottom_right">
                                        <field name="kanban_state" widget="state_selection"/>
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_supervision_equipment_request_calendar" model="ir.ui.view">
        <field name="name">supervision.equipment.request.calendar</field>
        <field name="model">supervision.equipment.request</field>
        <field name="arch" type="xml">
            <calendar string="維護排程" date_start="schedule_date" color="equipment_id"
                      event_open_popup="true" quick_create="false">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </calendar>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_supervision_equipment_request_search" model="ir.ui.view">
        <field name="name">supervision.equipment.request.search</field>
        <field name="model">supervision.equipment.request</field>
        <field name="arch" type="xml">
            <search string="搜尋維護請求">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="user_id"/>
                <field name="category_id"/>
                <field name="project_id"/>
                <separator/>
                <filter string="我的請求" name="my_requests"
                        domain="[('user_id', '=', uid)]"/>
                <filter string="我建立的" name="my_created"
                        domain="[('owner_user_id', '=', uid)]"/>
                <separator/>
                <filter string="糾正性維護" name="corrective"
                        domain="[('maintenance_type', '=', 'corrective')]"/>
                <filter string="預防性維護" name="preventive"
                        domain="[('maintenance_type', '=', 'preventive')]"/>
                <separator/>
                <filter string="緊急" name="urgent"
                        domain="[('priority', '=', '3')]"/>
                <filter string="高優先" name="high_priority"
                        domain="[('priority', 'in', ['2', '3'])]"/>
                <separator/>
                <filter string="已逾期" name="overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <filter string="今日排程" name="today"
                        domain="[('schedule_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('schedule_date', '&lt;', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="本週排程" name="this_week"
                        domain="[('schedule_date', '>=', (context_today() - relativedelta(weekday=0))),
                                 ('schedule_date', '&lt;', (context_today() + relativedelta(weeks=1, weekday=0)))]"/>
                <separator/>
                <filter string="進行中" name="in_progress"
                        domain="[('stage_id.done', '=', False)]"/>
                <filter string="已完成" name="done"
                        domain="[('stage_id.done', '=', True)]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="所屬工程" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="階段" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="維護類型" name="group_type" context="{'group_by': 'maintenance_type'}"/>
                    <filter string="設備" name="group_equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter string="設備分類" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="負責技師" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="優先級" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="請求日期" name="group_request_date" context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_supervision_equipment_request" model="ir.actions.act_window">
        <field name="name">設備維護請求</field>
        <field name="res_model">supervision.equipment.request</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_supervision_equipment_request_search"/>
        <field name="context">{'search_default_in_progress': 1, 'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一個維護請求
            </p>
            <p>
                追蹤設備維護請求，包含糾正性維護（故障維修）和預防性維護（定期保養）。
                使用看板視圖管理維護工作流程。
            </p>
        </field>
    </record>

    <!-- Action: 我的維護請求 -->
    <record id="action_supervision_equipment_request_my" model="ir.actions.act_window">
        <field name="name">我的維護請求</field>
        <field name="res_model">supervision.equipment.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'search_default_in_progress': 1}</field>
    </record>

    <!-- Action: 逾期維護請求 -->
    <record id="action_supervision_equipment_request_overdue" model="ir.actions.act_window">
        <field name="name">逾期維護請求</field>
        <field name="res_model">supervision.equipment.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_overdue', '=', True), ('stage_id.done', '=', False)]</field>
    </record>

</odoo>
