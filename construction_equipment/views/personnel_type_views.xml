<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_personnel_type_form" model="ir.ui.view">
        <field name="name">personnel.type.form</field>
        <field name="model">personnel.type</field>
        <field name="arch" type="xml">
            <form string="人員機具設定">
                <sheet>
                    <widget name="web_ribbon" title="已停用"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="record_type" widget="radio"/>
                            <field name="name" placeholder="例如：技工、大工、挖土機"/>
                            <field name="code" placeholder="選填"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="usage_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="詳細說明..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_personnel_type_list" model="ir.ui.view">
        <field name="name">personnel.type.list</field>
        <field name="model">personnel.type</field>
        <field name="arch" type="xml">
            <list string="人員機具設定" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="record_type"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="usage_count" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_personnel_type_search" model="ir.ui.view">
        <field name="name">personnel.type.search</field>
        <field name="model">personnel.type</field>
        <field name="arch" type="xml">
            <search string="搜尋人員機具設定">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="人員" name="personnel" domain="[('record_type', '=', 'personnel')]"/>
                <filter string="機具" name="equipment" domain="[('record_type', '=', 'equipment')]"/>
                <separator/>
                <filter string="啟用" name="active" domain="[('active', '=', True)]"/>
                <filter string="已停用" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="類型" name="group_record_type"
                            context="{'group_by': 'record_type'}"/>
                    <filter string="公司" name="group_company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_personnel_type" model="ir.actions.act_window">
        <field name="name">人員機具設定</field>
        <field name="res_model">personnel.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一筆人員機具設定
            </p>
            <p>
                在此定義工地常用的人員類型與機具類型。<br/>
                預設已包含 5 種人員類型：技工、大工、小工、作業、司機。
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_personnel_type"
              name="人員機具設定"
              parent="construction_supervision_base.menu_manpower_equipment"
              action="action_personnel_type"
              sequence="5"/>

</odoo>
