<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- 人機管理模組安全群組 -->

        <!-- 人機管理 - 使用者 -->
        <record id="group_equipment_user" model="res.groups">
            <field name="name">人機管理 - 使用者</field>
            <field name="category_id" ref="construction_supervision_base.module_category_construction_supervision"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">可查看設備資訊、建立維護請求、填寫人機記錄</field>
        </record>

        <!-- 人機管理 - 技師 -->
        <record id="group_equipment_technician" model="res.groups">
            <field name="name">人機管理 - 技師</field>
            <field name="category_id" ref="construction_supervision_base.module_category_construction_supervision"/>
            <field name="implied_ids" eval="[(4, ref('group_equipment_user'))]"/>
            <field name="comment">可處理維護請求、更新設備狀態</field>
        </record>

        <!-- 人機管理 - 主管 -->
        <record id="group_equipment_manager" model="res.groups">
            <field name="name">人機管理 - 主管</field>
            <field name="category_id" ref="construction_supervision_base.module_category_construction_supervision"/>
            <field name="implied_ids" eval="[(4, ref('group_equipment_technician'))]"/>
            <field name="comment">可管理設備分類、設備主檔、檢視 MTBF/MTTR 報表</field>
        </record>

    </data>

    <data noupdate="1">

        <!-- Record Rules -->

        <!-- 機具設備分類 - 所有使用者可讀 -->
        <record id="rule_equipment_category_read" model="ir.rule">
            <field name="name">機具設備分類: 所有使用者可讀</field>
            <field name="model_id" ref="model_supervision_equipment_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 機具設備 - 公司隔離 -->
        <record id="rule_equipment_company" model="ir.rule">
            <field name="name">機具設備: 公司隔離</field>
            <field name="model_id" ref="model_supervision_equipment"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_equipment_user'))]"/>
        </record>

        <!-- 維護請求 - 公司隔離 -->
        <record id="rule_equipment_request_company" model="ir.rule">
            <field name="name">維護請求: 公司隔離</field>
            <field name="model_id" ref="model_supervision_equipment_request"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_equipment_user'))]"/>
        </record>

        <!-- 維護請求階段 - 所有使用者可讀 -->
        <record id="rule_equipment_request_stage_read" model="ir.rule">
            <field name="name">維護請求階段: 所有使用者可讀</field>
            <field name="model_id" ref="model_supervision_equipment_request_stage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 施工日誌人機記錄 - 公司隔離 -->
        <record id="rule_daily_log_man_machine_company" model="ir.rule">
            <field name="name">施工日誌人機記錄: 公司隔離</field>
            <field name="model_id" ref="model_daily_log_man_machine"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_equipment_user'))]"/>
        </record>

        <!-- 系統管理者 - 完整存取 -->
        <record id="rule_admin_full_access_equipment_category" model="ir.rule">
            <field name="name">管理者: 設備分類完整存取</field>
            <field name="model_id" ref="model_supervision_equipment_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_equipment" model="ir.rule">
            <field name="name">管理者: 機具設備完整存取</field>
            <field name="model_id" ref="model_supervision_equipment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_equipment_request" model="ir.rule">
            <field name="name">管理者: 維護請求完整存取</field>
            <field name="model_id" ref="model_supervision_equipment_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_equipment_request_stage" model="ir.rule">
            <field name="name">管理者: 維護請求階段完整存取</field>
            <field name="model_id" ref="model_supervision_equipment_request_stage"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_daily_log_man_machine" model="ir.rule">
            <field name="name">管理者: 施工日誌人機記錄完整存取</field>
            <field name="model_id" ref="model_daily_log_man_machine"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
