<?xml version="1.0" encoding="utf-8"?>
<!--
    S4（2026-11-12）全域公司隔離：施工日誌人機料。說明（為什麼是全域規則、語意、寫入另由寫後檢查擋、noupdate、測試）在
    construction_supervision_base/security/company_rules.xml 檔頭；寫入面實作在 construction_supervision_base/models/company_rule_write_guard.py。
    一律走「紀錄所屬工程的公司」（子表沿父單），不用紀錄自己的 company_id（dev 上日誌、文件的 company_id 與工程公司不一致的各有上千／上百筆）。
-->
<odoo>
    <data>
        <record id="rule_company_global_daily_log_man_machine" model="ir.rule">
            <field name="name">人機料 - 公司隔離（全域，S4）</field>
            <field name="model_id" ref="model_daily_log_man_machine"/>
            <field name="domain_force">[('project_id.company_id', 'in', company_ids)]</field>
        </record>
        <!-- 沿父單：project_id 是 daily_log_id.project_id 的 stored related（施工日誌必填）；man_machine_id 可空，不拿來判斷 -->
        <record id="rule_company_global_daily_log_man_machine_detail" model="ir.rule">
            <field name="name">人機料日誌明細 - 公司隔離（全域，S4）</field>
            <field name="model_id" ref="model_daily_log_man_machine_detail"/>
            <field name="domain_force">[('project_id.company_id', 'in', company_ids)]</field>
        </record>

        <!-- ── S5（2026-11-18）：機具設備與維護請求 ──
             機具自己的 company_id 是獨立欄位（預設帶建立者當時選的公司），不拿來判斷；工程必填。
             維護請求：project_id 是 equipment_id.project_id 的 stored related（機具必填） -->
        <record id="rule_company_global_supervision_equipment" model="ir.rule">
            <field name="name">機具設備 - 公司隔離（全域，S5）</field>
            <field name="model_id" ref="model_supervision_equipment"/>
            <field name="domain_force">[('project_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_company_global_supervision_equipment_request" model="ir.rule">
            <field name="name">機具維護請求 - 公司隔離（全域，S5）</field>
            <field name="model_id" ref="model_supervision_equipment_request"/>
            <field name="domain_force">[('project_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
