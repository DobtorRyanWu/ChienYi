<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 批次下載精靈 - 設定表單 -->
    <record id="batch_download_wizard_form_view" model="ir.ui.view">
        <field name="name">batch.download.wizard.form</field>
        <field name="model">batch.download.wizard</field>
        <field name="arch" type="xml">
            <form string="報表 / 下載">
                <group invisible="state != 'draft'">
                    <group string="下載設定">
                        <field name="download_type" widget="radio"/>
                        <field name="daily_log_variant"
                               invisible="download_type != 'daily_log'"
                               required="download_type == 'daily_log'"/>
                        <field name="estimate_variant"
                               invisible="download_type != 'estimate'"
                               required="download_type == 'estimate'"/>
                        <field name="defect_variant"
                               invisible="download_type != 'defect'"
                               required="download_type == 'defect'"/>
                        <field name="plan_variant" widget="radio"
                               invisible="download_type != 'plan'"
                               required="download_type == 'plan'"/>
                        <field name="output_format" widget="radio"
                               invisible="download_type not in ['daily_log', 'estimate']"/>
                    </group>
                    <group string="篩選條件">
                        <field name="project_id" options="{'no_create': True}"
                               required="download_type in ['defect', 'self_inspection', 'test', 'review', 'plan', 'progress_schedule']"/>
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="date_from"
                               invisible="download_type == 'progress_schedule'"/>
                        <field name="date_to"
                               invisible="download_type == 'progress_schedule'"/>
                        <field name="record_count" readonly="1"
                               invisible="download_type == 'progress_schedule'"/>
                    </group>
                </group>

                <div class="alert alert-info" role="status"
                     invisible="state != 'draft' or download_type not in ['defect', 'self_inspection', 'test', 'review', 'plan']">
                    這類報表是<strong>整個工程案件的彙總表</strong>，一個工程案件產出一份檔案，
                    內容與工程案件表單上的匯出按鈕相同。日期區間留空即列出全部記錄。
                </div>

                <div class="alert alert-info" role="status"
                     invisible="state != 'draft' or download_type != 'progress_schedule'">
                    這份樣板<strong>只自動帶入工程名稱與預定工期</strong>，工作項目與甘特長條需自行填寫
                    （Odoo 的進度表是週期 S 曲線，沒有工項工期資料，自動填會產生假的工項清單）。
                </div>

                <div class="alert alert-warning" role="alert"
                     invisible="state != 'draft' or not undated_note">
                    <strong>日期未填提醒</strong>
                    <field name="undated_note" nolabel="1" readonly="1"/>
                </div>

                <!-- 頁籤順序比照 download_type 的排列（一次只會顯示一個） -->
                <notebook invisible="state != 'draft'">
                    <page string="通報單" invisible="download_type != 'notification_slip'">
                        <field name="notification_slip_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="留空則依篩選條件自動選取..."/>
                        <p class="text-muted">
                            預約式工程施工回報單，一張通報單產出一個檔案。多筆會打包成 ZIP。
                        </p>
                    </page>
                    <page string="施工日誌" invisible="download_type != 'daily_log'">
                        <field name="daily_log_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="留空則依篩選條件自動選取..."/>
                        <p class="text-muted">
                            手動選擇要下載的施工日誌，或留空以依據上方篩選條件自動選取已填寫的日誌。
                            多筆會打包成 ZIP。
                        </p>
                    </page>
                    <page string="估驗計價" invisible="download_type != 'estimate'">
                        <field name="estimate_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="留空則依篩選條件自動選取..."/>
                        <p class="text-muted">
                            手動選擇要下載的估驗計價表，或留空以依據上方篩選條件自動選取已核定的估驗單。
                            多筆會打包成 ZIP。
                        </p>
                    </page>
                    <page string="進度報告" invisible="download_type != 'progress_report'">
                        <field name="progress_report_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="留空則依篩選條件自動選取..."/>
                        <p class="text-muted">
                            對應「工程管理 &gt; 進度管理 &gt; 進度報告」的記錄，一份報告產出一個檔案。
                            數量欄位來自報告的「同步數據」，未同步過的報告會在下載前提示。
                        </p>
                    </page>
                </notebook>

                <field name="state" invisible="1"/>

                <footer invisible="state != 'draft'">
                    <button name="action_preview" string="預覽記錄" type="object"
                            class="btn-secondary"/>
                    <button name="action_download" string="開始下載" type="object"
                            class="btn-primary"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 批次下載精靈 - 結果表單 -->
    <record id="batch_download_wizard_result_view" model="ir.ui.view">
        <field name="name">batch.download.wizard.result.form</field>
        <field name="model">batch.download.wizard</field>
        <field name="arch" type="xml">
            <form string="下載完成">
                <!-- role=status 而非 alert：Odoo 的無障礙檢查要求 alert 只留給
                     「必須立刻中斷手邊動作」的訊息，這只是完成通知 -->
                <div class="alert alert-success" role="status">
                    <h4 class="alert-heading">檔案準備完成!</h4>
                    <p>點擊下方按鈕下載檔案。</p>
                </div>

                <group>
                    <field name="result_filename" readonly="1"/>
                    <field name="result_file" filename="result_filename" readonly="1"/>
                </group>

                <field name="state" invisible="1"/>

                <footer>
                    <button name="action_reset" string="重新下載" type="object"
                            class="btn-secondary"/>
                    <button string="關閉" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 批次下載動作 -->
    <record id="action_batch_download_wizard" model="ir.actions.act_window">
        <field name="name">批次下載</field>
        <field name="res_model">batch.download.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="batch_download_wizard_form_view"/>
        <field name="target">new</field>
    </record>

</odoo>
