<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 預約式自主檢查表單視圖擴展                       -->
    <!-- ============================================== -->
    <record id="view_reservation_self_inspection_form_reservation" model="ir.ui.view">
        <field name="name">reservation.self.inspection.form.reservation</field>
        <field name="model">reservation.self.inspection</field>
        <field name="inherit_id" ref="construction_quality.view_reservation_self_inspection_form"/>
        <field name="arch" type="xml">
            <!-- 在按鈕區新增缺失改善按鈕 -->
            <xpath expr="//button[@name='action_reset_draft']" position="after">
                <button name="action_create_defect_improvements"
                        string="建立缺失改善"
                        type="object"
                        class="btn-warning"
                        invisible="state == 'draft' or defect_count == 0"/>
                <button name="action_view_defect_improvements"
                        string="查看缺失改善"
                        type="object"
                        class="btn-secondary"
                        invisible="defect_improvement_count == 0"/>
            </xpath>

            <!-- 擴展通報單資訊群組 -->
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="slip_state" invisible="1"/>
                <field name="slip_work_status" widget="badge"
                       decoration-info="slip_work_status == 'draft'"
                       decoration-warning="slip_work_status == 'not_started'"
                       decoration-primary="slip_work_status == 'in_progress'"
                       decoration-success="slip_work_status == 'closed'"/>
                <field name="slip_location"/>
            </xpath>

            <!-- 擴展檢查項目 list 視圖 -->
            <xpath expr="//field[@name='checklist_ids']/list/field[@name='note']" position="after">
                <field name="defect_improvement_id" optional="hide"/>
                <field name="has_improvement" column_invisible="1"/>
                <button name="action_create_improvement"
                        type="object"
                        string="建立改善"
                        class="btn-sm btn-warning"
                        invisible="check_result != 'defect' or has_improvement"/>
                <button name="action_view_improvement"
                        type="object"
                        string="查看改善"
                        class="btn-sm btn-info"
                        invisible="not has_improvement"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 預約式自主檢查列表視圖擴展                       -->
    <!-- ============================================== -->
    <record id="view_reservation_self_inspection_tree_reservation" model="ir.ui.view">
        <field name="name">reservation.self.inspection.tree.reservation</field>
        <field name="model">reservation.self.inspection</field>
        <field name="inherit_id" ref="construction_quality.view_reservation_self_inspection_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="defect_improvement_count" optional="show" string="改善記錄"/>
                <field name="slip_work_status" optional="hide" widget="badge"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 預約式自主檢查搜尋視圖擴展                       -->
    <!-- ============================================== -->
    <record id="view_reservation_self_inspection_search_reservation" model="ir.ui.view">
        <field name="name">reservation.self.inspection.search.reservation</field>
        <field name="model">reservation.self.inspection</field>
        <field name="inherit_id" ref="construction_quality.view_reservation_self_inspection_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@expand='0']" position="inside">
                <filter string="通報單地點" name="group_slip_location"
                        context="{'group_by': 'slip_location'}"/>
                <filter string="施作狀態" name="group_work_status"
                        context="{'group_by': 'slip_work_status'}"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 預約式自主檢查項目表單視圖                       -->
    <!-- ============================================== -->
    <record id="view_reservation_self_inspection_item_form_reservation" model="ir.ui.view">
        <field name="name">reservation.self.inspection.item.form.reservation</field>
        <field name="model">reservation.self.inspection.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="檢查項目資訊">
                            <field name="sequence"/>
                            <field name="stage"/>
                            <field name="check_item"/>
                            <field name="design_standard"/>
                        </group>
                        <group string="檢查結果">
                            <field name="actual_result"/>
                            <field name="check_result" widget="radio"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <group string="缺失改善" invisible="check_result != 'defect'">
                        <field name="defect_improvement_id"/>
                        <field name="has_improvement"/>
                        <field name="improvement_state" widget="badge"
                               invisible="not has_improvement"/>
                        <button name="action_create_improvement"
                                string="建立缺失改善記錄"
                                type="object"
                                class="btn-warning"
                                invisible="check_result != 'defect' or has_improvement"/>
                        <button name="action_view_improvement"
                                string="查看缺失改善記錄"
                                type="object"
                                class="btn-info"
                                invisible="not has_improvement"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
