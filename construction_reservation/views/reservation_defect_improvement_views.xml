<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 預約式缺失改善表單視圖擴展 -->
    <record id="view_reservation_defect_improvement_form_reservation" model="ir.ui.view">
        <field name="name">reservation.defect.improvement.form.reservation</field>
        <field name="model">reservation.defect.improvement</field>
        <field name="inherit_id" ref="construction_quality.view_reservation_defect_improvement_form"/>
        <field name="arch" type="xml">
            <!-- 在通報單資訊後加入通報單摘要欄位 -->
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="slip_number" invisible="not slip_id"/>
                <field name="slip_location" invisible="not slip_id"/>
            </xpath>

            <!-- 在 改善責任 group 中加入來源檢查資訊 -->
            <xpath expr="//field[@name='responsible_user_id']" position="after">
                <field name="is_from_inspection" invisible="not is_from_inspection"/>
                <field name="source_inspection_count" invisible="not is_from_inspection"/>
                <button name="action_view_source_inspections"
                        string="查看來源檢查"
                        type="object"
                        class="btn-link"
                        invisible="not is_from_inspection"/>
            </xpath>

            <!-- 在「關聯與備註」頁籤以與一般式相同的三欄格式顯示來源自主檢查 -->
            <xpath expr="//page[@name='relations']/group" position="before">
                <group string="來源自主檢查" invisible="not is_from_inspection">
                    <field name="source_inspection_id" string="來源自主檢查" readonly="1"/>
                    <field name="source_inspection_no" string="檢查編號"/>
                    <field name="source_inspection_item_id" string="來源檢查項目"
                           readonly="1" options="{'no_open': True}"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- 預約式缺失改善列表視圖擴展 -->
    <record id="view_reservation_defect_improvement_tree_reservation" model="ir.ui.view">
        <field name="name">reservation.defect.improvement.tree.reservation</field>
        <field name="model">reservation.defect.improvement</field>
        <field name="inherit_id" ref="construction_quality.view_reservation_defect_improvement_tree"/>
        <field name="arch" type="xml">
            <!-- 在 state 前加入改善進度、複查狀態等延伸欄位 -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="improvement_progress" widget="progressbar" optional="show"/>
                <field name="recheck_result" optional="hide" widget="badge"
                       decoration-success="recheck_result == 'pass'"
                       decoration-danger="recheck_result == 'fail'"
                       decoration-warning="recheck_result == 'pending'"/>
                <field name="is_from_inspection" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- 預約式缺失改善搜尋視圖擴展 -->
    <record id="view_reservation_defect_improvement_search_reservation" model="ir.ui.view">
        <field name="name">reservation.defect.improvement.search.reservation</field>
        <field name="model">reservation.defect.improvement</field>
        <field name="inherit_id" ref="construction_quality.view_reservation_defect_improvement_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='safety_env']" position="after">
                <separator/>
                <filter string="待複查" name="pending_recheck"
                        domain="[('recheck_result', '=', 'pending')]"/>
                <filter string="複查通過" name="recheck_pass"
                        domain="[('recheck_result', '=', 'pass')]"/>
                <filter string="複查不通過" name="recheck_fail"
                        domain="[('recheck_result', '=', 'fail')]"/>
                <filter string="來自自主檢查" name="from_inspection"
                        domain="[('is_from_inspection', '=', True)]"/>
            </xpath>
            <xpath expr="//group[@expand='0']" position="inside">
                <filter string="複查結果" name="group_recheck"
                        context="{'group_by': 'recheck_result'}"/>
                <filter string="責任歸屬" name="group_responsible"
                        context="{'group_by': 'responsible_party'}"/>
            </xpath>
        </field>
    </record>

    <!-- 預約式缺失改善 Kanban 視圖擴展 -->
    <record id="view_reservation_defect_improvement_kanban_reservation" model="ir.ui.view">
        <field name="name">reservation.defect.improvement.kanban.reservation</field>
        <field name="model">reservation.defect.improvement</field>
        <field name="inherit_id" ref="construction_quality.view_reservation_defect_improvement_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="improvement_progress"/>
            </xpath>
            <xpath expr="//div[@class='o_kanban_record_body']" position="inside">
                <div class="progress mt-1" style="height: 5px;">
                    <div class="progress-bar" role="progressbar"
                         t-attf-style="width: #{record.improvement_progress.raw_value}%"
                         t-att-aria-valuenow="record.improvement_progress.raw_value"
                         aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
