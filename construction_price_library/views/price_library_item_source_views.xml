<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 價格庫來源 - 列表視圖                           -->
    <!-- ============================================== -->
    <record id="view_price_library_item_source_tree" model="ir.ui.view">
        <field name="name">price.library.item.source.tree</field>
        <field name="model">price.library.item.source</field>
        <field name="arch" type="xml">
            <list string="價格庫來源" create="false" edit="false" delete="false">
                <field name="library_item_id"/>
                <field name="project_code"/>
                <field name="project_name"/>
                <field name="task_id"/>
                <field name="unit_price" widget="monetary"/>
                <field name="planned_qty"/>
                <field name="planned_amount" widget="monetary" sum="總金額"/>
                <field name="created_date"/>
                <field name="created_by_id"/>
                <field name="company_id" groups="construction_supervision_base.group_supervisor_admin"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 價格庫來源 - 表單視圖                           -->
    <!-- ============================================== -->
    <record id="view_price_library_item_source_form" model="ir.ui.view">
        <field name="name">price.library.item.source.form</field>
        <field name="model">price.library.item.source</field>
        <field name="arch" type="xml">
            <form string="價格來源" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="價格庫項目">
                            <field name="library_item_id"/>
                            <field name="company_id" groups="construction_supervision_base.group_supervisor_admin"/>
                        </group>
                        <group string="來源專案">
                            <field name="project_id"/>
                            <field name="project_code"/>
                            <field name="project_name"/>
                        </group>
                    </group>
                    <group>
                        <group string="來源工項">
                            <field name="task_id"/>
                            <field name="unit_price" widget="monetary"/>
                            <field name="planned_qty"/>
                            <field name="planned_amount" widget="monetary"/>
                        </group>
                        <group string="建立資訊">
                            <field name="created_date"/>
                            <field name="created_by_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 價格庫來源 - 搜尋視圖                           -->
    <!-- ============================================== -->
    <record id="view_price_library_item_source_search" model="ir.ui.view">
        <field name="name">price.library.item.source.search</field>
        <field name="model">price.library.item.source</field>
        <field name="arch" type="xml">
            <search string="搜尋價格來源">
                <field name="library_item_id"/>
                <field name="project_id"/>
                <field name="project_code"/>
                <field name="task_id"/>
                <separator/>
                <filter name="filter_this_year" string="本年建立"
                        domain="[('created_date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%Y-01-01'))]"/>
                <filter name="filter_this_month" string="本月建立"
                        domain="[('created_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter name="group_by_library_item" string="價格庫項目" context="{'group_by': 'library_item_id'}"/>
                    <filter name="group_by_project" string="來源專案" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_created_date" string="建立日期" context="{'group_by': 'created_date:month'}"/>
                    <filter name="group_by_company" string="公司" context="{'group_by': 'company_id'}"
                            groups="construction_supervision_base.group_supervisor_admin"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 價格庫來源 - 動作                               -->
    <!-- ============================================== -->
    <record id="action_price_library_item_source" model="ir.actions.act_window">
        <field name="name">價格庫來源</field>
        <field name="res_model">price.library.item.source</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_price_library_item_source_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                沒有價格來源記錄
            </p>
            <p>
                價格來源記錄會在專案結案時自動建立。
            </p>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 價格庫來源 - 選單                               -->
    <!-- ============================================== -->
    <menuitem id="menu_price_library_item_source"
              name="價格庫來源"
              parent="construction_supervision_base.menu_price_library_config"
              action="action_price_library_item_source"
              sequence="15"/>

</odoo>
