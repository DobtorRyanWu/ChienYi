<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 註：已移除過時的「舊權限清理」<delete> 區塊。
             此模組權限早已改為「僅系統管理者統一管理」(見下方 rule_*_admin)；
             舊的 viewer/editor/manager 群組、ir.rule、ir.model.access 已不存在。
             原本用 ref('group_price_library_viewer') 等做 <delete>，會在每次升級時
             因找不到 External ID 而噴出無害的 traceback（被 Odoo skip）。清理任務
             早已完成，故移除以保持升級 log 乾淨。 -->

        <!-- ============================================== -->
        <!-- 新的記錄規則 (Record Rules)                      -->
        <!-- ============================================== -->
        <!-- 價格庫功能改為由系統管理者統一管理 -->

        <!-- 價格庫分類：系統管理者完整權限 -->
        <record id="rule_price_library_category_admin" model="ir.rule">
            <field name="name">價格庫分類 - 系統管理者權限</field>
            <field name="model_id" ref="model_price_library_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 價格庫項目：系統管理者完整權限 -->
        <record id="rule_price_library_item_admin" model="ir.rule">
            <field name="name">價格庫項目 - 系統管理者權限</field>
            <field name="model_id" ref="model_price_library_item"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 價格歷史：系統管理者完整權限 -->
        <record id="rule_price_library_item_history_admin" model="ir.rule">
            <field name="name">價格歷史 - 系統管理者權限</field>
            <field name="model_id" ref="model_price_library_item_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================== -->
        <!-- 多公司隔離規則 (Multi-Company Isolation)         -->
        <!-- ============================================== -->
        <!-- 訂閱者只能查看自己公司的價格庫資料 -->

        <!-- 價格庫分類：多公司隔離 - 訂閱者唯讀 -->
        <record id="rule_price_library_category_multi_company" model="ir.rule">
            <field name="name">價格庫分類 - 多公司隔離</field>
            <field name="model_id" ref="model_price_library_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 價格庫項目：多公司隔離 - 訂閱者唯讀 -->
        <record id="rule_price_library_item_multi_company" model="ir.rule">
            <field name="name">價格庫項目 - 多公司隔離</field>
            <field name="model_id" ref="model_price_library_item"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 價格來源：多公司隔離 - 訂閱者唯讀 -->
        <record id="rule_price_library_item_source_multi_company" model="ir.rule">
            <field name="name">價格庫項目來源 - 多公司隔離</field>
            <field name="model_id" ref="model_price_library_item_source"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 價格歷史：多公司隔離 - 訂閱者唯讀 -->
        <record id="rule_price_library_item_history_multi_company" model="ir.rule">
            <field name="name">價格歷史 - 多公司隔離</field>
            <field name="model_id" ref="model_price_library_item_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ============================================== -->
        <!-- 全域公司隔離（18.0.1.1.0）                        -->
        <!-- ============================================== -->
        <!-- 上面兩組群組規則都是 (1=1)（註解寫「只能查看自己公司」但實際沒擋）。正式站 jt 是多家監造公司
             共用的庫：寫進廷暉、和建的契約單價分析之後，任泰的管理者會在價格庫看到別家的單價。
             全域規則與群組規則是 AND：任何人都只看得到「目前選取的公司」的價格庫。
             結案提取（_extract_tasks_to_price_library）走 sudo，不受影響。 -->
        <record id="rule_price_library_category_company" model="ir.rule">
            <field name="name">價格庫分類 - 公司隔離</field>
            <field name="model_id" ref="model_price_library_category"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_price_library_item_company" model="ir.rule">
            <field name="name">價格庫項目 - 公司隔離</field>
            <field name="model_id" ref="model_price_library_item"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_price_library_item_source_company" model="ir.rule">
            <field name="name">價格來源 - 公司隔離</field>
            <field name="model_id" ref="model_price_library_item_source"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!-- 價格歷史本身沒有 company_id，跟著項目的公司 -->
        <record id="rule_price_library_item_history_company" model="ir.rule">
            <field name="name">價格歷史 - 公司隔離</field>
            <field name="model_id" ref="model_price_library_item_history"/>
            <field name="domain_force">[('item_id.company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
