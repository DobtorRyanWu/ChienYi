<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 資料隔離規則 (Record Rules)                      -->
        <!-- ============================================== -->

        <!-- 操作軌跡 - 監造單位可看所有軌跡 -->
        <record id="rule_audit_trail_supervision" model="ir.rule">
            <field name="name">操作軌跡: 監造單位完整存取</field>
            <field name="model_id" ref="model_audit_trail"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervision_manager')), (4, ref('construction_supervision_base.group_supervision_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 操作軌跡 - 施工廠商可看自己公司的軌跡 -->
        <record id="rule_audit_trail_contractor" model="ir.rule">
            <field name="name">操作軌跡: 施工廠商限制存取</field>
            <field name="model_id" ref="model_audit_trail"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_contractor_manager')), (4, ref('construction_supervision_base.group_contractor_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 系統管理者 - 完整讀取 -->
        <record id="rule_audit_trail_admin" model="ir.rule">
            <field name="name">操作軌跡: 管理者完整讀取</field>
            <field name="model_id" ref="model_audit_trail"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
