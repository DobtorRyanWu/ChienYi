<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 預設 8 類（依流程圖主圖）。noupdate：後台可自行增修，升級不會蓋回去。 -->
    <data noupdate="1">
        <record id="category_operation_question" model="construction.service.category">
            <field name="name">操作疑問</field>
            <field name="sequence">10</field>
            <field name="ask_functional_module" eval="True"/>
        </record>
        <record id="category_sales" model="construction.service.category">
            <field name="name">銷售相關</field>
            <field name="sequence">20</field>
        </record>
        <record id="category_system_problem" model="construction.service.category">
            <field name="name">系統問題</field>
            <field name="sequence">30</field>
            <field name="is_system_problem" eval="True"/>
            <field name="ask_functional_module" eval="True"/>
        </record>
        <record id="category_hardware" model="construction.service.category">
            <field name="name">硬體設備問題</field>
            <field name="sequence">40</field>
        </record>
        <record id="category_product_suggestion" model="construction.service.category">
            <field name="name">產品建議</field>
            <field name="sequence">50</field>
        </record>
        <record id="category_billing_invoice" model="construction.service.category">
            <field name="name">帳務發票問題</field>
            <field name="sequence">60</field>
        </record>
        <record id="category_billing_audit" model="construction.service.category">
            <field name="name">帳務查核問題</field>
            <field name="sequence">70</field>
        </record>
        <record id="category_other" model="construction.service.category">
            <field name="name">其他</field>
            <field name="sequence">90</field>
        </record>
    </data>
</odoo>
