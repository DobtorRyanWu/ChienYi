<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_category_list" model="ir.ui.view">
        <field name="name">construction.service.category.list</field>
        <field name="model">construction.service.category</field>
        <field name="arch" type="xml">
            <list string="服務單類別" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="ask_functional_module"/>
                <field name="is_system_problem"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_service_category_search" model="ir.ui.view">
        <field name="name">construction.service.category.search</field>
        <field name="model">construction.service.category</field>
        <field name="arch" type="xml">
            <search string="服務單類別">
                <field name="name"/>
                <filter name="archived" string="已封存" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_service_category" model="ir.actions.act_window">
        <field name="name">服務單類別</field>
        <field name="res_model">construction.service.category</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
