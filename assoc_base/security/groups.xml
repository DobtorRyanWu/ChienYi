<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 公會系統的權限分類。與 ChienYi 慣例（category_id=False 隱藏）不同：
         這是新產品，群組要能在使用者表單上直接勾選指派。 -->
    <record id="module_category_association" model="ir.module.category">
        <field name="name">公會系統</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_assoc_staff" model="res.groups">
        <field name="name">公會職員</field>
        <field name="category_id" ref="module_category_association"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_assoc_admin" model="res.groups">
        <field name="name">公會管理員</field>
        <field name="category_id" ref="module_category_association"/>
        <field name="implied_ids" eval="[(4, ref('group_assoc_staff'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
