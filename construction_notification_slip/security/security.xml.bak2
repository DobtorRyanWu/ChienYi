<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 資料隔離規則 (Record Rules)                      -->
        <!-- ============================================== -->

        <!-- 通報單 - 監造單位可看所有通報單 -->
        <record id="rule_notification_slip_supervision" model="ir.rule">
            <field name="name">通報單: 監造單位完整存取</field>
            <field name="model_id" ref="model_reservation_notification_slip"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervision_manager')), (4, ref('construction_supervision_base.group_supervision_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 通報單 - 施工廠商可看參與專案的通報單 -->
        <record id="rule_notification_slip_contractor" model="ir.rule">
            <field name="name">通報單: 施工廠商限制存取</field>
            <field name="model_id" ref="model_reservation_notification_slip"/>
            <field name="domain_force">[('project_id.contractor_company_ids', 'in', [user.company_id.id])]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_contractor_manager')), (4, ref('construction_supervision_base.group_contractor_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 通報單明細 - 監造單位完整存取 -->
        <record id="rule_notification_slip_line_supervision" model="ir.rule">
            <field name="name">通報單明細: 監造單位完整存取</field>
            <field name="model_id" ref="model_reservation_notification_slip_line"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervision_manager')), (4, ref('construction_supervision_base.group_supervision_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 通報單明細 - 施工廠商限制存取 -->
        <record id="rule_notification_slip_line_contractor" model="ir.rule">
            <field name="name">通報單明細: 施工廠商限制存取</field>
            <field name="model_id" ref="model_reservation_notification_slip_line"/>
            <field name="domain_force">[('project_id.contractor_company_ids', 'in', [user.company_id.id])]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_contractor_manager')), (4, ref('construction_supervision_base.group_contractor_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 驗收單 - 監造單位完整存取 -->
        <record id="rule_notification_acceptance_supervision" model="ir.rule">
            <field name="name">驗收單: 監造單位完整存取</field>
            <field name="model_id" ref="model_notification_acceptance"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervision_manager')), (4, ref('construction_supervision_base.group_supervision_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 驗收單 - 施工廠商唯讀 -->
        <record id="rule_notification_acceptance_contractor" model="ir.rule">
            <field name="name">驗收單: 施工廠商唯讀</field>
            <field name="model_id" ref="model_notification_acceptance"/>
            <field name="domain_force">[('project_id.contractor_company_ids', 'in', [user.company_id.id])]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_contractor_manager')), (4, ref('construction_supervision_base.group_contractor_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 驗收明細 - 監造單位完整存取 -->
        <record id="rule_notification_acceptance_line_supervision" model="ir.rule">
            <field name="name">驗收明細: 監造單位完整存取</field>
            <field name="model_id" ref="model_notification_acceptance_line"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervision_manager')), (4, ref('construction_supervision_base.group_supervision_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 驗收明細 - 施工廠商唯讀 -->
        <record id="rule_notification_acceptance_line_contractor" model="ir.rule">
            <field name="name">驗收明細: 施工廠商唯讀</field>
            <field name="model_id" ref="model_notification_acceptance_line"/>
            <field name="domain_force">[('slip_id.project_id.contractor_company_ids', 'in', [user.company_id.id])]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_contractor_manager')), (4, ref('construction_supervision_base.group_contractor_engineer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 系統管理者 - 完整存取 -->
        <record id="rule_admin_notification_slip" model="ir.rule">
            <field name="name">管理者: 通報單完整存取</field>
            <field name="model_id" ref="model_reservation_notification_slip"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_notification_slip_line" model="ir.rule">
            <field name="name">管理者: 通報單明細完整存取</field>
            <field name="model_id" ref="model_reservation_notification_slip_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_notification_acceptance" model="ir.rule">
            <field name="name">管理者: 驗收單完整存取</field>
            <field name="model_id" ref="model_notification_acceptance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_notification_acceptance_line" model="ir.rule">
            <field name="name">管理者: 驗收明細完整存取</field>
            <field name="model_id" ref="model_notification_acceptance_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
