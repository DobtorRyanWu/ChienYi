<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 加入工項 Wizard（Odoo 原生 M2M 選取） -->
    <record id="view_add_slip_line_wizard_form" model="ir.ui.view">
        <field name="name">add.slip.line.wizard.form</field>
        <field name="model">add.slip.line.wizard</field>
        <field name="arch" type="xml">
            <form string="加入工項">
                <field name="slip_id" invisible="1"/>
                <group>
                    <field name="project_id" readonly="1"/>
                </group>

                <!-- 原生 M2M 工項選取，篩選搜尋由 Odoo 標準介面處理 -->
                <field name="selected_task_ids" nolabel="1"
                       domain="[('supervision_project_id', '=', project_id), ('is_summary_item', '=', False), ('active', '=', True)]"
                       options="{'no_create': True, 'no_open': True}"
                       context="{'list_view_ref': 'construction_supervision_base.view_task_tree_supervision_full', 'search_view_ref': 'construction_supervision_base.view_task_search_supervision'}">
                    <list>
                        <field name="display_item_no" string="項次" readonly="1" width="60px"/>
                        <field name="name" string="施工項目" readonly="1"/>
                        <field name="unit" string="單位" readonly="1"/>
                        <field name="planned_qty" string="契約數量" readonly="1" digits="[16, 4]"/>
                        <field name="unit_price" string="單價" readonly="1"/>
                        <field name="full_item_no" string="完整項次" readonly="1" optional="hide"/>
                    </list>
                </field>

                <footer>
                    <button name="action_add_lines" type="object"
                            string="加入選取工項" class="btn-primary"
                            invisible="not selected_task_ids"/>
                    <button string="關閉" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
