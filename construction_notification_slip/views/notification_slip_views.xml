<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 通報單 - 表單視圖                                -->
    <!-- ============================================== -->
    <record id="view_reservation_notification_slip_form" model="ir.ui.view">
        <field name="name">reservation.notification.slip.form</field>
        <field name="model">reservation.notification.slip</field>
        <field name="arch" type="xml">
            <form string="通報單">
                <header>
                    <button name="action_confirm" string="確認" type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="開始施工" type="object"
                            class="oe_highlight"
                            invisible="state != 'not_started'"/>
                    <button name="action_close" string="結案" type="object"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_return_to_draft" string="退回草稿" type="object"
                            invisible="state not in ['not_started', 'in_progress']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,not_started,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="通報單名稱"/>
                        </h1>
                    </div>

                    <!-- 基本資訊區 -->
                    <group string="基本資訊">
                        <group>
                            <field name="project_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="slip_number" readonly="1"/>
                            <field name="slip_no" readonly="state != 'draft'"/>
                            <field name="location" readonly="state == 'closed'"/>
                            <field name="location_detail" readonly="state == 'closed'"
                                   placeholder="可逐行填寫多個施工地點（會印在通報單上）"/>
                            <!-- 通報單照片若沒有 GPS EXIF，會沿用這組座標 -->
                            <label for="latitude" string="施工地點座標"/>
                            <div class="o_row">
                                <field name="latitude" readonly="state == 'closed'"
                                       placeholder="緯度"/>
                                <field name="longitude" readonly="state == 'closed'"
                                       placeholder="經度"/>
                            </div>
                        </group>
                        <group>
                            <field name="survey_date"/>
                            <field name="compiler_id"/>
                            <field name="valuation_count" readonly="1"/>
                        </group>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>

                    <!-- 工程預期區 -->
                    <group string="工程預期">
                        <group>
                            <field name="planned_start_date"/>
                            <field name="planned_duration"/>
                            <field name="planned_end_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="estimated_amount"/>
                            <field name="design_summary" placeholder="設計概述"/>
                        </group>
                    </group>

                    <!-- 工程執行區 -->
                    <group string="工程執行">
                        <group>
                            <field name="actual_start_date"/>
                            <field name="actual_end_date"/>
                            <field name="actual_duration" readonly="1"/>
                            <field name="overdue_display" readonly="1"/>
                        </group>
                        <group>
                            <field name="settlement_amount" readonly="1"/>
                            <field name="completion_summary" placeholder="完工概述"/>
                        </group>
                    </group>

                    <!-- 施工詳細表頁籤 -->
                    <notebook>
                        <page string="施工詳細表" name="detail_lines">
                            <button name="action_open_add_lines_wizard" string="加入工項"
                                    type="object" class="btn-primary mb-2"
                                    invisible="state == 'closed'"/>
                            <field name="detail_line_ids"
                                   readonly="state == 'closed'">
                                <list string="施工詳細表" editable="bottom" create="false">
                                    <field name="description" string="項目及說明" readonly="1"/>
                                    <field name="parent_item_name" string="父工項" readonly="1" optional="show"/>
                                    <field name="display_item_no" string="項次" readonly="1"/>
                                    <!-- item_no 是本明細自己的必填欄（列印報表印的是它，不是上面的
                                         display_item_no）。加入工項時由 wizard 從契約工項帶入，
                                         但同單不可重複，帶入值不合用時要能在這裡改。 -->
                                    <field name="item_no" string="項目編號"/>
                                    <field name="unit" string="單位" readonly="1"/>
                                    <field name="unit_price" string="單價" readonly="1"/>
                                    <field name="planned_qty" string="預估數量"/>
                                    <field name="planned_amount" string="預估金額" sum="預估總金額"/>
                                    <field name="actual_qty" string="實際完成數量"/>
                                    <field name="actual_amount" string="實際金額" sum="實際總金額"/>
                                    <field name="specification" string="規格說明" optional="hide"/>
                                    <field name="note" string="備註" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="task_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="備註" name="notes">
                            <group>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page string="關聯照片" name="related_photos">
                            <!-- 同檢試驗：本頁籤原本沒有任何上傳入口。 -->
                            <button name="%(construction_photo.action_photo_upload_wizard)d"
                                    type="action" string="批次上傳照片"
                                    class="btn-primary" icon="fa-camera"
                                    invisible="not id"/>
                            <field name="related_photo_count" invisible="1"/>
                            <field name="related_photo_ids" nolabel="1" mode="kanban" create="false"
                                   context="{'kanban_view_ref': 'construction_photo.supervision_photo_view_kanban_embedded',
                                             'form_view_ref': 'construction_photo.supervision_photo_view_form_embedded'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 通報單 - 列表視圖                                -->
    <!-- ============================================== -->
    <record id="view_reservation_notification_slip_tree" model="ir.ui.view">
        <field name="name">reservation.notification.slip.tree</field>
        <field name="model">reservation.notification.slip</field>
        <field name="arch" type="xml">
            <list string="通報單列表"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'closed'">
                <field name="project_id" string="所屬工程"/>
                <field name="slip_no" string="通報單次數"/>
                <field name="slip_number" string="通報單編號"/>
                <field name="location" string="工程地點"/>
                <field name="planned_start_date" string="預定開工日"/>
                <field name="planned_end_date" string="預定完工日"/>
                <field name="actual_start_date" string="實際開工日"/>
                <field name="actual_end_date" string="實際竣工日"/>
                <field name="state" string="施作狀態" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'not_started'"
                       decoration-primary="state == 'in_progress'"
                       decoration-success="state == 'closed'"/>
                <field name="valuation_count" string="已估驗次數"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 通報單 - 搜尋視圖                                -->
    <!-- ============================================== -->
    <record id="view_reservation_notification_slip_search" model="ir.ui.view">
        <field name="name">reservation.notification.slip.search</field>
        <field name="model">reservation.notification.slip</field>
        <field name="arch" type="xml">
            <search string="搜尋通報單">
                <field name="slip_number"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="location"/>
                <field name="compiler_id"/>
                <separator/>
                <filter string="草稿" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="未開始" name="not_started" domain="[('state', '=', 'not_started')]"/>
                <filter string="施工中" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="已結案" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="逾期" name="overdue"
                        domain="[('overdue_days', '>', 0)]"/>
                <separator/>
                <filter string="我建立的" name="my_slips"
                        domain="[('compiler_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="工程" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="狀態" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="編製人員" name="group_by_compiler" context="{'group_by': 'compiler_id'}"/>
                    <filter string="預定開工月" name="group_by_start_month" context="{'group_by': 'planned_start_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 通報單 - 看板視圖                                -->
    <!-- ============================================== -->
    <record id="view_reservation_notification_slip_kanban" model="ir.ui.view">
        <field name="name">reservation.notification.slip.kanban</field>
        <field name="model">reservation.notification.slip</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="slip_number"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="location"/>
                <field name="state"/>
                <field name="estimated_amount"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="slip_number"/>
                                        </strong>
                                    </div>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'info', 'not_started': 'warning', 'in_progress': 'primary', 'closed': 'success'}}"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="name"/>
                                    <div>
                                        <i class="fa fa-map-marker" title="位置"/> <field name="location"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span title="預估金額">
                                            <field name="estimated_amount" widget="monetary"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 通報單 - 動作                                    -->
    <!-- ============================================== -->
    <record id="action_reservation_notification_slip" model="ir.actions.act_window">
        <field name="name">通報單</field>
        <field name="res_model">reservation.notification.slip</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_reservation_notification_slip_search"/>
        <field name="context">{'search_default_group_by_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一張通報單
            </p>
            <p>
                通報單是預約式工程的核心管理單位，
                每張通報單代表一個施工地點或批次。
            </p>
        </field>
    </record>

    <!-- 執行中通報單 -->
    <record id="action_notification_slip_in_progress" model="ir.actions.act_window">
        <field name="name">執行中通報單</field>
        <field name="res_model">reservation.notification.slip</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'in_progress')]</field>
        <field name="context">{}</field>
    </record>

</odoo>
