<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 通報單編號序號 -->
        <record id="seq_reservation_notification_slip" model="ir.sequence">
            <field name="name">通報單編號</field>
            <field name="code">reservation.notification.slip</field>
            <field name="prefix">SLIP-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- 驗收單編號序號 -->
        <record id="seq_notification_acceptance" model="ir.sequence">
            <field name="name">通報單驗收單編號</field>
            <field name="code">notification.acceptance</field>
            <field name="prefix">NACC-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
