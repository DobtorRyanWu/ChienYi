<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_water_level_gap_scan" model="ir.cron">
            <field name="name">水位監測：序號缺口稽核</field>
            <field name="model_id" ref="model_water_level_gap"/>
            <field name="state">code</field>
            <field name="code">model._cron_gap_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_water_level_chain_verify" model="ir.cron">
            <field name="name">水位監測：雜湊鏈驗證（增量）</field>
            <field name="model_id" ref="model_water_level_integrity_check"/>
            <field name="state">code</field>
            <field name="code">model._cron_chain_verify()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_water_level_alert_scan" model="ir.cron">
            <field name="name">水位監測：異常掃描與告警</field>
            <field name="model_id" ref="model_water_level_monitor"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_scan()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_water_level_retention_audit" model="ir.cron">
            <field name="name">水位監測：保存期間稽核</field>
            <field name="model_id" ref="model_water_level_monitor"/>
            <field name="state">code</field>
            <field name="code">model._cron_retention_audit()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_water_level_daily_rollup" model="ir.cron">
            <field name="name">水位監測：日摘要（只新增不刪原始資料）</field>
            <field name="model_id" ref="model_water_level_monitor"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_rollup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_water_level_archive_notice" model="ir.cron">
            <field name="name">水位監測：保存到期提醒（不自動刪除）</field>
            <field name="model_id" ref="model_water_level_monitor"/>
            <field name="state">code</field>
            <field name="code">model._cron_archive_notice()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_water_level_source_pull" model="ir.cron">
            <field name="name">水位監測：從資料來源撈取</field>
            <field name="model_id" ref="model_water_level_source"/>
            <field name="state">code</field>
            <field name="code">model._cron_pull()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
