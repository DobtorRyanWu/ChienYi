<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 工程案件這一側的欄位，掛回核心的視圖（核心不認得 project_id） -->

    <!-- ===== 監測場域 ===== -->
    <record id="view_water_level_site_list_project" model="ir.ui.view">
        <field name="name">water.level.site.list.project</field>
        <field name="model">water.level.site</field>
        <field name="inherit_id" ref="water_level_core.view_water_level_site_list"/>
        <field name="arch" type="xml">
            <field name="site_type" position="after">
                <field name="project_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_water_level_site_form_project" model="ir.ui.view">
        <field name="name">water.level.site.form.project</field>
        <field name="model">water.level.site</field>
        <field name="inherit_id" ref="water_level_core.view_water_level_site_form"/>
        <field name="arch" type="xml">
            <field name="site_type" position="after">
                <field name="project_id"
                       invisible="site_type != 'project'"
                       required="site_type == 'project'"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_water_level_site_search_project" model="ir.ui.view">
        <field name="name">water.level.site.search.project</field>
        <field name="model">water.level.site</field>
        <field name="inherit_id" ref="water_level_core.view_water_level_site_search"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="project_id"/>
            </field>
        </field>
    </record>

    <!-- ===== 監測站 ===== -->
    <record id="view_water_level_device_list_project" model="ir.ui.view">
        <field name="name">water.level.device.list.project</field>
        <field name="model">water.level.device</field>
        <field name="inherit_id" ref="water_level_core.view_water_level_device_list"/>
        <field name="arch" type="xml">
            <field name="site_id" position="after">
                <field name="project_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_water_level_device_form_project" model="ir.ui.view">
        <field name="name">water.level.device.form.project</field>
        <field name="model">water.level.device</field>
        <field name="inherit_id" ref="water_level_core.view_water_level_device_form"/>
        <field name="arch" type="xml">
            <field name="site_id" position="after">
                <!-- 由場域帶入，社區場域為空 -->
                <field name="project_id" readonly="1" invisible="not project_id"/>
            </field>
        </field>
    </record>

    <record id="view_water_level_device_search_project" model="ir.ui.view">
        <field name="name">water.level.device.search.project</field>
        <field name="model">water.level.device</field>
        <field name="inherit_id" ref="water_level_core.view_water_level_device_search"/>
        <field name="arch" type="xml">
            <field name="site_id" position="after">
                <field name="project_id"/>
            </field>
            <filter name="group_site" position="after">
                <filter name="group_project" string="工程案件"
                        context="{'group_by': 'project_id'}"/>
            </filter>
        </field>
    </record>

    <!-- ===== 水位紀錄 ===== -->
    <record id="view_water_level_reading_list_project" model="ir.ui.view">
        <field name="name">water.level.reading.list.project</field>
        <field name="model">water.level.reading</field>
        <field name="inherit_id" ref="water_level_core.view_water_level_reading_list"/>
        <field name="arch" type="xml">
            <field name="device_id" position="after">
                <field name="project_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_water_level_reading_search_project" model="ir.ui.view">
        <field name="name">water.level.reading.search.project</field>
        <field name="model">water.level.reading</field>
        <field name="inherit_id" ref="water_level_core.view_water_level_reading_search"/>
        <field name="arch" type="xml">
            <field name="device_id" position="after">
                <field name="project_id"/>
            </field>
        </field>
    </record>

    <!-- ===== 選單 =====
         核心的「水位監測」是頂層 App；監造系統裡要掛在「品質安全」底下，
         與自主檢查、缺失管理同層（拆模組前就是這個位置）。
         核心升級會把 parent 重設成空，但升級核心一定連帶升級本模組（依賴者跟著升），
         本檔在核心之後載入，所以最後結果固定是掛在品質安全底下。 -->
    <record id="water_level_core.menu_water_level_root" model="ir.ui.menu">
        <field name="parent_id" ref="construction_supervision_base.menu_quality_safety_root"/>
        <field name="sequence">30</field>
    </record>
</odoo>
