<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 核心只定義一個管理員群組。內部使用者（base.group_user）的權限照舊由 ACL 給；
         前台（portal）一條 ACL、一條 rule 都不給——那是工程／社區模組各自的事，
         只裝核心時前台讀不到任何水位資料。 -->
    <record id="module_category_water_level" model="ir.module.category">
        <field name="name">水位監測</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_water_level_manager" model="res.groups">
        <field name="name">水位監測管理員</field>
        <field name="category_id" ref="module_category_water_level"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- 初始成員只在安裝時給一次（noupdate）：之後有人把 admin 移出這個群組，
         下次升級核心不會又把他加回來。
         監造系統管理員的管理權限由工程模組直接給 ACL，刻意不用 implied 這個群組：
         implied 只會加不會減，拔掉監造系統管理員後水位管理權限會殘留。 -->
    <data noupdate="1">
        <record id="group_water_level_manager" model="res.groups">
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
