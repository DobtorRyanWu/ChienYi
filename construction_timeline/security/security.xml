<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 工時記錄資料隔離規則                              -->
        <!-- ============================================== -->

        <!-- 工時記錄 - 使用者可存取自己的工時記錄 -->
        <record id="rule_timesheet_user_own" model="ir.rule">
            <field name="name">工時記錄: 使用者存取自己的記錄</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 系統管理者 - 完整存取 -->
        <record id="rule_timesheet_admin_full_access" model="ir.rule">
            <field name="name">工時記錄: 管理者完整存取</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
