<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 工程例假日（合約 §4）：監造方可改，營造方唯讀（dash_rest_days_readonly） -->
    <record id="view_project_form_rest_days" model="ir.ui.view">
        <field name="name">project.project.form.rest.days</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="construction_supervision_base.view_supervision_project_form"/>
        <field name="arch" type="xml">
            <group name="actual_dates" position="after">
                <group string="例假日（工作天計算）" name="rest_days">
                    <field name="dash_rest_days_readonly" invisible="1"/>
                    <field name="rest_day_mon" readonly="dash_rest_days_readonly"/>
                    <field name="rest_day_tue" readonly="dash_rest_days_readonly"/>
                    <field name="rest_day_wed" readonly="dash_rest_days_readonly"/>
                    <field name="rest_day_thu" readonly="dash_rest_days_readonly"/>
                    <field name="rest_day_fri" readonly="dash_rest_days_readonly"/>
                    <field name="rest_day_sat" readonly="dash_rest_days_readonly"/>
                    <field name="rest_day_sun" readonly="dash_rest_days_readonly"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
