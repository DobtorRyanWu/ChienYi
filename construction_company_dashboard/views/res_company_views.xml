<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 新建公司必選公司類型（合約 §0b-30）：欄位必填、移到公司名稱底下（原本在「工程監造」分頁裡，
         新建時不會看到）；畫面不預帶值由 models/company_type_choice.py 處理。原分頁的「公司類型」群組只剩標題，藏起來。 -->
    <record id="view_company_form_dash_type_required" model="ir.ui.view">
        <field name="name">res.company.form.dash.company.type.required</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="construction_supervision_base.view_company_form_supervision"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <!-- 原「公司類型」群組（欄位的父節點）：移走欄位前先藏起來（繼承不能用 string 當選擇器） -->
            <xpath expr="//field[@name='company_type']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <label for="company_type"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/label[@for='company_type']" position="after">
                <xpath expr="//field[@name='company_type']" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
