<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="construction_company_dashboard.KanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <div class="o_dash_top px-3 pt-3">
                <div t-if="totpMissing" class="alert alert-warning o_dash_totp_alert" role="alert">
                    <strong>請到「我的偏好」啟用兩步驟驗證後才看得到資料。</strong>
                    （右上角頭像 → 我的偏好 → 帳號安全）
                </div>
                <div t-if="dash.blockedMessage and !totpMissing" class="alert alert-warning o_dash_blocked_alert" role="alert">
                    <t t-esc="dash.blockedMessage"/>
                </div>
                <div t-if="dash.loadError" class="alert alert-danger o_dash_kpi_error" role="alert">
                    公司合計：<t t-esc="dash.loadError"/>
                </div>
                <div t-if="dash.kpis" class="o_dash_kpis d-flex flex-wrap gap-2">
                    <t t-foreach="dash.kpis" t-as="kpi" t-key="kpi.key">
                        <div class="o_dash_kpi card px-3 py-2"
                             t-att-class="{'o_dash_kpi_ok': kpi.status === 'ok'}"
                             t-att-data-kpi="kpi.key"
                             t-on-click="() => this.onKpiClick(kpi)">
                            <div class="o_dash_kpi_label text-muted small" t-esc="kpi.label"/>
                            <t t-if="kpi.status === 'ok'">
                                <div class="o_dash_kpi_value fs-4 fw-bold">
                                    <a href="#" t-on-click.prevent="() => this.onKpiClick(kpi)"><t t-esc="kpi.count"/></a>
                                </div>
                                <div t-if="kpi.amount !== null" class="o_dash_kpi_amount small">
                                    <t t-esc="formatAmount(kpi.amount)"/> 元
                                </div>
                                <div t-if="dash.openKey === kpi.key" class="o_dash_kpi_parts small">
                                    <t t-foreach="kpi.parts" t-as="part" t-key="part.model">
                                        <div>
                                            <a href="#" t-on-click.prevent.stop="() => this.drilldown(kpi.key, part.model)">
                                                <t t-esc="part.label"/>：<t t-esc="part.count"/>
                                            </a>
                                        </div>
                                    </t>
                                </div>
                            </t>
                            <div t-else="" class="o_dash_kpi_reason o_dash_bad small" t-esc="kpi.message"/>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>
