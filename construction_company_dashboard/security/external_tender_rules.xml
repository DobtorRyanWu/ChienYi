<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 外部標案（淞源 C6）：多公司——只看自己允許公司的 -->
        <record id="external_tender_company_rule" model="ir.rule">
            <field name="name">外部標案：所屬公司在允許公司內</field>
            <field name="model_id" ref="model_construction_external_tender"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
