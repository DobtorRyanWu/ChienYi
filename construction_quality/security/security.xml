<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Record Rules -->

        <!-- 一般式自主檢查 - 公司隔離 -->
        <record id="rule_general_inspection_company" model="ir.rule">
            <field name="name">一般式自主檢查: 公司隔離</field>
            <field name="model_id" ref="model_general_self_inspection"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 預約式自主檢查 - 公司隔離 -->
        <record id="rule_reservation_inspection_company" model="ir.rule">
            <field name="name">預約式自主檢查: 公司隔離</field>
            <field name="model_id" ref="model_reservation_self_inspection"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 預約式缺失改善 - 公司隔離 -->
        <record id="rule_reservation_defect_company" model="ir.rule">
            <field name="name">預約式缺失改善: 公司隔離</field>
            <field name="model_id" ref="model_reservation_defect_improvement"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 自主檢查類型 - 所有使用者可讀 -->
        <record id="rule_inspection_type_read" model="ir.rule">
            <field name="name">自主檢查類型: 所有使用者可讀</field>
            <field name="model_id" ref="model_self_inspection_type"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 系統管理者 - 完整存取 -->
        <record id="rule_admin_full_access_inspection" model="ir.rule">
            <field name="name">管理者: 一般式自主檢查完整存取</field>
            <field name="model_id" ref="model_general_self_inspection"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_reservation_inspection" model="ir.rule">
            <field name="name">管理者: 預約式自主檢查完整存取</field>
            <field name="model_id" ref="model_reservation_self_inspection"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_reservation_defect" model="ir.rule">
            <field name="name">管理者: 預約式缺失改善完整存取</field>
            <field name="model_id" ref="model_reservation_defect_improvement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
