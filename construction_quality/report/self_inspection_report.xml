        <field name="report_file">construction_quality.report_reservation_self_inspection</field>
        <field name="print_report_name">'自主檢查_%s_%s' % (object.inspection_no or '', object.inspection_date or '')</field>
        <field name="binding_model_id" ref="model_reservation_self_inspection"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_self_inspection"/>
