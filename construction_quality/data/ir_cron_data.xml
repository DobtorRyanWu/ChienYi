<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            預約式缺失改善的逾期排程。

            is_overdue / overdue_days 是 store=True 的計算欄位，depends 只有
            deadline/state/closure_date，不含「今天」，因此期限過了不會自己翻成逾期，
            必須靠排程定期重算。後台「預約式逾期缺失」選單的 domain 就是
            is_overdue = True，沒有排程等於那個選單永遠是空的。

            一般式的對應排程在 construction_general/data/ir_cron_data.xml
            （general.defect.improvement 定義在 construction_general，本模組不能 ref 它）。
            兩邊呼叫的是同一組 mixin 方法。
        -->

        <!-- 預約式缺失逾期通知（每日）-->
        <record id="cron_reservation_defect_overdue_notification" model="ir.cron">
            <field name="name">預約式缺失逾期通知（每日）</field>
            <field name="model_id" ref="model_reservation_defect_improvement"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_overdue_notification()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- 預約式缺失逾期狀態更新（每小時）-->
        <record id="cron_reservation_defect_check_overdue" model="ir.cron">
            <field name="name">預約式缺失逾期狀態更新（每小時）</field>
            <field name="model_id" ref="model_reservation_defect_improvement"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

    </data>
</odoo>
