<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 缺失逾期通知排程任務（每日 08:00 執行）-->
        <record id="cron_defect_overdue_notification" model="ir.cron">
            <field name="name">缺失逾期通知（每日）</field>
            <field name="model_id" ref="model_supervision_defect"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_overdue_notification()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- 缺失逾期狀態更新排程任務（每小時執行）-->
        <record id="cron_defect_check_overdue" model="ir.cron">
            <field name="name">缺失逾期狀態更新（每小時）</field>
            <field name="model_id" ref="model_supervision_defect"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>

    </data>
</odoo>
