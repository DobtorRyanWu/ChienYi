<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 預約式缺失改善 List View -->
    <record id="view_reservation_defect_improvement_tree" model="ir.ui.view">
        <field name="name">reservation.defect.improvement.tree</field>
        <field name="model">reservation.defect.improvement</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state == 'closed'">
                <field name="record_no"/>
                <field name="slip_id"/>
                <field name="project_id"/>
                <field name="source_type"/>
                <field name="defect_category"/>
                <field name="severity"
                       decoration-warning="severity == 'major'"
                       decoration-danger="severity == 'critical'"
                       widget="badge"/>
                <field name="defect_location"/>
                <field name="found_date"/>
                <field name="deadline"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="overdue_days"
                       decoration-danger="overdue_days > 0"/>
                <field name="responsible_user_id"/>
                <field name="state"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('notified', 'improving')"
                       decoration-primary="state == 'improved'"
                       decoration-success="state in ('verified', 'closed')"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- 預約式缺失改善 Form View -->
    <record id="view_reservation_defect_improvement_form" model="ir.ui.view">
        <field name="name">reservation.defect.improvement.form</field>
        <field name="model">reservation.defect.improvement</field>
        <field name="arch" type="xml">
            <form string="預約式缺失改善">
                <header>
                    <button name="action_notify"
                            string="通知改善"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_improvement"
                            string="開始改善"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'notified'"/>
                    <button name="action_complete_improvement"
                            string="完成改善"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'improving'"/>
                    <button name="action_verify_pass"
                            string="驗證通過"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'improved'"/>
                    <button name="action_verify_fail"
                            string="驗證不通過"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'improved'"/>
                    <button name="action_close"
                            string="結案"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'verified'"/>
                    <button name="action_reopen"
                            string="重新開啟"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('verified', 'closed')"/>
                    <button name="action_reset_draft"
                            string="重設"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'notified')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,notified,improving,improved,verified,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="已逾期" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1>
                            <field name="record_no" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="通報單資訊">
                            <field name="slip_id" required="1"/>
                            <field name="project_id"/>
                            <field name="record_type" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="缺失分類">
                            <field name="source_type"/>
                            <field name="check_type"/>
                            <field name="defect_category" invisible="1"/>
                            <field name="defect_category_construction"
                                   invisible="check_type != 'construction'"
                                   required="check_type == 'construction'"/>
                            <field name="defect_category_safety"
                                   invisible="check_type != 'safety_env'"
                                   required="check_type == 'safety_env'"/>
                            <field name="severity" invisible="not id"/>
                        </group>
                    </group>
                    <group>
                        <group string="發現資訊">
                            <field name="discovery_unit"/>
                            <field name="discovery_user_id"/>
                            <field name="found_date"/>
                        </group>
                        <group string="改善責任">
                            <field name="improvement_unit"/>
                            <field name="responsible_user_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="日期">
                            <field name="notification_date"/>
                            <field name="deadline"/>
                            <field name="improvement_date" readonly="1" invisible="not id"/>
                            <field name="closure_date" readonly="1" invisible="not id"/>
                        </group>
                        <group string="逾期與罰款狀態" invisible="not id">
                            <field name="is_overdue"/>
                            <field name="overdue_days"/>
                            <field name="is_fined"/>
                            <field name="fine_amount" invisible="not is_fined"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="not id or not is_fined">
                        <group string="罰款說明">
                            <field name="fine_note" nolabel="1"/>
                        </group>
                    </group>

                    <field name="supervision_prefix" invisible="1"/>
                    <field name="contractor_prefix" invisible="1"/>

                    <notebook>
                        <!-- 缺失內容 -->
                        <page string="缺失內容" name="defect">
                            <group>
                                <field name="defect_location"/>
                            </group>
                            <group string="缺失具體情形">
                                <field name="defect_description" nolabel="1"/>
                            </group>
                            <group string="缺失原因" invisible="not id">
                                <field name="defect_cause" nolabel="1"/>
                            </group>
                        </page>

                        <!-- 改善內容 -->
                        <page string="改善內容" name="improvement" invisible="not id">
                            <group string="矯正措施">
                                <field name="improvement_action" nolabel="1"/>
                            </group>
                            <group string="預防措施">
                                <field name="prevention_action" nolabel="1"/>
                            </group>
                            <group string="改善結果">
                                <field name="improvement_result" nolabel="1"/>
                            </group>
                        </page>

                        <!-- 複查資訊 -->
                        <page string="複查資訊" name="recheck" invisible="not id">
                            <group>
                                <group string="複查資訊">
                                    <field name="recheck_date"/>
                                    <field name="recheck_result"/>
                                </group>
                            </group>
                            <group string="複查說明">
                                <field name="recheck_note" nolabel="1"/>
                            </group>
                        </page>

                        <!-- 照片附件 -->
                        <page string="照片附件" name="photos">
                            <!-- 批次上傳：三階段各一顆。只在編輯模式出現 ——
                                 記錄尚未存檔時沒有 active_id，精靈無從得知要掛哪筆缺失。 -->
                            <div class="mb-2" invisible="not id">
                                <button name="%(construction_photo.action_photo_upload_wizard)d"
                                        type="action" string="上傳 矯正前照片"
                                        class="btn-primary" icon="fa-camera"
                                        context="{'default_photo_stage': 'before'}"/>
                                <button name="%(construction_photo.action_photo_upload_wizard)d"
                                        type="action" string="上傳 矯正中照片"
                                        class="btn-secondary" icon="fa-camera"
                                        context="{'default_photo_stage': 'during'}"/>
                                <button name="%(construction_photo.action_photo_upload_wizard)d"
                                        type="action" string="上傳 矯正後照片"
                                        class="btn-secondary" icon="fa-camera"
                                        context="{'default_photo_stage': 'after'}"/>
                            </div>

                            <!-- 三個階段**垂直排列**（與一般式缺失同步）。
                                 原本外層 <group> 包三個內層 <group>，Odoo 的 group
                                 預設兩欄 → 前／中 並排、後 掉到第二列，看起來像
                                 「一左一右」。改用 <separator> 直接堆在 page 底下。 -->

                            <div invisible="id">
                                <separator string="缺失照片"/>
                                <field name="before_photo_ids" nolabel="1" mode="kanban" create="false"
                                       context="{'default_photo_stage': 'before',
                                                 'kanban_view_ref': 'construction_photo.supervision_photo_view_kanban_embedded',
                                                 'form_view_ref': 'construction_photo.supervision_photo_view_form_embedded'}"/>
                            </div>

                            <div invisible="not id">
                                <separator string="矯正及預防前"/>
                                <field name="before_photo_ids" nolabel="1" mode="kanban" create="false"
                                       context="{'default_photo_stage': 'before',
                                                 'kanban_view_ref': 'construction_photo.supervision_photo_view_kanban_embedded',
                                                 'form_view_ref': 'construction_photo.supervision_photo_view_form_embedded'}"/>

                                <separator string="矯正及預防中"/>
                                <field name="during_photo_ids" nolabel="1" mode="kanban" create="false"
                                       context="{'default_photo_stage': 'during',
                                                 'kanban_view_ref': 'construction_photo.supervision_photo_view_kanban_embedded',
                                                 'form_view_ref': 'construction_photo.supervision_photo_view_form_embedded'}"/>

                                <separator string="矯正及預防後"/>
                                <field name="after_photo_ids" nolabel="1" mode="kanban" create="false"
                                       context="{'default_photo_stage': 'after',
                                                 'kanban_view_ref': 'construction_photo.supervision_photo_view_kanban_embedded',
                                                 'form_view_ref': 'construction_photo.supervision_photo_view_form_embedded'}"/>
                            </div>

                            <group string="相關文件附件">
                                <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                            </group>
                        </page>

                        <!-- 驗證結案 -->
                        <page string="驗證結案" name="verification" invisible="not id">
                            <group>
                                <group string="驗證資訊">
                                    <field name="verifier_id"/>
                                    <field name="verify_date"/>
                                    <field name="verify_result"/>
                                </group>
                                <group string="結案資訊">
                                    <field name="closer_id"/>
                                    <field name="closure_date"/>
                                </group>
                            </group>
                            <group string="驗證意見">
                                <field name="verify_comment" nolabel="1"/>
                            </group>
                            <group string="結案說明">
                                <field name="close_comment" nolabel="1"/>
                            </group>
                        </page>

                        <!-- 關聯與備註 -->
                        <page string="關聯與備註" name="relations" invisible="not id">
                            <group string="備註">
                                <field name="note" nolabel="1"/>
                            </group>
                        </page>

                        <!-- 編號資訊 -->
                        <page string="編號資訊" name="number_info">
                            <group>
                                <group>
                                    <field name="sequence_number"/>
                                    <field name="found_date"/>
                                    <field name="check_type"/>
                                    <field name="record_type" readonly="1"/>
                                </group>
                                <group>
                                    <div class="alert alert-info" role="alert">
                                        <strong>📌 記錄類型（監造／營造）的決定方式</strong>：<br/>
                                        • 直接從選單新增：依進入的選單決定（「監造缺失改善」=監造、「營造缺失改善」=營造）<br/>
                                        • 從自主檢查「建立缺失改善」精靈建立：於精靈中選擇<br/>
                                        <br/>
                                        <strong>⚠️ 注意</strong>：修改「當日序號」後編號會自動重新計算，<br/>
                                        請確保不會與其他記錄產生衝突。
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- 預約式缺失改善 Search View -->
    <record id="view_reservation_defect_improvement_search" model="ir.ui.view">
        <field name="name">reservation.defect.improvement.search</field>
        <field name="model">reservation.defect.improvement</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_no"/>
                <field name="slip_id"/>
                <field name="project_id"/>
                <field name="defect_description"/>
                <field name="responsible_user_id"/>
                <separator/>
                <filter string="草稿" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="已通知" name="notified"
                        domain="[('state', '=', 'notified')]"/>
                <filter string="改善中" name="improving"
                        domain="[('state', '=', 'improving')]"/>
                <filter string="已改善" name="improved"
                        domain="[('state', '=', 'improved')]"/>
                <filter string="已驗證" name="verified"
                        domain="[('state', '=', 'verified')]"/>
                <filter string="結案" name="closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="待處理" name="pending"
                        domain="[('state', 'in', ('notified', 'improving'))]"/>
                <filter string="已逾期" name="is_overdue"
                        domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter string="施工檢查" name="construction"
                        domain="[('check_type', '=', 'construction')]"/>
                <filter string="安衛環境" name="safety_env"
                        domain="[('check_type', '=', 'safety_env')]"/>
                <separator/>
                <filter string="監造記錄" name="supervision"
                        domain="[('record_type', '=', 'supervision')]"/>
                <filter string="營造記錄" name="contractor"
                        domain="[('record_type', '=', 'contractor')]"/>
                <separator/>
                <group expand="0" string="群組" name="groupby">
                    <filter string="通報單" name="group_slip"
                            context="{'group_by': 'slip_id'}"/>
                    <filter string="工程" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="缺失類別" name="group_category"
                            context="{'group_by': 'defect_category'}"/>
                    <filter string="嚴重程度" name="group_severity"
                            context="{'group_by': 'severity'}"/>
                    <filter string="狀態" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="記錄類型" name="group_record_type"
                            context="{'group_by': 'record_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 預約式缺失改善 Kanban View -->
    <record id="view_reservation_defect_improvement_kanban" model="ir.ui.view">
        <field name="name">reservation.defect.improvement.kanban</field>
        <field name="model">reservation.defect.improvement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="record_no"/>
                <field name="slip_id"/>
                <field name="defect_category"/>
                <field name="severity"/>
                <field name="deadline"/>
                <field name="is_overdue"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_title">
                                <strong><field name="record_no"/></strong>
                                <span t-if="record.is_overdue.raw_value" class="badge text-bg-danger ms-1">逾期</span>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="slip_id"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <span t-if="record.severity.raw_value == 'critical'" class="badge text-bg-danger">嚴重</span>
                                    <span t-if="record.severity.raw_value == 'major'" class="badge text-bg-warning">重大</span>
                                    <span t-if="record.severity.raw_value == 'moderate'" class="badge text-bg-secondary">中等</span>
                                    <field name="defect_category"/>
                                </div>
                                <div t-if="record.deadline.raw_value">
                                    改善期限: <field name="deadline"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 監造缺失改善 -->
    <record id="action_reservation_defect_improvement_supervision" model="ir.actions.act_window">
        <field name="name">預約式監造缺失改善</field>
        <field name="res_model">reservation.defect.improvement</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_reservation_defect_improvement_search"/>
        <field name="domain">[('record_type', '=', 'supervision')]</field>
        <field name="context">{
            'default_record_type': 'supervision',
            'search_default_group_project': 1,
            'search_default_group_slip': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一筆監造缺失改善記錄
            </p>
            <p>
                記錄監造單位發現的缺失及其改善情況。
            </p>
        </field>
    </record>

    <!-- 營造缺失改善 -->
    <record id="action_reservation_defect_improvement_contractor" model="ir.actions.act_window">
        <field name="name">預約式營造缺失改善</field>
        <field name="res_model">reservation.defect.improvement</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_reservation_defect_improvement_search"/>
        <field name="domain">[('record_type', '=', 'contractor')]</field>
        <field name="context">{
            'default_record_type': 'contractor',
            'search_default_group_project': 1,
            'search_default_group_slip': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一筆營造缺失改善記錄
            </p>
            <p>
                記錄營造廠商發現的缺失及其改善情況。
            </p>
        </field>
    </record>

    <!-- 監造逾期缺失 -->
    <record id="action_reservation_defect_improvement_supervision_overdue" model="ir.actions.act_window">
        <field name="name">預約式監造逾期缺失</field>
        <field name="res_model">reservation.defect.improvement</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_reservation_defect_improvement_search"/>
        <field name="domain">[
            ('record_type', '=', 'supervision'),
            ('is_overdue', '=', True),
            ('state', 'not in', ('verified', 'closed'))
        ]</field>
        <field name="context">{'default_record_type': 'supervision'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                目前沒有逾期的監造缺失改善
            </p>
        </field>
    </record>

    <!-- 營造逾期缺失 -->
    <record id="action_reservation_defect_improvement_contractor_overdue" model="ir.actions.act_window">
        <field name="name">預約式營造逾期缺失</field>
        <field name="res_model">reservation.defect.improvement</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_reservation_defect_improvement_search"/>
        <field name="domain">[
            ('record_type', '=', 'contractor'),
            ('is_overdue', '=', True),
            ('state', 'not in', ('verified', 'closed'))
        ]</field>
        <field name="context">{'default_record_type': 'contractor'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                目前沒有逾期的營造缺失改善
            </p>
        </field>
    </record>

    <!-- 預約式缺失改善 Action (向後兼容) -->
    <record id="action_reservation_defect_improvement" model="ir.actions.act_window">
        <field name="name">預約式缺失改善</field>
        <field name="res_model">reservation.defect.improvement</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_reservation_defect_improvement_search"/>
        <field name="context">{'search_default_group_project': 1, 'search_default_group_slip': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一筆缺失改善記錄
            </p>
            <p>
                預約式缺失改善用於追蹤通報單中的施工缺失及其改善狀態。
            </p>
        </field>
    </record>

    <!-- 預約式逾期缺失 Action (不分監造/營造，顯示該專案類型所有逾期缺失) -->
    <record id="action_reservation_defect_improvement_overdue" model="ir.actions.act_window">
        <field name="name">預約式逾期缺失</field>
        <field name="res_model">reservation.defect.improvement</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_reservation_defect_improvement_search"/>
        <field name="domain">[('is_overdue', '=', True), ('state', 'not in', ('verified', 'closed'))]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                目前沒有逾期的缺失改善
            </p>
        </field>
    </record>

</odoo>
