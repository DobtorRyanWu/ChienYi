<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 契約工項選擇用 Tree View（Many2many 彈出視窗用） -->
    <record id="view_project_task_inspection_selection_tree" model="ir.ui.view">
        <field name="name">project.task.inspection.selection.tree</field>
        <field name="model">project.task</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="項目及說明"/>
                <field name="parent_id" string="父工項"/>
                <field name="item_no" string="工項編號"/>
                <field name="unit" string="單位"/>
                <field name="planned_qty" string="契約數量"/>
            </list>
        </field>
    </record>

    <!-- 自主檢查類型 Tree View -->
    <record id="view_self_inspection_type_tree" model="ir.ui.view">
        <field name="name">self.inspection.type.tree</field>
        <field name="model">self.inspection.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="description"/>
                <field name="sequence" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- 自主檢查類型 Form View -->
    <record id="view_self_inspection_type_form" model="ir.ui.view">
        <field name="name">self.inspection.type.form</field>
        <field name="model">self.inspection.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inspections"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check-square-o">
                            <field name="inspection_count" widget="statinfo" string="檢查次數"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="已封存" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="code"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group>
                        <field name="template_file" filename="template_filename"/>
                        <field name="template_filename" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="查驗段落" name="stages">
                            <div class="alert alert-info" role="alert">
                                段落＝抽查紀錄表的分段（例：一 廠商自主檢查／二 施工中／三 銑刨作業）。
                                新類型預設帶「施工前／施工中／施工後」，可自行增刪與拖曳排序。
                                <b>新類型請先儲存，再到下一頁籤設定各項目的段落。</b>
                            </div>
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="legacy_code" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="預設檢查項目" name="default_items">
                            <field name="default_item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="stage_id"
                                           domain="[('type_id', '=', parent.id)]"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="check_standard"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="關聯契約工項" name="tasks">
                            <field name="task_ids"
                                   context="{'list_view_ref': 'construction_quality.view_project_task_inspection_selection_tree'}">
                                <list>
                                    <field name="name" string="項目及說明"/>
                                    <field name="parent_id" string="父工項"/>
                                    <field name="item_no" string="工項編號"/>
                                    <field name="unit" string="單位"/>
                                    <field name="planned_qty" string="契約數量"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 自主檢查類型 Search View -->
    <record id="view_self_inspection_type_search" model="ir.ui.view">
        <field name="name">self.inspection.type.search</field>
        <field name="model">self.inspection.type</field>
        <field name="arch" type="xml">
            <search>
                <!-- 預設搜尋同時比對 名稱/代碼/說明，方便快速篩選 -->
                <field name="name" string="名稱/代碼/說明"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('description', 'ilike', self)]"/>
                <field name="code" string="代碼"/>
                <field name="project_id"/>
                <filter string="結構工程" name="structure"
                        domain="[('category', '=', 'structure')]"/>
                <filter string="土木工程" name="civil"
                        domain="[('category', '=', 'civil')]"/>
                <filter string="電氣工程" name="electrical"
                        domain="[('category', '=', 'electrical')]"/>
                <filter string="已封存" name="inactive"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="群組" name="groupby">
                    <filter string="所屬工程" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="工程類別" name="group_category"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 自主檢查類型 Action -->
    <record id="action_self_inspection_type" model="ir.actions.act_window">
        <field name="name">自主檢查類型</field>
        <field name="res_model">self.inspection.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_self_inspection_type_search"/>
        <field name="context">{"search_default_group_project": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一個自主檢查類型
            </p>
            <p>
                自主檢查類型用於管理不同工程項目的檢查表樣板。
            </p>
        </field>
    </record>

    <!-- 自主檢查項目樣板庫 Action（系統設定 > 樣板設定 用）
         只顯示全域樣板（project_id = False），即匯入的共用樣板庫，依工程類別分組 -->
    <record id="action_self_inspection_type_library" model="ir.actions.act_window">
        <field name="name">自主檢查項目樣板庫</field>
        <field name="res_model">self.inspection.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('project_id', '=', False)]</field>
        <field name="search_view_id" ref="view_self_inspection_type_search"/>
        <field name="context">{'default_project_id': False, 'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                尚無全域樣板
            </p>
            <p>
                這裡列出所有共用的自主檢查項目樣板（含檢查項目與檢查標準），<br/>
                可供各工程建立自主檢查時直接選用。
            </p>
        </field>
    </record>

</odoo>
