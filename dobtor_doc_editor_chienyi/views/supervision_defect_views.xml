<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supervision_defect_form_dobtor" model="ir.ui.view">
        <field name="name">supervision.defect.form.dobtor</field>
        <field name="model">supervision.defect</field>
        <field name="inherit_id" ref="construction_quality.view_supervision_defect_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_linked_doc"
                        string="開啟線上文件"
                        type="object"
                        class="oe_highlight"
                        icon="fa-file-text-o"
                        invisible="state == 'closed'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="linked_doc_id" invisible="1"/>
                <field name="linked_doc_count" invisible="1"/>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="dobtor_button_box">
                    <button name="action_open_linked_doc"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="linked_doc_count == 0">
                        <field name="linked_doc_count" widget="statinfo"
                               string="線上文件"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
