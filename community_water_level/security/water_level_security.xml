                                        ('site_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="water_level_reading_community_member_rule" model="ir.rule">
            <field name="name">Portal: 水位紀錄 - 僅前台成員的社區</field>
            <field name="model_id" ref="water_level_core.model_water_level_reading"/>
            <field name="domain_force">[('device_id.site_id.site_type', '=', 'community'),
                                        ('device_id.site_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 2026-10 補洞：容量曲線、事件、事件影像、日摘要原本給了 portal 讀取 ACL 卻沒有 rule，
             等於任何前台帳號都讀得到所有場域的資料。改成跟著社區成員走。 -->
        <record id="water_level_tank_curve_community_member_rule" model="ir.rule">
            <field name="name">Portal: 容量曲線 - 僅前台成員的社區</field>
