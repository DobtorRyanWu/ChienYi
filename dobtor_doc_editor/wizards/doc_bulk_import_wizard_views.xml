<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 批次匯入 wizard form -->
    <record id="view_doc_bulk_import_wizard_form" model="ir.ui.view">
        <field name="name">doc.bulk.import.wizard.form</field>
        <field name="model">doc.bulk.import.wizard</field>
        <field name="arch" type="xml">
            <form string="批次匯入文件">
                <sheet>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft'">
                        <p>
                            上傳含多個 <strong>.docx</strong> 的 ZIP 壓縮檔，
                            wizard 會逐一解析建立 <em>doc.document</em>。
                        </p>
                        <ul>
                            <li>限制：壓縮檔內最多 5000 個檔案、解壓後總計不超過 500 MB；
                                每個 .docx 內部最多 1000 個項目、解壓後不超過 200 MB；
                                壓縮比異常（單一檔案超過 1 MB 且壓縮 100 倍以上）會被拒絕</li>
                            <li>每個 .docx 會建立一筆「<em>檔名 [批次匯入_YYYY-MM-DD]</em>」文件</li>
                            <li>失敗的檔案會列在結果區，可選擇略過繼續或中止</li>
                        </ul>
                    </div>

                    <group invisible="state != 'draft'">
                        <field name="archive_file" filename="archive_filename"/>
                        <field name="archive_filename" invisible="1"/>
                        <field name="target_company_id"/>
                        <field name="skip_failures"/>
                    </group>

                    <group invisible="state == 'draft'">
                        <field name="state" readonly="1"/>
                        <field name="created_count" readonly="1"/>
                        <field name="failed_count" readonly="1"/>
                        <field name="log_text" readonly="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run_import" type="object"
                            string="開始匯入" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button special="cancel" string="關閉"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_doc_bulk_import_wizard" model="ir.actions.act_window">
        <field name="name">批次匯入文件</field>
        <field name="res_model">doc.bulk.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- 注意：menu_doc_bulk_import 的 <menuitem> 已移至 views/menu.xml，
         因為它 parent 指向 menu_dobtor_doc_root（在 menu.xml 定義），
         而本檔在 manifest 中先於 menu.xml 載入，原地放會造成前向引用 ParseError。 -->

</odoo>
