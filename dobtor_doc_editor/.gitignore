# =========================
# 1. 前端開發與編譯暫存 (Node.js / TS)
# =========================
node_modules/
dist/
# 例外：這支 CLI 產物必須進版控。
# 平台是從 GitHub clone 模組原始碼到伺服器，不進 git 就永遠不會出現在那裡；
# 症狀是一切正常直到有人點「文件樣板 → 用編輯器開啟 .docx」，
# 跳出與真正原因完全無關的「DOCX 解析失敗」。
# 「編譯產物不進 git」是通則，此處例外划算：單一檔案、不常變。
!tools/dist/
!tools/dist/parse_docx_cli.cjs
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# CI 輸出（Sprint 20 補入）
tests/vitest-junit.xml
tests/fixtures/sprint18_ratio_grid_report.json
test-results/

# VR run 暫存（Sprint 158 補入）
tests/fixtures/.visual_regression_tmp/
tests/fixtures/**/golden/*_diff.png

# Autopilot Y 本機設定（Sprint 158 補入；per-machine、不進 git）
.antigravity/

# =========================
# 2. Odoo 後端與 Python 暫存
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so

# =========================
# 3. 資安防護 (絕對不可進版控！)
# =========================
.env
.env.*
*.pem
*.key

# =========================
# 4. 作業系統與編輯器垃圾
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/

