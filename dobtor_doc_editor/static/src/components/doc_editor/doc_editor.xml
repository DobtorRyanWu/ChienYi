<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dobtor_doc_editor.DocEditor">
        <!--
            Phase 8 Template UI Builder（ADR-022）— Phase 1 視覺風格靠攏。
            布局對照（圖：dobtor esign template editor）：
              row 1  doc-header-bar     檔名 + 預覽/儲存/關閉
              row 2  doc-subnav         儀表板/請求/範本/設定（Phase 1 只啟用「範本」）
              row 3  doc-toolbar        既有頁面格式/縮放/版本/匯入/匯出/離線（合併進工具列）
              row 4  doc-field-toolbar  欄位類型按鈕 + Odoo 欄位（Phase 1 點擊只彈 toast）
              row 5  doc-signer-bar     簽約人 chip + 頁碼 + zoom-fit
              row 6  doc-main           三欄式：thumbnails / canvas-workspace / inspector
              row 7  doc-statusbar      頁碼/欄位計數/hint
            Phase 1 不動 _initCanvasEditor 邏輯（仍掛在 .canvas-editor-container ref）。
        -->
        <div class="o_action o_dobtor_doc_editor"
             role="application"
             aria-label="文件編輯器">

            <!-- ═══ Row 1：Header bar（檔名 + 主操作）═══ -->
            <div class="doc-header-bar">
                <div class="doc-header-bar-left">
                    <i class="fa fa-file-text-o doc-header-icon" aria-hidden="true"/>
                    <input class="doc-header-title"
                           t-att-value="state.docName"
                           t-on-change="onTitleChange"
                           placeholder="未命名文件"
                           aria-label="文件標題"/>
                </div>
                <div class="doc-header-bar-right">
                    <button class="doc-header-btn"
                            t-on-click="onPreviewClick"
                            title="預覽（Phase 2）"
                            aria-label="預覽">
                        <i class="fa fa-external-link" aria-hidden="true"/>
                        <span class="d-none d-md-inline">預覽</span>
                    </button>
                    <button class="doc-header-btn primary"
                            t-att-class="state.isSaving ? 'saving' : ''"
                            t-on-click="onSave"
                            t-att-disabled="state.isSaving"
                            title="儲存文件 (Ctrl+S)"
                            aria-label="儲存文件"
                            aria-keyshortcuts="Control+S">
                        <i class="fa fa-save" aria-hidden="true"/>
                        <span t-if="state.isSaving">儲存中...</span>
                        <span t-else="">儲存</span>
                    </button>
                    <button class="doc-header-btn"
                            t-on-click="onClose"
                            title="關閉並返回"
                            aria-label="關閉並返回上一頁">
                        <i class="fa fa-times" aria-hidden="true"/>
                        <span class="d-none d-md-inline">關閉</span>
                    </button>
                </div>
            </div>

            <!-- ═══ Row 2：Sub-nav（儀表板/請求/範本/設定）═══ -->
            <nav class="doc-subnav" role="navigation" aria-label="模組分頁">
                <button class="doc-subnav-btn"
                        t-att-class="state.activeSubNav === 'dashboard' ? 'active' : ''"
                        t-on-click="() => this.onSubNavClick('dashboard')"
                        disabled="disabled"
                        title="儀表板（Phase 8 路線圖未開放）">
                    <i class="fa fa-tachometer me-1"/>儀表板
                </button>
                <button class="doc-subnav-btn"
                        t-att-class="state.activeSubNav === 'requests' ? 'active' : ''"
                        t-on-click="() => this.onSubNavClick('requests')"
                        disabled="disabled"
                        title="請求（Phase 8 路線圖未開放）">
                    <i class="fa fa-paper-plane me-1"/>請求
                </button>
                <button class="doc-subnav-btn"
                        t-att-class="state.activeSubNav === 'templates' ? 'active' : ''"
                        t-on-click="() => this.onSubNavClick('templates')"
                        title="範本">
                    <i class="fa fa-file-text me-1"/>範本
                </button>
                <button class="doc-subnav-btn"
                        t-att-class="state.activeSubNav === 'settings' ? 'active' : ''"
                        t-on-click="() => this.onSubNavClick('settings')"
                        disabled="disabled"
                        title="設定（Phase 8 路線圖未開放）">
                    <i class="fa fa-cog me-1"/>設定
                </button>
            </nav>

            <!-- ═══ Row 3：工具列（紙張 / 版本 / 匯入匯出 ‧ 右側縮放）═══
                 設計：左區密集分組（btn-group 共邊框），右區（縮放）用 margin-left:auto
                       推到最右，無論視窗寬度都保持單行視覺秩序。
            ═══ -->
            <div class="doc-toolbar"
                 role="toolbar"
                 aria-label="文件編輯器工具列">

                <!-- 紙張規格 -->
                <div class="doc-toolbar-field">
                    <label class="doc-toolbar-field-label">紙張</label>
                    <select class="doc-toolbar-select"
                            t-on-change="onPageFormatChange"
                            aria-label="頁面格式">
                        <option value="A4">A4</option>
                        <option value="A3">A3</option>
                        <option value="A5">A5</option>
                        <option value="letter">Letter</option>
                        <option value="legal">Legal</option>
                    </select>
                </div>

                <!-- 版本群組（segmented） -->
                <div class="doc-btn-group" role="group" aria-label="版本管理">
                    <button class="doc-toolbar-btn"
                            t-on-click="onSaveVersion"
                            title="儲存目前內容為版本快照"
                            aria-label="儲存版本快照">
                        <i class="fa fa-bookmark" aria-hidden="true"/>
                        <span class="ms-1">存版本</span>
                    </button>
                    <button class="doc-toolbar-btn"
                            t-on-click="onShowVersionPanel"
                            title="查看版本歷史 (Alt+H)"
                            aria-label="查看版本歷史"
                            aria-keyshortcuts="Alt+H"
                            aria-haspopup="dialog">
                        <i class="fa fa-history" aria-hidden="true"/>
                        <span class="ms-1">歷史</span>
                    </button>
                </div>

                <!-- 匯入匯出群組（segmented） -->
                <div class="doc-btn-group" role="group" aria-label="匯入匯出">
                    <button class="doc-toolbar-btn"
                            t-on-click="onExportPdf"
                            title="匯出為 PDF"
                            aria-label="匯出為 PDF">
                        <i class="fa fa-file-pdf-o text-danger" aria-hidden="true"/>
                        <span class="ms-1">PDF</span>
                    </button>
                    <button class="doc-toolbar-btn"
                            t-on-click="onExportDocx"
                            title="匯出為 DOCX"
                            aria-label="匯出為 DOCX">
                        <i class="fa fa-file-word-o text-primary" aria-hidden="true"/>
                        <span class="ms-1">DOCX</span>
                    </button>
                    <button class="doc-toolbar-btn"
                            t-on-click="onImportClick"
                            title="從 DOCX 或 ODT 匯入"
                            aria-label="匯入 DOCX 或 ODT 檔案">
                        <i class="fa fa-upload" aria-hidden="true"/>
                        <span class="ms-1">匯入</span>
                    </button>
                </div>

                <!-- 離線徽章（在線時自動隱藏） -->
                <t t-if="offlineBadge">
                    <span class="doc-toolbar-offline-badge">
                        <i class="fa fa-wifi"/> 離線
                    </span>
                </t>

                <!-- 右側：縮放（margin-left:auto 推到最右） -->
                <div class="doc-toolbar-right">
                    <div class="doc-toolbar-field">
                        <label class="doc-toolbar-field-label">縮放</label>
                        <select class="doc-toolbar-select doc-toolbar-zoom"
                                title="縮放比例"
                                aria-label="縮放比例"
                                t-on-change="onZoomChange">
                            <option value="0.5">50%</option>
                            <option value="0.75">75%</option>
                            <option value="1" selected="">100%</option>
                            <option value="1.25">125%</option>
                            <option value="1.5">150%</option>
                            <option value="2">200%</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- ═══ Row 4：Field toolbar（欄位類型按鈕 + Odoo 欄位）═══ -->
            <div class="doc-field-toolbar"
                 role="toolbar"
                 aria-label="範本欄位工具列">
                <span class="doc-field-toolbar-label">欄位：</span>
                <t t-foreach="FIELD_TYPES" t-as="ft" t-key="ft.key">
                    <button class="doc-field-btn"
                            t-att-data-field-type="ft.key"
                            draggable="true"
                            t-on-click="() => this.onFieldButtonClick(ft.key)"
                            t-on-dragstart="(ev) => this.onFieldDragStart(ev, ft.key)"
                            t-on-dragend="onFieldDragEnd"
                            t-attf-title="點擊插入游標位置，或拖到文件任意處新增「#{ft.label}」欄位"
                            t-attf-aria-label="新增 #{ft.label} 欄位">
                        <t t-if="ft.icon === 'A'">
                            <span class="doc-field-btn-glyph">A</span>
                        </t>
                        <t t-else="">
                            <i t-attf-class="fa #{ft.icon}" aria-hidden="true"/>
                        </t>
                        <span t-esc="ft.label"/>
                    </button>
                </t>

                <div class="doc-field-toolbar-sep" role="separator" aria-hidden="true"/>

                <button class="doc-field-btn doc-field-btn-odoo"
                        t-on-click="onOdooFieldClick"
                        title="插入 Odoo 模型欄位"
                        aria-label="插入 Odoo 模型欄位">
                    <i class="fa fa-database" aria-hidden="true"/>
                    Odoo 欄位
                </button>
            </div>

            <!-- ═══ Row 5：Signer bar（簽約人 chip + 頁碼 + zoom fit）═══ -->
            <div class="doc-signer-bar">
                <span class="doc-signer-bar-label">簽約人：</span>
                <t t-foreach="state.signers" t-as="signer" t-key="signer.id">
                    <button class="doc-signer-chip"
                            t-att-class="state.activeSignerId === signer.id ? 'active' : ''"
                            t-att-style="'--signer-color: ' + signer.color"
                            t-on-click="() => this.onSignerClick(signer.id)"
                            t-attf-aria-label="切換到簽約人 #{signer.name}">
                        <span class="doc-signer-chip-dot"/>
                        <span class="doc-signer-chip-name" t-esc="signer.name"/>
                        <span class="doc-signer-chip-count" t-esc="signer.count"/>
                    </button>
                </t>

                <div class="doc-signer-bar-spacer"/>

                <!-- 頁碼導航 -->
                <button class="doc-pager-btn"
                        t-on-click="onPrevPage"
                        t-att-disabled="state.pageNo &lt;= 1"
                        aria-label="上一頁">
                    <i class="fa fa-chevron-left"/>
                </button>
                <span class="doc-pager-label">
                    <t t-esc="state.pageNo"/> 頁，共 <t t-esc="state.totalPages"/> 頁
                </span>
                <button class="doc-pager-btn"
                        t-on-click="onNextPage"
                        t-att-disabled="state.pageNo &gt;= state.totalPages"
                        aria-label="下一頁">
                    <i class="fa fa-chevron-right"/>
                </button>

                <div class="doc-signer-bar-sep"/>

                <select class="doc-toolbar-select"
                        t-on-change="onZoomFitChange"
                        aria-label="縮放模式">
                    <option value="auto">自動縮放</option>
                    <option value="width">符合寬度</option>
                    <option value="page">符合頁面</option>
                </select>
            </div>

            <!-- ═══ Row 6：Main grid（thumbnails / workspace / inspector）═══ -->
            <div class="doc-main">
                <!-- 左：頁面縮圖 panel（Phase 2 接 canvas-editor 縮圖 API） -->
                <aside class="doc-thumbnail-panel" aria-label="頁面縮圖">
                    <div class="doc-thumbnail-panel-header">頁面</div>
                    <div class="doc-thumbnail-list">
                        <t t-foreach="[1]" t-as="i" t-key="i">
                            <div class="doc-thumbnail-item active">
                                <div class="doc-thumbnail-page"/>
                                <span class="doc-thumbnail-num">
                                    1<span class="doc-thumbnail-badge" t-esc="state.fieldCount"/>
                                </span>
                            </div>
                        </t>
                    </div>
                </aside>

                <!-- 中：canvas-editor workspace（既有 _initCanvasEditor 邏輯不動）
                     Phase 2.2a：是 drag-and-drop drop target，可接受從欄位工具列拖入的欄位 -->
                <section class="doc-workspace"
                         role="region"
                         aria-label="文件編輯區"
                         t-att-class="state.isDropTarget ? 'is-drop-target' : ''"
                         t-on-dragover="onWorkspaceDragOver"
                         t-on-dragleave="onWorkspaceDragLeave"
                         t-on-drop="onWorkspaceDrop"
                         aria-busy="state.editorReady ? 'false' : 'true'">
                    <div class="canvas-editor-container" t-ref="canvasContainer">
                        <t t-if="!state.editorReady">
                            <div class="d-flex justify-content-center align-items-center h-100 py-5"
                                 role="status"
                                 aria-live="polite">
                                <i class="fa fa-spinner fa-spin fa-2x text-muted" aria-hidden="true"/>
                                <span class="ms-3 text-muted">載入中...</span>
                            </div>
                        </t>
                    </div>
                    <!-- Drop hint overlay（拖過時顯示） -->
                    <div class="doc-workspace-drop-hint" t-if="state.isDropTarget">
                        <i class="fa fa-arrow-down fa-2x mb-2"/>
                        <div class="doc-workspace-drop-hint-text">
                            放開以插入欄位到此位置
                        </div>
                    </div>
                </section>

                <!-- 右：Inspector panel — Phase 2.1 補項：雙向綁定 selectedField -->
                <aside class="doc-inspector-panel" aria-label="欄位屬性">
                    <t t-if="selectedField">
                        <div class="doc-inspector-header">
                            <i class="fa fa-cog me-2"/>
                            <span t-esc="selectedFieldLabel"/>
                            <span class="doc-inspector-field-id">#<t t-esc="selectedField.id"/></span>
                        </div>

                        <!-- 填寫者（簽約人下拉） -->
                        <div class="doc-inspector-field">
                            <label>填寫者</label>
                            <select t-on-change="(ev) => this.onInspectorFieldChange('signer_id', ev.target.value)">
                                <t t-foreach="state.signers.filter(s => s.id > 0)" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id"
                                            t-att-selected="s.id === selectedField.signer_id ? 'selected' : ''"
                                            t-esc="s.name"/>
                                </t>
                            </select>
                        </div>

                        <!-- 必填 -->
                        <div class="doc-inspector-field">
                            <label class="doc-inspector-checkbox">
                                <input type="checkbox"
                                       t-att-checked="selectedField.required ? 'checked' : ''"
                                       t-on-change="(ev) => this.onInspectorFieldChange('required', ev.target.checked)"/>
                                必填
                            </label>
                        </div>

                        <!-- 佔位符 -->
                        <div class="doc-inspector-field">
                            <label>佔位符</label>
                            <input type="text"
                                   placeholder="輸入佔位文字"
                                   t-att-value="selectedField.placeholder_text or ''"
                                   t-on-input="(ev) => this.onInspectorFieldChange('placeholder_text', ev.target.value)"/>
                        </div>

                        <!-- 字型大小 -->
                        <div class="doc-inspector-field">
                            <label>字型大小</label>
                            <input type="number" min="6" max="72"
                                   t-att-value="selectedField.font_size or 12"
                                   t-on-input="(ev) => this.onInspectorFieldChange('font_size', ev.target.value)"/>
                        </div>

                        <!-- Odoo 欄位（僅當 field_type === odoo_field 時顯示） -->
                        <t t-if="selectedField.field_type === 'odoo_field'">
                            <div class="doc-inspector-field">
                                <label>Odoo 欄位名稱</label>
                                <input type="text" placeholder="如 partner_id.name"
                                       t-att-value="selectedField.odoo_field_name or ''"
                                       t-on-input="(ev) => this.onInspectorFieldChange('odoo_field_name', ev.target.value)"/>
                            </div>
                        </t>

                        <!-- 刪除按鈕（推到底部） -->
                        <div class="doc-inspector-actions">
                            <button class="doc-inspector-delete-btn"
                                    t-on-click="onInspectorDeleteField"
                                    title="從後端紀錄刪除（文件上的占位符需手動按 Del）">
                                <i class="fa fa-trash me-1"/>
                                刪除欄位紀錄
                            </button>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="doc-inspector-empty">
                            <i class="fa fa-mouse-pointer fa-2x text-muted mb-2"/>
                            <p class="text-muted small mb-1">尚未選取欄位</p>
                            <p class="text-muted small">點擊文件上的欄位以編輯屬性</p>
                        </div>
                    </t>
                </aside>
            </div>

            <!-- ═══ 模板變數面板（既有 isTemplateMode）═══ -->
            <t t-if="state.isTemplateMode">
                <div class="doc-template-bar">
                    <span class="doc-template-bar-label">
                        <i class="fa fa-file-word-o me-1"/>
                        <t t-esc="state.templateFilename"/>
                    </span>
                    <span class="doc-template-bar-vars">
                        <t t-foreach="state.templateVariables" t-as="v" t-key="v">
                            <span class="badge bg-secondary me-1" t-esc="v"/>
                        </t>
                        <t t-if="!state.templateVariables.length">
                            <span class="text-muted">（未偵測到變數）</span>
                        </t>
                    </span>
                </div>
                <div class="doc-template-bar" style="align-items:flex-start; flex-direction:column; gap:4px;">
                    <span class="doc-template-bar-label">
                        <i class="fa fa-code me-1"/>
                        Context JSON（匯出時使用）
                    </span>
                    <textarea class="doc-context-json"
                              rows="4"
                              placeholder='{"projectName":"工程名稱","pages":[{"items":[{"no":"1","name":"材料名稱"}]}]}'
                              t-att-value="state.contextJson"
                              t-on-input="(e) => { state.contextJson = e.target.value; }"/>
                </div>
            </t>

            <!-- ═══ Row 7：Statusbar（頁碼 + 欄位計數 + hint）═══ -->
            <div class="doc-statusbar"
                 role="status"
                 aria-live="polite"
                 aria-atomic="true">
                <span class="doc-statusbar-hint d-none d-lg-inline">
                    <i class="fa fa-info-circle me-1"/>
                    從工具列點擊欄位插入文件中。點擊以選取。按 [Del] 以移除。
                </span>
                <span t-att-class="statusClass">
                    <t t-esc="state.statusMsg"/>
                </span>
                <span class="doc-statusbar-counts">
                    頁面 <t t-esc="state.pageNo"/> 的 <t t-esc="state.totalPages"/>
                    │ <t t-esc="state.fieldCount"/> 欄位
                    │ <t t-esc="state.pageFormat"/>
                </span>
            </div>

            <!-- 版本歷史面板（W7-8 P1-1） -->
            <t t-if="state.showVersionPanel and state.docId">
                <DocVersionPanel
                    docId="state.docId"
                    onClose.bind="onCloseVersionPanel"
                    onRestore.bind="onVersionRestored"/>
            </t>

        </div>
    </t>
</templates>
