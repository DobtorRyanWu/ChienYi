<?xml version="1.0" encoding="utf-8"?>
<!--
    估驗計價單 的「列印」按鈕（佔位）
    ⚠️ 僅提供列印入口；實際 PDF 版面由報表負責人於 <template> 設計，現為佔位。
       （未沿用同事版舊估驗報表，因其引用本模型未定義的欄位；版面交由報表負責人重做。）
-->
<odoo>

    <record id="action_report_payment_estimate" model="ir.actions.report">
        <field name="name">估驗計價單</field>
        <field name="model">payment.estimate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">construction_payment.report_payment_estimate</field>
        <field name="report_file">construction_payment.report_payment_estimate</field>
        <field name="binding_model_id" ref="model_payment_estimate"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_payment_estimate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="text-align:center;">估驗計價單</h2>
                        <p>編號／名稱：<span t-field="doc.display_name"/></p>
                        <p class="text-muted" style="margin-top:40px;">
                            （此列印格式尚待設計，將由報表負責人完成；本頁為佔位內容。）
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
