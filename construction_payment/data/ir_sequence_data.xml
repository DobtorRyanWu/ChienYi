<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================= -->
        <!-- Work Acceptance Sequence      -->
        <!-- ============================= -->
        <record id="seq_work_acceptance" model="ir.sequence">
            <field name="name">工項驗收單序號</field>
            <field name="code">work.acceptance</field>
            <field name="prefix">WA%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ============================= -->
        <!-- Payment Estimate Sequence     -->
        <!-- ============================= -->
        <record id="seq_payment_estimate" model="ir.sequence">
            <field name="name">估驗計價序號</field>
            <field name="code">payment.estimate</field>
            <field name="prefix">EST%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ============================= -->
        <!-- Payment Claim Sequence        -->
        <!-- ============================= -->
        <record id="seq_payment_claim" model="ir.sequence">
            <field name="name">請款單序號</field>
            <field name="code">payment.claim</field>
            <field name="prefix">CLM%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
