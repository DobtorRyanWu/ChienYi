<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 核定時有超量明細，先列出工項編號，按確定才核定 -->
    <record id="view_payment_estimate_approve_confirm_form" model="ir.ui.view">
        <field name="name">payment.estimate.approve.confirm.form</field>
        <field name="model">payment.estimate.approve.confirm</field>
        <field name="arch" type="xml">
            <form string="確認核定">
                <div class="alert alert-warning" role="alert">
                    <field name="message" nolabel="1" widget="text"/>
                </div>
                <field name="estimate_ids" invisible="1"/>
                <footer>
                    <button name="action_confirm" string="確定核定" type="object" class="btn-primary"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
