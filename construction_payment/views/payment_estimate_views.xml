<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================== -->
    <!-- Payment Estimate Views -->
    <!-- ====================== -->

    <!-- List View -->
    <record id="view_payment_estimate_tree" model="ir.ui.view">
        <field name="name">payment.estimate.tree</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <list string="估驗計價"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'pending_approval'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'archived'">
                <field name="project_id"/>
                <field name="name" string="估驗名稱"/>
                <field name="estimate_date"/>
                <field name="subtotal" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending_approval'"
                       decoration-success="state == 'approved'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_payment_estimate_form" model="ir.ui.view">
        <field name="name">payment.estimate.form</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <form string="估驗計價">
                <header>
                    <button name="action_open_import_wizard"
                            string="匯入工程案件"
                            type="object"
                            class="btn-primary"
                            icon="fa-download"
                            invisible="state != 'draft' or line_ids"/>
                    <button name="action_submit_estimate"
                            string="提出估驗"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or not line_ids"/>
                    <button name="action_approve"
                            string="核定"
                            type="object"
                            class="btn-success"
                            invisible="state != 'pending_approval'"/>
                    <button name="action_archive_estimate"
                            string="歸檔"
                            type="object"
                            invisible="state != 'approved'"/>
                    <button name="action_reset_to_draft"
                            string="退回草稿"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'pending_approval'"/>
                    <button name="action_backfill_summary_lines"
                            string="補列彙總項"
                            type="object"
                            icon="fa-sitemap"
                            invisible="state not in ('draft', 'pending_approval') or not line_ids"/>
                    <!-- 只有存在人工覆寫金額的工項時才出現 -->
                    <button name="action_open_manual_amount_wizard"
                            string="解除手動金額"
                            type="object"
                            icon="fa-undo"
                            invisible="state not in ('draft', 'pending_approval')
                                       or manual_amount_line_count == 0"/>
                    <field name="manual_amount_line_count" invisible="1"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,approved,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="（自動產生）"/>
                        </h1>
                    </div>

                    <group>
                        <group string="工程資訊">
                            <field name="project_id" readonly="1"/>
                            <field name="contract_no" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="contract_amount" readonly="1"/>
                        </group>
                        <group string="估驗資訊">
                            <field name="submitted_date" readonly="1"/>
                            <field name="estimate_date"
                                   readonly="state in ('approved', 'archived')"/>
                            <!-- 有非契約工項時才拆開顯示三個小計，否則版面照舊 -->
                            <field name="extra_line_count" invisible="1"/>
                            <field name="contract_subtotal" readonly="1"
                                   invisible="extra_line_count == 0"/>
                            <field name="extra_subtotal" readonly="1"
                                   invisible="extra_line_count == 0"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="extra_excluded_total" readonly="1"
                                   invisible="extra_excluded_total == 0"/>
                            <field name="submitted_by_id" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="估驗計價表" name="lines">
                            <field name="line_ids" nolabel="1">
                                <list string="估驗計價表" editable="bottom"
                                      create="false" delete="false"
                                      decoration-bold="is_summary_item">
                                    <field name="is_summary_item" column_invisible="1"/>
                                    <field name="description"/>
                                    <field name="parent_item_name"/>
                                    <field name="item_no"/>
                                    <field name="unit"/>
                                    <field name="contract_qty"/>
                                    <field name="approved_qty"/>
                                    <field name="unit_price"/>
                                    <field name="estimate_qty"
                                           readonly="is_summary_item or parent.state in ('approved', 'archived')"/>
                                    <field name="available_qty"/>
                                    <field name="previous_approved_qty" optional="show"/>
                                    <field name="cumulative_estimate_qty"/>
                                    <!-- 本次估驗金額：可手動覆寫，手動值優先於 單價 × 本次估驗數量。
                                         取消勾選「金額手動輸入」即還原為系統計算值。 -->
                                    <field name="estimate_amount"
                                           decoration-bf="is_amount_manual"
                                           readonly="is_summary_item or parent.state in ('approved', 'archived')"/>
                                    <!-- 旗標不佔欄位（清單已很擠）：只用來讓手動列顯示為粗體，
                                         並讓 onchange 同步。要還原成系統計算值，把金額改回
                                         單價 × 本次估驗數量 即自動解除手動。 -->
                                    <field name="is_amount_manual" column_invisible="1"/>
                                    <field name="manual_estimate_amount" column_invisible="1"/>
                                    <field name="cumulative_estimate_amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <!-- 非契約工項：估驗表上有、契約工項樹裡沒有的項目。
                             這一頁的資料一列都不寫 project.task，契約金額不受影響。 -->
                        <page string="非契約工項" name="extra_lines">
                            <div class="alert alert-info" role="status">
                                <p class="mb-1">
                                    <strong>非契約工項</strong>＝估驗詳細表上會出現、但契約工項樹裡沒有的項目。
                                    常見兩種，行為<strong>相反</strong>：
                                </p>
                                <ul class="mb-1">
                                    <li><strong>貳 物價調整</strong> —— 勾「計入估驗總額」，進本次估驗總金額。</li>
                                    <li><strong>參 變賣收入項</strong>（有價廢料變賣）—— <strong>不</strong>勾，
                                        另走解繳鏈，不進本次估驗總金額。</li>
                                </ul>
                                <p class="mb-0">
                                    金額一律填<strong>來源估驗詳細表印的正數</strong>（變賣收入雖是廠商付錢給機關，
                                    來源表印的也是正數，方向由「計入估驗總額」表達）。
                                    這張清單<strong>只能改本期的東西</strong>（本期顯示名稱、單價、數量、金額、是否計入）；
                                    項目編號／單位／父項屬於工項定義，要改請把「工項定義」欄調出來、點連結進去改。
                                    <strong>「計入估驗總額」由彙總項決定</strong> —— 子列跟著父列走，
                                    改彙總項那一列，底下的子列會自動跟著改。
                                </p>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap" style="margin: 10px 0;">
                                <!-- 這類工項在契約工項建立時根本不存在，所以入口是「新增」而不是
                                     「從下拉挑」。概念比照 契約變更單 ▸ 匯入工程案件精靈 ▸
                                     工項列表頁籤 ▸ [新增工項] 的 form dialog。 -->
                                <button name="action_open_extra_item_wizard"
                                        type="object" string="新增非契約工項"
                                        class="btn-primary" icon="fa-plus"
                                        invisible="state not in ('draft', 'pending_approval') or not project_id"/>
                                <button name="action_load_extra_items"
                                        type="object" string="帶入上期項目"
                                        class="btn-secondary" icon="fa-refresh"
                                        invisible="state not in ('draft', 'pending_approval') or not project_id"
                                        help="把本工程已建立的非契約工項帶進本期（數量 0，單價沿用最近一期）。已存在的列不會被覆寫。"/>
                            </div>
                            <field name="extra_line_ids" nolabel="1"
                                   readonly="state in ('approved', 'archived')">
                                <!-- create="false"：新增一律走上面的精靈（要同時建「工項定義」與
                                     「本期明細」兩筆，清單裡直接加一列做不到這件事）。 -->
                                <list string="非契約工項" editable="bottom" create="false"
                                      decoration-bold="is_summary_item"
                                      decoration-muted="not include_in_subtotal">
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_summary_item" column_invisible="1"/>
                                    <!-- item_level 供下面兩個 readonly 判斷用，
                                         必須留在 view 裡才抓得到值（不能用 optional="hide"）-->
                                    <field name="item_level" column_invisible="1"/>
                                    <field name="item_no" readonly="1"/>
                                    <!-- 🔴 只有這一個名稱欄。它是「本期的名稱」，每期各存一份：
                                         直接改它只影響這一期，其他期別與工項定義都不動。
                                         帶到下一期時會沿用最近一期的字。 -->
                                    <field name="name" string="項目名稱"/>
                                    <!-- 工項定義：點開可改項目編號／單位／父項（跨期共用）-->
                                    <field name="extra_item_id" string="工項定義"
                                           readonly="1" optional="hide"
                                           options="{'no_open': False}"/>
                                    <field name="parent_item_id" string="父工項" readonly="1" optional="show"/>
                                    <field name="unit" readonly="1"/>
                                    <field name="unit_price" readonly="is_summary_item"/>
                                    <field name="estimate_qty" readonly="is_summary_item"/>
                                    <field name="estimate_amount"
                                           decoration-bf="is_amount_manual"
                                           readonly="is_summary_item"/>
                                    <field name="is_amount_manual" column_invisible="1"/>
                                    <field name="manual_estimate_amount" column_invisible="1"/>
                                    <!-- 子列跟著彙總項走：有父項時唯讀，改彙總項那一列即可 -->
                                    <field name="include_in_subtotal" widget="boolean_toggle"
                                           readonly="item_level > 0"/>
                                    <field name="previous_approved_amount" optional="show"/>
                                    <field name="cumulative_estimate_amount"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="照片" name="photos">
                            <!-- 上傳走 construction_photo 的批次精靈：靠 context 的
                                 active_model / active_id 判斷來源，不需要改精靈。 -->
                            <button name="%(construction_photo.action_photo_upload_wizard)d"
                                    type="action" string="批次上傳照片"
                                    class="btn-primary" icon="fa-camera"
                                    invisible="not id"/>
                            <field name="photo_ids" nolabel="1" mode="kanban" create="false"
                                   context="{'kanban_view_ref': 'construction_photo.supervision_photo_view_kanban_embedded',
                                             'form_view_ref': 'construction_photo.supervision_photo_view_form_embedded'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_payment_estimate_search" model="ir.ui.view">
        <field name="name">payment.estimate.search</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <search string="估驗計價">
                <field name="name"/>
                <field name="project_id"/>
                <field name="estimate_no"/>
                <separator/>
                <filter string="草稿" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="待核定" name="filter_pending"
                        domain="[('state', '=', 'pending_approval')]"/>
                <filter string="已核定" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="已歸檔" name="filter_archived"
                        domain="[('state', '=', 'archived')]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="所屬工程" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="狀態" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_payment_estimate" model="ir.actions.act_window">
        <field name="name">估驗計價</field>
        <field name="res_model">payment.estimate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_payment_estimate_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立估驗計價
            </p>
            <p>
                建立新的估驗計價單，透過「匯入工程案件」載入契約工項並填寫估驗數量。
            </p>
        </field>
    </record>

</odoo>
