<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================== -->
    <!-- Payment Estimate Views -->
    <!-- ====================== -->

    <!-- List View -->
    <record id="view_payment_estimate_tree" model="ir.ui.view">
        <field name="name">payment.estimate.tree</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <list string="估驗計價"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'pending_approval'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'archived'">
                <field name="project_id"/>
                <field name="name" string="估驗名稱"/>
                <field name="estimate_date"/>
                <field name="subtotal" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending_approval'"
                       decoration-success="state == 'approved'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_payment_estimate_form" model="ir.ui.view">
        <field name="name">payment.estimate.form</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <form string="估驗計價">
                <header>
                    <button name="action_open_import_wizard"
                            string="匯入工程案件"
                            type="object"
                            class="btn-primary"
                            icon="fa-download"
                            invisible="state != 'draft' or line_ids"/>
                    <button name="action_submit_estimate"
                            string="提出估驗"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or not line_ids"/>
                    <button name="action_approve"
                            string="核定"
                            type="object"
                            class="btn-success"
                            invisible="state != 'pending_approval'"/>
                    <button name="action_archive_estimate"
                            string="歸檔"
                            type="object"
                            invisible="state != 'approved'"/>
                    <button name="action_reset_to_draft"
                            string="退回草稿"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'pending_approval'"/>
                    <button name="action_backfill_summary_lines"
                            string="補列彙總項"
                            type="object"
                            icon="fa-sitemap"
                            invisible="state not in ('draft', 'pending_approval') or not line_ids"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,approved,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="（自動產生）"/>
                        </h1>
                    </div>

                    <group>
                        <group string="工程資訊">
                            <field name="project_id" readonly="1"/>
                            <field name="contract_no" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="contract_amount" readonly="1"/>
                        </group>
                        <group string="估驗資訊">
                            <field name="submitted_date" readonly="1"/>
                            <field name="estimate_date"
                                   readonly="state in ('approved', 'archived')"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="submitted_by_id" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="估驗計價表" name="lines">
                            <field name="line_ids" nolabel="1">
                                <list string="估驗計價表" editable="bottom"
                                      create="false" delete="false"
                                      decoration-bold="is_summary_item">
                                    <field name="is_summary_item" column_invisible="1"/>
                                    <field name="description"/>
                                    <field name="parent_item_name"/>
                                    <field name="item_no"/>
                                    <field name="unit"/>
                                    <field name="contract_qty"/>
                                    <field name="approved_qty"/>
                                    <field name="unit_price"/>
                                    <field name="estimate_qty"
                                           readonly="is_summary_item or parent.state in ('approved', 'archived')"/>
                                    <field name="available_qty"/>
                                    <field name="previous_approved_qty" optional="show"/>
                                    <field name="cumulative_estimate_qty"/>
                                    <field name="estimate_amount"/>
                                    <field name="cumulative_estimate_amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_payment_estimate_search" model="ir.ui.view">
        <field name="name">payment.estimate.search</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <search string="估驗計價">
                <field name="name"/>
                <field name="project_id"/>
                <field name="estimate_no"/>
                <separator/>
                <filter string="草稿" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="待核定" name="filter_pending"
                        domain="[('state', '=', 'pending_approval')]"/>
                <filter string="已核定" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="已歸檔" name="filter_archived"
                        domain="[('state', '=', 'archived')]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="所屬工程" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="狀態" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_payment_estimate" model="ir.actions.act_window">
        <field name="name">估驗計價</field>
        <field name="res_model">payment.estimate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_payment_estimate_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立估驗計價
            </p>
            <p>
                建立新的估驗計價單，透過「匯入工程案件」載入契約工項並填寫估驗數量。
            </p>
        </field>
    </record>

</odoo>
