<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================== -->
    <!-- Payment Estimate Views -->
    <!-- ====================== -->

    <!-- Tree View -->
    <record id="view_payment_estimate_tree" model="ir.ui.view">
        <field name="name">payment.estimate.tree</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <list string="估驗計價" decoration-info="state == 'draft'"
                  decoration-warning="state in ('revision', 'reviewing')"
                  decoration-success="state in ('approved', 'paid')"
                  decoration-muted="state == 'submitted'">
                <field name="name"/>
                <field name="estimate_no"/>
                <field name="project_id"/>
                <field name="company_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="subtotal" sum="Total"/>
                <field name="cumulative_amount"/>
                <field name="completion_rate" widget="progressbar"/>
                <field name="payable_amount" sum="Payable"/>
                <field name="is_final"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('revision', 'reviewing', 'submitted')"
                       decoration-success="state in ('approved', 'paid', 'recommended')"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_payment_estimate_form" model="ir.ui.view">
        <field name="name">payment.estimate.form</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <form string="估驗計價">
                <header>
                    <button name="action_submit"
                            string="提送"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_review"
                            string="開始審查"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="construction_supervision_base.group_supervision_engineer"/>
                    <button name="action_request_revision"
                            string="要求補正"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'reviewing'"
                            groups="construction_supervision_base.group_supervision_engineer"/>
                    <button name="action_recommend"
                            string="建議核定"
                            type="object"
                            class="btn-success"
                            invisible="state != 'reviewing'"
                            groups="construction_supervision_base.group_supervision_engineer"/>
                    <button name="action_approve"
                            string="核定"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'recommended'"
                            groups="construction_supervision_base.group_supervision_manager"/>
                    <button name="action_mark_paid"
                            string="標記已撥付"
                            type="object"
                            invisible="state != 'approved'"
                            groups="construction_supervision_base.group_supervision_manager"/>
                    <button name="action_reset_to_draft"
                            string="重設為草稿"
                            type="object"
                            invisible="state not in ('submitted', 'revision')"
                            groups="base.group_system"/>
                    <button name="action_create_claim"
                            string="建立請款單"
                            type="object"
                            class="btn-success"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,reviewing,recommended,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="尾款" bg_color="bg-info"
                            invisible="not is_final"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="例如：第一期估驗"/>
                        </h1>
                    </div>
                    <group>
                        <group string="基本資訊">
                            <field name="project_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="estimate_no"/>
                            <field name="is_final"/>
                        </group>
                        <group string="估驗期間">
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="acceptance_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="計價明細" name="lines">
                            <field name="line_ids" context="{'default_estimate_id': id}">
                                <list string="計價明細" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="task_id"
                                           options="{'no_create': True}"
                                           domain="[('project_id', '=', parent.project_id)]"/>
                                    <field name="item_no" optional="show"/>
                                    <field name="description" optional="hide"/>
                                    <field name="unit"/>
                                    <field name="planned_qty"/>
                                    <field name="unit_price"/>
                                    <field name="planned_amount"/>
                                    <field name="previous_qty"/>
                                    <field name="current_qty"/>
                                    <field name="cumulative_qty"/>
                                    <field name="current_amount" sum="Total"/>
                                    <field name="cumulative_amount"/>
                                    <field name="completion_rate" widget="progressbar"/>
                                    <field name="over_budget" invisible="1"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <button name="action_load_from_acceptance"
                                            string="從驗收單載入"
                                            type="object"
                                            class="btn-secondary"
                                            icon="fa-download"
                                            invisible="state != 'draft'"/>
                                </group>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="subtotal"/>
                                    <field name="retention_rate"/>
                                    <field name="retention"/>
                                    <field name="payable_amount" class="oe_subtotal_footer_separator"/>
                                    <field name="cumulative_amount"/>
                                    <field name="contract_total"/>
                                    <field name="completion_rate" widget="progressbar"/>
                                </group>
                            </group>
                        </page>
                        <page string="簽核資訊" name="approval">
                            <group>
                                <group string="提送">
                                    <field name="submitter_id" readonly="1"/>
                                    <field name="submit_date" readonly="1"/>
                                </group>
                                <group string="審查">
                                    <field name="reviewer_id" readonly="1"/>
                                    <field name="review_date" readonly="1"/>
                                    <field name="review_comment"/>
                                </group>
                                <group string="核定">
                                    <field name="approver_id" readonly="1"/>
                                    <field name="approve_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="附件" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_payment_estimate_search" model="ir.ui.view">
        <field name="name">payment.estimate.search</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <search string="估驗計價">
                <field name="name"/>
                <field name="project_id"/>
                <field name="company_id"/>
                <field name="estimate_no"/>
                <separator/>
                <filter string="草稿" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="已提送" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="審查中" name="filter_reviewing" domain="[('state', '=', 'reviewing')]"/>
                <filter string="補正" name="filter_revision" domain="[('state', '=', 'revision')]"/>
                <filter string="建議核定" name="filter_recommended" domain="[('state', '=', 'recommended')]"/>
                <filter string="已核定" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="已撥付" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter string="尾款" name="filter_final" domain="[('is_final', '=', True)]"/>
                <filter string="待審核" name="filter_pending_review"
                        domain="[('state', 'in', ('submitted', 'reviewing', 'recommended'))]"/>
                <separator/>
                <filter string="本月" name="filter_this_month"
                        domain="[('period_end', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('period_end', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="工程" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="提送公司" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="期次" name="group_estimate_no" context="{'group_by': 'estimate_no'}"/>
                    <filter string="狀態" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="截止月份" name="group_period" context="{'group_by': 'period_end:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_payment_estimate_kanban" model="ir.ui.view">
        <field name="name">payment.estimate.kanban</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="project_id"/>
                <field name="company_id"/>
                <field name="estimate_no"/>
                <field name="subtotal"/>
                <field name="payable_amount"/>
                <field name="completion_rate"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb8">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span class="badge rounded-pill">
                                        第 <field name="estimate_no"/> 期
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="project_id"/>
                                    <br/>
                                    <field name="company_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="payable_amount" widget="monetary"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="completion_rate" widget="progressbar"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_payment_estimate_pivot" model="ir.ui.view">
        <field name="name">payment.estimate.pivot</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <pivot string="估驗計價分析">
                <field name="project_id" type="row"/>
                <field name="company_id" type="row"/>
                <field name="state" type="col"/>
                <field name="subtotal" type="measure"/>
                <field name="cumulative_amount" type="measure"/>
                <field name="payable_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_payment_estimate_graph" model="ir.ui.view">
        <field name="name">payment.estimate.graph</field>
        <field name="model">payment.estimate</field>
        <field name="arch" type="xml">
            <graph string="估驗計價趨勢" type="line">
                <field name="period_end" type="row" interval="month"/>
                <field name="subtotal" type="measure"/>
                <field name="cumulative_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_payment_estimate" model="ir.actions.act_window">
        <field name="name">估驗計價</field>
        <field name="res_model">payment.estimate</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="search_view_id" ref="view_payment_estimate_search"/>
        <field name="context">{'search_default_filter_draft': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立估驗計價
            </p>
            <p>
                估驗計價用於記錄各期工程完成進度與金額，
                由施工廠商提送，監造單位審查核定。
            </p>
        </field>
    </record>

    <!-- Action for pending review -->
    <record id="action_payment_estimate_pending" model="ir.actions.act_window">
        <field name="name">待審核估驗</field>
        <field name="res_model">payment.estimate</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_payment_estimate_search"/>
        <field name="domain">[('state', 'in', ['submitted', 'reviewing', 'recommended'])]</field>
        <field name="context">{'search_default_filter_pending_review': 1}</field>
    </record>

</odoo>
