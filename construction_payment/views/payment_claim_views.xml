<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== -->
    <!-- Payment Claim Views  -->
    <!-- ==================== -->

    <!-- Tree View -->
    <record id="view_payment_claim_tree" model="ir.ui.view">
        <field name="name">payment.claim.tree</field>
        <field name="model">payment.claim</field>
        <field name="arch" type="xml">
            <list string="請款單" decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state in ('approved', 'paid')"
                  decoration-danger="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="company_id"/>
                <field name="claim_type" widget="badge"
                       decoration-info="claim_type == 'service_fee'"
                       decoration-success="claim_type == 'construction'"/>
                <field name="authority_id"/>
                <field name="claim_period"/>
                <field name="claim_amount" sum="Total"/>
                <field name="retention_amount"/>
                <field name="net_amount" sum="Net Total"/>
                <field name="payment_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ('approved', 'paid')"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_payment_claim_form" model="ir.ui.view">
        <field name="name">payment.claim.form</field>
        <field name="model">payment.claim</field>
        <field name="arch" type="xml">
            <form string="請款單">
                <header>
                    <button name="action_submit"
                            string="提送"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            string="核准"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="base.group_user"/>
                    <button name="action_reject"
                            string="退回"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="base.group_user"/>
                    <button name="action_mark_paid"
                            string="標記已付款"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'approved'"
                            groups="base.group_user"/>
                    <button name="action_cancel"
                            string="取消"
                            type="object"
                            invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_reset_to_draft"
                            string="重設為草稿"
                            type="object"
                            invisible="state not in ('rejected', 'submitted')"
                            groups="base.group_system"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="服務費" bg_color="bg-info"
                            invisible="claim_type != 'service_fee'"/>
                    <widget name="web_ribbon" title="工程款" bg_color="bg-success"
                            invisible="claim_type != 'construction'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="請款資訊">
                            <field name="project_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="claim_type"/>
                            <field name="authority_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="期間">
                            <field name="claim_period"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="金額明細" name="amounts">
                            <group>
                                <group string="關聯單據">
                                    <field name="estimate_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           readonly="state != 'draft'"/>
                                    <field name="acceptance_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group string="金額">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="claim_amount"/>
                                    <field name="retention_amount"/>
                                    <field name="deduction_amount"/>
                                    <field name="net_amount" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>
                        <page string="發票資訊" name="invoice">
                            <group>
                                <group>
                                    <field name="invoice_number"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_amount"/>
                                </group>
                                <group>
                                    <field name="payment_date"/>
                                    <field name="payment_reference"/>
                                </group>
                            </group>
                        </page>
                        <page string="簽核資訊" name="approval">
                            <group>
                                <group string="提送">
                                    <field name="submitter_id" readonly="1"/>
                                    <field name="submit_date" readonly="1"/>
                                </group>
                                <group string="核准">
                                    <field name="approver_id" readonly="1"/>
                                    <field name="approve_date" readonly="1"/>
                                    <field name="approve_comment"/>
                                </group>
                            </group>
                        </page>
                        <page string="附件" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="備註" name="notes">
                            <field name="note" placeholder="輸入備註..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_payment_claim_search" model="ir.ui.view">
        <field name="name">payment.claim.search</field>
        <field name="model">payment.claim</field>
        <field name="arch" type="xml">
            <search string="請款單">
                <field name="name"/>
                <field name="project_id"/>
                <field name="company_id"/>
                <field name="authority_id"/>
                <field name="invoice_number"/>
                <separator/>
                <filter string="草稿" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="已提送" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="已核准" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="已付款" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <filter string="退回" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="取消" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="服務費" name="filter_service_fee" domain="[('claim_type', '=', 'service_fee')]"/>
                <filter string="工程款" name="filter_construction" domain="[('claim_type', '=', 'construction')]"/>
                <separator/>
                <filter string="待處理" name="filter_pending"
                        domain="[('state', 'in', ['submitted', 'approved'])]"/>
                <filter string="本月付款" name="filter_paid_this_month"
                        domain="[('payment_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('payment_date', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="群組">
                    <filter string="工程" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="請款公司" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="請款類型" name="group_claim_type" context="{'group_by': 'claim_type'}"/>
                    <filter string="狀態" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="付款月份" name="group_payment" context="{'group_by': 'payment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_payment_claim_kanban" model="ir.ui.view">
        <field name="name">payment.claim.kanban</field>
        <field name="model">payment.claim</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="project_id"/>
                <field name="company_id"/>
                <field name="claim_type"/>
                <field name="claim_amount"/>
                <field name="net_amount"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb8">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span t-if="record.claim_type.raw_value == 'service_fee'"
                                          class="badge rounded-pill text-bg-info">服務費</span>
                                    <span t-if="record.claim_type.raw_value == 'construction'"
                                          class="badge rounded-pill text-bg-success">工程款</span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="project_id"/>
                                    <br/>
                                    <field name="company_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span>請款: </span>
                                        <field name="claim_amount" widget="monetary"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span>實付: </span>
                                        <field name="net_amount" widget="monetary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_payment_claim_pivot" model="ir.ui.view">
        <field name="name">payment.claim.pivot</field>
        <field name="model">payment.claim</field>
        <field name="arch" type="xml">
            <pivot string="請款分析">
                <field name="project_id" type="row"/>
                <field name="company_id" type="row"/>
                <field name="claim_type" type="col"/>
                <field name="claim_amount" type="measure"/>
                <field name="retention_amount" type="measure"/>
                <field name="net_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_payment_claim_graph" model="ir.ui.view">
        <field name="name">payment.claim.graph</field>
        <field name="model">payment.claim</field>
        <field name="arch" type="xml">
            <graph string="請款趨勢" type="bar">
                <field name="payment_date" type="row" interval="month"/>
                <field name="claim_type" type="col"/>
                <field name="net_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_payment_claim" model="ir.actions.act_window">
        <field name="name">請款單</field>
        <field name="res_model">payment.claim</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="search_view_id" ref="view_payment_claim_search"/>
        <field name="context">{'search_default_filter_draft': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立請款單
            </p>
            <p>
                請款單用於向業主（政府機關）正式請款，
                支援服務費（監造單位）和工程款（施工廠商）。
            </p>
        </field>
    </record>

    <!-- Action for service fee claims -->
    <record id="action_payment_claim_service_fee" model="ir.actions.act_window">
        <field name="name">服務費請款</field>
        <field name="res_model">payment.claim</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_payment_claim_search"/>
        <field name="domain">[('claim_type', '=', 'service_fee')]</field>
        <field name="context">{'default_claim_type': 'service_fee', 'search_default_filter_service_fee': 1}</field>
    </record>

    <!-- Action for construction claims -->
    <record id="action_payment_claim_construction" model="ir.actions.act_window">
        <field name="name">工程款請款</field>
        <field name="res_model">payment.claim</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_payment_claim_search"/>
        <field name="domain">[('claim_type', '=', 'construction')]</field>
        <field name="context">{'default_claim_type': 'construction', 'search_default_filter_construction': 1}</field>
    </record>

    <!-- Action for pending claims -->
    <record id="action_payment_claim_pending" model="ir.actions.act_window">
        <field name="name">待處理請款</field>
        <field name="res_model">payment.claim</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_payment_claim_search"/>
        <field name="domain">[('state', 'in', ['submitted', 'approved'])]</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

</odoo>
