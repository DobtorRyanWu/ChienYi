<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================ -->
    <!-- Estimate Import Wizard Views     -->
    <!-- ================================ -->

    <record id="view_estimate_import_wizard_form" model="ir.ui.view">
        <field name="name">estimate.import.wizard.form</field>
        <field name="model">estimate.import.wizard</field>
        <field name="arch" type="xml">
            <form string="匯入工程案件">
                <header>
                    <button string="完成匯入" type="object"
                            name="action_import" class="btn-primary"/>
                    <button string="取消" type="object"
                            name="action_cancel" class="btn-secondary"/>
                </header>
                <group>
                    <group>
                        <field name="estimate_id" readonly="1" invisible="1"/>
                        <field name="estimate_date"/>
                        <field name="project_id"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="contract_no" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="contract_amount" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list string="工項明細" editable="bottom"
                          create="false" delete="false">
                        <field name="sequence" widget="handle"/>
                        <field name="description" readonly="1"/>
                        <field name="parent_item_name" readonly="1"/>
                        <field name="item_no" readonly="1"/>
                        <field name="unit" readonly="1"/>
                        <field name="contract_qty" readonly="1"/>
                        <field name="approved_qty" readonly="1"/>
                        <field name="unit_price" readonly="1"/>
                        <field name="estimate_qty"/>
                        <field name="available_qty" readonly="1"/>
                        <field name="previous_estimate_qty" readonly="1"/>
                        <field name="cumulative_estimate_qty" readonly="1"/>
                        <field name="estimate_amount" readonly="1" sum="Total"/>
                        <field name="note"/>
                        <field name="task_id" column_invisible="1"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

</odoo>
