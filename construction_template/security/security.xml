<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 資料隔離規則 (Record Rules)                      -->
        <!-- ============================================== -->

        <!-- 文件樣板 - 系統管理者完整存取 -->
        <record id="rule_document_template_admin" model="ir.rule">
            <field name="name">文件樣板: 管理者完整存取</field>
            <field name="model_id" ref="model_document_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 文件樣板 - 一般使用者可讀取系統預設與公司樣板 -->
        <record id="rule_document_template_user_read" model="ir.rule">
            <field name="name">文件樣板: 使用者讀取</field>
            <field name="model_id" ref="model_document_template"/>
            <field name="domain_force">[
                '|',
                ('is_default', '=', True),
                '|',
                ('company_id', '=', user.company_id.id),
                ('project_id.company_id', '=', user.company_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
