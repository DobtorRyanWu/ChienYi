<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 工程案件表單加專案層級的彙總樣板匯出。
         這類表是「整個專案的彙總」（一張表列出全部檢查／缺失／送審記錄），
         所以入口在工程案件而不是個別記錄。 -->
    <record id="view_supervision_project_form_export" model="ir.ui.view">
        <field name="name">project.project.form.export.template</field>
        <field name="model">project.project</field>
        <field name="inherit_id"
               ref="construction_supervision_base.view_supervision_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_project_template"
                        string="自主檢查總表"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'self_inspection'}"
                        help="列出本案全部自主檢查記錄的彙總表"/>
                <button name="action_export_project_template"
                        string="缺失處理紀錄"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-word-o"
                        context="{'template_type': 'defect_improvement'}"
                        help="矯正與預防處理紀錄——每筆缺失一頁"/>
                <button name="action_export_project_template"
                        string="缺失管制表"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-word-o"
                        context="{'template_type': 'defect_control'}"
                        help="矯正與預防紀錄管制表——全案缺失彙總"/>
                <button name="action_export_project_template"
                        string="送審管制表"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-word-o"
                        context="{'template_type': 'review_control'}"
                        help="材料設備送審管制總表"/>
                <!-- 三張表共用同一份空白樣板，差別只在表名與撈哪一類記錄，
                     所以 template_type 相同、用 plan_control_type 區分 -->
                <button name="action_export_project_template"
                        string="計畫書管制表"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'plan_control',
                                  'plan_control_type': 'plan'}"
                        help="計畫書送審管制總表(含工程保險)——全案計畫書彙總"/>
                <button name="action_export_project_template"
                        string="分項計畫管制表"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'plan_control',
                                  'plan_control_type': 'sub_plan'}"
                        help="分項計畫送審管制總表——各分項工程施工計畫彙總"/>
                <button name="action_export_project_template"
                        string="施工圖管制表"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'plan_control',
                                  'plan_control_type': 'drawing'}"
                        help="施工圖送審管制總表——施工圖送審彙總"/>
                <button name="action_export_project_template"
                        string="檢試驗管制表"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-word-o"
                        context="{'template_type': 'test_control'}"
                        help="材料設備檢（試）驗管制總表"/>
                <button name="action_export_project_template"
                        string="預定進度表"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'progress_schedule'}"
                        help="只帶入工程名稱與預定工期；工作項目與甘特圖無資料來源，需人工填寫"/>
            </xpath>
        </field>
    </record>

</odoo>
