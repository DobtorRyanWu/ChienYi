<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 估驗計價表單加「匯出計價單」：填進工程估驗計價單樣板。
         明細區印的是彙總列（大類），依實際筆數動態展開。 -->
    <record id="view_payment_estimate_form_export" model="ir.ui.view">
        <field name="name">payment.estimate.form.export.template</field>
        <field name="model">payment.estimate</field>
        <field name="inherit_id" ref="construction_payment.view_payment_estimate_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_estimate_template"
                        string="匯出計價單"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        help="把本張估驗的資料自動帶入「工程估驗計價單」樣板並下載"/>
                <!-- 以下三份來自 EAGLE 舊系統。原系統把估驗詳細表與估驗照片
                     打包成一個 zip；這裡拆成獨立按鈕，各自下載。 -->
                <button name="action_export_estimate_template"
                        string="匯出估驗詳細表"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'invoice_detail'}"
                        help="EAGLE 版估驗詳細表：契約／核定數量、單價、本次與累計估驗數量及金額"/>
                <button name="action_export_estimate_template"
                        string="匯出估驗照片"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-word-o"
                        context="{'template_type': 'invoice_photo'}"
                        help="本期區間內的施工照片，一頁兩張、日期浮水印"/>
                <!-- 2026-10-19 使用者裁示：「匯出進度報告」暫時隱藏（3.5.4）。
                     這份以估驗單為期間錨點，工項清單就是估驗單上的明細：
                     匯入建的估驗單只有工作簿有填的工項、契約變更後的「同步估驗計價工項」
                     要手動按且不更新單價 → 完成百分率的分母可能不完整。
                     進度報告改用「工程管理 > 進度管理 > 進度報告」（報表／下載中心也是那一份）。
                     恢復：拿掉下面的 invisible="1"、升版號、-u construction_template。 -->
                <button name="action_export_estimate_template"
                        string="匯出進度報告"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'progress_report'}"
                        invisible="1"
                        help="公共工程施工日誌第二聯（期間版）：本期與累計完成數量、完成百分率"/>
            </xpath>
        </field>
    </record>

</odoo>
