<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 文件樣板 - Tree View                            -->
    <!-- ============================================== -->
    <record id="view_document_template_tree" model="ir.ui.view">
        <field name="name">document.template.tree</field>
        <field name="model">document.template</field>
        <field name="arch" type="xml">
            <list string="文件樣板" default_order="template_type, sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_type"/>
                <field name="scope_type" widget="badge" decoration-info="scope_type == 'system'" decoration-success="scope_type == 'company'" decoration-warning="scope_type == 'project'"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="project_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="file_name"/>
                <field name="version"/>
                <field name="usage_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 文件樣板 - Form View                            -->
    <!-- ============================================== -->
    <record id="view_document_template_form" model="ir.ui.view">
        <field name="name">document.template.form</field>
        <field name="model">document.template</field>
        <field name="arch" type="xml">
            <form string="文件樣板">
                <header>
                    <button name="action_download_template" string="下載樣板" type="object" class="btn-primary" invisible="not attachment_id"/>
                    <button name="action_download_default_template" string="下載預設樣板" type="object" class="btn-secondary"/>
                    <button name="action_test_template" string="測試樣板" type="object" invisible="not attachment_id"/>
                    <button name="action_duplicate" string="複製樣板" type="object"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_usage_log" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="usage_count" widget="statinfo" string="使用次數"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="系統預設" bg_color="text-bg-info" invisible="not is_default"/>
                    <widget name="web_ribbon" title="已停用" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="樣板名稱"/>
                        </h1>
                    </div>
                    <group>
                        <group name="basic_info" string="基本資料">
                            <field name="template_type"/>
                            <field name="version"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group name="scope_info" string="適用範圍">
                            <field name="scope_type" readonly="1"/>
                            <field name="is_default"/>
                            <field name="project_id" invisible="is_default"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="樣板檔案" name="template_file">
                            <group>
                                <group string="檔案資訊">
                                    <field name="attachment_id" widget="many2one_binary" filename="file_name"/>
                                    <field name="file_name" readonly="1"/>
                                    <field name="file_size" readonly="1" widget="integer"/>
                                    <field name="mimetype" readonly="1"/>
                                </group>
                                <group string="使用統計">
                                    <field name="usage_count" readonly="1"/>
                                    <field name="last_used_date" readonly="1"/>
                                </group>
                            </group>
                            <group string="版本資訊">
                                <field name="version_notes" placeholder="此版本的更新說明..."/>
                            </group>
                        </page>
                        <page string="欄位對照" name="field_mapping">
                            <group>
                                <field name="field_mapping" widget="ace" options="{'mode': 'json'}" placeholder='{"A1": "project_id.name", "B2": "date"}'/>
                            </group>
                            <group string="對照說明">
                                <field name="field_mapping_display" readonly="1" nolabel="1"/>
                            </group>
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <p><strong>欄位對照說明：</strong></p>
                                    <p>使用 JSON 格式設定樣板欄位與系統欄位的對應關係。</p>
                                    <p>範例：</p>
                                    <pre>{
    "A1": "project_id.name",
    "B1": "project_id.code",
    "A3": "date",
    "B5": "total_amount"
}</pre>
                                </div>
                            </group>
                        </page>
                        <page string="說明" name="description">
                            <group>
                                <field name="description" placeholder="描述此樣板的用途與特點..."/>
                            </group>
                        </page>
                        <page string="備註" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 文件樣板 - Search View                          -->
    <!-- ============================================== -->
    <record id="view_document_template_search" model="ir.ui.view">
        <field name="name">document.template.search</field>
        <field name="model">document.template</field>
        <field name="arch" type="xml">
            <search string="搜尋文件樣板">
                <field name="name" string="名稱"/>
                <field name="template_type"/>
                <field name="project_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter string="系統預設" name="is_default" domain="[('is_default', '=', True)]"/>
                <filter string="專案樣板" name="has_project" domain="[('project_id', '!=', False)]"/>
                <filter string="公司樣板" name="company_only" domain="[('project_id', '=', False), ('is_default', '=', False)]"/>
                <separator/>
                <filter string="已上傳檔案" name="has_file" domain="[('attachment_id', '!=', False)]"/>
                <filter string="無檔案" name="no_file" domain="[('attachment_id', '=', False)]"/>
                <separator/>
                <filter string="啟用" name="active" domain="[('active', '=', True)]"/>
                <filter string="已停用" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <!-- 樣板類型過濾 -->
                <filter string="施工日誌-第一聯" name="type_daily_log_1" domain="[('template_type', '=', 'daily_log_1')]"/>
                <filter string="施工日誌-第二聯" name="type_daily_log_2" domain="[('template_type', '=', 'daily_log_2')]"/>
                <filter string="自主檢查表" name="type_self_inspection" domain="[('template_type', '=', 'self_inspection')]"/>
                <filter string="缺失改善" name="type_defect_improvement" domain="[('template_type', '=', 'defect_improvement')]"/>
                <filter string="進度報告" name="type_progress_report" domain="[('template_type', '=', 'progress_report')]"/>
                <filter string="估驗計價表" name="type_estimate_report" domain="[('template_type', '=', 'estimate_report')]"/>
                <group expand="0" string="群組">
                    <filter string="樣板類型" name="group_template_type" context="{'group_by': 'template_type'}"/>
                    <filter string="適用範圍" name="group_scope_type" context="{'group_by': 'scope_type'}"/>
                    <filter string="專案" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="公司" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 文件樣板 - Kanban View                          -->
    <!-- ============================================== -->
    <record id="view_document_template_kanban" model="ir.ui.view">
        <field name="name">document.template.kanban</field>
        <field name="model">document.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="template_type">
                <field name="name"/>
                <field name="template_type"/>
                <field name="scope_type"/>
                <field name="is_default"/>
                <field name="project_id"/>
                <field name="file_name"/>
                <field name="usage_count"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span t-if="record.is_default.raw_value" class="badge text-bg-info">系統預設</span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.file_name.value">
                                    <i class="fa fa-file-o me-1"/>
                                    <field name="file_name"/>
                                </div>
                                <div t-else="" class="text-muted">
                                    <i class="fa fa-exclamation-circle me-1"/>
                                    尚未上傳檔案
                                </div>
                                <div t-if="record.project_id.value">
                                    <i class="fa fa-briefcase me-1"/>
                                    <field name="project_id"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge" t-attf-class="#{record.scope_type.raw_value == 'system' ? 'text-bg-info' : record.scope_type.raw_value == 'company' ? 'text-bg-success' : 'text-bg-warning'}">
                                        <field name="scope_type"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span title="使用次數">
                                        <i class="fa fa-bar-chart me-1"/>
                                        <field name="usage_count"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 文件樣板 - Action                               -->
    <!-- ============================================== -->
    <record id="action_document_template" model="ir.actions.act_window">
        <field name="name">文件樣板</field>
        <field name="res_model">document.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_document_template_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一個文件樣板
            </p>
            <p>
                文件樣板用於產生各類報表，包含施工日誌、自主檢查表、估驗計價表等。
                <br/>
                支援系統預設樣板、公司樣板與專案專屬樣板。
            </p>
        </field>
    </record>

    <!-- 各類型樣板快速存取 Action -->
    <record id="action_document_template_daily_log" model="ir.actions.act_window">
        <field name="name">施工日誌樣板</field>
        <field name="res_model">document.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('template_type', 'in', ['daily_log_1', 'daily_log_2'])]</field>
        <field name="context">{'default_template_type': 'daily_log_1'}</field>
    </record>

    <record id="action_document_template_inspection" model="ir.actions.act_window">
        <field name="name">自主檢查樣板</field>
        <field name="res_model">document.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('template_type', '=', 'self_inspection')]</field>
        <field name="context">{'default_template_type': 'self_inspection'}</field>
    </record>

    <record id="action_document_template_defect" model="ir.actions.act_window">
        <field name="name">缺失改善樣板</field>
        <field name="res_model">document.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('template_type', 'in', ['defect_improvement', 'defect_control'])]</field>
        <field name="context">{'default_template_type': 'defect_improvement'}</field>
    </record>

    <record id="action_document_template_estimate" model="ir.actions.act_window">
        <field name="name">估驗計價樣板</field>
        <field name="res_model">document.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('template_type', '=', 'estimate_report')]</field>
        <field name="context">{'default_template_type': 'estimate_report'}</field>
    </record>

    <record id="action_document_template_progress" model="ir.actions.act_window">
        <field name="name">進度報告樣板</field>
        <field name="res_model">document.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('template_type', 'in', ['progress_report', 'progress_schedule'])]</field>
        <field name="context">{'default_template_type': 'progress_report'}</field>
    </record>

</odoo>
