<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 樣板設定主選單                                   -->
    <!-- ============================================== -->

    <!-- 主選單 - 放在工程監造設定下 -->
    <menuitem id="menu_document_template_root"
        name="樣板設定"
        parent="construction_supervision_base.menu_configuration"
        sequence="30"
        groups="construction_supervision_base.group_supervisor_admin,construction_supervision_base.group_supervision_manager"/>

    <!-- 所有樣板 -->
    <menuitem id="menu_document_template_all"
        name="所有樣板"
        parent="menu_document_template_root"
        action="action_document_template"
        sequence="1"/>

    <!-- 依類型分類選單 -->
    <menuitem id="menu_document_template_by_type"
        name="依類型"
        parent="menu_document_template_root"
        sequence="10"/>

    <menuitem id="menu_document_template_daily_log"
        name="施工日誌樣板"
        parent="menu_document_template_by_type"
        action="action_document_template_daily_log"
        sequence="1"/>

    <menuitem id="menu_document_template_inspection"
        name="自主檢查樣板"
        parent="menu_document_template_by_type"
        action="action_document_template_inspection"
        sequence="2"/>

    <menuitem id="menu_document_template_defect"
        name="缺失改善樣板"
        parent="menu_document_template_by_type"
        action="action_document_template_defect"
        sequence="3"/>

    <menuitem id="menu_document_template_estimate"
        name="估驗計價樣板"
        parent="menu_document_template_by_type"
        action="action_document_template_estimate"
        sequence="4"/>

    <menuitem id="menu_document_template_progress"
        name="進度報告樣板"
        parent="menu_document_template_by_type"
        action="action_document_template_progress"
        sequence="5"/>

</odoo>
