<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 在施工日誌表單的 header 加「匯出日報表」按鈕。
         按下去會把本張日誌的資料填進監造日報表第一聯樣板並直接下載 xlsx。 -->
    <record id="daily_log_sheet_view_form_export" model="ir.ui.view">
        <field name="name">daily.log.sheet.form.export.template</field>
        <field name="model">daily.log.sheet</field>
        <field name="inherit_id" ref="construction_daily_log.daily_log_sheet_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_daily_log_template"
                        string="監造日報表(一)"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'daily_log_1'}"
                        help="公共工程監造日報表 第一聯（監造單位填寫）"/>
                <button name="action_export_daily_log_template"
                        string="監造日報表(二)"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'daily_log_2'}"
                        help="公共工程監造日報表 第二聯 完成工程詳細表"/>
                <button name="action_export_daily_log_template"
                        string="施工日誌(一)"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'daily_log_c1'}"
                        help="公共工程施工日誌 第一聯（施工廠商填寫）"/>
                <button name="action_export_daily_log_template"
                        string="施工日誌(二)"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        context="{'template_type': 'daily_log_c2'}"
                        help="公共工程施工日誌 第二聯 完成工程詳細表"/>
            </xpath>
            <!-- 當天已完成的自主檢查（淞源 C1）：唯讀、不儲存，接在「三、施工取樣試驗紀錄」手填欄下面 -->
            <xpath expr="//field[@name='sampling_test_record']" position="after">
                <div colspan="2" class="text-muted small" invisible="not same_day_inspection_text">
                    以下由當天已完成的自主檢查自動帶入（唯讀）；匯出「施工日誌(一)」時會接在上面的內容之後。
                </div>
                <field name="same_day_inspection_text" nolabel="1" colspan="2" readonly="1"
                       invisible="not same_day_inspection_text"/>
            </xpath>
        </field>
    </record>

</odoo>
