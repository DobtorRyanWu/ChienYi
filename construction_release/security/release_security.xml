<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- 管理員：全部 -->
        <record id="rule_release_system" model="ir.rule">
            <field name="name">系統版本：管理員全部</field>
            <field name="model_id" ref="model_construction_release"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- 客服：問題單要顯示「修復版本」，草稿與已確認的也要看得到（欄位層級另有限制） -->
        <record id="rule_release_agent" model="ir.rule">
            <field name="name">系統版本：客服可讀全部</field>
            <field name="model_id" ref="model_construction_release"/>
            <field name="groups" eval="[(4, ref('construction_helpdesk.group_helpdesk_agent'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 其他內部使用者（含代操作員）：只看得到已發布的公告 -->
        <record id="rule_release_internal" model="ir.rule">
            <field name="name">系統版本：內部使用者只讀已發布</field>
            <field name="model_id" ref="model_construction_release"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('state', '=', 'published')]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
