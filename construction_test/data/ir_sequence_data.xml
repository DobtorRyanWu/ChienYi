<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate：序列記錄只在安裝時建立。沒有 noupdate 時，每次 -u（包括被別的模組連帶升級）都會把
         number_next 寫回 1、PG 序列 RESTART，當月靜默重號（單號沒有 UNIQUE，不會報錯）。
         同 construction_supervision_base、construction_payment 等 9 個模組的寫法。 -->
    <data noupdate="1">

    <!-- 檢試驗項目序列 -->
    <record id="seq_test_standard" model="ir.sequence">
        <field name="name">檢試驗項目</field>
        <field name="code">supervision.test.standard</field>
        <field name="prefix">TS-%(year)s-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- 檢(試)驗管制記錄序列 -->
    <record id="seq_test_record" model="ir.sequence">
        <field name="name">檢(試)驗管制記錄</field>
        <field name="code">supervision.test.record</field>
        <field name="prefix">TR-%(year)s%(month)s-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
    </data>
</odoo>
