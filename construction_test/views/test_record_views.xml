<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 需求3: 重組後的檢(試)驗管制記錄 Tree View -->
    <record id="view_test_record_tree" model="ir.ui.view">
        <field name="name">supervision.test.record.tree</field>
        <field name="model">supervision.test.record</field>
        <field name="arch" type="xml">
            <!-- 顏色規則：
                 藍色 = 系統自動建立且尚未檢驗（重點提醒）
                 綠色 = 檢驗已完成
                 黃色 = 已開始檢驗
            -->
            <list decoration-info="auto_created and processing_status == 'not_started'"
                  decoration-success="processing_status == 'completed'"
                  decoration-warning="processing_status == 'in_progress'">
                
                <!-- Action 按鈕 -->
                <header>
                    <button name="%(action_check_test_requirement_wizard)d"
                            string="檢查檢驗需求"
                            type="action"
                            class="btn-primary"
                            help="根據施工日誌檢查是否需要新增檢驗記錄"/>
                </header>
                
                <!-- 需求3: 重組後的欄位清單 -->
                <field name="processing_status" string="處理狀態" widget="badge"
                decoration-warning="processing_status == 'not_started'"
                decoration-info="processing_status == 'in_progress'"
                decoration-success="processing_status == 'completed'"/>

                <field name="auto_created" string="系統自動建立" readonly="1"/>

                <field name="project_id" string="所屬工程"/>
                
                <field name="task_id" string="材料名稱"/>
                
                <field name="contract_qty" string="契約數量"/>
                
                <field name="test_standard_name" string="檢試驗名稱"/>
                
                <field name="standard_frequency" string="規定抽樣頻率"/>
                
                <field name="expected_in_site_date" string="預定進場日期"/>

                <field name="in_site_date" string="實際進場日期"/>

                <field name="sample_date" string="抽樣日期"/>
                
                <field name="in_site_sum_quantity" string="累計進場數量"/>
                
                <field name="sample_sum_quantity" string="累計抽樣數量"/>
                
                <field name="result" string="抽試驗結果" widget="badge"
                decoration-success="result == 'pass'"
                decoration-danger="result == 'fail'"
                decoration-warning="result == 'pending'"/>
                
                <field name="responsible_user_id" string="負責人"/>
                
                <field name="archive_number" string="歸檔編號"/>
            </list>
        </field>
    </record>

    <!-- 需求5+6: 修改後的檢(試)驗管制記錄 Form View -->
    <record id="view_test_record_form" model="ir.ui.view">
        <field name="name">supervision.test.record.form</field>
        <field name="model">supervision.test.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- 需求7: 移除狀態按鈕，改為自動判定 -->
                    <field name="processing_status" widget="statusbar"
                           statusbar_visible="not_started,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-paperclip"
                                type="object" name="action_view_attachments"
                                invisible="attachment_count == 0">
                            <field name="attachment_count" widget="statinfo" string="附件"/>
                        </button>
                    </div>
                    
                    <!-- 系統自動建立的提示 -->
                    <div class="alert alert-info" role="alert" invisible="not auto_created">
                        <strong>系統自動建立</strong>
                        <p>此記錄由檢驗需求檢查功能自動建立</p>
                        <p invisible="not trigger_cumulative_qty">
                            觸發累計數量：<field name="trigger_cumulative_qty" readonly="1"/>
                        </p>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <div>
                            <field name="auto_created" invisible="1"/>
                            <field name="trigger_log_line_id" invisible="1"/>
                            <field name="trigger_cumulative_qty" invisible="1"/>
                            <field name="available_task_ids" invisible="1"/>
                        </div>
                    </div>
                    
                    <group>
                        <group string="基本資訊">
                            <field name="project_id"/>
                            <field name="standard_id"/>
                            <!-- 契約詳細表項次由材料名稱（task_id）自動帶出，
                                 所以緊接在來源欄位之後，選完馬上看得到 -->
                            <field name="task_id"/>
                            <field name="task_item_no" readonly="1"
                                   invisible="not task_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="基本資訊（續）">
                            <field name="responsible_user_id"/>
                        </group>
                    </group>
                    <group string="抽驗及會同人員">
                        <group string="業主方">
                            <field name="owner_member" nolabel="1"/>
                        </group>
                        <group string="監造方">
                            <field name="supervision_member_ids" widget="many2many_tags" nolabel="1"/>
                        </group>
                        <group string="營造方">
                            <field name="contractor_member_ids" widget="many2many_tags" nolabel="1"/>
                        </group>
                    </group>
                    <!-- 需求5: 新增檢試驗項目設定資料區塊 -->
                    <group string="檢試驗項目設定資料" invisible="not standard_id">
                        <group>
                            <field name="test_standard_name" readonly="1"/>
                            <field name="standard_describe" readonly="1"/>
                            <field name="standard_norm" readonly="1"/>
                        </group>
                        <group>
                            <field name="standard_frequency" readonly="1"/>
                            <field name="standard_unit" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="進場記錄">
                            <field name="expected_in_site_date"/>
                            <field name="in_site_date"/>
                            <field name="in_site_quantity"/>
                            <field name="in_site_sum_quantity"/>
                        </group>
                        <!-- 需求6: 取樣改為抽樣 -->
                        <group string="抽樣記錄">
                            <field name="sample_date"/>
                            <field name="sample_quantity"/>
                            <field name="sample_sum_quantity"/>
                            <field name="sample_rate" widget="progressbar"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="檢驗結果">
                            <field name="result"/>
                            <field name="result_date"/>
                            <field name="result_description"/>
                        </group>
                        <group string="歸檔資訊">
                            <field name="archive_number"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="檢驗報告附件" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"
                                   string="檢驗報告"/>
                        </page>
                        <page string="關聯照片" name="related_photos">
                            <!-- 本頁籤原本只有唯讀反查、完全沒有上傳入口（使用者反映的第 2 點）。
                                 照片收斂後 related_photo_ids 已是真 One2many，配上精靈即可上傳。 -->
                            <button name="%(construction_photo.action_photo_upload_wizard)d"
                                    type="action" string="批次上傳照片"
                                    class="btn-primary" icon="fa-camera"
                                    invisible="not id"/>
                            <field name="related_photo_count" invisible="1"/>
                            <field name="related_photo_ids" nolabel="1" mode="kanban" create="false"
                                   context="{'kanban_view_ref': 'construction_photo.supervision_photo_view_kanban_embedded',
                                             'form_view_ref': 'construction_photo.supervision_photo_view_form_embedded'}"/>
                        </page>
                        <page string="備註" name="notes">
                            <field name="note" placeholder="輸入備註說明..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 檢(試)驗管制記錄 Search View -->
    <record id="view_test_record_search" model="ir.ui.view">
        <field name="name">supervision.test.record.search</field>
        <field name="model">supervision.test.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="standard_id"/>
                <field name="task_id"/>
                <field name="test_standard_name"/>
                <field name="archive_number"/>
                <field name="expected_in_site_date"/>
                <field name="in_site_date"/>

                <!-- 需求7: 處理狀態篩選 -->
                <separator/>
                <filter string="尚未檢驗" name="not_started"
                        domain="[('processing_status', '=', 'not_started')]"/>
                <filter string="已開始檢驗" name="in_progress"
                        domain="[('processing_status', '=', 'in_progress')]"/>
                <filter string="檢驗完成" name="completed"
                        domain="[('processing_status', '=', 'completed')]"/>
                
                <!-- 建立來源篩選 -->
                <separator/>
                <filter string="系統自動建立" name="auto_created"
                        domain="[('auto_created', '=', True)]"/>
                <filter string="手動建立" name="manual_created"
                        domain="[('auto_created', '=', False)]"/>
                
                <!-- 重點組合：系統建立且尚未檢驗 -->
                <filter string="待處理(系統建立)" name="auto_not_started"
                        domain="[('auto_created', '=', True), ('processing_status', '=', 'not_started')]"/>
                
                <!-- 檢驗結果篩選 -->
                <separator/>
                <filter string="合格" name="pass"
                        domain="[('result', '=', 'pass')]"/>
                <filter string="不合格" name="fail"
                        domain="[('result', '=', 'fail')]"/>
                <filter string="待判定" name="pending_result"
                        domain="[('result', '=', 'pending')]"/>
                
                <!-- 時間篩選 -->
                <separator/>
                <filter string="本月實際進場" name="this_month"
                        domain="[('in_site_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="本週實際進場" name="this_week"
                        domain="[('in_site_date', '&gt;=', (context_today() - relativedelta(weeks=0, weekday=0)).strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter string="抽樣率不足" name="low_sample_rate"
                        domain="[('sample_rate', '&lt;', 100)]"/>
                
                <!-- 群組 -->
                <separator/>
                <group expand="0" string="群組">
                    <filter string="工程" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="材料名稱" name="group_task"
                            context="{'group_by': 'task_id'}"/>
                    <filter string="試驗工項" name="group_standard"
                            context="{'group_by': 'standard_id'}"/>
                    <filter string="處理狀態" name="group_processing_status"
                            context="{'group_by': 'processing_status'}"/>
                    <filter string="檢驗結果" name="group_result"
                            context="{'group_by': 'result'}"/>
                    <filter string="預定進場日期" name="group_expected_in_site_date"
                            context="{'group_by': 'expected_in_site_date:month'}"/>
                    <filter string="實際進場日期" name="group_in_site_date"
                            context="{'group_by': 'in_site_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 檢(試)驗管制記錄 Kanban View -->
    <record id="view_test_record_kanban" model="ir.ui.view">
        <field name="name">supervision.test.record.kanban</field>
        <field name="model">supervision.test.record</field>
        <field name="arch" type="xml">
            <kanban default_group_by="processing_status" class="o_kanban_mobile">
                <field name="name"/>
                <field name="project_id"/>
                <field name="standard_id"/>
                <field name="test_standard_name"/>
                <field name="expected_in_site_date"/>
                <field name="in_site_date"/>
                <field name="in_site_quantity"/>
                <field name="sample_rate"/>
                <field name="result"/>
                <field name="processing_status"/>
                <field name="auto_created"/>
                <progressbar field="processing_status"
                             colors='{"not_started": "warning", "in_progress": "info", "completed": "success"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="ribbon ribbon-top-right" t-if="record.auto_created.raw_value">
                                <span class="bg-info">自動</span>
                            </div>
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="test_standard_name"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><strong>試驗工項:</strong> <field name="standard_id"/></div>
                                <div><strong>預定進場日期:</strong> <field name="expected_in_site_date"/></div>
                                <div><strong>實際進場日期:</strong> <field name="in_site_date"/></div>
                                <div><strong>進場數量:</strong> <field name="in_site_quantity"/></div>
                                <div>
                                    <strong>抽樣率:</strong>
                                    <field name="sample_rate"/>%
                                </div>
                                <div t-if="record.result.raw_value == 'fail'" class="text-danger">
                                    <strong>不合格</strong>
                                </div>
                                <div t-if="record.result.raw_value == 'pass'" class="text-success">
                                    <strong>合格</strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="processing_status" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 檢(試)驗管制記錄 Pivot View -->
    <record id="view_test_record_pivot" model="ir.ui.view">
        <field name="name">supervision.test.record.pivot</field>
        <field name="model">supervision.test.record</field>
        <field name="arch" type="xml">
            <pivot string="檢(試)驗統計">
                <field name="project_id" type="row"/>
                <field name="standard_id" type="row"/>
                <field name="in_site_date" type="col" interval="month"/>
                <field name="in_site_quantity" type="measure"/>
                <field name="sample_quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 檢(試)驗管制記錄 Graph View -->
    <record id="view_test_record_graph" model="ir.ui.view">
        <field name="name">supervision.test.record.graph</field>
        <field name="model">supervision.test.record</field>
        <field name="arch" type="xml">
            <graph string="檢(試)驗趨勢" type="line">
                <field name="in_site_date" interval="month"/>
                <field name="in_site_quantity" type="measure"/>
                <field name="sample_quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 檢(試)驗管制記錄 Action -->
    <record id="action_test_record" model="ir.actions.act_window">
        <field name="name">檢(試)驗管制記錄</field>
        <field name="res_model">supervision.test.record</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_test_record_search"/>
        <field name="context">{
            'search_default_group_project': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立第一筆檢(試)驗記錄
            </p>
            <p>
                點擊上方「檢查檢驗需求」按鈕，系統會根據施工日誌自動建立需要的檢驗記錄。
            </p>
        </field>
    </record>

</odoo>