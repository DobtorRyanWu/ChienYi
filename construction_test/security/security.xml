<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================== -->
        <!-- 步驟 1：刪除舊的 ir.model.access 記錄             -->
        <!-- ============================================== -->

        <delete model="ir.model.access" search="[('id', '=', ref('access_test_standard_user'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_test_standard_manager'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_test_record_user'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_test_record_manager'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_test_frequency_condition_user'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_test_frequency_condition_manager'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_check_test_requirement_wizard_user'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_check_test_requirement_wizard_manager'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_check_test_requirement_cron_manager'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_test_task_statistics_user'))]"/>
        <delete model="ir.model.access" search="[('id', '=', ref('access_test_task_statistics_manager'))]"/>

        <!-- ============================================== -->
        <!-- 步驟 2：刪除使用舊基礎群組的 ir.rule                -->
        <!-- ============================================== -->

        <delete model="ir.rule" search="[('id', '=', ref('rule_test_standard_supervision'))]"/>
        <delete model="ir.rule" search="[('id', '=', ref('rule_test_record_supervision'))]"/>
        <delete model="ir.rule" search="[('id', '=', ref('rule_test_standard_contractor'))]"/>
        <delete model="ir.rule" search="[('id', '=', ref('rule_test_record_contractor'))]"/>

        <!-- ============================================== -->
        <!-- 步驟 3：刪除舊的群組定義                           -->
        <!-- ============================================== -->

        <delete model="res.groups" search="[('id', '=', ref('group_test_user'))]"/>
        <delete model="res.groups" search="[('id', '=', ref('group_test_manager'))]"/>

    </data>

    <data noupdate="1">

        <!-- ============================================== -->
        <!-- Record Rules（保留基本的公司隔離規則）              -->
        <!-- ============================================== -->

        <!-- 檢試驗項目 - 依專案公司隔離 -->
        <record id="rule_test_standard_company" model="ir.rule">
            <field name="name">檢試驗項目: 公司隔離</field>
            <field name="model_id" ref="model_supervision_test_standard"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 檢試驗記錄 - 依專案公司隔離 -->
        <record id="rule_test_record_company" model="ir.rule">
            <field name="name">檢(試)驗記錄: 公司隔離</field>
            <field name="model_id" ref="model_supervision_test_record"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 系統管理者完整存取 -->
        <record id="rule_admin_full_access_test_standard" model="ir.rule">
            <field name="name">管理者: 檢試驗項目完整存取</field>
            <field name="model_id" ref="model_supervision_test_standard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_test_record" model="ir.rule">
            <field name="name">管理者: 檢(試)驗記錄完整存取</field>
            <field name="model_id" ref="model_supervision_test_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
