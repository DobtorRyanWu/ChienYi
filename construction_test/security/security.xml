<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 舊版遷移清理已移除（記錄從未被建立，ref() 會報錯） -->

        <!-- 檢(試)驗記錄：前台成員制可見性（2026-11-04 補）。原本沒有任何套到前台的規則，
             庫內前台帳號讀得到每個工程的檢試驗記錄、也能在上面留言。照 construction_portal
             security.xml 的寫法：所有前台帳號只看參與的工程，老闆另加公司範圍（OR）。
             放在 noupdate 區塊外，既有的庫 -u 時才會建出來。
             回歸：construction_portal/tests/test_portal_orm_readonly.py 的 D 段 -->
        <record id="rule_test_record_portal_member" model="ir.rule">
            <field name="name">Portal: 檢(試)驗記錄 - 成員專案讀取（預設）</field>
            <field name="model_id" ref="model_supervision_test_record"/>
            <field name="domain_force">[('project_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_test_record_portal_boss" model="ir.rule">
            <field name="name">Portal老闆: 檢(試)驗記錄 - 公司範圍</field>
            <field name="model_id" ref="model_supervision_test_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>

    <data noupdate="1">

        <!-- ============================================== -->
        <!-- Record Rules（保留基本的公司隔離規則）              -->
        <!-- ============================================== -->

        <!-- 檢試驗項目 - 依專案公司隔離 -->
        <record id="rule_test_standard_company" model="ir.rule">
            <field name="name">檢試驗項目: 公司隔離</field>
            <field name="model_id" ref="model_supervision_test_standard"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 檢試驗記錄 - 依專案公司隔離 -->
        <record id="rule_test_record_company" model="ir.rule">
            <field name="name">檢(試)驗記錄: 公司隔離</field>
            <field name="model_id" ref="model_supervision_test_record"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 試驗項目及數據（附表11）：全域公司隔離。規則不會從母表繼承，而母表的
             「管理者完整存取」(1=1) 在多家監造公司共用的庫裡等於沒有隔離——子表不跟著放寬。
             前台沒有檢試驗填寫頁，ir.model.access.csv 也沒給前台角色權限。 -->
        <record id="rule_test_record_value_company" model="ir.rule">
            <field name="name">檢(試)驗試驗數據: 公司隔離</field>
            <field name="model_id" ref="model_supervision_test_record_value"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- 系統管理者完整存取 -->
        <record id="rule_admin_full_access_test_standard" model="ir.rule">
            <field name="name">管理者: 檢試驗項目完整存取</field>
            <field name="model_id" ref="model_supervision_test_standard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_test_record" model="ir.rule">
            <field name="name">管理者: 檢(試)驗記錄完整存取</field>
            <field name="model_id" ref="model_supervision_test_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
