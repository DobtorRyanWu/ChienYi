<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         工程單位選單 (歸屬於 工程管理 > 資源管理)
         =================================================================== -->

    <!-- 工程單位 -->
    <menuitem id="menu_partner_units"
              name="工程單位"
              parent="construction_supervision_base.menu_resource_management"
              sequence="10"/>

    <menuitem id="menu_construction_partners"
              name="所有單位"
              parent="menu_partner_units"
              action="action_construction_partners"
              sequence="10"/>

    <menuitem id="menu_construction_contractors"
              name="施工廠商"
              parent="menu_partner_units"
              action="action_construction_contractors"
              sequence="20"/>

    <menuitem id="menu_supervision_units"
              name="監造/設計單位"
              parent="menu_partner_units"
              action="action_supervision_units"
              sequence="30"/>

    <menuitem id="menu_construction_owners"
              name="業主單位"
              parent="menu_partner_units"
              action="action_construction_owners"
              sequence="40"/>

    <!-- 技術聯絡人：預設停用（實務上沒有使用情境，生產站實際資料 0 筆）。
         定義保留著，哪天要用就到「設定 → 技術 → 使用者介面 → 選單項目」
         把 active 勾回來即可。
         ⚠ 下方 record 每次模組升級都會把 active 重設回 False——這是刻意的，
         讓「預設關閉」成為每個站台的一致狀態；要長期開啟請改這裡而非只改後台。 -->
    <menuitem id="menu_technical_contacts"
              name="技術聯絡人"
              parent="construction_supervision_base.menu_resource_management"
              action="action_partner_technical_contact"
              sequence="20"/>
    <record id="menu_technical_contacts" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 廠商證照 -->
    <menuitem id="menu_partner_licenses"
              name="廠商證照"
              parent="construction_supervision_base.menu_resource_management"
              action="action_partner_license"
              sequence="30"/>

    <menuitem id="menu_partner_licenses_expiring"
              name="即將過期證照"
              parent="construction_supervision_base.menu_resource_management"
              action="action_partner_license_expiring"
              sequence="31"/>

    <!-- 工程單位分類設定 (歸屬於 系統設定 > 基礎設定) -->
    <menuitem id="menu_partner_categories"
              name="工程單位分類"
              parent="construction_supervision_base.menu_basic_config"
              action="action_supervision_partner_category"
              sequence="20"/>

</odoo>
