<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 廠商證照資料 視圖                                  -->
    <!-- ============================================== -->

    <!-- Tree View -->
    <record id="view_partner_license_tree" model="ir.ui.view">
        <field name="name">partner.license.tree</field>
        <field name="model">partner.license</field>
        <field name="arch" type="xml">
            <list string="廠商證照資料"
                  decoration-danger="expiry_status == 'expired'"
                  decoration-warning="expiry_status == 'expiring'"
                  decoration-muted="verification_state == 'rejected'">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="license_type"/>
                <field name="license_no"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="expiry_status" widget="badge"
                       decoration-success="expiry_status == 'valid'"
                       decoration-warning="expiry_status == 'expiring'"
                       decoration-danger="expiry_status == 'expired'"
                       decoration-info="expiry_status == 'no_expiry'"/>
                <field name="verification_state" widget="badge"
                       decoration-warning="verification_state == 'pending'"
                       decoration-success="verification_state == 'verified'"
                       decoration-danger="verification_state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_partner_license_form" model="ir.ui.view">
        <field name="name">partner.license.form</field>
        <field name="model">partner.license</field>
        <field name="arch" type="xml">
            <form string="廠商證照資料">
                <header>
                    <button name="action_verify"
                            string="驗證通過"
                            type="object"
                            class="btn-primary"
                            invisible="verification_state != 'pending'"/>
                    <button name="action_reject"
                            string="拒絕驗證"
                            type="object"
                            class="btn-danger"
                            invisible="verification_state != 'pending'"/>
                    <button name="action_reset_pending"
                            string="重設為待驗證"
                            type="object"
                            invisible="verification_state == 'pending'"/>
                    <field name="verification_state" widget="statusbar"
                           statusbar_visible="pending,verified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paperclip"
                                invisible="attachment_count == 0">
                            <field name="attachment_count" widget="statinfo" string="附件"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="已過期" bg_color="text-bg-danger"
                            invisible="expiry_status != 'expired'"/>
                    <widget name="web_ribbon" title="即將過期" bg_color="text-bg-warning"
                            invisible="expiry_status != 'expiring'"/>
                    <group>
                        <group string="基本資料">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="name"/>
                            <field name="license_type"/>
                            <field name="license_no"/>
                        </group>
                        <group string="有效期限">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_until_expiry"
                                   invisible="expiry_status == 'no_expiry'"/>
                            <field name="expiry_status" widget="badge"
                                   decoration-success="expiry_status == 'valid'"
                                   decoration-warning="expiry_status == 'expiring'"
                                   decoration-danger="expiry_status == 'expired'"
                                   decoration-info="expiry_status == 'no_expiry'"/>
                        </group>
                    </group>
                    <group>
                        <group string="發證資訊">
                            <field name="issue_authority"/>
                        </group>
                        <group string="驗證資訊">
                            <field name="verified_by" readonly="1"/>
                            <field name="verified_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="證照影本" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="備註" name="notes">
                            <field name="note" placeholder="輸入備註說明..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_partner_license_search" model="ir.ui.view">
        <field name="name">partner.license.search</field>
        <field name="model">partner.license</field>
        <field name="arch" type="xml">
            <search string="搜尋證照">
                <field name="name" string="證照名稱/字號"
                       filter_domain="['|', ('name', 'ilike', self), ('license_no', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="license_type"/>
                <separator/>
                <filter string="有效" name="filter_valid"
                        domain="[('expiry_status', 'in', ['valid', 'no_expiry'])]"/>
                <filter string="即將過期" name="filter_expiring"
                        domain="[('expiry_status', '=', 'expiring')]"/>
                <filter string="已過期" name="filter_expired"
                        domain="[('expiry_status', '=', 'expired')]"/>
                <separator/>
                <filter string="待驗證" name="filter_pending"
                        domain="[('verification_state', '=', 'pending')]"/>
                <filter string="已驗證" name="filter_verified"
                        domain="[('verification_state', '=', 'verified')]"/>
                <separator/>
                <group expand="0" string="分組">
                    <filter string="廠商" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="證照類型" name="group_type"
                            context="{'group_by': 'license_type'}"/>
                    <filter string="有效狀態" name="group_expiry"
                            context="{'group_by': 'expiry_status'}"/>
                    <filter string="驗證狀態" name="group_verification"
                            context="{'group_by': 'verification_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_partner_license_kanban" model="ir.ui.view">
        <field name="name">partner.license.kanban</field>
        <field name="model">partner.license</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="license_type"/>
                <field name="expiry_date"/>
                <field name="expiry_status"/>
                <field name="verification_state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.expiry_status.raw_value == 'expired' ? 'bg-danger-light' : record.expiry_status.raw_value == 'expiring' ? 'bg-warning-light' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="partner_id"/>
                                </div>
                                <div class="text-muted">
                                    <field name="license_type"/>
                                </div>
                                <div class="mt-2">
                                    <span class="badge" t-att-class="{
                                        'text-bg-success': record.expiry_status.raw_value == 'valid',
                                        'text-bg-warning': record.expiry_status.raw_value == 'expiring',
                                        'text-bg-danger': record.expiry_status.raw_value == 'expired',
                                        'text-bg-info': record.expiry_status.raw_value == 'no_expiry',
                                    }">
                                        <field name="expiry_status"/>
                                    </span>
                                    <span class="badge ms-1" t-att-class="{
                                        'text-bg-warning': record.verification_state.raw_value == 'pending',
                                        'text-bg-success': record.verification_state.raw_value == 'verified',
                                        'text-bg-danger': record.verification_state.raw_value == 'rejected',
                                    }">
                                        <field name="verification_state"/>
                                    </span>
                                </div>
                                <div class="text-muted" t-if="record.expiry_date.raw_value">
                                    有效期限: <field name="expiry_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_partner_license" model="ir.actions.act_window">
        <field name="name">廠商證照</field>
        <field name="res_model">partner.license</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_partner_license_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                新增廠商證照資料
            </p>
            <p>
                管理廠商的各類證照，包括營業執照、營造業登記證、
                技師執照等，系統會自動追蹤過期狀態。
            </p>
        </field>
    </record>

    <!-- Action: Expiring Licenses -->
    <record id="action_partner_license_expiring" model="ir.actions.act_window">
        <field name="name">即將過期證照</field>
        <field name="res_model">partner.license</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_partner_license_search"/>
        <field name="domain">[('expiry_status', '=', 'expiring')]</field>
        <field name="context">{'search_default_filter_expiring': 1}</field>
    </record>

</odoo>
