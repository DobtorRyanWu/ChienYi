<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 工程單位分類標籤 視圖                              -->
    <!-- ============================================== -->

    <!-- Tree View -->
    <record id="view_supervision_partner_category_tree" model="ir.ui.view">
        <field name="name">supervision.partner.category.tree</field>
        <field name="model">supervision.partner.category</field>
        <field name="arch" type="xml">
            <list string="工程單位分類標籤">
                <field name="sequence" widget="handle"/>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="partner_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_supervision_partner_category_form" model="ir.ui.view">
        <field name="name">supervision.partner.category.form</field>
        <field name="model">supervision.partner.category</field>
        <field name="arch" type="xml">
            <form string="工程單位分類標籤">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_partners"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-building-o">
                            <field name="partner_count" widget="statinfo" string="相關單位"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="已封存" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="分類說明..."/>
                    </group>
                    <notebook>
                        <page string="子分類" name="child_categories">
                            <field name="child_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="partner_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="相關單位" name="partners">
                            <field name="partner_ids" mode="kanban">
                                <kanban>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                                <div class="o_kanban_image_fill_left d-none d-md-block"
                                                     t-attf-style="background-image: url(#{kanban_image('res.partner', 'avatar_128', record.id.raw_value)})"
                                                     role="img"/>
                                                <div class="oe_kanban_details">
                                                    <strong class="o_kanban_record_title">
                                                        <field name="name"/>
                                                    </strong>
                                                    <div class="o_kanban_record_subtitle">
                                                        <field name="email"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_supervision_partner_category_search" model="ir.ui.view">
        <field name="name">supervision.partner.category.search</field>
        <field name="model">supervision.partner.category</field>
        <field name="arch" type="xml">
            <search string="搜尋分類標籤">
                <field name="name" string="名稱/代碼"
                       filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="complete_name"/>
                <field name="parent_id"/>
                <separator/>
                <filter string="頂層分類" name="filter_root"
                        domain="[('parent_id', '=', False)]"/>
                <separator/>
                <filter string="已封存" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="分組">
                    <filter string="上層分類" name="group_parent"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_supervision_partner_category" model="ir.actions.act_window">
        <field name="name">工程單位分類</field>
        <field name="res_model">supervision.partner.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_supervision_partner_category_search"/>
        <field name="context">{'search_default_filter_root': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立工程單位分類標籤
            </p>
            <p>
                分類標籤可用於將工程相關單位進行多維度分類，
                支援樹狀階層結構。
            </p>
        </field>
    </record>

</odoo>
