<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- 資料隔離規則 (Record Rules)                      -->
        <!-- ============================================== -->

        <!-- 工程單位分類標籤 - 所有人可讀取 -->
        <record id="rule_partner_category_read_all" model="ir.rule">
            <field name="name">工程分類標籤: 所有人可讀取</field>
            <field name="model_id" ref="model_supervision_partner_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 系統管理者 - 完整存取 -->
        <record id="rule_admin_full_access_partner_category" model="ir.rule">
            <field name="name">管理者: 工程分類標籤完整存取</field>
            <field name="model_id" ref="model_supervision_partner_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <!-- 廠商證照 - 一般使用者可讀取自己公司 -->
        <record id="rule_partner_license_user_read" model="ir.rule">
            <field name="name">廠商證照: 使用者公司存取</field>
            <field name="model_id" ref="model_partner_license"/>
            <field name="domain_force">[('partner_id.user_ids.company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_admin_full_access_partner_license" model="ir.rule">
            <field name="name">管理者: 廠商證照完整存取</field>
            <field name="model_id" ref="model_partner_license"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <!-- 技術聯絡人 - 一般使用者可存取自己公司 -->
        <record id="rule_technical_contact_user" model="ir.rule">
            <field name="name">技術聯絡人: 使用者公司存取</field>
            <field name="model_id" ref="model_partner_technical_contact"/>
            <field name="domain_force">[('partner_id.user_ids.company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_admin_full_access_technical_contact" model="ir.rule">
            <field name="name">管理者: 技術聯絡人完整存取</field>
            <field name="model_id" ref="model_partner_technical_contact"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
</odoo>
