<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================
         檔案管理 /construction/<pid>/documents

         2026-08-21：資料源從 supervision.document 改成 ir.attachment，
         與後台「檔案總覽」同一份資料。篩選由「文件分類」改成「資料夾」——
         分類已有 44 個，攤成 pills 在手機上會爆版；而且資料夾才是
         使用者腦中「檔案放在哪」的模型。

         前台**不提供建立資料夾**：結構由後台維護，現場人員只挑既有的丟。
         ============================================ -->
    <template id="portal_construction_documents" name="Construction Documents">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div class="cy-v10-app">
                <t t-call="construction_portal.portal_v10_header"/>
                <div class="cy-breadcrumb">
                    <a t-attf-href="/construction/#{project.id}" class="cy-breadcrumb-item">首頁</a>
                    <span class="cy-breadcrumb-item active">檔案管理</span>
                </div>

                <div class="cy-content">
                    <h4 style="font-weight: 700; margin-bottom: 12px;">檔案管理</h4>

                    <!-- 成功/錯誤訊息 -->
                    <t t-if="request.params.get('message') == 'uploaded'">
                        <div class="cy-event-card cy-event-info" style="margin-bottom: 12px;">
                            <span class="cy-event-icon" style="color: var(--wb-green);"><i class="fa fa-check-circle"/></span>
                            <div class="cy-event-body">
                                <div class="cy-event-title" style="color: var(--wb-green);">檔案上傳成功</div>
                            </div>
                        </div>
                    </t>
                    <t t-if="request.params.get('error') == 'no_file'">
                        <div class="cy-event-card cy-event-info" style="margin-bottom: 12px;">
                            <span class="cy-event-icon" style="color: var(--wb-red);"><i class="fa fa-exclamation-circle"/></span>
                            <div class="cy-event-body">
                                <div class="cy-event-title" style="color: var(--wb-red);">請先選擇檔案</div>
                            </div>
                        </div>
                    </t>

                    <!-- 資料夾篩選 -->
                    <div style="margin-bottom: 12px;">
                        <label class="form-label" style="font-size: 0.85rem;">資料夾</label>
                        <select class="form-select"
                                onchange="if(this.value){window.location.href=this.dataset.base+'?folder='+this.value;}else{window.location.href=this.dataset.base;}"
                                t-attf-data-base="/construction/#{project.id}/documents">
                            <option value="">全部檔案</option>
                            <t t-foreach="folders" t-as="folder">
                                <option t-att-value="folder.id"
                                        t-att-selected="'selected' if folder_filter == folder.id else None">
                                    <t t-esc="folder.complete_name"/>
                                </option>
                            </t>
                        </select>
                        <t t-if="folder_filter">
                            <div style="font-size: 0.75rem; color: var(--wb-t3); margin-top: 4px;">
                                含此資料夾底下所有子資料夾的檔案
                            </div>
                        </t>
                    </div>

                    <!-- 上傳表單（可摺疊）-->
                    <div class="cy-section-title" style="cursor: pointer; margin-top: 0;" data-collapse-toggle="doc_upload_form">
                        <span><i class="fa fa-upload" style="margin-right: 4px;"/> 上傳檔案</span>
                        <i class="fa fa-chevron-down" style="font-size: 0.8rem; color: var(--wb-t3);"/>
                    </div>
                    <div id="doc_upload_form" style="display: none;">
                        <div class="cy-card" style="margin-bottom: 14px;">
                            <div class="cy-card-body">
                                <form t-attf-action="/construction/#{project.id}/document/upload" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div style="margin-bottom: 10px;">
                                        <label class="form-label" style="font-size: 0.85rem;">
                                            放到哪個資料夾
                                        </label>
                                        <t t-if="folders">
                                            <select name="folder_id" class="form-select">
                                                <option value="">-- 不指定（之後由後台歸檔）--</option>
                                                <t t-foreach="folders" t-as="folder">
                                                    <option t-att-value="folder.id"
                                                            t-att-selected="'selected' if folder_filter == folder.id else None">
                                                        <t t-esc="folder.complete_name"/>
                                                    </option>
                                                </t>
                                            </select>
                                            <div style="font-size: 0.75rem; color: var(--wb-t3); margin-top: 4px;">
                                                文件分類會自動跟著資料夾走，不用另外選
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div style="font-size: 0.8rem; color: var(--wb-t3);">
                                                本工程尚未建立資料夾，檔案會先放在「未歸檔」，
                                                請後續由管理者歸檔。
                                            </div>
                                        </t>
                                    </div>
                                    <div style="margin-bottom: 10px;">
                                        <label class="form-label" style="font-size: 0.85rem;">檔案名稱</label>
                                        <input type="text" name="name" class="form-control" placeholder="留空則使用原始檔名"/>
                                    </div>
                                    <div style="margin-bottom: 10px;">
                                        <label class="form-label" style="font-size: 0.85rem;">
                                            選擇檔案 <span style="color: var(--wb-red);">*</span>
                                        </label>
                                        <input type="file" name="file" class="form-control" required="required"/>
                                    </div>
                                    <button type="submit" class="cy-btn cy-btn-primary cy-btn-block">
                                        <i class="fa fa-upload"/> 上傳
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <t t-if="not attachments">
                        <div class="cy-empty">
                            <i class="fa fa-folder-open-o"/>
                            <div class="cy-empty-text">尚無檔案</div>
                        </div>
                    </t>

                    <!-- 檔案列表 -->
                    <t t-foreach="attachments" t-as="att">
                        <div class="cy-task-row" style="cursor: default;">
                            <div class="cy-task-icon blue">
                                <i class="fa fa-file-o"/>
                            </div>
                            <div class="cy-task-info">
                                <div class="cy-task-name"><t t-esc="att.name"/></div>
                                <div class="cy-task-sub">
                                    <t t-if="att.folder_id">
                                        <i class="fa fa-folder-o"/> <t t-esc="att.folder_id.complete_name"/>
                                    </t>
                                    <t t-else="">
                                        <span style="color: var(--wb-t3);">未歸檔</span>
                                    </t>
                                    <t t-if="att.create_date">
                                        · <t t-esc="att.create_date.strftime('%Y-%m-%d')"/>
                                    </t>
                                </div>
                            </div>
                            <a t-attf-href="/construction/doc/#{att.id}"
                               class="cy-btn cy-btn-outline" style="font-size: 0.75rem; padding: 4px 10px; min-height: 30px;">
                                <i class="fa fa-download"/>
                            </a>
                        </div>
                    </t>

                    <div class="d-flex justify-content-center mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </div>

                <t t-call="construction_portal.portal_bottom_nav_v10"/>
            </div>
        </t>
    </template>
</odoo>
