<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_construction_settings" name="Construction Settings">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div class="cy-v10-app">
                <div class="cy-breadcrumb">
                    <a t-att-href="back_url or '/my/construction'" class="cy-breadcrumb-item">
                        <t t-esc="back_label or '工程列表'"/>
                    </a>
                    <span class="cy-breadcrumb-item active">設定</span>
                </div>


                <div class="cy-content">
                    <div class="cy-sec-divider"><span>設定</span></div>

                    <!-- 用戶資訊卡 -->
                    <div class="cy-card" style="overflow: hidden; margin-bottom: 16px;">
                        <!-- Avatar + 基本資訊 -->
                        <div style="padding: 20px 16px; display: flex; align-items: center; gap: 14px; border-bottom: 1px solid var(--wb-bdr);">
                            <div style="width: 56px; height: 56px; border-radius: 28px; background: linear-gradient(135deg, #e6a020, #d4880a); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 900; color: #fff; flex-shrink: 0;">
                                <t t-esc="user.name[:1]"/>
                            </div>
                            <div>
                                <div style="font-size: 1.2rem; font-weight: 700;"><t t-esc="user.name"/></div>
                                <div style="font-size: 0.85rem; color: var(--wb-t2);">現場施工人員</div>
                                <div style="font-size: 0.85rem; color: var(--wb-t3);"><t t-esc="partner.email or user.login"/></div>
                            </div>
                        </div>
                        <!-- 切換工程 -->
                        <a href="/my/construction" style="padding: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--wb-bdr); text-decoration: none; color: inherit; min-height: 56px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 1.2rem;">🏗</span>
                                <span style="font-size: 0.9rem; font-weight: 600;">切換工程</span>
                            </div>
                            <span style="font-size: 0.85rem; color: var(--wb-t3);">›</span>
                        </a>
                    </div>

                    <!-- 專案管理 -->
                    <div class="cy-section-title">專案管理</div>
                    <div class="cy-card" style="overflow: hidden; margin-bottom: 16px;">
                        <a t-attf-href="/my/construction/project/new#{projects and '?from_project=' + str(projects[0].id) or ''}" style="padding: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--wb-bdr); text-decoration: none; color: inherit; min-height: 56px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 1.2rem;">➕</span>
                                <span style="font-size: 0.9rem; font-weight: 600;">新增專案</span>
                            </div>
                            <span style="font-size: 0.85rem; color: var(--wb-t3);">›</span>
                        </a>
                        <t t-if="projects">
                            <a t-attf-href="/my/construction/#{projects[0].id}/documents" style="padding: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--wb-bdr); text-decoration: none; color: inherit; min-height: 56px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <span style="font-size: 1.2rem;">📂</span>
                                    <span style="font-size: 0.9rem; font-weight: 600;">檔案管理</span>
                                </div>
                                <span style="font-size: 0.85rem; color: var(--wb-t3);">›</span>
                            </a>
                        </t>
                        <t t-foreach="projects" t-as="proj">
                            <a t-attf-href="/my/construction/#{proj.id}" style="padding: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--wb-bdr); text-decoration: none; color: inherit;">
                                <div>
                                    <div style="font-size: 0.95rem; font-weight: 700;"><t t-esc="proj.name"/></div>
                                    <div style="display: flex; gap: 8px; margin-top: 6px;">
                                        <span t-attf-class="cy-badge #{proj.project_type == 'general' and 'cy-badge-confirmed' or 'cy-badge-completion'}">
                                            <t t-if="proj.project_type == 'general'">一般式</t>
                                            <t t-else="">預約式</t>
                                        </span>
                                        <span t-attf-class="cy-badge cy-badge-#{proj.state}">
                                            <t t-esc="dict(proj._fields['state'].selection).get(proj.state, proj.state)"/>
                                        </span>
                                    </div>
                                </div>
                                <span style="font-size: 0.9rem; color: var(--wb-t3);">›</span>
                            </a>
                        </t>
                    </div>

                    <!-- 系統 -->
                    <div class="cy-section-title">系統</div>
                    <div class="cy-card" style="overflow: hidden; margin-bottom: 16px;">
                        <div style="padding: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--wb-bdr); min-height: 56px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 1.2rem;">🔔</span>
                                <span style="font-size: 0.9rem; font-weight: 600;">通知設定</span>
                            </div>
                            <span style="font-size: 0.85rem; color: var(--wb-t3);">›</span>
                        </div>
                        <div style="padding: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--wb-bdr); min-height: 56px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 1.2rem;">📱</span>
                                <span style="font-size: 0.9rem; font-weight: 600;">系統版本</span>
                            </div>
                            <span style="font-size: 0.85rem; color: var(--wb-t3);">v10.0</span>
                        </div>
                    </div>

                    <!-- 其他 -->
                    <div class="cy-section-title">其他</div>
                    <div class="cy-card" style="overflow: hidden; margin-bottom: 16px;">
                        <a href="/my" style="padding: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--wb-bdr); text-decoration: none; color: inherit; min-height: 56px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 1.2rem;">🏠</span>
                                <span style="font-size: 0.9rem; font-weight: 600;">Portal 首頁</span>
                            </div>
                            <span style="font-size: 0.85rem; color: var(--wb-t3);">›</span>
                        </a>
                        <a href="/my/account" style="padding: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--wb-bdr); text-decoration: none; color: inherit; min-height: 56px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 1.2rem;">👤</span>
                                <span style="font-size: 0.9rem; font-weight: 600;">編輯個人資料</span>
                            </div>
                            <span style="font-size: 0.85rem; color: var(--wb-t3);">›</span>
                        </a>
                        <a href="/web/session/logout" style="padding: 16px; display: flex; align-items: center; justify-content: space-between; text-decoration: none; color: inherit; min-height: 56px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 1.2rem;">ℹ</span>
                                <span style="font-size: 0.9rem; font-weight: 600;">關於</span>
                            </div>
                            <span style="font-size: 0.85rem; color: var(--wb-t3);">›</span>
                        </a>
                    </div>

                    <!-- 登出 -->
                    <a href="/web/session/logout" style="display: block; width: 100%; padding: 16px; border-radius: 14px; border: 1px solid rgba(232,54,79,0.2); background: rgba(232,54,79,0.06); color: var(--wb-red); font-size: 0.9rem; font-weight: 700; text-align: center; text-decoration: none; min-height: 52px;">
                        登出
                    </a>
                </div>
            </div>
        </t>
    </template>
</odoo>
