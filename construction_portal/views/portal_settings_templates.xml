<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        個人帳號頁 /construction/settings
        v11 重整:從原本「綜合設定頁」縮減為純「個人帳號」頁
        - 切換工程/新增專案/檔案管理/通知設定/Portal 首頁/關於/登出 已全部移到 drawer
        - 此頁只留:用戶資訊大卡 + 編輯個人資料(連 Odoo 原生 /my/account) + 系統版本
        - HUD 升級:左側 ‹ 返回箭頭、右側合併 avatar 開 drawer(視覺與首頁一致)
    -->
    <template id="portal_construction_settings" name="Construction Personal Account">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div class="cy-v10-app">
                <!-- HUD: ‹ 返回 + 標題 + 合併 avatar -->
                <div class="cy-hud" style="padding-bottom: 0;">
                    <div class="cy-hud-top">
                        <div class="cy-hud-left">
                            <a t-att-href="back_url or '/construction'" class="cy-hud-back" t-att-title="back_label or '返回'">
                                ‹
                            </a>
                        </div>
                        <div class="cy-hud-project">個人帳號</div>
                        <button type="button" class="cy-hud-avatar cy-hud-menu-avatar"
                                data-bs-toggle="offcanvas" data-bs-target="#cyDrawer"
                                aria-controls="cyDrawer" aria-label="開啟主選單">
                            <span class="cy-hud-menu-avatar-initial"><t t-esc="request.env.user.name[:1]"/></span>
                            <span class="cy-hud-menu-avatar-chevron" aria-hidden="true">▾</span>
                        </button>
                    </div>
                </div>

                <div class="cy-content">
                    <!-- 用戶資訊大卡 -->
                    <div class="cy-card" style="overflow: hidden; margin-bottom: 16px;">
                        <div style="padding: 24px 16px; display: flex; align-items: center; gap: 14px;">
                            <div style="width: 64px; height: 64px; border-radius: 16px; background: linear-gradient(135deg, var(--wb-brand), var(--wb-brand-dark)); display: flex; align-items: center; justify-content: center; font-size: 1.75rem; font-weight: 900; color: #fff; flex-shrink: 0; box-shadow: 0 2px 8px rgba(118,159,205,0.3);">
                                <t t-esc="user.name[:1]"/>
                            </div>
                            <div style="min-width: 0; flex: 1;">
                                <div style="font-size: 1.25rem; font-weight: 700; color: var(--wb-t1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    <t t-esc="user.name"/>
                                </div>
                                <div style="font-size: 0.85rem; color: var(--wb-t2); margin-top: 2px;">
                                    <t t-esc="partner.function or '現場施工人員'"/>
                                </div>
                                <div style="font-size: 0.8rem; color: var(--wb-t3); margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    <t t-esc="partner.email or user.login"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 帳號 -->
                    <div class="cy-section-title">帳號</div>
                    <div class="cy-card" style="overflow: hidden; margin-bottom: 16px;">
                        <a href="/my/account" style="padding: 16px; display: flex; align-items: center; justify-content: space-between; text-decoration: none; color: inherit; min-height: 56px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 1.2rem;">✏</span>
                                <div>
                                    <div style="font-size: 0.95rem; font-weight: 600;">編輯個人資料</div>
                                    <div style="font-size: 0.78rem; color: var(--wb-t3); margin-top: 2px;">姓名、Email、密碼</div>
                                </div>
                            </div>
                            <span style="font-size: 1.1rem; color: var(--wb-t3);">›</span>
                        </a>
                    </div>

                    <!-- 系統資訊 -->
                    <div class="cy-section-title">系統資訊</div>
                    <div class="cy-card" style="overflow: hidden; margin-bottom: 24px;">
                        <div style="padding: 16px; display: flex; align-items: center; justify-content: space-between; min-height: 56px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 1.2rem;">📱</span>
                                <span style="font-size: 0.95rem; font-weight: 600;">系統版本</span>
                            </div>
                            <span style="font-size: 0.85rem; color: var(--wb-t3); font-weight: 600;">ChienYi Portal v11.0</span>
                        </div>
                    </div>

                    <!-- 登出 -->
                    <a href="/web/session/logout" style="display: block; width: 100%; padding: 16px; border-radius: 14px; border: 1px solid rgba(232,54,79,0.2); background: rgba(232,54,79,0.06); color: var(--wb-red); font-size: 0.95rem; font-weight: 700; text-align: center; text-decoration: none; min-height: 52px;">
                        登出
                    </a>
                </div>

                <!-- v11 右側抽屜選單(由 HUD avatar 觸發) -->
                <t t-call="construction_portal.portal_v10_drawer"/>
            </div>
        </t>
    </template>
</odoo>
