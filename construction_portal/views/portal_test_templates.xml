<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================
         檢試驗管制列表 /construction/<pid>/tests
         C（2026-07-14）：新建 portal 頁，補齊照片上傳
         ============================================ -->
    <template id="portal_construction_tests" name="Construction Test Records">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div class="cy-v10-app">
                <t t-call="construction_portal.portal_v10_header"/>
                <div class="cy-breadcrumb">
                    <a t-attf-href="/construction/#{project.id}" class="cy-breadcrumb-item">首頁</a>
                    <span class="cy-breadcrumb-item active">檢試驗管制</span>
                </div>

                <div class="cy-content">
                    <div class="cy-section-title">
                        <span>檢試驗管制紀錄</span>
                        <span style="font-size: 0.8rem; color: var(--wb-t3);">
                            <t t-esc="test_count"/> 筆
                        </span>
                    </div>

                    <!-- 結果篩選 chips -->
                    <div style="display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap;">
                        <a t-attf-href="/construction/#{project.id}/tests"
                           t-attf-class="cy-chip #{not result_filter and 'active' or ''}">全部</a>
                        <a t-attf-href="/construction/#{project.id}/tests?result=pass"
                           t-attf-class="cy-chip #{result_filter == 'pass' and 'active' or ''}">合格</a>
                        <a t-attf-href="/construction/#{project.id}/tests?result=fail"
                           t-attf-class="cy-chip #{result_filter == 'fail' and 'active' or ''}">不合格</a>
                        <a t-attf-href="/construction/#{project.id}/tests?result=pending"
                           t-attf-class="cy-chip #{result_filter == 'pending' and 'active' or ''}">待判定</a>
                    </div>

                    <t t-if="tests">
                        <t t-foreach="tests" t-as="test">
                            <a t-attf-href="/construction/#{project.id}/test/#{test.id}"
                               class="cy-card" style="display: block; text-decoration: none; color: inherit; margin-bottom: 8px;">
                                <div class="cy-card-body" style="padding: 14px;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                        <div style="min-width: 0; flex: 1;">
                                            <div style="font-weight: 700; font-size: 0.95rem;">
                                                <t t-esc="test.test_standard_name or (test.standard_id and test.standard_id.name) or test.name or '檢試驗'"/>
                                            </div>
                                            <div style="font-size: 0.82rem; color: var(--wb-t3); margin-top: 2px;">
                                                <t t-esc="test.name or ''"/>
                                                <t t-if="test.task_id"> · <t t-esc="test.task_id.name"/></t>
                                            </div>
                                        </div>
                                        <span t-attf-style="flex-shrink: 0; font-size: 0.78rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; #{test.result == 'pass' and 'background: rgba(34,197,94,.15); color: var(--wb-green);' or (test.result == 'fail' and 'background: rgba(239,68,68,.15); color: var(--wb-red);' or 'background: var(--wb-bg2); color: var(--wb-t3);')}">
                                            <t t-if="test.result == 'pass'">合格</t>
                                            <t t-elif="test.result == 'fail'">不合格</t>
                                            <t t-else="">待判定</t>
                                        </span>
                                    </div>
                                    <div style="display: flex; gap: 12px; font-size: 0.82rem; color: var(--wb-t2); margin-top: 8px; flex-wrap: wrap;">
                                        <span t-if="test.sample_date">📅 抽樣 <t t-esc="test.sample_date"/></span>
                                        <span t-if="test.related_photo_count">📷 <t t-esc="test.related_photo_count"/></span>
                                    </div>
                                </div>
                            </a>
                        </t>

                        <!-- 分頁 -->
                        <div t-if="pager['page_count'] > 1" class="cy-pager" style="margin-top: 12px;">
                            <t t-call="portal.pager"/>
                        </div>
                    </t>
                    <t t-else="">
                        <div style="text-align: center; color: var(--wb-t3); padding: 40px 16px;">
                            尚無檢試驗紀錄
                        </div>
                    </t>
                </div>

                <t t-call="construction_portal.portal_bottom_nav_v10"/>
            </div>
        </t>
    </template>

    <!-- ============================================
         檢試驗管制詳情 /construction/<pid>/test/<tid>
         ============================================ -->
    <template id="portal_construction_test_detail" name="Construction Test Record Detail">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div class="cy-v10-app">
                <t t-call="construction_portal.portal_v10_header"/>
                <div class="cy-breadcrumb">
                    <a t-attf-href="/construction/#{project.id}" class="cy-breadcrumb-item">首頁</a>
                    <a t-attf-href="/construction/#{project.id}/tests" class="cy-breadcrumb-item">檢試驗管制</a>
                    <span class="cy-breadcrumb-item active"><t t-esc="test.name or '詳情'"/></span>
                </div>

                <div class="cy-content">
                    <!-- 標題 + 結果 -->
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; gap: 8px;">
                        <div style="min-width: 0; flex: 1;">
                            <h4 style="font-weight: 700; margin: 0;">
                                <t t-esc="test.test_standard_name or (test.standard_id and test.standard_id.name) or '檢試驗'"/>
                            </h4>
                            <div style="font-size: 0.85rem; color: var(--wb-t3);">
                                <t t-esc="test.name or ''"/>
                            </div>
                        </div>
                        <span t-attf-style="flex-shrink: 0; font-size: 0.8rem; font-weight: 700; padding: 4px 12px; border-radius: 999px; #{test.result == 'pass' and 'background: rgba(34,197,94,.15); color: var(--wb-green);' or (test.result == 'fail' and 'background: rgba(239,68,68,.15); color: var(--wb-red);' or 'background: var(--wb-bg2); color: var(--wb-t3);')}">
                            <t t-esc="result_selection.get(test.result, test.result or '待判定')"/>
                        </span>
                    </div>

                    <!-- 基本資訊 -->
                    <div class="cy-section-title">基本資訊</div>
                    <div class="cy-info-section">
                        <div class="cy-info-row" t-if="test.task_id">
                            <span class="cy-info-label">材料名稱</span>
                            <span class="cy-info-value"><t t-esc="test.task_id.name"/></span>
                        </div>
                        <div class="cy-info-row" t-if="test.standard_unit">
                            <span class="cy-info-label">檢查單位</span>
                            <span class="cy-info-value"><t t-esc="test.standard_unit"/></span>
                        </div>
                        <div class="cy-info-row" t-if="test.standard_frequency">
                            <span class="cy-info-label">抽樣頻率</span>
                            <span class="cy-info-value"><t t-esc="test.standard_frequency"/></span>
                        </div>
                        <div class="cy-info-row" t-if="test.responsible_user_id">
                            <span class="cy-info-label">負責人</span>
                            <span class="cy-info-value"><t t-esc="test.responsible_user_id.name"/></span>
                        </div>
                        <div class="cy-info-row" t-if="test.processing_status">
                            <span class="cy-info-label">處理狀態</span>
                            <span class="cy-info-value"><t t-esc="status_selection.get(test.processing_status, test.processing_status)"/></span>
                        </div>
                    </div>

                    <!-- 抽樣/進場 -->
                    <div class="cy-section-title">抽樣與進場</div>
                    <div class="cy-info-section">
                        <div class="cy-info-row" t-if="test.in_site_date">
                            <span class="cy-info-label">進場日期</span>
                            <span class="cy-info-value"><t t-esc="test.in_site_date"/></span>
                        </div>
                        <div class="cy-info-row" t-if="test.in_site_quantity">
                            <span class="cy-info-label">進場數量</span>
                            <span class="cy-info-value"><t t-esc="test.in_site_quantity"/></span>
                        </div>
                        <div class="cy-info-row" t-if="test.sample_date">
                            <span class="cy-info-label">抽樣日期</span>
                            <span class="cy-info-value"><t t-esc="test.sample_date"/></span>
                        </div>
                        <div class="cy-info-row" t-if="test.sample_quantity">
                            <span class="cy-info-label">抽樣數量</span>
                            <span class="cy-info-value"><t t-esc="test.sample_quantity"/></span>
                        </div>
                        <div class="cy-info-row" t-if="test.sample_rate">
                            <span class="cy-info-label">抽樣率</span>
                            <span class="cy-info-value"><t t-esc="'%.1f' % test.sample_rate"/>%</span>
                        </div>
                    </div>

                    <!-- 結果 -->
                    <t t-if="test.result_date or test.result_description">
                        <div class="cy-section-title">結果</div>
                        <div class="cy-info-section">
                            <div class="cy-info-row" t-if="test.result_date">
                                <span class="cy-info-label">判定日期</span>
                                <span class="cy-info-value"><t t-esc="test.result_date"/></span>
                            </div>
                            <div class="cy-info-row" t-if="test.result_description" style="flex-direction: column; align-items: flex-start; gap: 4px;">
                                <span class="cy-info-label">結果說明</span>
                                <span class="cy-info-value" style="white-space: pre-wrap;"><t t-esc="test.result_description"/></span>
                            </div>
                        </div>
                    </t>

                    <!-- 照片（C 2026-07-14：檢試驗照片上傳 + 顯示 related_photo_ids） -->
                    <div class="cy-section-title" style="margin-top: 24px;">
                        <span>照片</span>
                        <span style="font-size: 0.8rem; color: var(--wb-t3);">
                            <t t-esc="len(test.related_photo_ids)"/> 張
                        </span>
                    </div>
                    <t t-if="request.params.get('message') == 'photo_added'">
                        <div class="cy-event-card" style="margin-bottom: 12px;">
                            <span class="cy-event-icon" style="color: var(--wb-green);"><i class="fa fa-check-circle"/></span>
                            <div class="cy-event-body"><div class="cy-event-desc">照片已上傳</div></div>
                        </div>
                    </t>
                    <t t-if="test.related_photo_ids">
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 14px;">
                            <t t-foreach="test.related_photo_ids" t-as="photo">
                                <t t-if="photo.attachment_id">
                                    <a t-attf-href="/construction/img/#{photo.attachment_id.id}" target="_blank"
                                       style="display: block; aspect-ratio: 1; overflow: hidden; border-radius: var(--wb-radius); border: 1px solid var(--wb-bdr);">
                                        <img t-attf-src="/construction/img/#{photo.attachment_id.id}"
                                             style="width: 100%; height: 100%; object-fit: cover;"
                                             t-att-alt="photo.description or ''"/>
                                    </a>
                                </t>
                            </t>
                        </div>
                    </t>
                    <form t-attf-action="/construction/#{project.id}/test/#{test.id}/photo/upload"
                          method="post" enctype="multipart/form-data" style="margin-bottom: 14px;">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="file" name="photos" accept="image/*" multiple="multiple"
                               capture="environment"
                               style="display: block; width: 100%; margin-bottom: 8px; font-size: 0.85rem;"/>
                        <!-- 說明欄由 cy_photo_meta_fields 提供；此處原本另有一個
                             同名 name="description" 的 input，同一張 form 兩個同名
                             欄位取值不確定，已移除。 -->
                        <t t-call="construction_portal.cy_photo_meta_fields"/>
                        <t t-call="construction_portal.cy_photo_geo_fields"/>
                        <button type="submit" class="cy-btn cy-btn-outline" style="width: 100%;">
                            <i class="fa fa-camera"/> 上傳照片
                        </button>
                    </form>

                    <!-- 備註 -->
                    <t t-if="test.note">
                        <div class="cy-section-title">備註</div>
                        <div class="cy-info-section" style="padding: 12px 16px;">
                            <div style="font-size: 0.9rem; white-space: pre-wrap;"><t t-esc="test.note"/></div>
                        </div>
                    </t>

                    <!-- 訊息紀錄 -->
                    <div class="cy-section-title" style="margin-top: 24px;">訊息</div>
                    <div style="background: var(--wb-bg2); border-radius: var(--wb-radius); border: 1px solid var(--wb-bdr); padding: 12px; margin-bottom: 14px;">
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="test"/>
                        </t>
                    </div>
                </div>

                <t t-call="construction_portal.portal_bottom_nav_v10"/>
            </div>
        </t>
    </template>
</odoo>
