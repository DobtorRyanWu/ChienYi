<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================
         通報單列表 /construction/<pid>/slips
         ============================================ -->
    <template id="portal_construction_slips" name="Construction Notification Slips">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div class="cy-v10-app">
                <t t-call="construction_portal.portal_v10_header"/>
                <div class="cy-breadcrumb">
                    <a t-attf-href="/construction/#{project.id}" class="cy-breadcrumb-item">首頁</a>
                    <span class="cy-breadcrumb-item active">通報單</span>
                </div>

                <div class="cy-content">
                    <h4 style="font-weight: 700; margin-bottom: 12px;">通報單</h4>

                    <t t-if="not slips">
                        <div class="cy-empty">
                            <i class="fa fa-file-text-o"/>
                            <div class="cy-empty-text">尚無通報單</div>
                        </div>
                    </t>

                    <t t-foreach="slips" t-as="slip">
                        <a t-attf-href="/construction/#{project.id}/slip/#{slip.id}" class="cy-slip-card">
                            <div class="cy-slip-header">
                                <span class="cy-slip-no">
                                    第 <t t-esc="slip.slip_no"/> 次通報
                                </span>
                                <span t-attf-class="cy-slip-state #{slip.state}">
                                    <t t-esc="dict(slip._fields['state'].selection).get(slip.state, slip.state)"/>
                                </span>
                            </div>
                            <div style="font-size: 0.9rem; color: var(--wb-t1); margin-bottom: 4px;">
                                <t t-esc="slip.location or ''"/>
                            </div>
                            <div class="cy-slip-meta">
                                <t t-if="slip.planned_start_date">
                                    預定 <t t-esc="slip.planned_start_date"/>
                                </t>
                                <t t-if="slip.estimated_amount">
                                    · NT$ <t t-esc="'{:,.0f}'.format(slip.estimated_amount)"/>
                                </t>
                                <t t-if="slip.overdue_days and slip.overdue_days > 0">
                                    <span style="color: var(--wb-red); font-weight: 700;">
                                        · 逾期 <t t-esc="slip.overdue_days"/> 天
                                    </span>
                                </t>
                            </div>
                        </a>
                    </t>

                    <div class="d-flex justify-content-center mt-3">
                        <t t-call="portal.pager"/>
                    </div>
                </div>

                <t t-call="construction_portal.portal_bottom_nav_v10"/>
            </div>
        </t>
    </template>

    <!-- ============================================
         通報單詳情 /construction/<pid>/slip/<sid>
         ============================================ -->
    <template id="portal_construction_slip_detail" name="Notification Slip Detail">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div class="cy-v10-app">
                <t t-call="construction_portal.portal_v10_header"/>
                <div class="cy-breadcrumb">
                    <a t-attf-href="/construction/#{project.id}" class="cy-breadcrumb-item">首頁</a>
                    <a t-attf-href="/construction/#{project.id}/slips" class="cy-breadcrumb-item">通報單</a>
                    <span class="cy-breadcrumb-item active">第 <t t-esc="slip.slip_no"/> 次</span>
                </div>

                <div class="cy-content">
                    <!-- 標題 + 狀態 -->
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                        <div style="min-width: 0; flex: 1;">
                            <h4 style="font-weight: 700; margin: 0;">
                                第 <t t-esc="slip.slip_no"/> 次通報
                            </h4>
                            <div style="font-size: 0.85rem; color: var(--wb-t3);">
                                <t t-esc="slip.slip_number or ''"/>
                            </div>
                        </div>
                        <span t-attf-class="cy-slip-state #{slip.state}" style="flex-shrink: 0; margin-left: 8px;">
                            <t t-esc="state_selection.get(slip.state, slip.state)"/>
                        </span>
                    </div>

                    <!-- 審核動作（限老闆/主管） -->
                    <t t-if="request.env.user.has_group('construction_supervision_base.group_portal_boss') or request.env.user.has_group('construction_supervision_base.group_portal_manager') or request.env.user.has_group('base.group_system')">
                        <t t-if="request.params.get('error')">
                            <div class="cy-event-card cy-event-urgent" style="margin-bottom: 12px;">
                                <span class="cy-event-icon" style="color: var(--wb-red);"><i class="fa fa-times-circle"/></span>
                                <div class="cy-event-body"><div class="cy-event-desc"><t t-esc="request.params.get('error')"/></div></div>
                            </div>
                        </t>
                        <div style="display: flex; gap: 8px; margin-bottom: 16px;" t-if="slip.state in ('draft', 'in_progress')">
                            <form t-if="slip.state == 'draft'" t-attf-action="/construction/#{project.id}/slip/#{slip.id}/confirm" method="post" style="flex:1;">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="cy-btn cy-btn-primary" style="width:100%;"><i class="fa fa-check"/> 核定</button>
                            </form>
                            <form t-if="slip.state == 'in_progress'" t-attf-action="/construction/#{project.id}/slip/#{slip.id}/close" method="post" style="flex:1;">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="cy-btn cy-btn-primary" style="width:100%;"><i class="fa fa-flag-checkered"/> 結案</button>
                            </form>
                        </div>
                    </t>

                    <!-- 逾期警告 -->
                    <t t-if="slip.overdue_days and slip.overdue_days > 0">
                        <div class="cy-event-card cy-event-urgent" style="margin-bottom: 12px;">
                            <span class="cy-event-icon" style="color: var(--wb-red);"><i class="fa fa-clock-o"/></span>
                            <div class="cy-event-body">
                                <div class="cy-event-title" style="color: var(--wb-red);">
                                    逾期 <t t-esc="slip.overdue_days"/> 天
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- 基本資訊 -->
                    <div class="cy-section-title">基本資訊</div>
                    <div class="cy-info-section">
                        <div class="cy-info-row">
                            <span class="cy-info-label">工程地點</span>
                            <span class="cy-info-value"><t t-esc="slip.location or '-'"/></span>
                        </div>
                        <div class="cy-info-row" t-if="slip.location_detail">
                            <span class="cy-info-label">詳細位置</span>
                            <span class="cy-info-value"><t t-esc="slip.location_detail"/></span>
                        </div>
                        <div class="cy-info-row" t-if="slip.survey_date">
                            <span class="cy-info-label">會勘日期</span>
                            <span class="cy-info-value"><t t-esc="slip.survey_date"/></span>
                        </div>
                    </div>

                    <!-- 工期 -->
                    <div class="cy-section-title">工期</div>
                    <div class="cy-info-section">
                        <div class="cy-info-row">
                            <span class="cy-info-label">預定開工</span>
                            <span class="cy-info-value"><t t-esc="slip.planned_start_date or '-'"/></span>
                        </div>
                        <div class="cy-info-row">
                            <span class="cy-info-label">預定完工</span>
                            <span class="cy-info-value"><t t-esc="slip.planned_end_date or '-'"/></span>
                        </div>
                        <div class="cy-info-row" t-if="slip.planned_duration">
                            <span class="cy-info-label">預定工期</span>
                            <span class="cy-info-value"><t t-esc="slip.planned_duration"/> 日</span>
                        </div>
                        <div class="cy-info-row" t-if="slip.actual_start_date">
                            <span class="cy-info-label">實際開工</span>
                            <span class="cy-info-value"><t t-esc="slip.actual_start_date"/></span>
                        </div>
                        <div class="cy-info-row" t-if="slip.actual_end_date">
                            <span class="cy-info-label">實際竣工</span>
                            <span class="cy-info-value"><t t-esc="slip.actual_end_date"/></span>
                        </div>
                        <div class="cy-info-row" t-if="slip.actual_duration">
                            <span class="cy-info-label">實際工期</span>
                            <span class="cy-info-value"><t t-esc="slip.actual_duration"/> 日</span>
                        </div>
                    </div>

                    <!-- 金額 -->
                    <div class="cy-section-title">金額</div>
                    <div class="cy-info-section">
                        <div class="cy-info-row">
                            <span class="cy-info-label">預估金額</span>
                            <span class="cy-info-value accent">
                                <t t-if="slip.estimated_amount">
                                    NT$ <t t-esc="'{:,.0f}'.format(slip.estimated_amount)"/>
                                </t>
                                <t t-else="">-</t>
                            </span>
                        </div>
                        <div class="cy-info-row">
                            <span class="cy-info-label">結算金額</span>
                            <span class="cy-info-value accent">
                                <t t-if="slip.settlement_amount">
                                    NT$ <t t-esc="'{:,.0f}'.format(slip.settlement_amount)"/>
                                </t>
                                <t t-else="">-</t>
                            </span>
                        </div>
                    </div>

                    <!-- 工項明細 -->
                    <t t-if="slip.detail_line_ids">
                        <div class="cy-section-title">
                            <span>工項明細</span>
                            <span style="font-size: 0.8rem; color: var(--wb-t3);">
                                <t t-esc="len(slip.detail_line_ids)"/> 項
                            </span>
                        </div>

                        <t t-foreach="slip.detail_line_ids" t-as="line">
                            <div class="cy-card" style="margin-bottom: 8px;">
                                <div class="cy-card-body" style="padding: 12px 14px;">
                                    <div style="font-weight: 700; font-size: 0.9rem; margin-bottom: 4px;">
                                        <t t-if="line.item_no">
                                            <span style="color: var(--wb-t3); font-size: 0.8rem;">[<t t-esc="line.item_no"/>] </span>
                                        </t>
                                        <t t-esc="line.description"/>
                                    </div>
                                    <div style="display: flex; gap: 12px; font-size: 0.85rem; flex-wrap: wrap;">
                                        <span>預估：<strong><t t-esc="line.planned_qty"/> <t t-esc="line.unit"/></strong></span>
                                        <span>實際：<strong><t t-esc="line.actual_qty"/></strong></span>
                                        <span>單價：<strong>NT$ <t t-esc="'{:,.0f}'.format(line.unit_price)"/></strong></span>
                                    </div>
                                    <!-- 進度條 -->
                                    <t t-if="line.completion_rate">
                                        <div style="display: flex; align-items: center; gap: 8px; margin-top: 6px;">
                                            <div class="cy-progress-bar" style="flex: 1;">
                                                <div class="cy-progress-fill"
                                                     t-attf-style="width: #{min(line.completion_rate, 100)}%;"/>
                                            </div>
                                            <span style="font-size: 0.8rem; font-weight: 700; color: var(--wb-amber); min-width: 40px; text-align: right;">
                                                <t t-esc="'%.0f' % line.completion_rate"/>%
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>

                    <!-- 自主檢查 -->
                    <div class="cy-section-title">
                        <span>自主檢查</span>
                        <a t-attf-href="/construction/#{project.id}/reservation-inspection/new?slip_id=#{slip.id}"
                           class="cy-btn cy-btn-outline"
                           style="font-size: 0.8rem; padding: 4px 12px; min-height: 32px;">
                            <i class="fa fa-plus"/> 新增檢查
                        </a>
                    </div>
                    <t t-if="slip_inspections">
                        <div class="cy-card" style="overflow: hidden;">
                            <t t-foreach="slip_inspections" t-as="si">
                                <a t-attf-href="/construction/reservation-inspection/#{si.id}"
                                   style="text-decoration: none; color: inherit; display: block; padding: 16px; border-bottom: 1px solid var(--wb-bdr);">
                                    <div style="display: flex; justify-content: space-between;">
                                        <span style="font-size: 0.9rem; font-weight: 600;">
                                            <t t-esc="si.inspection_type_id.name or si.inspection_no or ''"/>
                                        </span>
                                        <span t-attf-class="cy-badge cy-badge-#{si.state}">
                                            <t t-esc="dict(si._fields['state'].selection).get(si.state, si.state)"/>
                                        </span>
                                    </div>
                                    <div style="font-size: 0.85rem; color: var(--wb-t2); margin-top: 4px;">
                                        <t t-esc="si.inspection_location or ''"/> / <t t-esc="si.inspection_date or ''"/>
                                    </div>
                                </a>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div style="font-size: 0.85rem; color: var(--wb-t3); margin-bottom: 14px;">尚無自主檢查紀錄</div>
                    </t>

                    <!-- 缺失改善 -->
                    <div class="cy-section-title">缺失改善</div>
                    <t t-if="slip_defects">
                        <div class="cy-card" style="overflow: hidden;">
                            <t t-foreach="slip_defects" t-as="sd">
                                <div style="padding: 16px; border-bottom: 1px solid var(--wb-bdr);">
                                    <div style="display: flex; justify-content: space-between;">
                                        <span style="font-size: 0.9rem; font-weight: 600;">
                                            <t t-esc="sd.record_no or ''"/> <t t-esc="sd.defect_description and sd.defect_description[:40] or ''"/>
                                        </span>
                                        <span t-attf-class="cy-badge cy-badge-#{sd.state}">
                                            <t t-esc="dict(sd._fields['state'].selection).get(sd.state, sd.state)"/>
                                        </span>
                                    </div>
                                    <div style="font-size: 0.85rem; color: var(--wb-t2); margin-top: 4px;">
                                        <t t-if="sd.is_overdue"><span style="color: var(--wb-red);">逾期<t t-esc="sd.overdue_days"/>天</span></t>
                                        <t t-elif="sd.deadline"> 期限 <t t-esc="sd.deadline"/></t>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div style="font-size: 0.85rem; color: var(--wb-t3); margin-bottom: 14px;">尚無缺失紀錄</div>
                    </t>

                    <!-- 備註 -->
                    <t t-if="slip.design_summary">
                        <div class="cy-section-title">設計概述</div>
                        <div class="cy-info-section" style="padding: 12px 16px;">
                            <div style="font-size: 0.9rem; white-space: pre-wrap;"><t t-esc="slip.design_summary"/></div>
                        </div>
                    </t>

                    <!-- 訊息紀錄 -->
                    <div class="cy-section-title" style="margin-top: 24px;">訊息</div>
                    <div style="background: var(--wb-bg2); border-radius: var(--wb-radius); border: 1px solid var(--wb-bdr); padding: 12px; margin-bottom: 14px;">
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="slip"/>
                        </t>
                    </div>
                </div>

                <t t-call="construction_portal.portal_bottom_nav_v10"/>
            </div>
        </t>
    </template>
</odoo>
