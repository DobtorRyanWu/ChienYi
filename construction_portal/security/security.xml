<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Portal 用戶存取規則（v11 角色分級）

    可見性設計（採「base.group_portal 預設成員制 + 老闆 OR 公司範圍」）：
    - base.group_portal 一律套「成員制」rule：只看被指派為參與成員的專案。
      → 任何 portal 帳號（含尚未改派的舊 4 層群組）預設只看成員專案，安全 deny-by-default。
    - 老闆 group_portal_subscriber（v18.0.4.3.0 合併後）另加一條「公司範圍」rule，OR 疊加 → 老闆看公司承包全部。
      （老闆本身通常不是任何專案的成員，成員 rule 對他回空集合，OR 後等同公司範圍。）

    寫入說明：
    - 前台 create/write 多走 controller .sudo()，sudo 會繞過 ir.rule 與 ir.model.access，
      故前台寫入隔離（現場人員只改自己建的、建專案/審核限老闆+主管）由 controller guard 強制。
    - 以下寫入 rule 僅作後台與非 sudo 路徑的防禦層。觀看者(observer)不給任何寫入 rule。
    -->

    <!-- ============================================================ -->
    <!-- 工程案件 project.project：可見性主閘門                          -->
    <!-- （合併後工程案件＝project.project；原委派後盾 rule 已隨委派 FK  -->
    <!--   消滅而移除，避免非老闆 portal 用戶取得公司範圍存取）           -->
    <!-- ============================================================ -->

    <!-- 預設（所有 portal 帳號）：只看被指派為參與成員的專案；排除草稿/終止。
         老闆另有 boss_rule OR 疊加（全部專案、不分狀態），不受此狀態過濾影響。 -->
    <record id="supervision_project_portal_member_rule" model="ir.rule">
        <field name="name">Portal: 工程案件 - 僅參與成員專案（預設）</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[
            ('member_user_ids', 'in', [user.id]),
            ('state', 'not in', ['draft', 'terminated'])
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 老闆：全庫所有專案（一庫一公司＝公司全部；不受專案狀態限制，OR 疊加在成員制之上） -->
    <record id="supervision_project_portal_boss_rule" model="ir.rule">
        <field name="name">Portal老闆: 工程案件 - 全部專案</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============================================================ -->
    <!-- 子單據：預設成員制讀取 + 老闆公司範圍 + 主管/現場寫入            -->
    <!-- ============================================================ -->

