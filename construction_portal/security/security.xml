<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal 用戶存取規則 -->
    <!--
    設計說明：
    使用 contractor_partner_ids 輔助欄位進行安全規則檢查
    因為 Many2many 欄位遍歷 (contractor_company_ids.partner_id) 在 ir.rule domain 中無法正確運作
    -->

    <!--
    project.project: Portal 用戶可存取關聯的工程專案
    這條規則繞過 project 模組的關注者要求，讓承包廠商可以直接存取
    使用 portal_contractor_partner_ids 輔助欄位（stored computed field）
    -->
    <record id="project_project_portal_contractor_rule" model="ir.rule">
        <field name="name">Portal: 工程專案 - 承包廠商關聯 (繞過關注者)</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[
            ('portal_contractor_partner_ids', 'in', [user.partner_id.commercial_partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 工程案件: Portal 用戶可查看其公司為承包廠商的工程 -->
    <record id="supervision_project_portal_rule" model="ir.rule">
        <field name="name">Portal: 工程案件 - 承包廠商關聯</field>
        <field name="model_id" ref="construction_supervision_base.model_supervision_project"/>
        <field name="domain_force">[
            ('contractor_partner_ids', 'in', [user.partner_id.commercial_partner_id.id]),
            ('state', 'not in', ['draft', 'terminated'])
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 自主檢查: Portal 用戶可查看其工程的檢查記錄 -->
    <record id="general_self_inspection_portal_rule" model="ir.rule">
        <field name="name">Portal: 自主檢查 - 工程關聯</field>
        <field name="model_id" ref="construction_quality.model_general_self_inspection"/>
        <field name="domain_force">[
            ('project_id.contractor_partner_ids', 'in', [user.partner_id.commercial_partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 缺失: Portal 用戶可查看其工程的缺失記錄 -->
    <record id="supervision_defect_portal_rule" model="ir.rule">
        <field name="name">Portal: 缺失 - 工程關聯</field>
        <field name="model_id" ref="construction_quality.model_supervision_defect"/>
        <field name="domain_force">[
            ('project_id.contractor_partner_ids', 'in', [user.partner_id.commercial_partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 照片: Portal 用戶可查看其工程的照片 -->
    <record id="supervision_photo_portal_rule" model="ir.rule">
        <field name="name">Portal: 照片 - 工程關聯</field>
        <field name="model_id" ref="construction_photo.model_supervision_photo"/>
        <field name="domain_force">[
            ('project_id.contractor_partner_ids', 'in', [user.partner_id.commercial_partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 檢查類型: Portal 用戶可讀取 -->
    <record id="self_inspection_type_portal_rule" model="ir.rule">
        <field name="name">Portal: 檢查類型 - 讀取</field>
        <field name="model_id" ref="construction_quality.model_self_inspection_type"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
