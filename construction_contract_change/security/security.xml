<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 契約變更管理群組 -->
        <record id="group_contract_change_user" model="res.groups">
            <field name="name">契約變更管理 / 使用者</field>
            <field name="category_id" ref="construction_supervision_base.module_category_construction_supervision"/>
            <field name="implied_ids" eval="[(4, ref('construction_supervision_base.group_supervision_engineer'))]"/>
            <field name="comment">可查看和建立契約變更單</field>
        </record>

        <record id="group_contract_change_manager" model="res.groups">
            <field name="name">契約變更管理 / 管理員</field>
            <field name="category_id" ref="construction_supervision_base.module_category_construction_supervision"/>
            <field name="implied_ids" eval="[(4, ref('group_contract_change_user')), (4, ref('construction_supervision_base.group_supervision_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">可審核和核定契約變更單</field>
        </record>

        <!-- 記錄規則：契約變更單 -->
        <record id="contract_change_order_company_rule" model="ir.rule">
            <field name="name">契約變更單：公司隔離</field>
            <field name="model_id" ref="model_contract_change_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 記錄規則：契約變更明細 -->
        <record id="contract_change_order_line_company_rule" model="ir.rule">
            <field name="name">契約變更明細：公司隔離</field>
            <field name="model_id" ref="model_contract_change_order_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
