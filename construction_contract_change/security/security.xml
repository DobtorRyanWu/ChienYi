<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 記錄規則：契約變更單 -->
        <record id="contract_change_order_company_rule" model="ir.rule">
            <field name="name">契約變更單：公司隔離</field>
            <field name="model_id" ref="model_contract_change_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 記錄規則：契約變更明細 -->
        <record id="contract_change_order_line_company_rule" model="ir.rule">
            <field name="name">契約變更明細：公司隔離</field>
            <field name="model_id" ref="model_contract_change_order_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 系統管理者 - 完整存取 -->
        <record id="rule_admin_full_access_change_order" model="ir.rule">
            <field name="name">管理者: 契約變更單完整存取</field>
            <field name="model_id" ref="model_contract_change_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

        <record id="rule_admin_full_access_change_order_line" model="ir.rule">
            <field name="name">管理者: 契約變更明細完整存取</field>
            <field name="model_id" ref="model_contract_change_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_supervisor_admin'))]"/>
        </record>

    </data>
    <data>
        <!-- 掛在工程底下的業務資料：前台成員制可見性（2026-11-04 補）。原本前台讀得到、卻沒有任何前台規則，非成員經 RPC 讀得到別案（第四輪審查實測估驗單、契約變更、工程資料夾）。寫法同照片、缺失、日誌：所有前台帳號只看參與的工程，老闆另加公司範圍。回歸：construction_portal/tests/test_portal_orm_readonly.py 的 D 段 -->
        <record id="change_order_portal_member_rule" model="ir.rule">
            <field name="name">Portal: 契約變更 - 成員專案讀取（預設）</field>
            <field name="model_id" ref="model_contract_change_order"/>
            <field name="domain_force">[('project_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="change_order_portal_boss_rule" model="ir.rule">
            <field name="name">Portal老闆: 契約變更 - 公司範圍</field>
            <field name="model_id" ref="model_contract_change_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="change_order_line_portal_member_rule" model="ir.rule">
            <field name="name">Portal: 契約變更明細 - 成員專案讀取（預設）</field>
            <field name="model_id" ref="model_contract_change_order_line"/>
            <field name="domain_force">[('project_id.member_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="change_order_line_portal_boss_rule" model="ir.rule">
            <field name="name">Portal老闆: 契約變更明細 - 公司範圍</field>
            <field name="model_id" ref="model_contract_change_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('construction_supervision_base.group_portal_subscriber'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
