<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================== -->
    <!-- 契約變更單 Tree View -->
    <!-- ====================== -->
    <record id="contract_change_order_view_tree" model="ir.ui.view">
        <field name="name">contract.change.order.tree</field>
        <field name="model">contract.change.order</field>
        <field name="arch" type="xml">
            <list string="契約變更單"
                  decoration-info="state == 'draft'"
                  decoration-warning="state in ('submitted', 'reviewing')"
                  decoration-success="state in ('approved', 'applied')"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="change_reason"/>
                <field name="change_date"/>
                <field name="original_contract_amount" optional="hide"/>
                <field name="change_amount" sum="Total"/>
                <field name="change_amount_rate" widget="percentage"/>
                <field name="new_contract_amount"/>
                <field name="change_duration"/>
                <field name="line_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('submitted', 'reviewing')"
                       decoration-success="state in ('approved', 'applied')"
                       decoration-danger="state == 'rejected'"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ====================== -->
    <!-- 契約變更單 Form View -->
    <!-- ====================== -->
    <record id="contract_change_order_view_form_v2" model="ir.ui.view">
        <field name="name">contract.change.order.form.v2</field>
        <field name="model">contract.change.order</field>
        <field name="arch" type="xml">
            <form string="契約變更單">
                <header>
                    <button name="action_submit" type="object" string="提送審查"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="開始審查"
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="construction_contract_change.group_contract_change_manager"/>
                    <button name="action_approve" type="object" string="核定通過"
                            class="oe_highlight"
                            invisible="state != 'reviewing'"
                            groups="construction_contract_change.group_contract_change_manager"/>
                    <button name="action_apply" type="object" string="套用變更"
                            class="oe_highlight"
                            invisible="state != 'approved'"
                            groups="construction_contract_change.group_contract_change_manager"
                            confirm="確定要套用此變更？套用後將更新工項與專案契約資訊。"/>
                    <button name="action_reject" type="object" string="駁回"
                            class="btn-danger"
                            invisible="state not in ('submitted', 'reviewing')"
                            groups="construction_contract_change.group_contract_change_manager"/>
                    <button name="action_reset_draft" type="object" string="重設為草稿"
                            invisible="state not in ('submitted', 'rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,reviewing,approved,applied"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="明細"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="基本資訊">
                            <field name="project_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="change_date"
                                   readonly="state != 'draft'"/>
                            <field name="change_reason"
                                   readonly="state != 'draft'"/>
                            <!-- 新增：其他原因說明 -->
                            <field name="other_reason_detail"
                                   readonly="state != 'draft'"
                                   invisible="change_reason != 'other'"
                                   required="change_reason == 'other'"
                                   placeholder="請說明其他變更原因..."/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="契約資訊">
                            <field name="original_contract_amount"/>
                            <field name="original_duration"/>
                            <label for="change_duration"/>
                            <div class="o_row">
                                <field name="change_duration"
                                       readonly="state not in ('draft', 'submitted')"
                                       class="oe_inline" style="width: 100px;"/>
                                <span>日</span>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="變更金額">
                            <field name="change_amount"/>
                            <field name="change_amount_rate" widget="percentage"/>
                        </group>
                        <group string="變更後契約">
                            <field name="new_contract_amount"/>
                            <field name="new_duration"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="變更明細" name="lines">
                            <!-- 直接可編輯的變更明細列表 -->
                            <field name="line_ids" nolabel="1"
                                   context="{'default_change_order_id': active_id}">
                                <list string="變更明細" 
                                      editable="bottom"
                                      decoration-success="change_type == 'add'"
                                      decoration-info="change_type == 'modify'"
                                      decoration-danger="change_type == 'delete'">
                                    <!-- 拖曳排序 -->
                                    <field name="sequence" widget="handle"/>
                                    
                                    <!-- 變更類型 -->
                                    <field name="change_type" required="1"/>
                                    
                                    <!-- 原工項/父工項 -->
                                    <field name="task_id"
                                           invisible="change_type == 'add'"
                                           required="change_type in ('modify', 'delete')"
                                           domain="[('supervision_project_id', '=', parent.project_id), ('active', '=', True)]"
                                           options="{'no_create': True}"/>
                                    
                                    <field name="parent_task_id"
                                           invisible="change_type != 'add'"
                                           domain="[('supervision_project_id', '=', parent.project_id), ('active', '=', True), ('is_summary_item', '=', True)]"
                                           options="{'no_create': True}"/>
                                    
                                    <!-- 工項資訊 -->
                                    <field name="item_level" optional="show" readonly="1"/>
                                    <field name="item_no" 
                                           required="change_type == 'add'"
                                           readonly="change_type != 'add'"/>
                                    <field name="item_name" required="1"
                                           readonly="change_type != 'add'"/>
                                    <field name="unit"/>
                                    
                                    <!-- 原值 -->
                                    <field name="original_qty" 
                                           readonly="1"
                                           optional="show"
                                           invisible="change_type == 'add'"/>
                                    <field name="original_unit_price" 
                                           readonly="1"
                                           optional="hide"
                                           invisible="change_type == 'add'"/>
                                    <field name="original_amount" 
                                           readonly="1"
                                           optional="hide"
                                           invisible="change_type == 'add'"
                                           widget="monetary"/>
                                    
                                    <!-- 新值 -->
                                    <field name="new_qty"
                                           invisible="change_type == 'delete'"
                                           required="change_type in ('add', 'modify')"/>
                                    <field name="new_unit_price"
                                           invisible="change_type == 'delete'"
                                           required="change_type in ('add', 'modify')"
                                           optional="hide"/>
                                    <field name="new_amount" 
                                           readonly="1"
                                           optional="hide"
                                           invisible="change_type == 'delete'"
                                           widget="monetary"/>
                                    
                                    <!-- 變更金額 -->
                                    <field name="change_amount" 
                                           readonly="1" 
                                           sum="合計"
                                           widget="monetary"/>
                                    
                                    <!-- 隱藏欄位 -->
                                    <field name="project_id" column_invisible="1"/>
                                    <field name="change_order_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="變更說明" name="description">
                            <field name="change_reason_detail"
                                   placeholder="請詳細說明變更原因與內容..."
                                   readonly="state not in ('draft', 'submitted')"/>
                        </page>
                        <page string="審核資訊" name="approval"
                              invisible="state == 'draft'">
                            <group>
                                <group string="提送資訊">
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_date"/>
                                </group>
                                <group string="審核資訊">
                                    <field name="reviewed_by_id"/>
                                    <field name="reviewed_date"/>
                                </group>
                            </group>
                            <group>
                                <group string="核定資訊"
                                       invisible="state not in ('approved', 'applied')">
                                    <field name="approved_by_id"/>
                                    <field name="approved_date"/>
                                </group>
                                <group string="套用資訊"
                                       invisible="state != 'applied'">
                                    <field name="applied_by_id"/>
                                    <field name="applied_date"/>
                                </group>
                            </group>
                            <group string="駁回資訊"
                                   invisible="state != 'rejected'">
                                <field name="rejection_reason" nolabel="1"/>
                            </group>
                        </page>
                        <page string="備註" name="notes">
                            <field name="notes"
                                   readonly="state not in ('draft', 'submitted', 'reviewing')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- ... 其餘視圖保持不變 ... -->

</odoo>
