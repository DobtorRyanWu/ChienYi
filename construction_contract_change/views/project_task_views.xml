<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- 契約工項 - 變更紀錄頁籤                          -->
    <!-- ============================================== -->
    <record id="view_task_form_change_history" model="ir.ui.view">
        <field name="name">project.task.form.change.history</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="construction_supervision_base.view_task_form_supervision"/>
        <field name="arch" type="xml">
            <!-- 在備註頁籤後新增變更紀錄頁籤 -->
            <xpath expr="//page[@name='notes']" position="after">
                <page string="變更紀錄" name="change_history" invisible="not change_order_ids">
                    <group>
                        <group string="變更資訊">
                            <field name="change_type" readonly="1"/>
                            <field name="change_order_id" readonly="1"/>
                            <field name="is_change_item" readonly="1"/>
                        </group>
                        <group string="變更歷史">
                            <field name="change_history_display" readonly="1" widget="text"/>
                        </group>
                    </group>
                    <separator string="歷次變更單"/>
                    <field name="change_order_ids" nolabel="1">
                        <list string="變更單列表">
                            <field name="name" string="變更單編號"/>
                            <field name="change_no" string="第幾次"/>
                            <field name="state" string="狀態" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- 添加隱藏欄位 -->
            <xpath expr="//field[@name='supervision_project_id']" position="after">
                <field name="change_order_ids" invisible="1"/>
                <field name="change_type" invisible="1"/>
                <field name="change_order_id" invisible="1"/>
                <field name="is_change_item" invisible="1"/>
                <field name="change_history_display" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 契約工項 - 列表視圖添加變更紀錄欄位                -->
    <!-- ============================================== -->
    <record id="view_task_tree_change_info" model="ir.ui.view">
        <field name="name">project.task.tree.change.info</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="construction_supervision_base.view_task_tree_supervision"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='construction_notes']" position="after">
                <field name="change_history_display" string="變更紀錄" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 契約工項 - 專案專屬列表添加變更紀錄                -->
    <!-- ============================================== -->
    <record id="view_task_tree_project_specific_change" model="ir.ui.view">
        <field name="name">project.task.tree.project.specific.change</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="construction_supervision_base.view_task_tree_project_specific"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='construction_notes']" position="after">
                <field name="change_history_display" string="變更紀錄" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- 契約工項 - 專用列表添加變更紀錄                    -->
    <!-- ============================================== -->
    <record id="view_task_tree_supervision_full_change" model="ir.ui.view">
        <field name="name">project.task.tree.supervision.full.change</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="construction_supervision_base.view_task_tree_supervision_full"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='construction_notes']" position="after">
                <field name="change_history_display" string="變更紀錄" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
