<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================== -->
    <!-- 匯入工程案件精靈 Form   -->
    <!-- ====================== -->
    <record id="contract_change_wizard_view_form" model="ir.ui.view">
        <field name="name">contract.change.wizard.form</field>
        <field name="model">contract.change.wizard</field>
        <field name="arch" type="xml">
            <form string="匯入工程案件">
                <header>
                    <button name="action_confirm" type="object"
                            string="確認並儲存變更明細"
                            class="oe_highlight"/>
                    <button name="action_open_file_import_wizard" type="object"
                            string="從檔案匯入"
                            class="btn-secondary"
                            icon="fa-file-excel-o"
                            invisible="not project_id"/>
                    <button name="action_cancel" type="object"
                            string="取消返回"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <!-- 工程選擇區 -->
                    <group>
                        <group string="選擇工程">
                            <field name="change_order_id" readonly="1" invisible="1"/>
                            <field name="project_id"
                                   options="{'no_create': True}"
                                   placeholder="請選擇工程案件..."/>
                        </group>
                        <group string="批次單價調整">
                            <label for="adjust_rate"/>
                            <div class="o_row">
                                <field name="adjust_rate" class="oe_inline" style="width: 80px;"/>
                                <span class="ms-1">%</span>
                                <button name="action_apply_rate" type="object"
                                        string="套用比例調整"
                                        class="btn-primary ms-3"
                                        icon="fa-check"
                                        help="一次調整所有工項：新單價 = 原單價 × 比例%"/>
                            </div>
                            <div class="text-muted small">
                                新單價 = 原單價 × 比例%（如輸入 80 = 原單價打八折）
                            </div>
                        </group>
                        <!-- 案例一：工項完全不動、只調整契約總額 -->
                        <group string="發包工程費調整（工項不動時使用）">
                            <field name="lump_adjust_amount"/>
                            <field name="lump_adjust_reason"
                                   placeholder="例如：業主追加預算、上限金額提高"/>
                            <div class="text-muted small">
                                只調整契約總額、不動任何工項時填此欄（正數追加、負數追減）。
                                只填此欄也可以直接按「確認並儲存變更明細」。
                            </div>
                        </group>
                    </group>

                    <!-- 變更統計 -->
                    <group>
                        <group string="變更統計">
                            <div class="o_row">
                                <span>修改: </span><field name="modify_count" class="oe_inline"/><span> 項</span>
                                <span class="mx-2">|</span>
                                <span>歸零: </span><field name="zero_out_count" class="oe_inline"/><span> 項</span>
                                <span class="mx-2">|</span>
                                <span>刪除: </span><field name="delete_count" class="oe_inline"/><span> 項</span>
                                <span class="mx-2">|</span>
                                <span>新增: </span><field name="add_count" class="oe_inline"/><span> 項</span>
                            </div>
                            <field name="total_change_amount" string="總變更金額"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- 金額核對報告（有差異時自動顯示，位於列表上方） -->
                    <div invisible="not reconciliation_report">
                        <div class="alert alert-warning" role="alert"
                             invisible="not show_reconciliation_report">
                            <strong>⚠ 金額核對報告：以下分類系統計算與 XLSX 宣告合價有差異</strong><br/>
                            <field name="reconciliation_report" widget="text" readonly="1" nolabel="1"/>
                            <button name="action_close_reconciliation"
                                    string="已了解，關閉提示"
                                    type="object" class="btn btn-sm btn-secondary mt-2"/>
                        </div>
                        <button name="action_open_reconciliation"
                                string="顯示金額核對報告"
                                type="object"
                                invisible="show_reconciliation_report"
                                class="btn btn-sm btn-warning"/>
                    </div>

                    <notebook>
                    <page string="工項列表" name="items">
                    <!-- 新增工項按鈕 -->
                    <div class="d-flex align-items-center gap-2 flex-wrap" style="margin: 10px 0;">
                        <button name="action_add_new_line" type="object"
                                string="新增工項"
                                class="btn-primary"
                                icon="fa-plus"/>
                    </div>

                    <!-- 工項列表 -->
                    <field name="wizard_line_ids" nolabel="1">
                        <list string="工項列表" editable="bottom"
                              decoration-success="change_type == 'add'"
                              decoration-info="change_type == 'modify'"
                              decoration-warning="change_type == 'zero_out'"
                              decoration-danger="change_type == 'delete'">
                            <!-- 1. 變更類型（彙總項與稅什費唯讀）-->
                            <field name="change_type" readonly="is_summary_item or is_tax_misc_item"/>
                            <!-- 2. 工項名稱 -->
                            <field name="display_item_name" string="工項名稱" readonly="1"/>
                            <!-- 隱藏：item_name 供後端 create/action_confirm 使用 -->
                            <field name="item_name" column_invisible="1"/>
                            <!-- 3. 父工項（合併欄）：既有彙總項 或 本次新增群組，單欄顯示/編輯 -->
                            <field name="parent_ref"
                                   string="父工項"
                                   readonly="is_summary_item"/>
                            <!-- 後端權威欄位（隱藏，供 domain/邏輯使用），編輯在行內 dialog -->
                            <field name="parent_task_id" column_invisible="1"/>
                            <field name="parent_line_id" column_invisible="1"/>
                            <field name="is_new_group" optional="hide"/>
                            <!-- 預備單價項目（不計入契約金額） -->
                            <field name="exclude_from_contract_amount"
                                   string="不計入契約金額" optional="hide"/>
                            <!-- 4. 工項編號 -->
                            <field name="item_no"/>
                            <!-- 5. 單位 -->
                            <field name="unit"/>
                            <!-- 6. 原數量 -->
                            <field name="original_qty" readonly="1"/>
                            <!-- 7. 原單價 -->
                            <field name="original_unit_price" readonly="1"/>
                            <!-- 8. 原金額 -->
                            <field name="original_amount" readonly="1"/>
                            <!-- 9. 新數量（彙總項唯讀）-->
                            <field name="new_qty" readonly="is_summary_item"/>
                            <!-- 10. 新單價（彙總項與稅什費唯讀）-->
                            <field name="new_unit_price"
                                   readonly="is_summary_item or is_tax_misc_item or is_lump_sum_item"/>
                            <!-- 11. 新金額（整包費用項直接填這一欄，不經數量 × 單價）-->
                            <field name="new_amount"
                                   readonly="not is_lump_sum_item or change_type != 'modify'"/>
                            <!-- 12. 金額增減 -->
                            <field name="change_amount" readonly="1" sum="合計"/>
                            <!-- 隱藏欄位（後台邏輯用） -->
                            <field name="sequence" column_invisible="1"/>
                            <field name="task_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="is_summary_item" column_invisible="1"/>
                            <field name="is_tax_misc_item" column_invisible="1"/>
                            <field name="is_lump_sum_item" column_invisible="1"/>
                        </list>
                    </field>
                    </page>

                    <!-- ── 比例項設定 ────────────────────────────────────
                         直接編輯 project.task 的計算組態（比例與比例基數）。
                         比例是工項自己的組態、不是某一次變更的量價，
                         檔案匯入精靈也是直接寫 task.tax_misc_rate，行為一致。
                         刻意掛 project.task 而非再開一個 wizard.line 的 One2many：
                         同一批 wizard line 掛在兩個 x2many 上，編輯時快取會不同步。 -->
                    <page string="比例項設定" name="rate_items">
                        <div class="text-muted small" style="margin: 10px 0;">
                            這裡列出「金額不是由數量 × 單價決定」的工項：
                            <b>比例項</b>（稅什費、自主品管費等，金額 = 比例 × 基數）與
                            <b>整包費用項</b>（單價欄本來就空白、只有一筆整包金額）。<br/>
                            <b>比例基數</b>留空 = 同層全部前置工項（稅什費的傳統行為）；
                            指定時只以選定的工項為基數，用來表達
                            「自主品管費 = 工程費 × 2%」這種基數只有特定群組的公式。
                            基數只能選<b>排在該工項前面的同層工項</b>，故不會循環參照。<br/>
                            <b>整包費用項</b>若設了比例，金額改由比例算出（比例優先）；
                            留空則維持整包金額，變更時在「工項列表」直接填新金額。<br/>
                            ⚠ 此頁的修改會<b>直接寫回契約工項</b>，不經變更明細。
                        </div>
                        <field name="rate_task_ids" nolabel="1"
                               invisible="not project_id">
                            <list editable="bottom" create="0" delete="0">
                                <field name="display_item_no" string="項次" readonly="1"/>
                                <field name="name" string="工項名稱" readonly="1"/>
                                <field name="unit" string="單位" readonly="1"/>
                                <field name="is_lump_sum" string="整包費用項"/>
                                <field name="tax_misc_rate" string="比例 (%)"/>
                                <!-- 不要加 readonly="not tax_misc_rate"：整包費用項一開始
                                     比例是 0，加了就永遠設不了基數（先有雞先有蛋）。
                                     沒有比例時基數只是備而不用，不影響任何計算。 -->
                                <field name="rate_base_task_ids" string="比例基數"
                                       widget="many2many_tags"
                                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                                       placeholder="留空 = 同層全部前置工項"/>
                                <field name="xml_amount" string="整包金額"
                                       readonly="not is_lump_sum"/>
                                <field name="planned_amount" string="契約金額"
                                       readonly="1" sum="合計"/>
                                <!-- rate_base_task_ids 的 domain 用到這兩欄 -->
                                <field name="parent_id" column_invisible="1"/>
                                <field name="sequence" column_invisible="1"/>
                            </list>
                        </field>
                        <div class="text-muted small" invisible="project_id">
                            請先於上方選擇工程案件。
                        </div>
                    </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================= -->
    <!-- 新增工項 Dialog (wizard.line form) -->
    <!-- ========================= -->
    <record id="contract_change_wizard_line_view_form" model="ir.ui.view">
        <field name="name">contract.change.wizard.line.form</field>
        <field name="model">contract.change.wizard.line</field>
        <field name="arch" type="xml">
            <form string="新增工項">
                <sheet>
                    <field name="wizard_id" invisible="1"/>
                    <field name="change_type" invisible="1"/>
                    <field name="project_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <group string="基本資訊">
                        <field name="is_new_group"/>
                        <field name="parent_task_id"
                               string="父工項(原契約已存在)"
                               domain="[('supervision_project_id', '=', project_id), ('is_summary_item', '=', True), ('active', '=', True)]"
                               options="{'no_create': True}"
                               placeholder="留空 = 新增最高層工項（壹/貳/參...）"/>
                        <field name="parent_line_id"
                               string="父工項(本次新增)"
                               domain="[('wizard_id', '=', wizard_id), ('change_type', '=', 'add'), ('is_new_group', '=', True), ('id', '!=', id)]"
                               options="{'no_create': True}"
                               placeholder="父為本次新增的群組時選此（與上方擇一）"/>
                        <field name="item_no"
                               placeholder="系統自動產生，可手動修改"/>
                        <field name="item_name"
                               placeholder="請輸入工項名稱"/>
                        <field name="unit"/>
                        <field name="exclude_from_contract_amount"/>
                        <!-- 整包費用項：單位「式」、沒有單價、只有一筆整包金額
                             （自主品管費、工安費等）。勾選後改填「新金額」。 -->
                        <field name="is_new_lump_sum" invisible="is_new_group"/>
                    </group>
                    <group string="數量單價">
                        <field name="is_lump_amount_item" invisible="1"/>
                        <field name="new_qty" invisible="is_lump_amount_item"/>
                        <field name="new_unit_price" invisible="is_lump_amount_item"/>
                        <field name="new_amount"
                               readonly="not is_lump_amount_item"
                               required="is_lump_amount_item"/>
                        <field name="change_amount" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="確認新增" class="oe_highlight" special="save"/>
                    <button string="取消" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_contract_change_wizard" model="ir.actions.act_window">
        <field name="name">匯入工程案件</field>
        <field name="res_model">contract.change.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
